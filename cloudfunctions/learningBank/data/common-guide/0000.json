[{"id":"prehistoric-civilization::paleolithic-tools-and-fire","scope":"humanities-history","groupId":"prehistoric-civilization","groupTitle":"史前时代","groupTakeaway":"史前时代分为旧石器时代、新石器时代和传说时代三组。前两组比较工具、用火、农业与手工业，传说时代关注部落融合、首领推选和治水故事。","title":"旧石器时代的工具与用火","content":"元谋人已经会制造工具并知道用火；北京人会制造石器、使用天然火并保存火种；山顶洞人仍使用打制石器，同时掌握磨光、钻孔、制作骨针和人工取火技术。","label":"旧石器时代的工具与用火","note":"元谋人已经会制造工具并知道用火；北京人会制造石器、使用天然火并保存火种；山顶洞人仍使用打制石器，同时掌握磨光、钻孔、制作骨针和人工取火技术。","learningGoal":"比较元谋人、北京人和山顶洞人在工具制造与用火方面的发展。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"prehistoric-civilization","tabId":"prehistoric-1","sourceUnitIds":["cs-1-9-p1-old-stone-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=prehistoric-civilization&tabId=prehistoric-1","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"f6ca5d4a","learningSignature":"df4f219a"},{"id":"prehistoric-civilization::neolithic-crops-and-tools","scope":"humanities-history","groupId":"prehistoric-civilization","groupTitle":"史前时代","groupTakeaway":"史前时代分为旧石器时代、新石器时代和传说时代三组。前两组比较工具、用火、农业与手工业，传说时代关注部落融合、首领推选和治水故事。","title":"新石器时代的主要作物与工具","content":"河姆渡文化位于长江流域下游，种植水稻并使用骨耜；仰韶文化位于黄河中游，以磨制石器为主要生产工具，种植粟和黍，半坡遗址是其代表。","label":"新石器时代的主要作物与工具","note":"河姆渡文化位于长江流域下游，种植水稻并使用骨耜；仰韶文化位于黄河中游，以磨制石器为主要生产工具，种植粟和黍，半坡遗址是其代表。","learningGoal":"区分河姆渡文化与仰韶文化的地域、作物和生产工具。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"prehistoric-civilization","tabId":"prehistoric-2","sourceUnitIds":["cs-1-9-p1-p2-new-stone-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=prehistoric-civilization&tabId=prehistoric-2","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"7a7e0e4d","learningSignature":"b1d45af"},{"id":"prehistoric-civilization::neolithic-crafts-by-culture","scope":"humanities-history","groupId":"prehistoric-civilization","groupTitle":"史前时代","groupTakeaway":"史前时代分为旧石器时代、新石器时代和传说时代三组。前两组比较工具、用火、农业与手工业，传说时代关注部落融合、首领推选和治水故事。","title":"新石器文化的手工业特征","content":"红山文化以彩陶和玉猪龙等玉雕著称；大汶口文化出现黑陶、白陶和养蚕缫丝；龙山文化出土大量黑陶，因此又被称为“黑陶文化”。","label":"新石器文化的手工业特征","note":"红山文化以彩陶和玉猪龙等玉雕著称；大汶口文化出现黑陶、白陶和养蚕缫丝；龙山文化出土大量黑陶，因此又被称为“黑陶文化”。","learningGoal":"说清红山文化、大汶口文化和龙山文化各自的代表性手工业特征。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"prehistoric-civilization","tabId":"prehistoric-2","sourceUnitIds":["cs-1-9-p1-p2-new-stone-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=prehistoric-civilization&tabId=prehistoric-2","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"f79cfdb7","learningSignature":"d9b31f95"},{"id":"prehistoric-civilization::yanhuang-banquan-zhuolu","scope":"humanities-history","groupId":"prehistoric-civilization","groupTitle":"史前时代","groupTakeaway":"史前时代分为旧石器时代、新石器时代和传说时代三组。前两组比较工具、用火、农业与手工业，传说时代关注部落融合、首领推选和治水故事。","title":"阪泉之战与涿鹿之战","content":"传说中，阪泉之战发生在黄帝与炎帝之间，战后部落逐渐融合；涿鹿之战中，炎帝、黄帝部落联合对抗蚩尤部落。两场战事共同用于说明炎黄部落的融合过程。","label":"阪泉之战与涿鹿之战","note":"传说中，阪泉之战发生在黄帝与炎帝之间，战后部落逐渐融合；涿鹿之战中，炎帝、黄帝部落联合对抗蚩尤部落。两场战事共同用于说明炎黄部落的融合过程。","learningGoal":"区分阪泉之战和涿鹿之战的交战双方及其在传说时代中的意义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"prehistoric-civilization","tabId":"prehistoric-3","sourceUnitIds":["cs-1-9-p2-flame-yellow-yao-shun-yu-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=prehistoric-civilization&tabId=prehistoric-3","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a8ea593d","learningSignature":"4c52c6cb"},{"id":"prehistoric-civilization::abdication-system","scope":"humanities-history","groupId":"prehistoric-civilization","groupTitle":"史前时代","groupTakeaway":"史前时代分为旧石器时代、新石器时代和传说时代三组。前两组比较工具、用火、农业与手工业，传说时代关注部落融合、首领推选和治水故事。","title":"禅让制","content":"禅让制是传说中尧、舜、禹时期部落联盟推选首领的制度。其核心是由各部落首领推举部落联盟首领，不以父子世袭作为继承方式。","label":"禅让制","note":"禅让制是传说中尧、舜、禹时期部落联盟推选首领的制度。其核心是由各部落首领推举部落联盟首领，不以父子世袭作为继承方式。","learningGoal":"说清禅让制的适用时期、推选主体和非世袭特征。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"prehistoric-civilization","tabId":"prehistoric-3","sourceUnitIds":["cs-1-9-p2-flame-yellow-yao-shun-yu-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=prehistoric-civilization&tabId=prehistoric-3","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"8ee92556","learningSignature":"5cf86257"}]