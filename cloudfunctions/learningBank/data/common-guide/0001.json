[{"id":"prehistoric-civilization::yu-flood-control-method","scope":"humanities-history","groupId":"prehistoric-civilization","groupTitle":"史前时代","groupTakeaway":"史前时代分为旧石器时代、新石器时代和传说时代三组。前两组比较工具、用火、农业与手工业，传说时代关注部落融合、首领推选和治水故事。","title":"大禹治水的方法","content":"传说中，大禹吸取鲧治水失败的教训，改变单纯堵水的办法，采用疏导洪水的方式，并长期在外与民众治水。“三过家门而不入”用于表现其公而忘私。","label":"大禹治水的方法","note":"传说中，大禹吸取鲧治水失败的教训，改变单纯堵水的办法，采用疏导洪水的方式，并长期在外与民众治水。“三过家门而不入”用于表现其公而忘私。","learningGoal":"说明大禹治水相较鲧治水的方法变化及相关典故含义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"prehistoric-civilization","tabId":"prehistoric-3","sourceUnitIds":["cs-1-9-p2-flame-yellow-yao-shun-yu-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=prehistoric-civilization&tabId=prehistoric-3","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ffa19324"},{"id":"three-kingdoms-sui-tang::guandu-chibi-comparison","scope":"humanities-history","groupId":"three-kingdoms-sui-tang","groupTitle":"三国两晋南北朝","groupTakeaway":"三国两晋南北朝可沿战争与政权更替理解：三场战役定位三国，西晋统一后转入东晋和南北对峙，孝文帝改革与江南开发反映民族交融和经济变化。","title":"官渡之战与赤壁之战","content":"200年的官渡之战中，曹操击败袁绍，为统一北方奠定基础；208年的赤壁之战中，孙刘联军以火攻击败曹军，为三国鼎立局面的形成奠定基础。","label":"官渡之战与赤壁之战","note":"200年的官渡之战中，曹操击败袁绍，为统一北方奠定基础；208年的赤壁之战中，孙刘联军以火攻击败曹军，为三国鼎立局面的形成奠定基础。","learningGoal":"区分官渡之战与赤壁之战的交战双方和历史作用。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"three-kingdoms-sui-tang","tabId":"three-kingdoms","sourceUnitIds":["cs-1-9-p5-p6-three-kingdoms-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=three-kingdoms-sui-tang&tabId=three-kingdoms","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"5f55f7a3"},{"id":"three-kingdoms-sui-tang::yiling-battle","scope":"humanities-history","groupId":"three-kingdoms-sui-tang","groupTitle":"三国两晋南北朝","groupTakeaway":"三国两晋南北朝可沿战争与政权更替理解：三场战役定位三国，西晋统一后转入东晋和南北对峙，孝文帝改革与江南开发反映民族交融和经济变化。","title":"夷陵之战","content":"公元221年，刘备为夺回荆州并替关羽报仇，率军进攻东吴。东吴将领陆逊采取火攻，击败刘备。夷陵之战反映的是吴、蜀之间的冲突。","label":"夷陵之战","note":"公元221年，刘备为夺回荆州并替关羽报仇，率军进攻东吴。东吴将领陆逊采取火攻，击败刘备。夷陵之战反映的是吴、蜀之间的冲突。","learningGoal":"识别夷陵之战的交战双方、主要人物和结果。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"three-kingdoms-sui-tang","tabId":"three-kingdoms","sourceUnitIds":["cs-1-9-p5-p6-three-kingdoms-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=three-kingdoms-sui-tang&tabId=three-kingdoms","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"9a26b7e7"},{"id":"three-kingdoms-sui-tang::three-kingdoms-foundation","scope":"humanities-history","groupId":"three-kingdoms-sui-tang","groupTitle":"三国两晋南北朝","groupTakeaway":"三国两晋南北朝可沿战争与政权更替理解：三场战役定位三国，西晋统一后转入东晋和南北对峙，孝文帝改革与江南开发反映民族交融和经济变化。","title":"魏蜀吴三国的建立","content":"220年曹丕称帝，定都洛阳，建立曹魏；221年刘备称帝，定都成都，建立蜀汉；229年孙权称帝，定都建业，建立东吴。","label":"魏蜀吴三国的建立","note":"220年曹丕称帝，定都洛阳，建立曹魏；221年刘备称帝，定都成都，建立蜀汉；229年孙权称帝，定都建业，建立东吴。","learningGoal":"说清魏、蜀、吴各自的建立时间、建立者和都城。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"three-kingdoms-sui-tang","tabId":"three-kingdoms","sourceUnitIds":["cs-1-9-p5-p6-three-kingdoms-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=three-kingdoms-sui-tang&tabId=three-kingdoms","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"845cecc0"},{"id":"three-kingdoms-sui-tang::western-eastern-jin-transition","scope":"humanities-history","groupId":"three-kingdoms-sui-tang","groupTitle":"三国两晋南北朝","groupTakeaway":"三国两晋南北朝可沿战争与政权更替理解：三场战役定位三国，西晋统一后转入东晋和南北对峙，孝文帝改革与江南开发反映民族交融和经济变化。","title":"西晋与东晋的政权更替","content":"265年司马炎建立西晋并定都洛阳；316年西晋灭亡。317年司马睿在建康重建晋室，史称东晋。两晋的分界在于西晋覆亡后晋室转到江南。","label":"西晋与东晋的政权更替","note":"265年司马炎建立西晋并定都洛阳；316年西晋灭亡。317年司马睿在建康重建晋室，史称东晋。两晋的分界在于西晋覆亡后晋室转到江南。","learningGoal":"说清西晋建立、灭亡以及东晋在江南建立的先后关系。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"three-kingdoms-sui-tang","tabId":"two-jin","sourceUnitIds":["cs-1-9-p6-two-jin-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=three-kingdoms-sui-tang&tabId=two-jin","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b1e4f37e"}]