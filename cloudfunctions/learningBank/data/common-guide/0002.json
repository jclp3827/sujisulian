[{"id":"three-kingdoms-sui-tang::feishui-battle","scope":"humanities-history","groupId":"three-kingdoms-sui-tang","groupTitle":"三国两晋南北朝","groupTakeaway":"三国两晋南北朝可沿战争与政权更替理解：三场战役定位三国，西晋统一后转入东晋和南北对峙，孝文帝改革与江南开发反映民族交融和经济变化。","title":"淝水之战","content":"公元383年，前秦苻坚进攻东晋，东晋在谢安等人领导下击败前秦。淝水之战是一场以少胜多的战役，战后南北长期对峙的局面进一步确立。","label":"淝水之战","note":"公元383年，前秦苻坚进攻东晋，东晋在谢安等人领导下击败前秦。淝水之战是一场以少胜多的战役，战后南北长期对峙的局面进一步确立。","learningGoal":"说明淝水之战的双方、结果及其对南北局势的影响。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"three-kingdoms-sui-tang","tabId":"northern-southern","sourceUnitIds":["cs-1-9-p6-five-hu-northern-southern-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=three-kingdoms-sui-tang&tabId=northern-southern","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3b806140"},{"id":"three-kingdoms-sui-tang::northern-southern-dynasties-sequence","scope":"humanities-history","groupId":"three-kingdoms-sui-tang","groupTitle":"三国两晋南北朝","groupTakeaway":"三国两晋南北朝可沿战争与政权更替理解：三场战役定位三国，西晋统一后转入东晋和南北对峙，孝文帝改革与江南开发反映民族交融和经济变化。","title":"南朝与北朝的政权序列","content":"南朝依次为宋、齐、梁、陈，均定都建康；北朝从北魏开始，北魏后来分为东魏和西魏，二者又分别被北齐和北周取代。","label":"南朝与北朝的政权序列","note":"南朝依次为宋、齐、梁、陈，均定都建康；北朝从北魏开始，北魏后来分为东魏和西魏，二者又分别被北齐和北周取代。","learningGoal":"区分南朝和北朝的主要政权及其先后关系。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"three-kingdoms-sui-tang","tabId":"northern-southern","sourceUnitIds":["cs-1-9-p6-five-hu-northern-southern-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=three-kingdoms-sui-tang&tabId=northern-southern","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a744609b"},{"id":"three-kingdoms-sui-tang::northern-wei-xiaowen-reform","scope":"humanities-history","groupId":"three-kingdoms-sui-tang","groupTitle":"三国两晋南北朝","groupTakeaway":"三国两晋南北朝可沿战争与政权更替理解：三场战役定位三国，西晋统一后转入东晋和南北对峙，孝文帝改革与江南开发反映民族交融和经济变化。","title":"北魏孝文帝改革","content":"北魏孝文帝改革包括推行均田制、494年迁都洛阳，以及改穿汉服、学习汉语、采用汉姓、提倡鲜卑人与汉人通婚等汉化措施。","label":"北魏孝文帝改革","note":"北魏孝文帝改革包括推行均田制、494年迁都洛阳，以及改穿汉服、学习汉语、采用汉姓、提倡鲜卑人与汉人通婚等汉化措施。","learningGoal":"概括北魏孝文帝改革的土地、迁都和汉化措施。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"three-kingdoms-sui-tang","tabId":"northern-southern","sourceUnitIds":["cs-1-9-p6-five-hu-northern-southern-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=three-kingdoms-sui-tang&tabId=northern-southern","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c7c0fc9c"},{"id":"three-kingdoms-sui-tang::jiangnan-economic-development","scope":"humanities-history","groupId":"three-kingdoms-sui-tang","groupTitle":"三国两晋南北朝","groupTakeaway":"三国两晋南北朝可沿战争与政权更替理解：三场战役定位三国，西晋统一后转入东晋和南北对峙，孝文帝改革与江南开发反映民族交融和经济变化。","title":"江南经济开发的影响","content":"三国两晋南北朝时期，江南农业开发从江东扩展到长江流域，并波及岭南和闽江流域。江南开发使南北经济趋向平衡，为以后经济重心南移奠定基础。","label":"江南经济开发的影响","note":"三国两晋南北朝时期，江南农业开发从江东扩展到长江流域，并波及岭南和闽江流域。江南开发使南北经济趋向平衡，为以后经济重心南移奠定基础。","learningGoal":"说明江南开发的地域扩展及其对经济重心变化的影响。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"three-kingdoms-sui-tang","tabId":"three-kingdoms-economy","sourceUnitIds":["cs-1-9-p6-three-kingdoms-northern-southern-economy-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=three-kingdoms-sui-tang&tabId=three-kingdoms-economy","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"50437a1d"},{"id":"sui-tang::sui-unification-and-fall","scope":"humanities-history","groupId":"sui-tang","groupTitle":"隋唐","groupTakeaway":"隋唐知识可分为政权时间线、制度、社会经济和对外交往四层。先理解隋统一与唐兴衰，再掌握科举、三省六部、赋税制度及工程、农具、制瓷和人物往来。","title":"隋朝的建立、统一与灭亡","content":"581年杨坚建立隋朝，定都长安；589年隋灭陈，完成统一。隋文帝时期出现“开皇之治”。618年江都兵变后隋炀帝被杀，隋朝灭亡。","label":"隋朝的建立、统一与灭亡","note":"581年杨坚建立隋朝，定都长安；589年隋灭陈，完成统一。隋文帝时期出现“开皇之治”。618年江都兵变后隋炀帝被杀，隋朝灭亡。","learningGoal":"说清隋朝建立、统一、治世和灭亡的关键节点。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"sui-tang","tabId":"sui","sourceUnitIds":["cs-1-9-p7-sui-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sui-tang&tabId=sui","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b0ac9c2e"}]