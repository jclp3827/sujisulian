[{"id":"sui-tang::jianzhen-japan-voyages","scope":"humanities-history","groupId":"sui-tang","groupTitle":"隋唐","groupTakeaway":"隋唐知识可分为政权时间线、制度、社会经济和对外交往四层。先理解隋统一与唐兴衰，再掌握科举、三省六部、赋税制度及工程、农具、制瓷和人物往来。","title":"鉴真东渡","content":"鉴真历经六次东渡到达日本，在日本传播佛教，并介绍中国的医药、建筑、雕塑、文学、书法和绘画等知识，对中日文化交流产生重要影响。","label":"鉴真东渡","note":"鉴真历经六次东渡到达日本，在日本传播佛教，并介绍中国的医药、建筑、雕塑、文学、书法和绘画等知识，对中日文化交流产生重要影响。","learningGoal":"说清鉴真东渡的目的、次数和文化交流意义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"sui-tang","tabId":"sui-tang-diplomacy","sourceUnitIds":["cs-1-9-p9-sui-tang-diplomacy-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sui-tang&tabId=sui-tang-diplomacy","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"fa07f693","learningSignature":"4a300c85"},{"id":"five-dynasties-yuan::five-dynasties-ten-kingdoms","scope":"humanities-history","groupId":"five-dynasties-yuan","groupTitle":"五代、辽、宋、夏、金、元","groupTakeaway":"五代至元代先看政权并立与更替，再看北宋集权、改革和宋金关系，最后掌握元朝制度及宋元农业、手工业与商业的变化。","title":"五代十国","content":"907年至960年，黄河流域依次出现后梁、后唐、后晋、后汉、后周，合称“五代”；南方各地和北方山西先后存在十个割据政权，合称“十国”。979年北宋灭北汉，五代十国时期结束。","label":"五代十国","note":"907年至960年，黄河流域依次出现后梁、后唐、后晋、后汉、后周，合称“五代”；南方各地和北方山西先后存在十个割据政权，合称“十国”。979年北宋灭北汉，五代十国时期结束。","learningGoal":"区分五代与十国的地域、政权构成和结束节点。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"five-dynasties-yuan","tabId":"five-dynasties","sourceUnitIds":["cs-1-9-p9-five-dynasties-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=five-dynasties-yuan&tabId=five-dynasties","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"69261fb5","learningSignature":"acaef823"},{"id":"five-dynasties-yuan::liao-foundation-and-fall","scope":"humanities-history","groupId":"five-dynasties-yuan","groupTitle":"五代、辽、宋、夏、金、元","groupTakeaway":"五代至元代先看政权并立与更替，再看北宋集权、改革和宋金关系，最后掌握元朝制度及宋元农业、手工业与商业的变化。","title":"辽的建立与灭亡","content":"10世纪初，耶律阿保机统一契丹各部，916年称帝建立契丹国；947年改国号为辽；1125年辽被金所灭。","label":"辽的建立与灭亡","note":"10世纪初，耶律阿保机统一契丹各部，916年称帝建立契丹国；947年改国号为辽；1125年辽被金所灭。","learningGoal":"准确说出辽政权的民族、建立者、改国号和灭亡时间。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"five-dynasties-yuan","tabId":"liao","sourceUnitIds":["cs-1-9-p9-liao-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=five-dynasties-yuan&tabId=liao","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c37fb2ea","learningSignature":"a15bd30c"},{"id":"five-dynasties-yuan::northern-song-foundation-and-fall","scope":"humanities-history","groupId":"five-dynasties-yuan","groupTitle":"五代、辽、宋、夏、金、元","groupTakeaway":"五代至元代先看政权并立与更替，再看北宋集权、改革和宋金关系，最后掌握元朝制度及宋元农业、手工业与商业的变化。","title":"北宋的建立与灭亡","content":"960年赵匡胤发动陈桥兵变，建立北宋并定都东京；1127年金军攻破东京，俘虏宋徽宗、宋钦宗，史称“靖康之耻”，北宋灭亡。","label":"北宋的建立与灭亡","note":"960年赵匡胤发动陈桥兵变，建立北宋并定都东京；1127年金军攻破东京，俘虏宋徽宗、宋钦宗，史称“靖康之耻”，北宋灭亡。","learningGoal":"说清北宋从陈桥兵变建国到靖康之耻灭亡的关键节点。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"five-dynasties-yuan","tabId":"northern-song","sourceUnitIds":["cs-1-9-p9-p10-northern-song-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=five-dynasties-yuan&tabId=northern-song","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"aa631b99","learningSignature":"9d99afb9"},{"id":"five-dynasties-yuan::northern-song-reforms","scope":"humanities-history","groupId":"five-dynasties-yuan","groupTitle":"五代、辽、宋、夏、金、元","groupTakeaway":"五代至元代先看政权并立与更替，再看北宋集权、改革和宋金关系，最后掌握元朝制度及宋元农业、手工业与商业的变化。","title":"庆历新政与王安石变法","content":"庆历新政由宋仁宗时期的范仲淹、欧阳修等推动，但实行时间较短。1069年宋神宗任用王安石变法，目标是富国强兵、改变积贫积弱，措施涉及经济、农业和军事。","label":"庆历新政与王安石变法","note":"庆历新政由宋仁宗时期的范仲淹、欧阳修等推动，但实行时间较短。1069年宋神宗任用王安石变法，目标是富国强兵、改变积贫积弱，措施涉及经济、农业和军事。","learningGoal":"区分庆历新政与王安石变法的时期、主要人物和基本目标。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"five-dynasties-yuan","tabId":"northern-song","sourceUnitIds":["cs-1-9-p9-p10-northern-song-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=five-dynasties-yuan&tabId=northern-song","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"85d71f92","learningSignature":"65adcb7d"}]