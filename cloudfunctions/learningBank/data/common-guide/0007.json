[{"id":"five-dynasties-yuan::yuan-administrative-institutions","scope":"humanities-history","groupId":"five-dynasties-yuan","groupTitle":"五代、辽、宋、夏、金、元","groupTakeaway":"五代至元代先看政权并立与更替，再看北宋集权、改革和宋金关系，最后掌握元朝制度及宋元农业、手工业与商业的变化。","title":"元朝的地方与边疆管理","content":"元朝中央设中书省总理政务，地方设行中书省；澎湖巡检司负责管辖澎湖和台湾；宣政院管理全国佛教事务和西藏地区行政事务。","label":"元朝的地方与边疆管理","note":"元朝中央设中书省总理政务，地方设行中书省；澎湖巡检司负责管辖澎湖和台湾；宣政院管理全国佛教事务和西藏地区行政事务。","learningGoal":"区分行省制度、澎湖巡检司和宣政院各自管理的区域或事务。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"five-dynasties-yuan","tabId":"yuan","sourceUnitIds":["cs-1-9-p11-yuan-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=five-dynasties-yuan&tabId=yuan","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"2e3e3571"},{"id":"five-dynasties-yuan::song-yuan-agriculture","scope":"humanities-history","groupId":"five-dynasties-yuan","groupTitle":"五代、辽、宋、夏、金、元","groupTakeaway":"五代至元代先看政权并立与更替，再看北宋集权、改革和宋金关系，最后掌握元朝制度及宋元农业、手工业与商业的变化。","title":"宋元时期的农业变化","content":"宋代太湖流域的苏州、湖州成为重要粮仓，占城稻得到推广，水稻产量地位上升；棉花种植由两广、福建逐渐扩展到长江流域。","label":"宋元时期的农业变化","note":"宋代太湖流域的苏州、湖州成为重要粮仓，占城稻得到推广，水稻产量地位上升；棉花种植由两广、福建逐渐扩展到长江流域。","learningGoal":"概括宋元时期粮食作物和棉花种植的地域变化。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"five-dynasties-yuan","tabId":"five-dynasties-yuan-economy","sourceUnitIds":["cs-1-9-p11-five-dynasties-yuan-economy-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=five-dynasties-yuan&tabId=five-dynasties-yuan-economy","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a6fc8c22"},{"id":"five-dynasties-yuan::song-yuan-handicrafts","scope":"humanities-history","groupId":"five-dynasties-yuan","groupTitle":"五代、辽、宋、夏、金、元","groupTakeaway":"五代至元代先看政权并立与更替，再看北宋集权、改革和宋金关系，最后掌握元朝制度及宋元农业、手工业与商业的变化。","title":"宋元时期的制瓷、棉纺与造船","content":"宋代形成汝、官、哥、钧、定五大名窑，定窑以白瓷著称；元代黄道婆将棉纺织技术和工具带到松江；宋代广州、泉州、明州等东南沿海地区造船业发达。","label":"宋元时期的制瓷、棉纺与造船","note":"宋代形成汝、官、哥、钧、定五大名窑，定窑以白瓷著称；元代黄道婆将棉纺织技术和工具带到松江；宋代广州、泉州、明州等东南沿海地区造船业发达。","learningGoal":"说清宋元时期制瓷、棉纺和造船业各自的代表事实。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"five-dynasties-yuan","tabId":"five-dynasties-yuan-economy","sourceUnitIds":["cs-1-9-p11-five-dynasties-yuan-economy-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=five-dynasties-yuan&tabId=five-dynasties-yuan-economy","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3e2d97c2"},{"id":"five-dynasties-yuan::song-yuan-commerce","scope":"humanities-history","groupId":"five-dynasties-yuan","groupTitle":"五代、辽、宋、夏、金、元","groupTakeaway":"五代至元代先看政权并立与更替，再看北宋集权、改革和宋金关系，最后掌握元朝制度及宋元农业、手工业与商业的变化。","title":"宋元时期的商业变化","content":"北宋出现交子，宋代城市中坊与市的界限被打破，草市更加普遍，早市和夜市发展；元代泉州成为重要的对外贸易港口。","label":"宋元时期的商业变化","note":"北宋出现交子，宋代城市中坊与市的界限被打破，草市更加普遍，早市和夜市发展；元代泉州成为重要的对外贸易港口。","learningGoal":"说明宋元时期纸币、市场空间、营业时间和对外港口的变化。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"five-dynasties-yuan","tabId":"five-dynasties-yuan-economy","sourceUnitIds":["cs-1-9-p11-five-dynasties-yuan-economy-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=five-dynasties-yuan&tabId=five-dynasties-yuan-economy","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c36d1dc2"},{"id":"ming-qing::ming-foundation-and-fall","scope":"humanities-history","groupId":"ming-qing","groupTitle":"明清","groupTakeaway":"明清知识先分政权沿革、国家治理和社会经济三层。明代关注建立、永乐时期、危机与制度，清代关注建立、统一治理与主要制度，经济部分关注作物、制瓷和生产关系。","title":"明朝的建立与灭亡","content":"1368年朱元璋建立明朝，年号洪武，定都应天府。1644年李自成率军攻入北京，崇祯帝自缢，明朝在全国的统治结束。","label":"明朝的建立与灭亡","note":"1368年朱元璋建立明朝，年号洪武，定都应天府。1644年李自成率军攻入北京，崇祯帝自缢，明朝在全国的统治结束。","learningGoal":"说清明朝建立与灭亡的时间、人物和都城。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"ming-qing","tabId":"ming","sourceUnitIds":["cs-1-9-p11-p13-ming-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ming-qing&tabId=ming","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"e07294d7"}]