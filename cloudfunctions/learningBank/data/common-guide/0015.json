[{"id":"poetry-ci-qu::li-qingzhao-identity-and-works","scope":"humanities-history","groupId":"poetry-ci-qu","groupTitle":"词曲","groupTakeaway":"词曲知识按宋词流派与作家、元曲作家与作品、明清戏曲传奇三层展开。卡片分别说明人物称谓、代表作、名句出处和作品组合，避免把整段文学史压成作品清单。","title":"李清照的称谓与代表作","content":"李清照号易安居士，是婉约派代表词人，形成具有个人风格的“易安体”。代表作有《一剪梅》《声声慢》《如梦令·昨夜雨疏风骤》等。","label":"李清照的称谓与代表作","note":"李清照号易安居士，是婉约派代表词人，形成具有个人风格的“易安体”。代表作有《一剪梅》《声声慢》《如梦令·昨夜雨疏风骤》等。","learningGoal":"说清李清照的号、词派、词体称谓和代表作。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"poetry-ci-qu","tabId":"graceful-ci-school","sourceUnitIds":["cs-10-15-p6-p7-graceful-ci-school-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=poetry-ci-qu&tabId=graceful-ci-school","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ed953eb2","learningSignature":"3a74a11"},{"id":"poetry-ci-qu::li-qingzhao-lines-and-works","scope":"humanities-history","groupId":"poetry-ci-qu","groupTitle":"词曲","groupTakeaway":"词曲知识按宋词流派与作家、元曲作家与作品、明清戏曲传奇三层展开。卡片分别说明人物称谓、代表作、名句出处和作品组合，避免把整段文学史压成作品清单。","title":"李清照名句的作品出处","content":"“知否，知否？应是绿肥红瘦”出自《如梦令·昨夜雨疏风骤》；“才下眉头，却上心头”出自《一剪梅》；“寻寻觅觅，冷冷清清”出自《声声慢》。","label":"李清照名句的作品出处","note":"“知否，知否？应是绿肥红瘦”出自《如梦令·昨夜雨疏风骤》；“才下眉头，却上心头”出自《一剪梅》；“寻寻觅觅，冷冷清清”出自《声声慢》。","learningGoal":"区分李清照三组常考名句各自的作品出处。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"poetry-ci-qu","tabId":"graceful-ci-school","sourceUnitIds":["cs-10-15-p6-p7-graceful-ci-school-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=poetry-ci-qu&tabId=graceful-ci-school","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"632897cd","learningSignature":"211ace0c"},{"id":"poetry-ci-qu::liu-yong-identity-and-works","scope":"humanities-history","groupId":"poetry-ci-qu","groupTitle":"词曲","groupTakeaway":"词曲知识按宋词流派与作家、元曲作家与作品、明清戏曲传奇三层展开。卡片分别说明人物称谓、代表作、名句出处和作品组合，避免把整段文学史压成作品清单。","title":"柳永的称谓与代表作","content":"柳永原名三变，又称柳七，是婉约派代表词人，代表作有《雨霖铃》。叶梦得以“凡有井水处，即能歌柳词”形容柳永词在当时流传广泛。","label":"柳永的称谓与代表作","note":"柳永原名三变，又称柳七，是婉约派代表词人，代表作有《雨霖铃》。叶梦得以“凡有井水处，即能歌柳词”形容柳永词在当时流传广泛。","learningGoal":"说清柳永的原名、别称、词派、代表作和传播特点。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"poetry-ci-qu","tabId":"graceful-ci-school","sourceUnitIds":["cs-10-15-p6-p7-graceful-ci-school-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=poetry-ci-qu&tabId=graceful-ci-school","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"dff08669","learningSignature":"ebed9cac"},{"id":"poetry-ci-qu::yuan-qu-four-masters-composition","scope":"humanities-history","groupId":"poetry-ci-qu","groupTitle":"词曲","groupTakeaway":"词曲知识按宋词流派与作家、元曲作家与作品、明清戏曲传奇三层展开。卡片分别说明人物称谓、代表作、名句出处和作品组合，避免把整段文学史压成作品清单。","title":"元曲四大家","content":"元曲四大家是关汉卿、白朴、马致远、郑光祖。四人各有代表杂剧：关汉卿《窦娥冤》，白朴《梧桐雨》，马致远《汉宫秋》，郑光祖《倩女离魂》。","label":"元曲四大家","note":"元曲四大家是关汉卿、白朴、马致远、郑光祖。四人各有代表杂剧：关汉卿《窦娥冤》，白朴《梧桐雨》，马致远《汉宫秋》，郑光祖《倩女离魂》。","learningGoal":"准确说出元曲四大家及各自的一部代表作。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"poetry-ci-qu","tabId":"yuan-qu-four-masters","sourceUnitIds":["cs-10-15-p7-yuan-qu-four-masters-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=poetry-ci-qu&tabId=yuan-qu-four-masters","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"5aa7943b","learningSignature":"700a644a"},{"id":"poetry-ci-qu::guan-hanqing-works","scope":"humanities-history","groupId":"poetry-ci-qu","groupTitle":"词曲","groupTakeaway":"词曲知识按宋词流派与作家、元曲作家与作品、明清戏曲传奇三层展开。卡片分别说明人物称谓、代表作、名句出处和作品组合，避免把整段文学史压成作品清单。","title":"关汉卿的代表作","content":"关汉卿是元代杂剧作家，代表作有《窦娥冤》《救风尘》《拜月亭》《单刀会》等。《窦娥冤》中的三桩誓愿是血溅白练、六月飞雪和大旱三年。","label":"关汉卿的代表作","note":"关汉卿是元代杂剧作家，代表作有《窦娥冤》《救风尘》《拜月亭》《单刀会》等。《窦娥冤》中的三桩誓愿是血溅白练、六月飞雪和大旱三年。","learningGoal":"说清关汉卿的代表作和《窦娥冤》三桩誓愿。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"poetry-ci-qu","tabId":"yuan-qu-four-masters","sourceUnitIds":["cs-10-15-p7-yuan-qu-four-masters-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=poetry-ci-qu&tabId=yuan-qu-four-masters","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"183fee65","learningSignature":"8af6b416"}]