[{"id":"poetry-ci-qu::four-dreams-composition","scope":"humanities-history","groupId":"poetry-ci-qu","groupTitle":"词曲","groupTakeaway":"词曲知识按宋词流派与作家、元曲作家与作品、明清戏曲传奇三层展开。卡片分别说明人物称谓、代表作、名句出处和作品组合，避免把整段文学史压成作品清单。","title":"临川四梦","content":"临川四梦又称玉茗堂四梦，是明代汤显祖的四部戏曲：《牡丹亭》《紫钗记》《南柯记》《邯郸记》。其中《牡丹亭》又名《还魂记》。","label":"临川四梦","note":"临川四梦又称玉茗堂四梦，是明代汤显祖的四部戏曲：《牡丹亭》《紫钗记》《南柯记》《邯郸记》。其中《牡丹亭》又名《还魂记》。","learningGoal":"准确说出临川四梦的作者、别称、四部作品及《牡丹亭》别名。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"poetry-ci-qu","tabId":"four-dreams","sourceUnitIds":["cs-10-15-p7-p8-four-dreams-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=poetry-ci-qu&tabId=four-dreams","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a8d33eca"},{"id":"poetry-ci-qu::palace-eternal-youth-basic-facts","scope":"humanities-history","groupId":"poetry-ci-qu","groupTitle":"词曲","groupTakeaway":"词曲知识按宋词流派与作家、元曲作家与作品、明清戏曲传奇三层展开。卡片分别说明人物称谓、代表作、名句出处和作品组合，避免把整段文学史压成作品清单。","title":"《长生殿》的作者与故事","content":"《长生殿》是清代戏曲作家洪昇的代表作，写唐明皇和杨贵妃的爱情故事。作品以唐代历史人物为主角，但创作时代属于清代。","label":"《长生殿》的作者与故事","note":"《长生殿》是清代戏曲作家洪昇的代表作，写唐明皇和杨贵妃的爱情故事。作品以唐代历史人物为主角，但创作时代属于清代。","learningGoal":"说清《长生殿》的作者、时代、主要人物及易混作品。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"poetry-ci-qu","tabId":"palace-eternal-youth","sourceUnitIds":["cs-10-15-p8-palace-eternal-youth-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=poetry-ci-qu&tabId=palace-eternal-youth","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"d9f4d597"},{"id":"poetry-ci-qu::peach-blossom-fan-basic-facts","scope":"humanities-history","g