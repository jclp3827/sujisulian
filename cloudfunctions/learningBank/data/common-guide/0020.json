[{"id":"classical-novels::scholars-basic-facts","scope":"humanities-history","groupId":"classical-novels","groupTitle":"小说","groupTakeaway":"古典小说知识分为单部作品和作品组合两层。单部作品说明作者、时代、体裁或主要内容，组合卡区分明代四大奇书与四大名著。","title":"《儒林外史》的作者与体裁","content":"《儒林外史》的作者是吴敬梓，是一部长篇章回体讽刺小说，也是古代讽刺文学的代表作品，《范进中举》出自这部小说。","label":"《儒林外史》的作者与体裁","note":"《儒林外史》的作者是吴敬梓，是一部长篇章回体讽刺小说，也是古代讽刺文学的代表作品，《范进中举》出自这部小说。","learningGoal":"说清《儒林外史》的作者、体裁、文学类型和选篇出处。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"classical-novels","tabId":"classical-novel-works","sourceUnitIds":["cs-10-15-p8-classical-novels-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-novels&tabId=classical-novel-works","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"9609ffbb"},{"id":"classical-novels::four-marvelous-books","scope":"humanities-history","groupId":"classical-novels","groupTitle":"小说","groupTakeaway":"古典小说知识分为单部作品和作品组合两层。单部作品说明作者、时代、体裁或主要内容，组合卡区分明代四大奇书与四大名著。","title":"明代四大奇书","content":"明代四大奇书包括《水浒传》《三国演义》《西游记》《金瓶梅》。其中《金瓶梅》是这一组合与四大名著最直接的差别。","label":"明代四大奇书","note":"明代四大奇书包括《水浒传》《三国演义》《西游记》《金瓶梅》。其中《金瓶梅》是这一组合与四大名著最直接的差别。","learningGoal":"准确说出明代四大奇书，并识别其中的《金瓶梅》。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"classical-novels","tabId":"classical-novel-groupings","sourceUnitIds":["cs-10-15-p9-classical-novel-groupings-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-novels&tabId=classical-novel-groupings","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"57ce7896"},{"id":"classical-novels::four-classic-novels","scope":"humanities-history","groupId":"classical-novels","groupTitle":"小说","groupTakeaway":"古典小说知识分为单部作品和作品组合两层。单部作品说明作者、时代、体裁或主要内容，组合卡区分明代四大奇书与四大名著。","title":"四大名著","content":"四大名著包括《水浒传》《三国演义》《西游记》《红楼梦》。前三部与明代四大奇书相同，第四部是《红楼梦》。","label":"四大名著","note":"四大名著包括《水浒传》《三国演义》《西游记》《红楼梦》。前三部与明代四大奇书相同，第四部是《红楼梦》。","learningGoal":"准确说出四大名著，并识别其中的《红楼梦》。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"classical-novels","tabId":"classical-novel-groupings","sourceUnitIds":["cs-10-15-p9-classical-novel-groupings-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-novels&tabId=classical-novel-groupings","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"564c4845"},{"id":"classical-novels::novel-groupings-difference","scope":"humanities-history","groupId":"classical-novels","groupTitle":"小说","groupTakeaway":"古典小说知识分为单部作品和作品组合两层。单部作品说明作者、时代、体裁或主要内容，组合卡区分明代四大奇书与四大名著。","title":"四大奇书与四大名著的差别","content":"明代四大奇书和四大名著都包含《水浒传》《三国演义》《西游记》；四大奇书另有《金瓶梅》，四大名著另有《红楼梦》。","label":"四大奇书与四大名著的差别","note":"明代四大奇书和四大名著都包含《水浒传》《三国演义》《西游记》；四大奇书另有《金瓶梅》，四大名著另有《红楼梦》。","learningGoal":"比较四大奇书与四大名著的三部共同作品和一部不同作品。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"classical-novels","tabId":"classical-novel-groupings","sourceUnitIds":["cs-10-15-p9-classical-novel-groupings-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-novels&tabId=classical-novel-groupings","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"64bf996b"},{"id":"classical-novels::gold-jade-marriage","scope":"humanities-history","groupId":"classical-novels","groupTitle":"小说","groupTakeaway":"古典小说知识分为单部作品和作品组合两层。单部作品说明作者、时代、体裁或主要内容，组合卡区分明代四大奇书与四大名著。","title":"《红楼梦》的金玉良缘","content":"《红楼梦》中的“金玉良缘”指贾宝玉与薛宝钗的婚姻关系，其中“玉”联系贾宝玉，“金”联系薛宝钗。","label":"《红楼梦》的金玉良缘","note":"《红楼梦》中的“金玉良缘”指贾宝玉与薛宝钗的婚姻关系，其中“玉”联系贾宝玉，“金”联系薛宝钗。","learningGoal":"说明金玉良缘所指人物及金、玉分别联系谁。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"classical-novels","tabId":"classical-novel-groupings","sourceUnitIds":["cs-10-15-p9-classical-novels-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-novels&tabId=classical-novel-groupings","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"9708058"}]