[{"id":"fiction-history-modern-literature::zuozhuan-basic-facts","scope":"humanities-history","groupId":"fiction-history-modern-literature","groupTitle":"史学著作","groupTakeaway":"史学著作知识按著作基本信息、史书组合和内部体例展开。先区分作者与史书体裁，再说明二十四史、前四史、《史记》体例和《春秋》三传。","title":"《左传》的作者与体裁","content":"《左传》又称《春秋左氏传》，传统上归于左丘明，是围绕《春秋》展开叙事的编年史著作，记事较为详备。","label":"《左传》的作者与体裁","note":"《左传》又称《春秋左氏传》，传统上归于左丘明，是围绕《春秋》展开叙事的编年史著作，记事较为详备。","learningGoal":"说清《左传》的别名、传统作者和史书体裁。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-table","cs-10-15-p9-historiography-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fiction-history-modern-literature&tabId=historiography-works","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a07cc105"},{"id":"fiction-history-modern-literature::guoyu-basic-facts","scope":"humanities-history","groupId":"fiction-history-modern-literature","groupTitle":"史学著作","groupTakeaway":"史学著作知识按著作基本信息、史书组合和内部体例展开。先区分作者与史书体裁，再说明二十四史、前四史、《史记》体例和《春秋》三传。","title":"《国语》的史书体裁","content":"《国语》按不同诸侯国分别记述史事，属于国别体史书。它以国家为叙事单位，与按年代编排的编年体不同。","label":"《国语》的史书体裁","note":"《国语》按不同诸侯国分别记述史事，属于国别体史书。它以国家为叙事单位，与按年代编排的编年体不同。","learningGoal":"说明《国语》的国别体特征及其与编年体的差别。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fiction-history-modern-literature&tabId=historiography-works","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","in