[{"id":"fiction-history-modern-literature::spring-autumn-three-commentaries","scope":"humanities-history","groupId":"fiction-history-modern-literature","groupTitle":"史学著作","groupTakeaway":"史学著作知识按著作基本信息、史书组合和内部体例展开。先区分作者与史书体裁，再说明二十四史、前四史、《史记》体例和《春秋》三传。","title":"《春秋》三传","content":"《春秋》三传是解释《春秋》的《春秋左氏传》《春秋公羊传》《春秋谷梁传》，传统作者分别为左丘明、公羊高、谷梁赤。","label":"《春秋》三传","note":"《春秋》三传是解释《春秋》的《春秋左氏传》《春秋公羊传》《春秋谷梁传》，传统作者分别为左丘明、公羊高、谷梁赤。","learningGoal":"准确说出《春秋》三传及各自的传统作者。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fiction-history-modern-literature&tabId=historiography-works","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"d7cd7db1"},{"id":"fiction-history-modern-literature::houhanshu-sanguozhi-authors","scope":"humanities-history","groupId":"fiction-history-modern-literature","groupTitle":"史学著作","groupTakeaway":"史学著作知识按著作基本信息、史书组合和内部体例展开。先区分作者与史书体裁，再说明二十四史、前四史、《史记》体例和《春秋》三传。","title":"《后汉书》与《三国志》的作者","content":"《后汉书》的作者是南朝宋范晔，《三国志》的作者是西晋陈寿。两部书都列入前四史，但作者所处朝代不同。","label":"《后汉书》与《三国志》的作者","note":"《后汉书》的作者是南朝宋范晔，《三国志》的作者是西晋陈寿。两部书都列入前四史，但作者所处朝代不同。","learningGoal":"区分《后汉书》《三国志》的作者及作者所处朝代。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fiction-history-modern-literature&tabId=historiography-works","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3e81ffc3"},{"id":"fiction-history-modern-literature::lu-xun-shiji-appraisal","scope":"humanities-history","groupId":"fiction-history-modern-literature","groupTitle":"史学著作","groupTakeaway":"史学著作知识按著作基本信息、史书组合和内部体例展开。先区分作者与史书体裁，再说明二十四史、前四史、《史记》体例和《春秋》三传。","title":"鲁迅对《史记》的评价","content":"鲁迅以“史家之绝唱，无韵之《离骚》”评价《史记》，前半句肯定其史学价值，后半句突出其文学成就。","label":"鲁迅对《史记》的评价","note":"鲁迅以“史家之绝唱，无韵之《离骚》”评价《史记》，前半句肯定其史学价值，后半句突出其文学成就。","learningGoal":"识别鲁迅评价《史记》的名句及两层含义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fiction-history-modern-literature&tabId=historiography-works","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ed579b4"},{"id":"modern-literature::lu-xun-name-and-works","scope":"humanities-history","groupId":"modern-literature","groupTitle":"中国现当代文学","groupTakeaway":"现当代文学知识按作家身份、笔名或原名、作品类型和作品组合展开。重点区分鲁迅的文集、茅盾与巴金的三部曲，以及老舍、莫言的代表作。","title":"鲁迅的本名与代表作","content":"鲁迅原名周樟寿，后改名周树人，浙江绍兴人。代表作包括《狂人日记》，以及小说集《呐喊》《彷徨》等。","label":"鲁迅的本名与代表作","note":"鲁迅原名周樟寿，后改名周树人，浙江绍兴人。代表作包括《狂人日记》，以及小说集《呐喊》《彷徨》等。","learningGoal":"说清鲁迅的原名、籍贯和主要小说作品。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"modern-literature","tabId":"modern-writers","sourceUnitIds":["cs-10-15-p10-modern-writers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=modern-literature&tabId=modern-writers","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"bf255c6"},{"id":"modern-literature::lu-xun-collection-types","scope":"humanities-history","groupId":"modern-literature","groupTitle":"中国现当代文学","groupTakeaway":"现当代文学知识按作家身份、笔名或原名、作品类型和作品组合展开。重点区分鲁迅的文集、茅盾与巴金的三部曲，以及老舍、莫言的代表作。","title":"鲁迅作品集的类型","content":"鲁迅的《呐喊》《彷徨》是小说集，《朝花夕拾》是散文集，《野草》是散文诗集，《南腔北调集》是杂文集。","label":"鲁迅作品集的类型","note":"鲁迅的《呐喊》《彷徨》是小说集，《朝花夕拾》是散文集，《野草》是散文诗集，《南腔北调集》是杂文集。","learningGoal":"区分鲁迅四组作品集的文学类型。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"modern-literature","tabId":"modern-writers","sourceUnitIds":["cs-10-15-p10-modern-writers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=modern-literature&tabId=modern-writers","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ed75e331"}]