[{"id":"modern-literature::mao-dun-name-and-works","scope":"humanities-history","groupId":"modern-literature","groupTitle":"中国现当代文学","groupTakeaway":"现当代文学知识按作家身份、笔名或原名、作品类型和作品组合展开。重点区分鲁迅的文集、茅盾与巴金的三部曲，以及老舍、莫言的代表作。","title":"茅盾的本名与代表作","content":"作家茅盾本名沈雁冰，长篇小说有《子夜》，短篇小说有《林家铺子》等。他还创作了蚀三部曲和农村三部曲。","label":"茅盾的本名与代表作","note":"作家茅盾本名沈雁冰，长篇小说有《子夜》，短篇小说有《林家铺子》等。他还创作了蚀三部曲和农村三部曲。","learningGoal":"说清茅盾的本名、代表小说和两组三部曲。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"modern-literature","tabId":"modern-writers","sourceUnitIds":["cs-10-15-p10-modern-writers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=modern-literature&tabId=modern-writers","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3dab982f"},{"id":"modern-literature::mao-dun-trilogies","scope":"humanities-history","groupId":"modern-literature","groupTitle":"中国现当代文学","groupTakeaway":"现当代文学知识按作家身份、笔名或原名、作品类型和作品组合展开。重点区分鲁迅的文集、茅盾与巴金的三部曲，以及老舍、莫言的代表作。","title":"茅盾的两组三部曲","content":"茅盾的蚀三部曲包括《幻灭》《动摇》《追求》，农村三部曲包括《春蚕》《秋收》《残冬》。两组作品名称和主题序列不同。","label":"茅盾的两组三部曲","note":"茅盾的蚀三部曲包括《幻灭》《动摇》《追求》，农村三部曲包括《春蚕》《秋收》《残冬》。两组作品名称和主题序列不同。","learningGoal":"区分茅盾的蚀三部曲和农村三部曲。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"modern-literature","tabId":"modern-writers","sourceUnitIds":["cs-10-15-p10-modern-writers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=modern-literature&tabId=modern-writers","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3b686b68"},{"id":"modern-literature::lao-she-works","scope":"humanities-history","groupId":"modern-literature","groupTitle":"中国现当代文学","groupTakeaway":"现当代文学知识按作家身份、笔名或原名、作品类型和作品组合展开。重点区分鲁迅的文集、茅盾与巴金的三部曲，以及老舍、莫言的代表作。","title":"老舍的称号与代表作","content":"老舍获有“人民艺术家”称号，代表作包括长篇小说《骆驼祥子》《四世同堂》和话剧《茶馆》。","label":"老舍的称号与代表作","note":"老舍获有“人民艺术家”称号，代表作包括长篇小说《骆驼祥子》《四世同堂》和话剧《茶馆》。","learningGoal":"说清老舍的称号及三部代表作。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"modern-literature","tabId":"modern-writers","sourceUnitIds":["cs-10-15-p10-modern-writers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=modern-literature&tabId=modern-writers","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"58764264"},{"id":"modern-literature::ba-jin-trilogies","scope":"humanities-history","groupId":"modern-literature","groupTitle":"中国现当代文学","groupTakeaway":"现当代文学知识按作家身份、笔名或原名、作品类型和作品组合展开。重点区分鲁迅的文集、茅盾与巴金的三部曲，以及老舍、莫言的代表作。","title":"巴金的两组三部曲","content":"巴金的爱情三部曲是《雾》《雨》《电》，激流三部曲是《家》《春》《秋》；此外还有散文集《随想录》。","label":"巴金的两组三部曲","note":"巴金的爱情三部曲是《雾》《雨》《电》，激流三部曲是《家》《春》《秋》；此外还有散文集《随想录》。","learningGoal":"区分巴金的爱情三部曲、激流三部曲和散文集。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"modern-literature","tabId":"modern-writers","sourceUnitIds":["cs-10-15-p10-modern-writers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=modern-literature&tabId=modern-writers","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"67283333"},{"id":"modern-literature::mo-yan-name-award-works","scope":"humanities-history","groupId":"modern-literature","groupTitle":"中国现当代文学","groupTakeaway":"现当代文学知识按作家身份、笔名或原名、作品类型和作品组合展开。重点区分鲁迅的文集、茅盾与巴金的三部曲，以及老舍、莫言的代表作。","title":"莫言的本名、奖项与代表作","content":"莫言本名管谟业，山东高密人，2012年获得诺贝尔文学奖。代表作有《红高粱家族》《丰乳肥臀》《蛙》等。","label":"莫言的本名、奖项与代表作","note":"莫言本名管谟业，山东高密人，2012年获得诺贝尔文学奖。代表作有《红高粱家族》《丰乳肥臀》《蛙》等。","learningGoal":"说清莫言的本名、籍贯、获奖时间和代表作。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"modern-literature","tabId":"modern-writers","sourceUnitIds":["cs-10-15-p10-modern-writers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=modern-literature&tabId=modern-writers","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b11d1e73"}]