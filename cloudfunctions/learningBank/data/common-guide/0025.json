[{"id":"selection-thought-ritual::hereditary-office-rule","scope":"humanities-history","groupId":"selection-thought-ritual","groupTitle":"选官制度","groupTakeaway":"中国古代选官制度按依据变化展开：先秦重血缘世袭，战国以军功授爵，汉代有察举和征辟，魏晋实行九品中正，隋唐以后以科举考试选拔人才。","title":"世卿世禄制","content":"世卿世禄制是先秦贵族按照血缘世袭政治职位、权力和经济特权的制度。贵族后代可以承继家族原有的身份与利益。","label":"世卿世禄制","note":"世卿世禄制是先秦贵族按照血缘世袭政治职位、权力和经济特权的制度。贵族后代可以承继家族原有的身份与利益。","learningGoal":"说明世卿世禄制的时代、继承依据和承继内容。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"selection-thought-ritual","tabId":"hereditary-office","sourceUnitIds":["cs-10-15-p10-hereditary-office-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=selection-thought-ritual&tabId=hereditary-office","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"385f3b3d","learningSignature":"ee96a154"},{"id":"selection-thought-ritual::military-merit-rank-rule","scope":"humanities-history","groupId":"selection-thought-ritual","groupTitle":"选官制度","groupTakeaway":"中国古代选官制度按依据变化展开：先秦重血缘世袭，战国以军功授爵，汉代有察举和征辟，魏晋实行九品中正，隋唐以后以科举考试选拔人才。","title":"军功爵制","content":"军功爵制在战国变法中以军功作为赐爵依据，削弱贵族依靠出身垄断权力的局面。它反映选拔和授爵标准由血缘向军功转变。","label":"军功爵制","note":"军功爵制在战国变法中以军功作为赐爵依据，削弱贵族依靠出身垄断权力的局面。它反映选拔和授爵标准由血缘向军功转变。","learningGoal":"说明军功爵制的时代、授爵依据和制度作用。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"selection-thought-ritual","tabId":"military-merit-rank","sourceUnitIds":["cs-10-15-p10-military-merit-rank-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=selection-thought-ritual&tabId=military-merit-rank","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"d6aad04a","learningSignature":"f7dc6996"},{"id":"selection-thought-ritual::recommendation-system","scope":"humanities-history","groupId":"selection-thought-ritual","groupTitle":"选官制度","groupTakeaway":"中国古代选官制度按依据变化展开：先秦重血缘世袭，战国以军功授爵，汉代有察举和征辟，魏晋实行九品中正，隋唐以后以科举考试选拔人才。","title":"察举制","content":"察举又称荐举，由高级官员考察平民或下级官吏的品德与才干，再把合适人选推荐给朝廷。其关键环节是官员考察和向朝廷推荐。","label":"察举制","note":"察举又称荐举，由高级官员考察平民或下级官吏的品德与才干，再把合适人选推荐给朝廷。其关键环节是官员考察和向朝廷推荐。","learningGoal":"说清察举制的推荐主体、考察对象和选拔过程。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"selection-thought-ritual","tabId":"recommendation-recruitment","sourceUnitIds":["cs-10-15-p10-recommendation-recruitment-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=selection-thought-ritual&tabId=recommendation-recruitment","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"65a1307","learningSignature":"e91be8d7"},{"id":"selection-thought-ritual::zheng-bi-difference","scope":"humanities-history","groupId":"selection-thought-ritual","groupTitle":"选官制度","groupTakeaway":"中国古代选官制度按依据变化展开：先秦重血缘世袭，战国以军功授爵，汉代有察举和征辟，魏晋实行九品中正，隋唐以后以科举考试选拔人才。","title":"征与辟的区别","content":"汉代征辟制度中，皇帝直接聘请人才做官称为“征”，官府聘请人才任职称为“辟”。两者都属于聘任，但发出聘请的主体不同。","label":"征与辟的区别","note":"汉代征辟制度中，皇帝直接聘请人才做官称为“征”，官府聘请人才任职称为“辟”。两者都属于聘任，但发出聘请的主体不同。","learningGoal":"区分征与辟的聘任主体。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"selection-thought-ritual","tabId":"recommendation-recruitment","sourceUnitIds":["cs-10-15-p10-recommendation-recruitment-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=selection-thought-ritual&tabId=recommendation-recruitment","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a5cd3923","learningSignature":"b07ff1f8"},{"id":"selection-thought-ritual::nine-rank-operation","scope":"humanities-history","groupId":"selection-thought-ritual","groupTitle":"选官制度","groupTakeaway":"中国古代选官制度按依据变化展开：先秦重血缘世袭，战国以军功授爵，汉代有察举和征辟，魏晋实行九品中正，隋唐以后以科举考试选拔人才。","title":"九品中正制的选拔方式","content":"九品中正制用于魏晋时期选拔官员，由中正官考察人才的出身、品德等条件，将其评定为九个品级，再据此录用。","label":"九品中正制的选拔方式","note":"九品中正制用于魏晋时期选拔官员，由中正官考察人才的出身、品德等条件，将其评定为九个品级，再据此录用。","learningGoal":"说明九品中正制的时代、评定者、考察因素和品级结构。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"selection-thought-ritual","tabId":"nine-rank-system","sourceUnitIds":["cs-10-15-p11-nine-rank-system-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=selection-thought-ritual&tabId=nine-rank-system","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"6d700e92","learningSignature":"472256b2"}]