[{"id":"selection-thought-ritual::nine-rank-later-stratification","scope":"humanities-history","groupId":"selection-thought-ritual","groupTitle":"选官制度","groupTakeaway":"中国古代选官制度按依据变化展开：先秦重血缘世袭，战国以军功授爵，汉代有察举和征辟，魏晋实行九品中正，隋唐以后以科举考试选拔人才。","title":"九品中正制的后期门第化","content":"九品中正制后期越来越受家世门第影响，形成“上品无寒门、下品无士族”的现象。高门士族更容易获得较高品级，寒门上升受到限制。","label":"九品中正制的后期门第化","note":"九品中正制后期越来越受家世门第影响，形成“上品无寒门、下品无士族”的现象。高门士族更容易获得较高品级，寒门上升受到限制。","learningGoal":"说明九品中正制后期门第化的表现。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"selection-thought-ritual","tabId":"nine-rank-system","sourceUnitIds":["cs-10-15-p11-nine-rank-system-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=selection-thought-ritual&tabId=nine-rank-system","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"132115e","learningSignature":"3c9dde77"},{"id":"selection-thought-ritual::imperial-exam-levels","scope":"humanities-history","groupId":"selection-thought-ritual","groupTitle":"选官制度","groupTakeaway":"中国古代选官制度按依据变化展开：先秦重血缘世袭，战国以军功授爵，汉代有察举和征辟，魏晋实行九品中正，隋唐以后以科举考试选拔人才。","title":"科举相关考试的四个层级","content":"传统科举相关考试由低到高可按院试、乡试、会试、殿试区分。通过院试取得生员或秀才身份，乡试录取举人，会试录取贡士，殿试录取进士。","label":"科举相关考试的四个层级","note":"传统科举相关考试由低到高可按院试、乡试、会试、殿试区分。通过院试取得生员或秀才身份，乡试录取举人，会试录取贡士，殿试录取进士。","learningGoal":"区分院试、乡试、会试、殿试及各自录取身份。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"selection-thought-ritual","tabId":"imperial-examination","sourceUnitIds":["cs-10-15-p11-imperial-examination-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=selection-thought-ritual&tabId=imperial-examination","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"8c91dd65","learningSignature":"8422ef81"},{"id":"selection-thought-ritual::imperial-exam-first-places","scope":"humanities-history","groupId":"selection-thought-ritual","groupTitle":"选官制度","groupTakeaway":"中国古代选官制度按依据变化展开：先秦重血缘世袭，战国以军功授爵，汉代有察举和征辟，魏晋实行九品中正，隋唐以后以科举考试选拔人才。","title":"科举各级考试的第一名","content":"院试第一名称案首，乡试第一名称解元，会试第一名称会元，殿试第一名称状元。解元、会元、状元连续取得，称为“连中三元”。","label":"科举各级考试的第一名","note":"院试第一名称案首，乡试第一名称解元，会试第一名称会元，殿试第一名称状元。解元、会元、状元连续取得，称为“连中三元”。","learningGoal":"准确说出四级考试第一名的称谓和连中三元的含义。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"selection-thought-ritual","tabId":"imperial-examination","sourceUnitIds":["cs-10-15-p11-imperial-examination-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=selection-thought-ritual&tabId=imperial-examination","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c4d71f06","learningSignature":"ec914a6f"},{"id":"selection-thought-ritual::jinshi-three-ranks","scope":"humanities-history","groupId":"selection-thought-ritual","groupTitle":"选官制度","groupTakeaway":"中国古代选官制度按依据变化展开：先秦重血缘世袭，战国以军功授爵，汉代有察举和征辟，魏晋实行九品中正，隋唐以后以科举考试选拔人才。","title":"进士三甲","content":"殿试录取的进士分为三甲：一甲三人是状元、榜眼、探花，赐进士及第；二甲赐进士出身；三甲赐同进士出身。","label":"进士三甲","note":"殿试录取的进士分为三甲：一甲三人是状元、榜眼、探花，赐进士及第；二甲赐进士出身；三甲赐同进士出身。","learningGoal":"区分进士三甲的人员范围和授予称谓。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"selection-thought-ritual","tabId":"imperial-examination","sourceUnitIds":["cs-10-15-p11-imperial-examination-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=selection-thought-ritual&tabId=imperial-examination","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"525f4453","learningSignature":"390bc987"},{"id":"traditional-thought-ritual::confucius-identity-teachings","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"孔子的身份与主要思想","content":"孔子名丘，字仲尼，是春秋时期鲁国人和儒家学派创始人，后世尊称“至圣”。他提倡仁者爱人、以德治民和克己复礼。","label":"孔子的身份与主要思想","note":"孔子名丘，字仲尼，是春秋时期鲁国人和儒家学派创始人，后世尊称“至圣”。他提倡仁者爱人、以德治民和克己复礼。","learningGoal":"说清孔子的时代、身份、称谓和主要思想。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"confucian-thought","sourceUnitIds":["cs-10-15-p11-p12-confucian-thought-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=confucian-thought","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"fe7407f5","learningSignature":"68512c52"}]