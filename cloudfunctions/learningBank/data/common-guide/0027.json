[{"id":"traditional-thought-ritual::confucius-education","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"孔子的教育主张","content":"孔子兴办私学，主张“有教无类”，强调教育对象不应受出身和类别限制。这一主张体现其扩大教育范围的思想。","label":"孔子的教育主张","note":"孔子兴办私学，主张“有教无类”，强调教育对象不应受出身和类别限制。这一主张体现其扩大教育范围的思想。","learningGoal":"说明孔子有教无类主张的基本含义。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"confucian-thought","sourceUnitIds":["cs-10-15-p11-p12-confucian-thought-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=confucian-thought","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"549380d1"},{"id":"traditional-thought-ritual::mencius-thought","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"孟子的身份与主要思想","content":"孟子名轲，是战国时期儒家代表人物，后世称“亚圣”，著有《孟子》。他主张仁政、民贵君轻和性本善。","label":"孟子的身份与主要思想","note":"孟子名轲，是战国时期儒家代表人物，后世称“亚圣”，著有《孟子》。他主张仁政、民贵君轻和性本善。","learningGoal":"说清孟子的时代、称谓、著作和主要主张。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"confucian-thought","sourceUnitIds":["cs-10-15-p11-p12-confucian-thought-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=confucian-thought","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"d08dea15"},{"id":"traditional-thought-ritual::xunzi-thought","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"荀子的身份与主要思想","content":"荀子名况，字卿，是战国末期儒家代表人物。他提出性恶论，强调礼义法度和后天教化，并主张“制天命而用之”。","label":"荀子的身份与主要思想","note":"荀子名况，字卿，是战国末期儒家代表人物。他提出性恶论，强调礼义法度和后天教化，并主张“制天命而用之”。","learningGoal":"说清荀子的时代、身份和主要思想。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"confucian-thought","sourceUnitIds":["cs-10-15-p11-p12-confucian-thought-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=confucian-thought","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"5c336ede"},{"id":"traditional-thought-ritual::xunzi-transform-nature","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"荀子的化性起伪","content":"“化性起伪”强调通过后天教化改造人的自然本性，用礼义和社会规范培育道德观念。这里的“伪”指人为努力和后天作为。","label":"荀子的化性起伪","note":"“化性起伪”强调通过后天教化改造人的自然本性，用礼义和社会规范培育道德观念。这里的“伪”指人为努力和后天作为。","learningGoal":"说明化性起伪所指的改造方式和伪的含义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"confucian-thought","sourceUnitIds":["cs-10-15-p11-p12-confucian-thought-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=confucian-thought","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"65b2d31e"},{"id":"traditional-thought-ritual::dong-zhongshu-new-confucianism","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"董仲舒的新儒学主张","content":"董仲舒提出“罢黜百家，独尊儒术”，并发展天人合一、天人感应等学说。他把政治秩序与儒家伦理联系起来。","label":"董仲舒的新儒学主张","note":"董仲舒提出“罢黜百家，独尊儒术”，并发展天人合一、天人感应等学说。他把政治秩序与儒家伦理联系起来。","learningGoal":"识别董仲舒新儒学的主要主张。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"confucian-thought","sourceUnitIds":["cs-10-15-p11-p12-confucian-thought-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=confucian-thought","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"55a9dc7e"}]