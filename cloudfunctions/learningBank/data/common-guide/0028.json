[{"id":"traditional-thought-ritual::three-bonds-five-constants","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"三纲五常","content":"三纲指君为臣纲、父为子纲、夫为妻纲；五常指仁、义、礼、智、信。三纲说明传统伦理关系，五常概括五项道德规范。","label":"三纲五常","note":"三纲指君为臣纲、父为子纲、夫为妻纲；五常指仁、义、礼、智、信。三纲说明传统伦理关系，五常概括五项道德规范。","learningGoal":"准确说出三纲和五常的具体内容。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"confucian-thought","sourceUnitIds":["cs-10-15-p11-p12-confucian-thought-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=confucian-thought","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"15e21d70","learningSignature":"4953c07a"},{"id":"traditional-thought-ritual::laozi-thought-work","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"老子的著作与主要思想","content":"老子姓李名耳，字聃，是道家学派创始人，著有《道德经》，又称《老子》。其思想包括无为而治，并关注事物向相反方向转化。","label":"老子的著作与主要思想","note":"老子姓李名耳，字聃，是道家学派创始人，著有《道德经》，又称《老子》。其思想包括无为而治，并关注事物向相反方向转化。","learningGoal":"说清老子的姓名、学派、著作和主要思想。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=hundred-schools","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"e631f7e5","learningSignature":"8a8e44"},{"id":"traditional-thought-ritual::zhuangzi-work","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"庄子的身份与著作","content":"庄子名周，是战国中期道家代表人物，代表作《庄子》又称《南华经》。庄周梦蝶、濠梁之辩等典故与他有关。","label":"庄子的身份与著作","note":"庄子名周，是战国中期道家代表人物，代表作《庄子》又称《南华经》。庄周梦蝶、濠梁之辩等典故与他有关。","learningGoal":"说清庄子的时代、学派、著作别名和相关典故。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=hundred-schools","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"7fe444d0","learningSignature":"933ab2bc"},{"id":"traditional-thought-ritual::legalist-core-representatives","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"法家的核心思想与代表人物","content":"法家以法治为核心思想，代表人物包括商鞅、韩非和李斯。其政治主张强调用明确制度和权力手段治理国家。","label":"法家的核心思想与代表人物","note":"法家以法治为核心思想，代表人物包括商鞅、韩非和李斯。其政治主张强调用明确制度和权力手段治理国家。","learningGoal":"识别法家的核心思想和主要代表人物。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=hundred-schools","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a87bf95e","learningSignature":"d4d40020"},{"id":"traditional-thought-ritual::mohist-propositions","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"墨家的主要主张","content":"墨子是墨家创始人，提出兼爱、非攻、尚贤、尚同、天志、明鬼、非命、非乐、节葬、节用等主张。兼爱和非攻是其中常见的核心概括。","label":"墨家的主要主张","note":"墨子是墨家创始人，提出兼爱、非攻、尚贤、尚同、天志、明鬼、非命、非乐、节葬、节用等主张。兼爱和非攻是其中常见的核心概括。","learningGoal":"准确说出墨家的创始人和主要主张。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=hundred-schools","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ba424fa6","learningSignature":"db1e8672"}]