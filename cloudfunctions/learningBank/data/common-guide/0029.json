[{"id":"traditional-thought-ritual::sunzi-authorship-names","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"《孙子兵法》的作者与别名","content":"《孙子兵法》由孙武所著，又称《孙武兵法》《吴孙子兵法》《孙子兵书》等。孙武因此被后世尊称为“兵圣”。","label":"《孙子兵法》的作者与别名","note":"《孙子兵法》由孙武所著，又称《孙武兵法》《吴孙子兵法》《孙子兵书》等。孙武因此被后世尊称为“兵圣”。","learningGoal":"说清《孙子兵法》的作者、常见别名和作者称谓。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=hundred-schools","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ebab813f"},{"id":"traditional-thought-ritual::school-names-representatives","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"名家的代表人物与命题","content":"名家的代表人物有惠施和公孙龙。公孙龙提出“白马非马”“离坚白”等命题，讨论概念、名称与事物之间的关系。","label":"名家的代表人物与命题","note":"名家的代表人物有惠施和公孙龙。公孙龙提出“白马非马”“离坚白”等命题，讨论概念、名称与事物之间的关系。","learningGoal":"识别名家的代表人物和公孙龙的主要命题。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=hundred-schools","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"6df01d26"},{"id":"traditional-thought-ritual::school-names-thesis","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"名家的名实关系","content":"名家以“名”和“实”的关系为核心问题：“名”指概念和名称，“实”指实际事物。名家重视概念是否准确以及名称能否符合对象。","label":"名家的名实关系","note":"名家以“名”和“实”的关系为核心问题：“名”指概念和名称，“实”指实际事物。名家重视概念是否准确以及名称能否符合对象。","learningGoal":"说明名家所讨论的名与实分别指什么。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=hundred-schools","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"1cd2e70b"},{"id":"traditional-thought-ritual::strategists-alliance","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"纵横家的合纵与连横","content":"纵横家以游说诸侯、从事政治外交活动为特点。苏秦是合纵派代表，主张联合多国；张仪是连横派代表，推动各国分别与秦合作。","label":"纵横家的合纵与连横","note":"纵横家以游说诸侯、从事政治外交活动为特点。苏秦是合纵派代表，主张联合多国；张仪是连横派代表，推动各国分别与秦合作。","learningGoal":"区分纵横家的活动特点及苏秦、张仪所属派别。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=hundred-schools","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"78068bcd"},{"id":"traditional-thought-ritual::bamboo-seven-sages","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"竹林七贤","content":"竹林七贤指魏晋时期的嵇康、阮籍、山涛、向秀、刘伶、王戎和阮咸。七人因交游与思想风貌被并称。","label":"竹林七贤","note":"竹林七贤指魏晋时期的嵇康、阮籍、山涛、向秀、刘伶、王戎和阮咸。七人因交游与思想风貌被并称。","learningGoal":"准确说出竹林七贤的七位人物。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"metaphysics-three-teachings","sourceUnitIds":["cs-10-15-p13-metaphysics-three-teachings-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=metaphysics-three-teachings","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"2d9ccaf1"}]