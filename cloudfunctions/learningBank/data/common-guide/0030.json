[{"id":"traditional-thought-ritual::er-cheng-neo-confucianism","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"二程与宋代理学","content":"二程指北宋程颢、程颐兄弟，是程朱理学的重要奠基者。他们提出天理概念，并重视通过格物致知认识事物和道理。","label":"二程与宋代理学","note":"二程指北宋程颢、程颐兄弟，是程朱理学的重要奠基者。他们提出天理概念，并重视通过格物致知认识事物和道理。","learningGoal":"说清二程所指人物及其在宋代理学中的地位和主张。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"song-ming-neo-confucianism","sourceUnitIds":["cs-10-15-p13-song-ming-neo-confucianism-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=song-ming-neo-confucianism","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"5ada7c54"},{"id":"traditional-thought-ritual::zhu-xi-neo-confucianism","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"朱熹与程朱理学","content":"南宋朱熹是程朱理学的集大成者，著有《四书章句集注》。这部著作系统解释《大学》《中庸》《论语》《孟子》。","label":"朱熹与程朱理学","note":"南宋朱熹是程朱理学的集大成者，著有《四书章句集注》。这部著作系统解释《大学》《中庸》《论语》《孟子》。","learningGoal":"说明朱熹的时代、理学地位和代表著作。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"song-ming-neo-confucianism","sourceUnitIds":["cs-10-15-p13-song-ming-neo-confucianism-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=song-ming-neo-confucianism","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"44adbdd0"},{"id":"traditional-thought-ritual::wang-yangming-thought","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"王守仁的心学主张","content":"明代王守仁又称王阳明，是心学的集大成者，提出“知行合一”和“致良知”。其思想强调道德认识与实践不能分离。","label":"王守仁的心学主张","note":"明代王守仁又称王阳明，是心学的集大成者，提出“知行合一”和“致良知”。其思想强调道德认识与实践不能分离。","learningGoal":"说清王守仁的时代、思想流派和主要主张。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"song-ming-neo-confucianism","sourceUnitIds":["cs-10-15-p13-song-ming-neo-confucianism-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=song-ming-neo-confucianism","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a983438a"},{"id":"traditional-thought-ritual::late-ming-three-thinkers","scope":"humanities-history","groupId":"traditional-thought-ritual","groupTitle":"中国古代思想","groupTakeaway":"中国古代思想先看先秦诸子学派，再看魏晋至明清的发展。人物卡以身份、代表著作和核心主张为主，学派卡用于区分儒、道、法、墨、名、兵、纵横等思想方向。","title":"明末清初三大思想家","content":"明末清初三大思想家通常指王夫之、黄宗羲和顾炎武。王夫之强调气与器，黄宗羲批判“一家之法”，顾炎武倡导经世致用。","label":"明末清初三大思想家","note":"明末清初三大思想家通常指王夫之、黄宗羲和顾炎武。王夫之强调气与器，黄宗羲批判“一家之法”，顾炎武倡导经世致用。","learningGoal":"区分明末清初三大思想家及各自的主要观点。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"traditional-thought-ritual","tabId":"late-ming-early-qing-thought","sourceUnitIds":["cs-10-15-p13-late-ming-early-qing-thought-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-thought-ritual&tabId=late-ming-early-qing-thought","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"63120f7"},{"id":"ritual-system::five-rites-classification","scope":"humanities-history","groupId":"ritual-system","groupTitle":"礼仪制度","groupTakeaway":"古代礼仪先用吉、嘉、宾、军、凶五礼建立分类，再展开祭祀、婚礼和丧礼。判断时重点看礼仪用途、六礼顺序、祭品组合和不同身份的死亡称谓。","title":"古代五礼","content":"古代五礼包括吉礼、嘉礼、宾礼、军礼和凶礼。祭祀属吉礼，冠婚属嘉礼，接待宾客属宾礼，军旅属军礼，丧葬属凶礼。","label":"古代五礼","note":"古代五礼包括吉礼、嘉礼、宾礼、军礼和凶礼。祭祀属吉礼，冠婚属嘉礼，接待宾客属宾礼，军旅属军礼，丧葬属凶礼。","learningGoal":"准确说出五礼并区分各自对应的事务。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"ritual-system","tabId":"five-rites","sourceUnitIds":["cs-10-15-p13-five-rites-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ritual-system&tabId=five-rites","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c9f773e1"}]