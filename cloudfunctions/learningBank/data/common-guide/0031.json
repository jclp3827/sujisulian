[{"id":"ritual-system::auspicious-rite-scope","scope":"humanities-history","groupId":"ritual-system","groupTitle":"礼仪制度","groupTakeaway":"古代礼仪先用吉、嘉、宾、军、凶五礼建立分类，再展开祭祀、婚礼和丧礼。判断时重点看礼仪用途、六礼顺序、祭品组合和不同身份的死亡称谓。","title":"吉礼的祭祀对象","content":"吉礼主要用于祭祀天神、地祇和人鬼。天神指天上的神明，地祇指地上神灵，人鬼指祖先等受到祭祀的人。","label":"吉礼的祭祀对象","note":"吉礼主要用于祭祀天神、地祇和人鬼。天神指天上的神明，地祇指地上神灵，人鬼指祖先等受到祭祀的人。","learningGoal":"说明吉礼的用途和三类主要祭祀对象。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ritual-system","tabId":"auspicious-rite","sourceUnitIds":["cs-10-15-p13-auspicious-rite-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ritual-system&tabId=auspicious-rite","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"6dda7dbc"},{"id":"ritual-system::festive-rite-scope","scope":"humanities-history","groupId":"ritual-system","groupTitle":"礼仪制度","groupTakeaway":"古代礼仪先用吉、嘉、宾、军、凶五礼建立分类，再展开祭祀、婚礼和丧礼。判断时重点看礼仪用途、六礼顺序、祭品组合和不同身份的死亡称谓。","title":"嘉礼的用途与范围","content":"嘉礼用于和合人际关系、沟通和联络感情，冠礼、笄礼、婚礼等都属于嘉礼。它关注人生礼仪和社会成员之间的关系。","label":"嘉礼的用途与范围","note":"嘉礼用于和合人际关系、沟通和联络感情，冠礼、笄礼、婚礼等都属于嘉礼。它关注人生礼仪和社会成员之间的关系。","learningGoal":"说明嘉礼的主要用途和常见礼仪类型。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ritual-system","tabId":"festive-rite","sourceUnitIds":["cs-10-15-p13-festive-rite-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ritual-system&tabId=festive-rite","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b18259b2"},{"id":"ritual-system::six-marriage-rites","scope":"humanities-history","groupId":"ritual-system","groupTitle":"礼仪制度","groupTakeaway":"古代礼仪先用吉、嘉、宾、军、凶五礼建立分类，再展开祭祀、婚礼和丧礼。判断时重点看礼仪用途、六礼顺序、祭品组合和不同身份的死亡称谓。","title":"婚礼六礼","content":"婚礼六礼依次是纳采、问名、纳吉、纳征、请期、亲迎。分别对应提亲、询问姓名生辰、占卜吉凶、送聘礼、确定婚期和迎娶。","label":"婚礼六礼","note":"婚礼六礼依次是纳采、问名、纳吉、纳征、请期、亲迎。分别对应提亲、询问姓名生辰、占卜吉凶、送聘礼、确定婚期和迎娶。","learningGoal":"准确说出婚礼六礼的顺序和各环节含义。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"ritual-system","tabId":"six-marriage-rites","sourceUnitIds":["cs-10-15-p13-six-marriage-rites-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ritual-system&tabId=six-marriage-rites","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"e25b45fa"},{"id":"ritual-system::tailao-shaolao-animals","scope":"humanities-history","groupId":"ritual-system","groupTitle":"礼仪制度","groupTakeaway":"古代礼仪先用吉、嘉、宾、军、凶五礼建立分类，再展开祭祀、婚礼和丧礼。判断时重点看礼仪用途、六礼顺序、祭品组合和不同身份的死亡称谓。","title":"太牢与少牢的祭品组合","content":"太牢和少牢按祭祀所用牲畜组合区分：牛、羊、豕三牲齐备称太牢，只用羊、豕称少牢。二者差别在于是否包括牛。","label":"太牢与少牢的祭品组合","note":"太牢和少牢按祭祀所用牲畜组合区分：牛、羊、豕三牲齐备称太牢，只用羊、豕称少牢。二者差别在于是否包括牛。","learningGoal":"区分太牢和少牢的牲畜组合。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"ritual-system","tabId":"grand-lesser-sacrifice","sourceUnitIds":["cs-10-15-p13-grand-lesser-sacrifice-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ritual-system&tabId=grand-lesser-sacrifice","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ca33507f"},{"id":"ritual-system::funeral-rank-terms","scope":"humanities-history","groupId":"ritual-system","groupTitle":"礼仪制度","groupTakeaway":"古代礼仪先用吉、嘉、宾、军、凶五礼建立分类，再展开祭祀、婚礼和丧礼。判断时重点看礼仪用途、六礼顺序、祭品组合和不同身份的死亡称谓。","title":"古代丧礼中的死亡称谓","content":"古代丧礼称谓随身份不同而变化：天子死称崩，诸侯称薨，大夫称卒，士称不禄，庶人称死。","label":"古代丧礼中的死亡称谓","note":"古代丧礼称谓随身份不同而变化：天子死称崩，诸侯称薨，大夫称卒，士称不禄，庶人称死。","learningGoal":"区分天子、诸侯、大夫、士和庶人的死亡称谓。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"ritual-system","tabId":"funeral-rite","sourceUnitIds":["cs-10-15-p13-funeral-rite-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ritual-system&tabId=funeral-rite","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"411655cc"}]