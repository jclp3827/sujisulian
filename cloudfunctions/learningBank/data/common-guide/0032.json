[{"id":"ancient-science-medicine::four-inventions-list","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"四大发明的组成","content":"中国古代四大发明是造纸术、活字印刷术、指南针和火药。四项技术分别服务于书写传播、文字复制、方向辨认和燃烧爆炸应用。","label":"四大发明的组成","note":"中国古代四大发明是造纸术、活字印刷术、指南针和火药。四项技术分别服务于书写传播、文字复制、方向辨认和燃烧爆炸应用。","learningGoal":"准确说出四大发明并说明各自的基本用途。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"four-inventions","sourceUnitIds":["cs-10-15-p13-p14-four-inventions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=four-inventions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a46ba40"},{"id":"ancient-science-medicine::paper-before-cai-lun","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"蔡伦以前已经出现纸","content":"西汉已经出现絮纸和麻纤维纸，说明纸并非蔡伦首次创造。东汉蔡伦在已有基础上改进造纸术，推动植物纤维纸的制作。","label":"蔡伦以前已经出现纸","note":"西汉已经出现絮纸和麻纤维纸，说明纸并非蔡伦首次创造。东汉蔡伦在已有基础上改进造纸术，推动植物纤维纸的制作。","learningGoal":"区分纸的早期出现与蔡伦改进造纸术。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"four-inventions","sourceUnitIds":["cs-10-15-p13-p14-four-inventions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=four-inventions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"d9ad007e"},{"id":"ancient-science-medicine::cai-lun-paper-improvement","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"蔡伦改进造纸术","content":"东汉宦官蔡伦于105年改进造纸术，采用植物纤维制造纸张，后世称这种纸为蔡侯纸。这里应区分技术改进者与纸的最初出现。","label":"蔡伦改进造纸术","note":"东汉宦官蔡伦于105年改进造纸术，采用植物纤维制造纸张，后世称这种纸为蔡侯纸。这里应区分技术改进者与纸的最初出现。","learningGoal":"说明蔡伦改进造纸术的时代、时间和成果。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"four-inventions","sourceUnitIds":["cs-10-15-p13-p14-four-inventions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=four-inventions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"7565c655"},{"id":"ancient-science-medicine::diamond-sutra-print","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"唐代《金刚经》雕版印刷","content":"我国在868年印制《金刚经》，使用的是雕版印刷。它属于唐代印刷实物，判断时应与北宋毕昇的活字印刷术区分。","label":"唐代《金刚经》雕版印刷","note":"我国在868年印制《金刚经》，使用的是雕版印刷。它属于唐代印刷实物，判断时应与北宋毕昇的活字印刷术区分。","learningGoal":"说明《金刚经》印制的时代、年份和印刷方式。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"four-inventions","sourceUnitIds":["cs-10-15-p13-p14-four-inventions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=four-inventions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"2ea90d51"},{"id":"ancient-science-medicine::bi-sheng-movable-type","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"毕昇与活字印刷术","content":"11世纪中叶，北宋毕昇发明活字印刷术。活字可以分别制作、排版并重复使用，与整块刻制版面的雕版印刷不同。","label":"毕昇与活字印刷术","note":"11世纪中叶，北宋毕昇发明活字印刷术。活字可以分别制作、排版并重复使用，与整块刻制版面的雕版印刷不同。","learningGoal":"说清毕昇的时代、技术成果及其与雕版印刷的区别。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"four-inventions","sourceUnitIds":["cs-10-15-p13-p14-four-inventions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=four-inventions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"e539de52"}]