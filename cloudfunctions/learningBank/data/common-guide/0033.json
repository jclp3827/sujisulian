[{"id":"ancient-science-medicine::compass-development","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"司南到航海指南针","content":"战国时期人们发现磁石的指南特性并制成司南；北宋已使用磁针指南，后来把磁针装入罗盘，指南针开始用于航海。","label":"司南到航海指南针","note":"战国时期人们发现磁石的指南特性并制成司南；北宋已使用磁针指南，后来把磁针装入罗盘，指南针开始用于航海。","learningGoal":"概括指南技术从司南到航海指南针的发展。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"four-inventions","sourceUnitIds":["cs-10-15-p13-p14-four-inventions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=four-inventions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a4df3efd","learningSignature":"9142798f"},{"id":"ancient-science-medicine::gunpowder-military-use","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"火药与突火枪","content":"唐末火药开始用于军事，南宋出现突火枪。火药是燃烧爆炸材料，突火枪则是利用火药喷射作用的早期火器。","label":"火药与突火枪","note":"唐末火药开始用于军事，南宋出现突火枪。火药是燃烧爆炸材料，突火枪则是利用火药喷射作用的早期火器。","learningGoal":"说明火药军用和突火枪出现的时代。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"four-inventions","sourceUnitIds":["cs-10-15-p13-p14-four-inventions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=four-inventions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"28345d4b","learningSignature":"6cfdf462"},{"id":"ancient-science-medicine::zhoubi-gougu","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"《周髀算经》与勾股关系","content":"《周髀算经》记载商高提出的“勾三、股四、弦五”。这组数说明直角三角形两直角边和斜边之间的勾股关系。","label":"《周髀算经》与勾股关系","note":"《周髀算经》记载商高提出的“勾三、股四、弦五”。这组数说明直角三角形两直角边和斜边之间的勾股关系。","learningGoal":"说明《周髀算经》记载的勾股数值关系。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"ancient-mathematics","sourceUnitIds":["cs-10-15-p14-mathematics-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=ancient-mathematics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"5db61547","learningSignature":"8ecda622"},{"id":"ancient-science-medicine::zu-chongzhi-pi","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"祖冲之计算圆周率","content":"南朝数学家祖冲之把圆周率精确计算到小数点后第七位。这项成果属于古代数学成就，应与历法、天文仪器等成果区分。","label":"祖冲之计算圆周率","note":"南朝数学家祖冲之把圆周率精确计算到小数点后第七位。这项成果属于古代数学成就，应与历法、天文仪器等成果区分。","learningGoal":"说清祖冲之的时代和圆周率计算成果。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"ancient-mathematics","sourceUnitIds":["cs-10-15-p14-mathematics-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=ancient-mathematics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"f8e6dbe7","learningSignature":"d0c0462d"},