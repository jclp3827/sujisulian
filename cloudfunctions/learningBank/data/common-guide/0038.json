ci-xiyuan","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"宋慈与《洗冤集录》","content":"南宋宋慈撰写《洗冤集录》，内容与检验、死因判断和案件查验有关，是中国古代法医学的重要著作。","label":"宋慈与《洗冤集录》","note":"南宋宋慈撰写《洗冤集录》，内容与检验、死因判断和案件查验有关，是中国古代法医学的重要著作。","learningGoal":"说明宋慈的时代、《洗冤集录》的学科领域和用途。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"traditional-medicine","sourceUnitIds":["cs-10-15-p16-traditional-medicine-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=traditional-medicine","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"7ea02dbe"}]