[{"id":"ancient-science-medicine::hua-tuo-achievements","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"华佗的医学成就","content":"东汉末华佗擅长外科，使用麻沸散，并创编五禽戏。五禽戏模仿虎、鹿、熊、猿、鸟五种动物的动作。","label":"华佗的医学成就","note":"东汉末华佗擅长外科，使用麻沸散，并创编五禽戏。五禽戏模仿虎、鹿、熊、猿、鸟五种动物的动作。","learningGoal":"说明华佗的时代、外科相关成果和五禽戏组成。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"traditional-medicine","sourceUnitIds":["cs-10-15-p16-traditional-medicine-table","cs-10-15-p16-traditional-medicine-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=traditional-medicine","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c6c51639"},{"id":"ancient-science-medicine::zhang-zhongjing-work","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"张仲景与《伤寒杂病论》","content":"东汉末张仲景撰写《伤寒杂病论》，后世整理为《伤寒论》和《金匮要略》两部分。张仲景被后世尊称为医圣。","label":"张仲景与《伤寒杂病论》","note":"东汉末张仲景撰写《伤寒杂病论》，后世整理为《伤寒论》和《金匮要略》两部分。张仲景被后世尊称为医圣。","learningGoal":"说清张仲景的时代、著作及后世称谓。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"traditional-medicine","sourceUnitIds":["cs-10-15-p16-traditional-medicine-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=traditional-medicine","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"sign