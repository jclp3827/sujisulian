[{"id":"ancient-science-medicine::li-shizhen-bencao","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"李时珍与《本草纲目》","content":"明代李时珍撰写《本草纲目》，系统整理药物知识，是中国传统药物学的重要著作。李时珍被后世称为药圣。","label":"李时珍与《本草纲目》","note":"明代李时珍撰写《本草纲目》，系统整理药物知识，是中国传统药物学的重要著作。李时珍被后世称为药圣。","learningGoal":"说清李时珍的时代、称谓和代表著作。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"traditional-medicine","sourceUnitIds":["cs-10-15-p16-traditional-medicine-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=traditional-medicine","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"7a2444ac"},{"id":"ancient-science-medicine::four-medical-classics","scope":"humanities-history","groupId":"ancient-science-medicine","groupTitle":"中国古代科技","groupTakeaway":"中国古代科技包括技术发明、数学、天文历法、地理、农业手工业和传统医学。各知识卡分别说明人物、时代、著作、技术用途或分类边界。","title":"四部传统医学典籍","content":"正文列出的四部传统医学典籍是《黄帝内经》《难经》《神农本草经》和《伤寒杂病论》，分别涉及医学理论、诊法、药物和临床辨治。","label":"四部传统医学典籍","note":"正文列出的四部传统医学典籍是《黄帝内经》《难经》《神农本草经》和《伤寒杂病论》，分别涉及医学理论、诊法、药物和临床辨治。","learningGoal":"准确说出正文列举的四部传统医学典籍。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"ancient-science-medicine","tabId":"traditional-medicine","sourceUnitIds":["cs-10-15-p16-traditional-medicine-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=ancient-science-medicine&tabId=traditional-medicine","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"6d133b4a"},{"id":"tr