[{"id":"traditional-arts::peking-opera-performance","scope":"humanities-history","groupId":"traditional-arts","groupTitle":"中国传统艺术","groupTakeaway":"中国传统艺术包括汉字书法、国画、戏曲与植物意象。知识卡分别说明书体和构字方法、艺术家与作品、剧种特征、脸谱含义以及象征组合。","title":"京剧四种表现手法","content":"京剧常用唱、念、做、打四种表现手法。唱和念属于声音表达，做是表演动作，打主要表现武打和程式化动作。","label":"京剧四种表现手法","note":"京剧常用唱、念、做、打四种表现手法。唱和念属于声音表达，做是表演动作，打主要表现武打和程式化动作。","learningGoal":"准确说出唱念做打并区分基本作用。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"traditional-arts","tabId":"traditional-opera","sourceUnitIds":["cs-10-15-p18-opera-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-arts&tabId=traditional-opera","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ec193e15","learningSignature":"a8ffc885"},{"id":"traditional-arts::four-famous-dan","scope":"humanities-history","groupId":"traditional-arts","groupTitle":"中国传统艺术","groupTakeaway":"中国传统艺术包括汉字书法、国画、戏曲与植物意象。知识卡分别说明书体和构字方法、艺术家与作品、剧种特征、脸谱含义以及象征组合。","title":"京剧四大名旦","content":"京剧四大名旦是梅兰芳、尚小云、程砚秋和荀慧生，常用“梅尚程荀”概括四人的姓氏。","label":"京剧四大名旦","note":"京剧四大名旦是梅兰芳、尚小云、程砚秋和荀慧生，常用“梅尚程荀”概括四人的姓氏。","learningGoal":"准确说出京剧四大名旦。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-arts","tabId":"traditional-opera","sourceUnitIds":["cs-10-15-p18-opera-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-arts&tabId=traditional-opera","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"5a93cdfd","learningSignature":"ec58cf5e"},{"id":"traditional-arts::yue-opera","scope":"humanities-history","groupId":"traditional-arts","groupTitle":"