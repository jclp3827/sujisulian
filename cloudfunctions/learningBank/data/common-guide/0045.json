[{"id":"traditional-arts::huangmei-opera","scope":"humanities-history","groupId":"traditional-arts","groupTitle":"中国传统艺术","groupTakeaway":"中国传统艺术包括汉字书法、国画、戏曲与植物意象。知识卡分别说明书体和构字方法、艺术家与作品、剧种特征、脸谱含义以及象征组合。","title":"黄梅戏的名称与地域","content":"黄梅戏又称黄梅调、采茶戏等，正文记载其起源于湖北黄梅，后来在安徽安庆发展壮大，代表剧目有《天仙配》《女驸马》。","label":"黄梅戏的名称与地域","note":"黄梅戏又称黄梅调、采茶戏等，正文记载其起源于湖北黄梅，后来在安徽安庆发展壮大，代表剧目有《天仙配》《女驸马》。","learningGoal":"说明黄梅戏的别称、起源地、发展地和代表剧目。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"traditional-arts","tabId":"traditional-opera","sourceUnitIds":["cs-10-15-p18-opera-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-arts&tabId=traditional-opera","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"4243085"},{"id":"traditional-arts::opera-three-leading-genres","scope":"humanities-history","groupId":"traditional-arts","groupTitle":"中国传统艺术","groupTakeaway":"中国传统艺术包括汉字书法、国画、戏曲与植物意象。知识卡分别说明书体和构字方法、艺术家与作品、剧种特征、脸谱含义以及象征组合。","title":"戏曲三鼎甲","content":"正文把京剧、豫剧和越剧合称为戏曲三鼎甲。这个称谓用于概括三个影响较大的剧种，并不等同于所有传统戏曲类型。","label":"戏曲三鼎甲","note":"正文把京剧、豫剧和越剧合称为戏曲三鼎甲。这个称谓用于概括三个影响较大的剧种，并不等同于所有传统戏曲类型。","learningGoal":"准确说出戏曲三鼎甲所指的三个剧种。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"traditional-arts","tabId":"traditional-opera","sourceUnitIds":["cs-10-15-p18-opera-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=traditional-arts&tabId=traditional-opera","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"969942d9"},{"id":"traditional-arts::red-white-face","scope":"humanities-history","groupId":"traditional-arts","groupTitle