istory","groupId":"daily-life-language","groupTitle":"中国古代生活","groupTakeaway":"中国古代生活常识包括传统节日、教育制度、织锦刺绣和饮食文化。知识卡分别说明日期习俗、诗句对应、学校课程、地域工艺和菜茶宴席。","title":"端午诗句中的粽子","content":"“角黍包金，香蒲切玉”出自黄裳《喜迁莺·端午泛湖》；“五色新丝缠角粽”出自欧阳修《渔家傲》，都以粽子表现端午习俗。","label":"端午诗句中的粽子","note":"“角黍包金，香蒲切玉”出自黄裳《喜迁莺·端午泛湖》；“五色新丝缠角粽”出自欧阳修《渔家傲》，都以粽子表现端午习俗。","learningGoal":"识别两组端午诗句及其中的节日食物。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"daily-life-language","tabId":"festivals-memorials","sourceUnitIds":["cs-10-15-p19-p20-festival-poetry-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=daily-life-language&tabId=festivals-memorials","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"f121c2c3","learningSignature":"71ba1b38"}]