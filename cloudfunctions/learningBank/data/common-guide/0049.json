[{"id":"daily-life-language::mid-autumn-poems","scope":"humanities-history","groupId":"daily-life-language","groupTitle":"中国古代生活","groupTakeaway":"中国古代生活常识包括传统节日、教育制度、织锦刺绣和饮食文化。知识卡分别说明日期习俗、诗句对应、学校课程、地域工艺和菜茶宴席。","title":"中秋诗句中的月亮","content":"“暮云收尽溢清寒，银汉无声转玉盘”出自苏轼《中秋月》；“一轮秋影转金波”出自辛弃疾《太常引》，都以月亮表现中秋。","label":"中秋诗句中的月亮","note":"“暮云收尽溢清寒，银汉无声转玉盘”出自苏轼《中秋月》；“一轮秋影转金波”出自辛弃疾《太常引》，都以月亮表现中秋。","learningGoal":"区分两组中秋诗句的作者和作品。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"daily-life-language","tabId":"festivals-memorials","sourceUnitIds":["cs-10-15-p19-p20-festival-poetry-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=daily-life-language&tabId=festivals-memorials","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"228c423e"},{"id":"daily-life-language::double-ninth-poems","scope":"humanities-history","groupId":"daily-life-language","groupTitle":"中国古代生活","groupTakeaway":"中国古代生活常识包括传统节日、教育制度、织锦刺绣和饮食文化。知识卡分别说明日期习俗、诗句对应、学校课程、地域工艺和菜茶宴席。","title":"重阳诗句中的登高与茱萸","content":"“遥知兄弟登高处，遍插茱萸少一人”出自王维《九月九日忆山东兄弟》；杜牧《九日齐山登高》也写重阳登高赏菊。","label":"重阳诗句中的登高与茱萸","note":"“遥知兄弟登高处，遍插茱萸少一人”出自王维《九月九日忆山东兄弟》；杜牧《九日齐山登高》也写重阳登高赏菊。","learningGoal":"识别重阳诗句中的习俗、作者和作品。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"daily-life-language","tabId":"festivals-memorials","sourceUnitIds":["cs-10-15-p19-p20-festival-poetry-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=daily-life-language&tabId=festivals-memorials","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"e349ce98"},{"id":"daily-life-language::school-name-history","scope":"humanities-history","groupId":"daily-life-language","groupTitle":"中国古代生活","groupTakeaway":"中国古代生活常识包括传统节日、教育制度、织锦刺绣和饮食文化。知识卡分别说明日期习俗、诗句对应、学校课程、地域工艺和菜茶宴席。","title":"校、序、庠与庠序","content":"传统说法称夏代学校为校、商代为序、周代为庠，因此先秦学校有时统称庠序。这组名称反映不同时代的学校称谓。","label":"校、序、庠与庠序","note":"传统说法称夏代学校为校、商代为序、周代为庠，因此先秦学校有时统称庠序。这组名称反映不同时代的学校称谓。","learningGoal":"区分校、序、庠对应的时代并说明庠序含义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"daily-life-language","tabId":"ancient-education","sourceUnitIds":["cs-10-15-p20-education-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=daily-life-language&tabId=ancient-education","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"90a39df3"},{"id":"daily-life-language::jixia-academy","scope":"humanities-history","groupId":"daily-life-language","groupTitle":"中国古代生活","groupTakeaway":"中国古代生活常识包括传统节日、教育制度、织锦刺绣和饮食文化。知识卡分别说明日期习俗、诗句对应、学校课程、地域工艺和菜茶宴席。","title":"齐国稷下学宫","content":"稷下学宫设于齐国，是古代重要的官办学术和教育机构，聚集学者讲学论辩，对战国思想发展产生影响。","label":"齐国稷下学宫","note":"稷下学宫设于齐国，是古代重要的官办学术和教育机构，聚集学者讲学论辩，对战国思想发展产生影响。","learningGoal":"说明稷下学宫的所属国家、性质和主要活动。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"daily-life-language","tabId":"ancient-education","sourceUnitIds":["cs-10-15-p20-education-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=daily-life-language&tabId=ancient-education","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3440dd52"},{"id":"daily-life-language::wenweng-stone-school","scope":"humanities-history","groupId":"daily-life-language","groupTitle":"中国古代生活","groupTakeaway":"中国古代生活常识包括传统节日、教育制度、织锦刺绣和饮食文化。知识卡分别说明日期习俗、诗句对应、学校课程、地域工艺和菜茶宴席。","title":"文翁石室","content":"文翁石室由蜀郡太守文翁创建，是地方官府兴办学校的代表。人物、官职、地点和学校名称应一并识别。","label":"文翁石室","note":"文翁石室由蜀郡太守文翁创建，是地方官府兴办学校的代表。人物、官职、地点和学校名称应一并识别。","learningGoal":"说清文翁石室的创建者、官职和学校性质。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"daily-life-language","tabId":"ancient-education","sourceUnitIds":["cs-10-15-p20-education-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=daily-life-language&tabId=ancient-education","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"1c0efc"}]