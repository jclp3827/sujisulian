[{"id":"classical-language-allusions::childhood-age-titles","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"始龀、垂髫与总角","content":"始龀指七八岁换牙时期，垂髫约指三四岁至八九岁，总角约指八九岁至十三四岁。三者都用于儿童阶段。","label":"始龀、垂髫与总角","note":"始龀指七八岁换牙时期，垂髫约指三四岁至八九岁，总角约指八九岁至十三四岁。三者都用于儿童阶段。","learningGoal":"区分始龀、垂髫和总角的大致年龄。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p21-age-title-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"bdd497e9","learningSignature":"b093b7f1"},{"id":"classical-language-allusions::youth-gender-titles","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"束发、豆蔻与及笄","content":"束发约指十五岁；豆蔻年华指女子十三四岁；及笄之年指女子十五岁。豆蔻和及笄有明确女性使用范围。","label":"束发、豆蔻与及笄","note":"束发约指十五岁；豆蔻年华指女子十三四岁；及笄之年指女子十五岁。豆蔻和及笄有明确女性使用范围。","learningGoal":"区分束发、豆蔻年华和及笄之年的年龄与性别。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p21-age-title-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"da57b8f4","learningSignature":"393d61a1"},{"id":"classical-language-allusions::weak-crown","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"弱冠之年","content":"弱冠指男子二十岁。古代男子成年举行冠礼，弱冠由此成为成年男子年龄称谓。","label":"弱冠之年","note":"弱冠指男子二十岁。古代男子成年举行冠礼，弱冠由此成为成年男子年龄称谓。","learningGoal":"说明弱冠对应的性别、年龄和礼仪背景。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p21-age-title-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"18579aa2","learningSignature":"da28957b"},{"id":"classical-language-allusions::thirty-to-fifty","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"而立、不惑与知天命","content":"而立之年指三十岁，不惑之年指四十岁，知天命之年指五十岁。三个称谓依次相差十年。","label":"而立、不惑与知天命","note":"而立之年指三十岁，不惑之年指四十岁，知天命之年指五十岁。三个称谓依次相差十年。","learningGoal":"准确说出而立、不惑和知天命对应的年龄。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p21-age-title-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b926e87f","learningSignature":"a6f7a993"},{"id":"classical-language-allusions::sixty-to-hundred","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"花甲、古稀、耄耋与期颐","content":"花甲或耳顺指六十岁，古稀指七十岁，耄耋约指八九十岁，期颐指一百岁。这些称谓依次用于老年阶段。","label":"花甲、古稀、耄耋与期颐","note":"花甲或耳顺指六十岁，古稀指七十岁，耄耋约指八九十岁，期颐指一百岁。这些称谓依次用于老年阶段。","learningGoal":"准确说出花甲、古稀、耄耋和期颐对应年龄。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p21-age-title-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"d4d98c74","learningSignature":"de288dcf"}]