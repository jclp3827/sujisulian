[{"id":"classical-language-allusions::supplemental-male-ages","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"舞勺、舞象与志学","content":"补充称谓中，舞勺之年指男子十三岁，舞象之年指男子十五至二十岁，志学之年指十五岁。","label":"舞勺、舞象与志学","note":"补充称谓中，舞勺之年指男子十三岁，舞象之年指男子十五至二十岁，志学之年指十五岁。","learningGoal":"区分舞勺、舞象和志学对应的年龄。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p21-p23-forms-of-address-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ec12e9f","learningSignature":"a5925755"},{"id":"classical-language-allusions::supplemental-later-ages","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"桃李、从心与鲐背","content":"桃李年华指女子二十岁，从心之年指七十岁，鲐背之年指九十岁。三者分别用于青年女性和高龄阶段。","label":"桃李、从心与鲐背","note":"桃李年华指女子二十岁，从心之年指七十岁，鲐背之年指九十岁。三者分别用于青年女性和高龄阶段。","learningGoal":"区分桃李年华、从心之年和鲐背之年。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p21-p23-forms-of-address-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"d4b22e65","learningSignature":"2e