[{"id":"classical-language-allusions::cultural-metonyms","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"杜康、丹青、社稷与丝竹","content":"杜康可代指酒，丹青可代指绘画，社稷可代指国家，丝竹可代指音乐。这些词由人物、材料或礼制事物引申为文化代称。","label":"杜康、丹青、社稷与丝竹","note":"杜康可代指酒，丹青可代指绘画，社稷可代指国家，丝竹可代指音乐。这些词由人物、材料或礼制事物引申为文化代称。","learningGoal":"说明杜康、丹青、社稷和丝竹分别代指什么。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p22-other-title-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"66c9bcb3","learningSignature":"300bcc3"},{"id":"classical-language-allusions::social-metonyms","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"桑梓、巾帼、须眉与桃李","content":"桑梓代指故乡，巾帼代指女性，须眉代指男子，桃李代指学生。词语表面所指与实际代称对象不同。","label":"桑梓、巾帼、须眉与桃李","note":"桑梓代指故乡，巾帼代指女性，须眉代指男子，桃李代指学生。词语表面所指与实际代称对象不同。","learningGoal":"说明桑梓、巾帼、须眉和桃李的代称对象。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p22-other-title-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"1d1782a0","learningSignature":"c6ee5208"},{"id":"classical-language-allusions::event-metonyms","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"于归、秦晋之好与弄璋弄瓦","content":"于归指女子出嫁，秦晋之好指婚姻；弄璋之喜指生儿子，弄瓦之喜指生女儿。这些都是人生礼俗相关称谓。","label":"于归、秦晋之好与弄璋弄瓦","note":"于归指女子出嫁，秦晋之好指婚姻；弄璋之喜指生儿子，弄瓦之喜指生女儿。这些都是人生礼俗相关称谓。","learningGoal":"区分于归、秦晋之好、弄璋和弄瓦的含义。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"forms-of-address","sourceUnitIds":["cs-10-15-p22-other-title-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=forms-of-address","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3579f549","learningSignature":"929c3375"},{"id":"classical-language-allusions::xiang-yu-idioms","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"项羽相关成语","content":"四面楚歌和破釜沉舟都与项羽有关。四面楚歌表现被围困孤立，破釜沉舟表现断绝退路、决心取胜。","label":"项羽相关成语","note":"四面楚歌和破釜沉舟都与项羽有关。四面楚歌表现被围困孤立，破釜沉舟表现断绝退路、决心取胜。","learningGoal":"识别与项羽相关的两个成语并说明含义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"idioms","sourceUnitIds":["cs-10-15-p23-idiom-allusion-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=idioms","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"f9729995","learningSignature":"b3