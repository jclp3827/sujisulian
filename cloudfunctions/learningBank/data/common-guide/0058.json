[{"id":"classical-language-allusions::analects-idioms","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"《论语》中的常见成语","content":"不耻下问、温故知新、见贤思齐、当仁不让、过犹不及、三思而行和后生可畏等都出自《论语》。","label":"《论语》中的常见成语","note":"不耻下问、温故知新、见贤思齐、当仁不让、过犹不及、三思而行和后生可畏等都出自《论语》。","learningGoal":"识别常见《论语》成语。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"idioms","sourceUnitIds":["cs-10-15-p23-book-idiom-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=idioms","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"5abe6cec","learningSignature":"62ab5325"},{"id":"classical-language-allusions::shiji-idioms","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"《史记》中的常见成语","content":"破釜沉舟、四面楚歌、约法三章、完璧归赵、负荆请罪、纸上谈兵、毛遂自荐和一鸣惊人等见于《史记》相关叙事。","label":"《史记》中的常见成语","note":"破釜沉舟、四面楚歌、约法三章、完璧归赵、负荆请罪、纸上谈兵、毛遂自荐和一鸣惊人等见于《史记》相关叙事。","learningGoal":"识别常见《史记》成语。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"idioms","sourceUnitIds":["cs-10-15-p23-book-idiom-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=idioms","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b089c985","learningSignature":"1f947a6e"},{"id":"classical-language-allusions::three-unknowns","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"一问三不知","content":"一问三不知表示不知道事情的起因、经过和结果。这里的三不知对应事件发展的三个基本环节。","label":"一问三不知","note":"一问三不知表示不知道事情的起因、经过和结果。这里的三不知对应事件发展的三个基本环节。","learningGoal":"说明一问三不知中的三项内容。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"idioms","sourceUnitIds":["cs-10-15-p24-word-meaning-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=idioms","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b9a16687","learningSignature":"5779a516"},{"id":"classical-language-allusions::colors-weapons-road","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"皂、干戈与阳关大道","content":"青红皂白中的皂指黑色；干戈是古代常用武器；阳关大道原指经过阳关通往西域的道路。","label":"皂、干戈与阳关大道","note":"青红皂白中的皂指黑色；干戈是古代常用武器；阳关大道原指经过阳关通往西域的道路。","learningGoal":"说明皂、干戈和阳关大道的原始含义。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"idioms","sourceUnitIds":["cs-10-15-p24-word-meaning-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=idioms","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"8bc9bcdb","learningSignature":"7a25c751"},{"id":"classical-language-allusions::strip-of-water","scope":"humanities-history","groupId":"classical-language-allusions","groupTitle":"中国古代用语","groupTakeaway":"中国古代用语包括年龄称谓、人物关系、谦敬辞、事物代称和成语典故。知识卡分别说明称谓对象、使用边界、人物出处与词语本义。","title":"一衣带水中的水","content":"一衣带水形容水面像衣带一样狭窄，正文指出成语中的水指长江，后来用于说明虽有江河相隔仍距离很近。","label":"一衣带水中的水","note":"一衣带水形容水面像衣带一样狭窄，正文指出成语中的水指长江，后来用于说明虽有江河相隔仍距离很近。","learningGoal":"说明一衣带水中的水所指对象和成语含义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"classical-language-allusions","tabId":"idioms","sourceUnitIds":["cs-10-15-p24-word-meaning-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=classical-language-allusions&tabId=idioms","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ae2bd73b","learningSignature":"4e826c51"}]