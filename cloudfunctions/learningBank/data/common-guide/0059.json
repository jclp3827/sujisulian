[{"id":"sports::olympic-rings-meaning","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"奥运五环的整体含义","content":"奥运五环整体象征五大洲的团结，以及世界各地运动员在奥运会相聚。五种环色不与五大洲逐一对应。","label":"奥运五环的整体含义","note":"奥运五环整体象征五大洲的团结，以及世界各地运动员在奥运会相聚。五种环色不与五大洲逐一对应。","learningGoal":"说明奥运五环的整体含义和颜色对应边界。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"sports","tabId":"olympic-rings","sourceUnitIds":["cs-10-15-p24-olympic-rings-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sports&tabId=olympic-rings","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"fc5b6fe3","learningSignature":"79f30202"},{"id":"sports::olympic-motto-current","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"现行奥林匹克格言","content":"现行奥林匹克格言是“更快、更高、更强——更团结”。前三项强调运动表现，新增的“更团结”强调团结与共同参与。","label":"现行奥林匹克格言","note":"现行奥林匹克格言是“更快、更高、更强——更团结”。前三项强调运动表现，新增的“更团结”强调团结与共同参与。","learningGoal":"准确说出现行奥林匹克格言的四个部分。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":2,"pointId":"sports","tabId":"olympic-motto","sourceUnitIds":["cs-10-15-p24-olympic-motto-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sports&tabId=olympic-motto","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a92b7d46","learningSignature":"cf92d1cd"},{"id":"sports::olympic-motto-history","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥