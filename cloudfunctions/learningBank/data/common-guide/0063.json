[{"id":"sports::basketball-start-fouls","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"篮球开赛与犯规离场","content":"按国际篮球规则，第一节以中圈跳球开始。一名球员累计5次犯规后不能继续参赛，需要退出比赛。","label":"篮球开赛与犯规离场","note":"按国际篮球规则，第一节以中圈跳球开始。一名球员累计5次犯规后不能继续参赛，需要退出比赛。","learningGoal":"说明国际篮球比赛如何开始以及个人犯规离场次数。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"sports","tabId":"basketball","sourceUnitIds":["cs-10-15-p25-basketball-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sports&tabId=basketball","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3128b664","learningSignature":"14ae840"},{"id":"sports::volleyball-six-on-court","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"排球场上人数","content":"室内排球比赛中，每队同时有6名队员在场上。两队隔网对抗，场上队员按规则轮转位置。","label":"排球场上人数","note":"室内排球比赛中，每队同时有6名队员在场上。两队隔网对抗，场上队员按规则轮转位置。","learningGoal":"准确说出室内排球每队的场上人数。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"sports","tabId":"volleyball","sourceUnitIds":["cs-10-15-p25-volleyball-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sports&tabId=volleyball","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"23482a80","learningSignature":"9abdecbd"},{"id":"sports::volleyball-match-sets","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"排球五局三胜","content":"室内排球通常采用五局三胜制，先赢得3局的队伍赢得整场比赛。比赛不一定需要打满5局。","label":"排球五局三胜","note":"室内排球通常采用五局三胜制，先赢得3局的队伍赢得整场比赛。比赛不一定需要打满5局。","learningGoal":"说明排球五局三胜制如何判定整场胜负。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"sports","tabId":"volleyball","sourceUnitIds":["cs-10-15-p25-volleyball-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sports&tabId=volleyball","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"87bb99d1","learningSignature":"7214424e"},{"id":"sports::volleyball-set-scoring","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"排球各局计分","content":"前四局先到25分且领先2分者胜；决胜局先到15分且领先2分者胜。达到目标分数但只领先1分时，比赛继续。","label":"排球各局计分","note":"前四局先到25分且领先2分者胜；决胜局先到15分且领先2分者胜。达到目标分数但只领先1分时，比赛继续。","learningGoal":"区分排球前四局与决胜局的目标分数和获胜条件。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"sports","tabId":"volleyball","sourceUnitIds":["cs-10-15-p25-volleyball-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sports&tabId=volleyball","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"76e587a1","learningSignature":"7c06f508"},{"id":"sports::table-tennis-game-scoring","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"乒乓球单局计分","content":"乒乓球一局先得11分者获胜；双方10比10后，必须继续比赛，直到一方领先2分。","label":"乒乓球单局计分","note":"乒乓球一局先得11分者获胜；双方10比10后，必须继续比赛，直到一方领先2分。",