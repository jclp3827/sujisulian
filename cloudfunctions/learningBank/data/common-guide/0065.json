[{"id":"sports::snooker-red-colour-stage","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"斯诺克红彩交替阶段","content":"台面还有红球时，选手先击打红球，再选择一个彩球。彩球合法入袋后放回原位，红球入袋后不再放回。","label":"斯诺克红彩交替阶段","note":"台面还有红球时，选手先击打红球，再选择一个彩球。彩球合法入袋后放回原位，红球入袋后不再放回。","learningGoal":"说明斯诺克第一阶段红球与彩球的击打和回置规则。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"sports","tabId":"snooker","sourceUnitIds":["cs-10-15-p25-snooker-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sports&tabId=snooker","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"f081f93e"},{"id":"sports::snooker-colour-clearance","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"斯诺克彩球清台顺序","content":"红球全部落袋后，按黄、绿、棕、蓝、粉、黑的顺序击打彩球。此阶段彩球入袋后不再放回。","label":"斯诺克彩球清台顺序","note":"红球全部落袋后，按黄、绿、棕、蓝、粉、黑的顺序击打彩球。此阶段彩球入袋后不再放回。","learningGoal":"准确说出斯诺克红球清台后的彩球击打顺序。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"sports","tabId":"snooker","sourceUnitIds":["cs-10-15-p25-snooker-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sports&tabId=snooker","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"fbd855cc"},{"id":"sports::snooker-values-147","scope":"humanities-history","groupId":"sports","groupTitle":"体育常识","groupTakeaway":"体育常识包括奥运会基本事实、竞技体操与耐力项目构成，以及足球、篮球、排球、乒乓球、羽毛球和斯诺克的基础规则。各卡明确项目、人数、时长、计分或比赛顺序。","title":"斯诺克分值与147分","content":"红球每个1分，黄、绿、棕、蓝、粉、黑依次为2至7分。常规局面下，连续完成15组红黑组合并清完彩球可得147分。","label":"斯诺克分值与147分","note":"红球每个1分，黄、绿、棕、蓝、粉、黑依次为2至7分。常规局面下，连续完成15组红黑组合并清完彩球可得147分。","learningGoal":"说明斯诺克红球和彩球分值以及147分的构成。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"sports","tabId":"snooker","sourceUnitIds":["cs-10-15-p25-snooker-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=sports&tabId=snooker","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"6c88471f"},{"id":"industrial-revolutions::first-period-place","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"第一次工业革命的时间与范围","content":"第一次工业革命发生于18世纪60年代至19世纪40年代，主要从英国展开。时间和发生范围构成这一阶段的基本定位。","label":"第一次工业革命的时间与范围","note":"第一次工业革命发生于18世纪60年代至19世纪40年代，主要从英国展开。时间和发生范围构成这一阶段的基本定位。","learningGoal":"准确说出第一次工业革命的时间范围和主要发生地。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"first-industrial-revolution","sourceUnitIds":["cs-16-22-p1-first-industrial-revolution-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=first-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"cbadf76d"},{"id":"industrial-revolutions::first-core-features","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"第一次工业革命的核心特征","content":"第一次工业革命以牛顿经典力学为理论背景，以珍妮纺纱机的发明为开始标志，以蒸汽机广泛应用为主要标志和动力特征。","label":"第一次工业革命的核心特征","note":"第一次工业革命以牛顿经典力学为理论背景，以珍妮纺纱机的发明为开始标志，以蒸汽机广泛应用为主要标志和动力特征。","learningGoal":"区分第一次工业革命的理论背景、开始标志和主要标志。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"first-industrial-revolution","sourceUnitIds":["cs-16-22-p1-first-industrial-revolution-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=first-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b08e712f"}]