[{"id":"industrial-revolutions::spinning-jenny","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"哈格里弗斯与珍妮纺纱机","content":"英国人哈格里弗斯于1765年发明珍妮纺纱机。它属于纺织机械成果，并被正文作为第一次工业革命的开始标志。","label":"哈格里弗斯与珍妮纺纱机","note":"英国人哈格里弗斯于1765年发明珍妮纺纱机。它属于纺织机械成果，并被正文作为第一次工业革命的开始标志。","learningGoal":"说明珍妮纺纱机的发明者、时间和历史定位。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"first-industrial-revolution","sourceUnitIds":["cs-16-22-p1-first-industrial-revolution-table","cs-16-22-p1-first-industrial-revolution-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=first-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"64196abe","learningSignature":"32236ed2"},{"id":"industrial-revolutions::watt-steam-engine","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"瓦特改良蒸汽机","content":"瓦特于1785年改良蒸汽机。蒸汽机的广泛应用成为第一次工业革命的主要标志，并为机器生产提供重要动力。","label":"瓦特改良蒸汽机","note":"瓦特于1785年改良蒸汽机。蒸汽机的广泛应用成为第一次工业革命的主要标志，并为机器生产提供重要动力。","learningGoal":"说明瓦特与蒸汽机的关系及其阶段意义。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"first-industrial-revolution","sourceUnitIds":["cs-16-22-p1-first-industrial-revolution-table","cs-16-22-p1-first-industrial-revolution-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=first-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"