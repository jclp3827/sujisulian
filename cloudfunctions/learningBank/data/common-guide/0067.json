[{"id":"industrial-revolutions::oersted-faraday","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"奥斯特与法拉第的电磁发现","content":"奥斯特于1820年发现电流能够产生磁效应；法拉第于1831年发现电磁感应。前者说明电生磁，后者揭示变化磁场能够产生电效应。","label":"奥斯特与法拉第的电磁发现","note":"奥斯特于1820年发现电流能够产生磁效应；法拉第于1831年发现电磁感应。前者说明电生磁，后者揭示变化磁场能够产生电效应。","learningGoal":"区分奥斯特和法拉第的电磁学发现。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"first-industrial-revolution","sourceUnitIds":["cs-16-22-p1-first-industrial-revolution-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=first-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"cf6ea997"},{"id":"industrial-revolutions::joule-heating","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"焦耳与电流热效应","content":"焦耳研究热功当量和电流热效应。焦耳定律可写为Q=I²Rt，表示电热与电流平方、电阻和通电时间有关。","label":"焦耳与电流热效应","note":"焦耳研究热功当量和电流热效应。焦耳定律可写为Q=I²Rt，表示电热与电流平方、电阻和通电时间有关。","learningGoal":"说明焦耳的研究成果和焦耳定律各符号的关系。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"first-industrial-revolution","sourceUnitIds":["cs-16-22-p1-first-industrial-revolution-table","cs-16-22-p1-first-industrial-revolution-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=first-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pe