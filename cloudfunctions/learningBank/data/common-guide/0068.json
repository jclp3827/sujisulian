[{"id":"industrial-revolutions::second-period-centers","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"第二次工业革命的时间与中心","content":"第二次工业革命发生于19世纪70年代至20世纪初，正文以美国和德国为主要发生范围。该阶段晚于以英国为中心的第一次工业革命。","label":"第二次工业革命的时间与中心","note":"第二次工业革命发生于19世纪70年代至20世纪初，正文以美国和德国为主要发生范围。该阶段晚于以英国为中心的第一次工业革命。","learningGoal":"准确说出第二次工业革命的时间范围和主要中心。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"second-industrial-revolution","sourceUnitIds":["cs-16-22-p2-second-industrial-revolution-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=second-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"aa05beaf","learningSignature":"240e5a7"},{"id":"industrial-revolutions::second-core-features","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"第二次工业革命的核心特征","content":"第二次工业革命以法拉第电磁感应原理为理论基础，以电力广泛应用为主要标志，电动机和内燃机成为主要动力机。","label":"第二次工业革命的核心特征","note":"第二次工业革命以法拉第电磁感应原理为理论基础，以电力广泛应用为主要标志，电动机和内燃机成为主要动力机。","learningGoal":"说明第二次工业革命的理论基础、主要标志和动力机。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"second-industrial-revolution","sourceUnitIds":["cs-16-22-p2-second-industrial-revolution-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=second-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceRea