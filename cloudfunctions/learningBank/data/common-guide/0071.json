[{"id":"industrial-revolutions::chicago-pile-one","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"芝加哥一号核反应堆","content":"1942年，美国芝加哥一号核反应堆实现受控自持核链式反应。该装置由费米团队研发，是核反应堆技术的重要里程碑。","label":"芝加哥一号核反应堆","note":"1942年，美国芝加哥一号核反应堆实现受控自持核链式反应。该装置由费米团队研发，是核反应堆技术的重要里程碑。","learningGoal":"说明芝加哥一号核反应堆的时间、成果和团队。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"third-industrial-revolution","sourceUnitIds":["cs-16-22-p3-third-industrial-revolution-table","cs-16-22-p3-third-industrial-revolution-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=third-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"88452f6f"},{"id":"industrial-revolutions::trinity-test","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"1945年首次核爆炸试验","content":"1945年，美国在三位一体试验中完成首次核爆炸。该节点与1942年受控核链式反应不同，前者是核武器试验，后者是反应堆实验。","label":"1945年首次核爆炸试验","note":"1945年，美国在三位一体试验中完成首次核爆炸。该节点与1942年受控核链式反应不同，前者是核武器试验，后者是反应堆实验。","learningGoal":"区分1942年核反应堆实验和1945年首次核爆炸。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"third-industrial-revolution","sourceUnitIds":["cs-16-22-p3-third-industrial-revolution-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=third-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","no