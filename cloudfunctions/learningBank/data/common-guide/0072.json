[{"id":"industrial-revolutions::gagarin-spaceflight","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"加加林首次载人航天飞行","content":"苏联宇航员加加林于1961年完成人类首次载人航天飞行。该成就发生在斯普特尼克一号发射之后、阿波罗11号登月之前。","label":"加加林首次载人航天飞行","note":"苏联宇航员加加林于1961年完成人类首次载人航天飞行。该成就发生在斯普特尼克一号发射之后、阿波罗11号登月之前。","learningGoal":"准确说出首次载人航天飞行的人物、国家和时间。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"third-industrial-revolution","sourceUnitIds":["cs-16-22-p3-third-industrial-revolution-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=third-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"9bd0e9e9","learningSignature":"4a76fde1"},{"id":"industrial-revolutions::salyut-one","scope":"science-technology","groupId":"industrial-revolutions","groupTitle":"三次工业革命","groupTakeaway":"三次工业革命分别以蒸汽动力、电力与内燃机、核能和信息航天技术为阶段特征。知识卡先说明每次革命的时间、范围与核心标志，再展开重要发明、理论和科技里程碑。","title":"礼炮一号空间站","content":"苏联于1971年发射礼炮一号。礼炮一号是早期空间站里程碑，体现航天活动从短期飞行转向在轨驻留平台。","label":"礼炮一号空间站","note":"苏联于1971年发射礼炮一号。礼炮一号是早期空间站里程碑，体现航天活动从短期飞行转向在轨驻留平台。","learningGoal":"说明礼炮一号的国家、时间和航天器类型。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"industrial-revolutions","tabId":"third-industrial-revolution","sourceUnitIds":["cs-16-22-p3-third-industrial-revolution-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=industrial-revolutions&tabId=third-industrial-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"8963a74a","learningSignature":"8602d1a2"},{"id":"china-modern-science-awards::two-bombs-one-satellite-scope","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"两弹一星的基本范围","content":"“两弹一星”主要指核弹、导弹和人造地球卫星。其中核弹包括原子弹和氢弹，这一概念概括了我国早期国防尖端科技的重要成果。","label":"两弹一星的基本范围","note":"“两弹一星”主要指核弹、导弹和人造地球卫星。其中核弹包括原子弹和氢弹，这一概念概括了我国早期国防尖端科技的重要成果。","learningGoal":"准确说出两弹一星所包含的三类成果。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1949-1977","sourceUnitIds":["cs-16-22-p4-two-bombs-one-satellite-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1949-1977","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c53c2fdf","learningSignature":"80345270"},{"id":"china-modern-science-awards::first-atomic-bomb","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"中国第一颗原子弹","content":"1964年，我国第一颗原子弹爆炸成功。这是“两弹一星”中的核弹成果之一，需与1967年第一颗氢弹试验成功区分。","label":"中国第一颗原子弹","note":"1964年，我国第一颗原子弹爆炸成功。这是“两弹一星”中的核弹成果之一，需与1967年第一颗氢弹试验成功区分。","learningGoal":"区分我国第一颗原子弹和第一颗氢弹的时间。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1949-1977","sourceUnitIds":["cs-16-22-p4-two-bombs-one-satellite-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1949-1977","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c2579c0f","learningSignature":"43b6f130"},{"id":"china-modern-science-awards::first-hydrogen-bomb","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"中国第一颗氢弹","content":"1967年，我国第一颗氢弹试验成功。它与1964年第一颗原子弹同属核弹成果，但时间节点和技术对象不同。","label":"中国第一颗氢弹","note":"1967年，我国第一颗氢弹试验成功。它与1964年第一颗原子弹同属核弹成果，但时间节点和技术对象不同。","learningGoal":"准确说出我国第一颗氢弹试验成功的年份。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1949-1977","sourceUnitIds":["cs-16-22-p4-two-bombs-one-satellite-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1949-1977","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"949adaa6","learningSignature":"f44494dc"}]