[{"id":"china-modern-science-awards::dongfeng-one","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"东风一号导弹","content":"1960年，东风一号导弹完成重要试验任务。它属于“两弹一星”中的导弹成果，与同年正文另列的自主研发火箭成果不能混为同一对象。","label":"东风一号导弹","note":"1960年，东风一号导弹完成重要试验任务。它属于“两弹一星”中的导弹成果，与同年正文另列的自主研发火箭成果不能混为同一对象。","learningGoal":"说明东风一号所属成果类别和时间。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1949-1977","sourceUnitIds":["cs-16-22-p4-two-bombs-one-satellite-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1949-1977","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"e7d85b5b"},{"id":"china-modern-science-awards::dongfanghong-one","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"东方红一号人造卫星","content":"1970年，我国第一颗人造地球卫星“东方红一号”成功进入太空，使我国具备独立发射人造卫星的能力。它对应“两弹一星”中的“一星”。","label":"东方红一号人造卫星","note":"1970年，我国第一颗人造地球卫星“东方红一号”成功进入太空，使我国具备独立发射人造卫星的能力。它对应“两弹一星”中的“一星”。","learningGoal":"说明东方红一号的时间、类型和两弹一星归属。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1949-1977","sourceUnitIds":["cs-16-22-p4-two-bombs-one-satellite-table","cs-16-22-p4-early-milestones-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1949-1977","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"9dd05748"},{"id":"china-modern-science-awards::early-domestic-rocket","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"我国早期自主研发火箭","content":"1960年，我国自主研发的第一枚火箭发射成功。该成果体现我国早期运载与火箭技术建设，正文将它与东风一号分别列示。","label":"我国早期自主研发火箭","note":"1960年，我国自主研发的第一枚火箭发射成功。该成果体现我国早期运载与火箭技术建设，正文将它与东风一号分别列示。","learningGoal":"说明我国自主研发第一枚火箭的时间和意义。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1949-1977","sourceUnitIds":["cs-16-22-p4-early-milestones-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1949-1977","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"49ea8230"},{"id":"china-modern-science-awards::synthetic-bovine-insulin","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"人工合成结晶牛胰岛素","content":"1965年，我国人工合成结晶牛胰岛素研制成功。这一成果属于生命科学和人工合成蛋白质研究，不属于核、导弹或卫星成果。","label":"人工合成结晶牛胰岛素","note":"1965年，我国人工合成结晶牛胰岛素研制成功。这一成果属于生命科学和人工合成蛋白质研究，不属于核、导弹或卫星成果。","learningGoal":"识别人工合成结晶牛胰岛素的时间和学科属性。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1949-1977","sourceUnitIds":["cs-16-22-p4-early-milestones-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1949-1977","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"75a3a80e"},{"id":"china-modern-science-awards::china-space-day","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"中国航天日","content":"每年4月24日是中国航天日，这一日期对应1970年东方红一号成功发射的历史节点。日期与事件共同构成常见科技史对应关系。","label":"中国航天日","note":"每年4月24日是中国航天日，这一日期对应1970年东方红一号成功发射的历史节点。日期与事件共同构成常见科技史对应关系。","learningGoal":"说明中国航天日的日期及其对应历史事件。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1949-1977","sourceUnitIds":["cs-16-22-p4-early-milestones-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1949-1977","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"5752c766"}]