[{"id":"china-modern-science-awards::shenzhou-five","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"神舟五号首次载人航天","content":"2003年，神舟五号完成我国首次载人航天飞行，航天员为杨利伟。任务名称、年份、人物和首次载人航天成果需要完整对应。","label":"神舟五号首次载人航天","note":"2003年，神舟五号完成我国首次载人航天飞行，航天员为杨利伟。任务名称、年份、人物和首次载人航天成果需要完整对应。","learningGoal":"准确说出我国首次载人航天任务的名称、时间和航天员。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1978-2019","sourceUnitIds":["cs-16-22-p4-china-modern-science-1978-2019-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1978-2019","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"467b0348"},{"id":"china-modern-science-awards::tiangong-one","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"天宫一号空间实验室","content":"2011年，天宫一号发射。正文将其定位为我国第一个空间实验室，它为交会对接和空间实验等任务提供了平台。","label":"天宫一号空间实验室","note":"2011年，天宫一号发射。正文将其定位为我国第一个空间实验室，它为交会对接和空间实验等任务提供了平台。","learningGoal":"说明天宫一号的时间和航天器类型。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1978-2019","sourceUnitIds":["cs-16-22-p4-china-modern-science-1978-2019-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1978-2019","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"efbbda7d"},{"id":"china-modern-science-awards::jiaolong-7062","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"蛟龙号载人深潜","content":"2012年，“蛟龙”号载人潜水器下潜至7062米，形成当时我国载人深潜的重要纪录。它属于海洋深潜装备，不属于航天器。","label":"蛟龙号载人深潜","note":"2012年，“蛟龙”号载人潜水器下潜至7062米，形成当时我国载人深潜的重要纪录。它属于海洋深潜装备，不属于航天器。","learningGoal":"说明蛟龙号的装备类型、时间和下潜深度。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1978-2019","sourceUnitIds":["cs-16-22-p4-china-modern-science-1978-2019-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1978-2019","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"44f924ac"},{"id":"china-modern-science-awards::liaoning-carrier","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"辽宁舰首艘航空母舰","content":"2012年，辽宁舰成为中国第一艘航空母舰，舷号为16。它与2019年入列、舷号17的山东舰在时间和国产化定位上不同。","label":"辽宁舰首艘航空母舰","note":"2012年，辽宁舰成为中国第一艘航空母舰，舷号为16。它与2019年入列、舷号17的山东舰在时间和国产化定位上不同。","learningGoal":"区分辽宁舰和山东舰的时间、定位与舷号。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1978-2019","sourceUnitIds":["cs-16-22-p4-china-modern-science-1978-2019-table","cs-16-22-p4-middle-science-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1978-2019","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"8f65cdd6"},{"id":"china-modern-science-awards::wukong-satellite","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"悟空号暗物质卫星","content":"2015年，“悟空号”暗物质粒子探测卫星发射。它用于探测高能粒子和研究暗物质相关科学问题，属于空间科学卫星。","label":"悟空号暗物质卫星","note":"2015年，“悟空号”暗物质粒子探测卫星发射。它用于探测高能粒子和研究暗物质相关科学问题，属于空间科学卫星。","learningGoal":"说明悟空号的发射时间和主要探测对象。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1978-2019","sourceUnitIds":["cs-16-22-p4-china-modern-science-1978-2019-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1978-2019","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c53545ce"}]