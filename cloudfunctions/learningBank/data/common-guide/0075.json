[{"id":"china-modern-science-awards::micius-satellite","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"墨子号量子科学实验卫星","content":"2016年，“墨子号”量子科学实验卫星发射。它以空间平台开展量子科学实验，需要与探测暗物质的悟空号区分。","label":"墨子号量子科学实验卫星","note":"2016年，“墨子号”量子科学实验卫星发射。它以空间平台开展量子科学实验，需要与探测暗物质的悟空号区分。","learningGoal":"区分墨子号和悟空号的研究方向。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1978-2019","sourceUnitIds":["cs-16-22-p4-china-modern-science-1978-2019-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1978-2019","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"877717be"},{"id":"china-modern-science-awards::shandong-carrier","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"山东舰首艘国产航空母舰","content":"2019年，山东舰入列，正文将其定位为中国第一艘国产航空母舰，舷号为17。辽宁舰是我国第一艘航空母舰，二者定位不同。","label":"山东舰首艘国产航空母舰","note":"2019年，山东舰入列，正文将其定位为中国第一艘国产航空母舰，舷号为17。辽宁舰是我国第一艘航空母舰，二者定位不同。","learningGoal":"说明山东舰的时间、国产化定位和舷号。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-1978-2019","sourceUnitIds":["cs-16-22-p4-china-modern-science-1978-2019-table","cs-16-22-p4-middle-science-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-1978-2019","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"7ce0a92d"},{"id":"china-modern-science-awards::tianwen-one-zhurong","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"天问一号与祝融号火星车","content":"2020年，天问一号火星探测任务展开，祝融号火星车随任务开展巡视探测。名称“天问”取自屈原《天问》，任务使我国行星探测迈出重要一步。","label":"天问一号与祝融号火星车","note":"2020年，天问一号火星探测任务展开，祝融号火星车随任务开展巡视探测。名称“天问”取自屈原《天问》，任务使我国行星探测迈出重要一步。","learningGoal":"说明天问一号、祝融号和名称来源的关系。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p5-recent-aerospace-table","cs-16-22-p6-aerospace-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"dac79112"},{"id":"china-modern-science-awards::mars-global-image","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"我国首次火星全球影像图","content":"2023年，我国发布首次火星探测火星全球影像图。该成果来自火星探测获得的数据，与2020年天问一号任务构成前后相接的任务链。","label":"我国首次火星全球影像图","note":"2023年，我国发布首次火星探测火星全球影像图。该成果来自火星探测获得的数据，与2020年天问一号任务构成前后相接的任务链。","learningGoal":"说明我国首次火星全球影像图的发布时间及其任务背景。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p5-recent-aerospace-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabI