[{"id":"china-modern-science-awards::change-six-components","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"嫦娥六号的四个组成部分","content":"2024年嫦娥六号探测器总重8.2吨，由轨道器、返回器、着陆器和上升器四部分组成。四部分分别服务于绕月、返回、着陆和样品上升等环节。","label":"嫦娥六号的四个组成部分","note":"2024年嫦娥六号探测器总重8.2吨，由轨道器、返回器、着陆器和上升器四部分组成。四部分分别服务于绕月、返回、着陆和样品上升等环节。","learningGoal":"准确说出嫦娥六号的四个组成部分。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p5-recent-aerospace-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c2f9b9de","learningSignature":"fedb7552"},{"id":"china-modern-science-awards::change-six-launch","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"嫦娥六号的发射火箭与发射场","content":"2024年，嫦娥六号由长征五号遥八运载火箭在中国文昌航天发射场发射。任务、火箭和发射场应作为一组对应关系。","label":"嫦娥六号的发射火箭与发射场","note":"2024年，嫦娥六号由长征五号遥八运载火箭在中国文昌航天发射场发射。任务、火箭和发射场应作为一组对应关系。","learningGoal":"准确说出嫦娥六号的运载火箭和发射场。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p5-recent-aerospace-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pe