[{"id":"china-modern-science-awards::shenzhou-nineteen-crew","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"神舟十九号航天员乘组","content":"2024年神舟十九号航天员乘组由蔡旭哲、宋令东和王浩泽组成。其中宋令东、王浩泽为首次执行飞行任务的“90后”航天员。","label":"神舟十九号航天员乘组","note":"2024年神舟十九号航天员乘组由蔡旭哲、宋令东和王浩泽组成。其中宋令东、王浩泽为首次执行飞行任务的“90后”航天员。","learningGoal":"准确说出神舟十九号乘组及两名首次飞行的90后航天员。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p5-recent-aerospace-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b21ae703","learningSignature":"9cd056fc"},{"id":"china-modern-science-awards::wang-haoze-role","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"王浩泽的航天员身份","content":"王浩泽是我国首位女性航天飞行工程师，也是我国第三位执行载人航天飞行任务的女性。她作为神舟十九号乘组成员于2024年执行任务。","label":"王浩泽的航天员身份","note":"王浩泽是我国首位女性航天飞行工程师，也是我国第三位执行载人航天飞行任务的女性。她作为神舟十九号乘组成员于2024年执行任务。","learningGoal":"说明王浩泽在我国载人航天史上的身份特点。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p5-recent-aerospace-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":