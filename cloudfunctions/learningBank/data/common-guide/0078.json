[{"id":"china-modern-science-awards::fujian-carrier","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"福建舰弹射型航空母舰","content":"2022年，福建舰下水，正文将其定位为中国第一艘弹射型航空母舰，舷号为18。它与舷号16的辽宁舰、舷号17的山东舰形成序列。","label":"福建舰弹射型航空母舰","note":"2022年，福建舰下水，正文将其定位为中国第一艘弹射型航空母舰，舷号为18。它与舷号16的辽宁舰、舷号17的山东舰形成序列。","learningGoal":"说明福建舰的时间、类型和舷号。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p6-recent-other-table","cs-16-22-p6-recent-other-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"9b580b6e","learningSignature":"c5792725"},{"id":"china-modern-science-awards::fendouzhe-depth","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"奋斗者号万米深潜","content":"2020年，“奋斗者”号在马里亚纳海沟成功坐底，深度达到10909米。它是载人潜水器成果，需要与2012年下潜7062米的蛟龙号区分。","label":"奋斗者号万米深潜","note":"2020年，“奋斗者”号在马里亚纳海沟成功坐底，深度达到10909米。它是载人潜水器成果，需要与2012年下潜7062米的蛟龙号区分。","learningGoal":"区分奋斗者号和蛟龙号的时间与深度。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p6-recent-other-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a170c596","learningSignature":"eefbb1ef"},{"id":"china-modern-science-awards::fendouzhe-expedition","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"奋斗者号环大洋洲科考","content":"2023年，“奋斗者”号完成国际首次环大洋洲载人深潜科考航次任务。这一成果描述的是科考航次，不是单次最大下潜深度。","label":"奋斗者号环大洋洲科考","note":"2023年，“奋斗者”号完成国际首次环大洋洲载人深潜科考航次任务。这一成果描述的是科考航次，不是单次最大下潜深度。","learningGoal":"区分奋斗者号的科考航次成果和深潜深度成果。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p6-recent-other-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3e5b0427","learningSignature":"3e90c88a"},{"id":"china-modern-science-awards::c919-commercial-flight","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"C919首次商业飞行","content":"2023年，国产大飞机C919完成首次商业飞行。C919定位为民用客机，需要与军用运输机运-20和水陆两栖救援飞机鲲龙AG600区分。","label":"C919首次商业飞行","note":"2023年，国产大飞机C919完成首次商业飞行。C919定位为民用客机，需要与军用运输机运-20和水陆两栖救援飞机鲲龙AG600区分。","learningGoal":"说明C919的任务定位及首次商业飞行时间。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p6-recent-other-table","cs-16-22-p6-recent-other-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"4db9920c","learningSignature":"77795b46"},{"id":"china-modern-science-awards::large-aircraft-trio","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"大飞机三类代表机型","content":"正文所列大飞机三类代表机型分别是民用客机C919、军用运输机运-20和水陆两栖救援飞机鲲龙AG600。三者的主要用途不同。","label":"大飞机三类代表机型","note":"正文所列大飞机三类代表机型分别是民用客机C919、军用运输机运-20和水陆两栖救援飞机鲲龙AG600。三者的主要用途不同。","learningGoal":"区分C919、运-20和鲲龙AG600的用途。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p6-recent-other-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"cd7db5ca","learningSignature":"5539615d"}]