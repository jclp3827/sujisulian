e-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"牛顿第一定律与惯性","content":"当物体不受外力或所受合力为零时，会保持静止或匀速直线运动状态。物体保持原有运动状态的性质叫惯性；惯性是物体自身的属性，不是一种力。","label":"牛顿第一定律与惯性","note":"当物体不受外力或所受合力为零时，会保持静止或匀速直线运动状态。物体保持原有运动状态的性质叫惯性；惯性是物体自身的属性，不是一种力。","learningGoal":"理解牛顿第一定律的条件，并区分惯性与力。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"physics","tabId":"newton-laws","sourceUnitIds":["cs-16-22-p8-newton-laws-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=newton-laws","mapping":"source-overlap","review":{"admission":"golden-candidate","sourceFidelity":"self-reviewed","noviceReadability":"accepted-by-user","independentFactReview":"pending-independent-review"},"signature":"53e472a7"}]