[{"id":"china-modern-science-awards::origin-wukong","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"本源悟空量子计算机","content":"2024年，“本源悟空”作为中国第三代自主超导量子计算机上线运行。它属于量子计算设备，与2015年的悟空号暗物质粒子探测卫星不是同一项目。","label":"本源悟空量子计算机","note":"2024年，“本源悟空”作为中国第三代自主超导量子计算机上线运行。它属于量子计算设备，与2015年的悟空号暗物质粒子探测卫星不是同一项目。","learningGoal":"区分本源悟空量子计算机和悟空号卫星。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p6-recent-other-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"dfbc8552"},{"id":"china-modern-science-awards::qinling-station","scope":"science-technology","groupId":"china-modern-science-awards","groupTitle":"中国现代科技史","groupTakeaway":"中国现代科技史可按三个阶段理解：早期形成核、导弹和卫星等基础能力，改革开放后拓展载人航天、深潜和科学卫星，近期继续推进探月探火、空间站及重大装备。","title":"秦岭站南极考察站","content":"2024年，秦岭站建成。它是我国第5个南极考察站，也是继长城站、中山站之后的第3个常年考察站，并面向太平洋扇区。","label":"秦岭站南极考察站","note":"2024年，秦岭站建成。它是我国第5个南极考察站，也是继长城站、中山站之后的第3个常年考察站，并面向太平洋扇区。","learningGoal":"说明秦岭站的建成时间及在我国南极考察站序列中的位置。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"china-modern-science-awards","tabId":"china-science-2020-2024","sourceUnitIds":["cs-16-22-p6-recent-other-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=china-modern-science-awards&tabId=china-science-2020-2024","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFa