[{"id":"physics::friction-increase-examples","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"自行车刹车和鞋底花纹怎样增大摩擦","content":"自行车刹车通过增大刹车片处的压力来增大摩擦；鞋底花纹通过增加接触面的粗糙程度来增大摩擦。两种做法对应不同的影响因素。","label":"自行车刹车和鞋底花纹怎样增大摩擦","note":"自行车刹车通过增大刹车片处的压力来增大摩擦；鞋底花纹通过增加接触面的粗糙程度来增大摩擦。两种做法对应不同的影响因素。","learningGoal":"区分增大压力和增加粗糙程度两种增摩擦方法。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p8-p9-friction-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"8c8cbde9","learningSignature":"abed6922"},{"id":"physics::rolling-reduces-friction","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"拉杆箱用滚动减小摩擦","content":"拉杆箱安装轮子后，把箱体与地面的滑动摩擦转变为滚动摩擦，从而更容易移动。它与把滚动改为滑动来增大摩擦的做法方向相反。","label":"拉杆箱用滚动减小摩擦","note":"拉杆箱安装轮子后，把箱体与地面的滑动摩擦转变为滚动摩擦，从而更容易移动。它与把滚动改为滑动来增大摩擦的做法方向相反。","learningGoal":"说明拉杆箱轮子减小摩擦的原理。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p8-p9-friction-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"45668528","learningSignature":"b6911b53"},{"id":"physics::friction-supports-daily-life","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"摩擦力维持行走和固定","content":"人行走、鞋带系紧以及螺丝钉固定物体都需要摩擦力。摩擦并非总是有害，应根据目标判断需要增大还是减小。","label":"摩擦力维持行走和固定","note":"人行走、鞋带系紧以及螺丝钉固定物体都需要摩擦力。摩擦并非总是有害，应根据目标判断需要增大还是减小。","learningGoal":"说明摩擦力在行走和固定物体中的作用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p8-p9-friction-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"45c51759","learningSignature":"28b78544"},{"id":"physics::lever-equilibrium","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"杠杆平衡条件","content":"杠杆平衡时满足动力×动力臂＝阻力×阻力臂。力臂是支点到力的作用线的垂直距离，比较杠杆是否省力要看两侧力臂，而不是只看杆的总长度。","label":"杠杆平衡条件","note":"杠杆平衡时满足动力×动力臂＝阻力×阻力臂。力臂是支点到力的作用线的垂直距离，比较杠杆是否省力要看两侧力臂，而不是只看杆的总长度。","learningGoal":"运用动力与阻力的力矩关系判断杠杆平衡。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p9-lever-formula-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ed6387c9","learningSignature":"71f7d6ee"},{"id":"physics::effort-saving-lever","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"省力杠杆","content":"省力杠杆的动力臂长于阻力臂，因此平衡时所需动力较小。撬棍、扳手、钳子和开瓶器是正文列出的典型应用。","label":"省力杠杆","note":"省力杠杆的动力臂长于阻力臂，因此平衡时所需动力较小。撬棍、扳手、钳子和开瓶器是正文列出的典型应用。","learningGoal":"说明省力杠杆的力臂特点并识别典型工具。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p9-lever-classification-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b999fb3f","learningSignature":"7548bd7d"}]