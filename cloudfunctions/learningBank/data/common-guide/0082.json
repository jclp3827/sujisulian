[{"id":"physics::effort-costing-lever","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"费力杠杆","content":"费力杠杆的动力臂短于阻力臂，因此平衡时需要较大动力，但常能换取更大的移动距离或操作便利。镊子、鱼竿和筷子是典型应用。","label":"费力杠杆","note":"费力杠杆的动力臂短于阻力臂，因此平衡时需要较大动力，但常能换取更大的移动距离或操作便利。镊子、鱼竿和筷子是典型应用。","learningGoal":"说明费力杠杆的力臂特点并识别典型工具。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p9-lever-classification-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"3f2fda10","learningSignature":"b207f315"},{"id":"physics::equal-arm-lever","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"等臂杠杆","content":"等臂杠杆的动力臂等于阻力臂，平衡时动力与阻力大小相等。天平、跷跷板和定滑轮是正文列出的代表。","label":"等臂杠杆","note":"等臂杠杆的动力臂等于阻力臂，平衡时动力与阻力大小相等。天平、跷跷板和定滑轮是正文列出的代表。","learningGoal":"说明等臂杠杆的力臂和力的关系并识别代表装置。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p9-lever-classification-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"db2c7c82","learningSignature":"d6f9274e"},{"id":"physics::lever-type-comparison","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"三类杠杆怎样比较","content":"动力臂大于阻力臂时属于省力杠杆，小于阻力臂时属于费力杠杆，等于阻力臂时属于等臂杠杆。分类依据是力臂关系，不是工具名称本身。","label":"三类杠杆怎样比较","note":"动力臂大于阻力臂时属于省力杠杆，小于阻力臂时属于费力杠杆，等于阻力臂时属于等臂杠杆。分类依据是力臂关系，不是工具名称本身。","learningGoal":"判断动力臂与阻力臂的关系并确定杠杆类型。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p9-lever-classification-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"1755aff5","learningSignature":"adfb3b02"},{"id":"physics::overweight-condition","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"超重取决于向上加速度","content":"物体具有向上加速度时，支持物对它的作用力大于重力，表现为超重。向上加速和向下减速都具有向上加速度，因此都可能出现超重。","label":"超重取决于向上加速度","note":"物体具有向上加速度时，支持物对它的作用力大于重力，表现为超重。向上加速和向下减速都具有向上加速度，因此都可能出现超重。","learningGoal":"判断加速度方向并识别超重状态。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p9-overweight-weightlessness-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"42995fbc","learningSignature":"3e3ab636"},{"id":"physics::weightlessness-condition","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"失重取决于向下加速度","content":"物体具有向下加速度时，支持力小于重力，表现为失重；完全失重是支持力降为零的特殊情况。判断失重应看加速度方向，不能只看物体正在上升还是下降。","label":"失重取决于向下加速度","note":"物体具有向下加速度时，支持力小于重力，表现为失重；完全失重是支持力降为零的特殊情况。判断失重应看加速度方向，不能只看物体正在上升还是下降。","learningGoal":"判断加速度方向并区分失重与完全失重。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p9-overweight-weightlessness-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b3c961b8","learningSignature":"37c768ad"}]