[{"id":"physics::flagpole-fixed-pulley","scope":"science-technology","groupId":"physics","groupTitle":"经典力学","groupTakeaway":"经典力学研究力与物体运动状态变化的关系。本组从力和牛顿三定律出发，再展开摩擦、杠杆、超重失重、浮力以及生活中的向心力和滑轮应用。","title":"旗杆顶部使用定滑轮","content":"旗杆顶部安装定滑轮可以改变拉力方向，使人在地面向下拉绳就能升起旗帜。理想定滑轮不省力，其主要作用是改变用力方向。","label":"旗杆顶部使用定滑轮","note":"旗杆顶部安装定滑轮可以改变拉力方向，使人在地面向下拉绳就能升起旗帜。理想定滑轮不省力，其主要作用是改变用力方向。","learningGoal":"说明旗杆使用定滑轮的主要作用。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"physics","tabId":"other-mechanics","sourceUnitIds":["cs-16-22-p10-life-mechanics-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=physics&tabId=other-mechanics","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"e3363579","learningSignature":"bad3f26f"},{"id":"chemistry::classification-framework","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"物质分类的两级框架","content":"第一层看由几种物质组成，区分纯净物和混合物；纯净物内部再看由几种元素组成，区分单质和化合物。两个层级的判断标准不同。","label":"物质分类的两级框架","note":"第一层看由几种物质组成，区分纯净物和混合物；纯净物内部再看由几种元素组成，区分单质和化合物。两个层级的判断标准不同。","learningGoal":"说明物质分类两级框架及各自判断标准。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"pure-substance","sourceUnitIds":["cs-16-22-p16-pure-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=pure-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"37cbff8b","learningSignature":"5f81a21c"},{"id":"chemistry::pure-substance-definition","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"纯净物的判断标准","content":"纯净物由一种物质组成。判断时看物质种类是否单一，而不是看其中只含一种元素；由多种元素组成的化合物也可以是纯净物。","label":"纯净物的判断标准","note":"纯净物由一种物质组成。判断时看物质种类是否单一，而不是看其中只含一种元素；由多种元素组成的化合物也可以是纯净物。","learningGoal":"判断一种材料是否满足纯净物定义。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"pure-substance","sourceUnitIds":["cs-16-22-p16-pure-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=pure-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"6916b785","learningSignature":"c60aa026"},{"id":"chemistry::pure-not-element-only","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"纯净物不等于只含一种元素","content":"纯净物强调只含一种物质，单质才要求只含同种元素。因此纯净物既包括单质，也包括由多种元素组成的化合物。","label":"纯净物不等于只含一种元素","note":"纯净物强调只含一种物质，单质才要求只含同种元素。因此纯净物既包括单质，也包括由多种元素组成的化合物。","learningGoal":"区分纯净物和单质的判断标准。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"pure-substance","sourceUnitIds":["cs-16-22-p16-pure-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=pure-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"e3196c5e","learningSignature":"67252870"},{"id":"chemistry::mixture-definition","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"混合物的判断标准","content":"混合物由两种或多种物质混合而成。混合后各成分共同存在，因此判断混合物要数物质种类，而不是只数元素种类。","label":"混合物的判断标准","note":"混合物由两种或多种物质混合而成。混合后各成分共同存在，因此判断混合物要数物质种类，而不是只数元素种类。","learningGoal":"判断一种材料是否由多种物质构成。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"chemistry","tabId":"mixture","sourceUnitIds":["cs-16-22-p16-mixture-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=mixture","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"f2d02ff","learningSignature":"a594cc96"}]