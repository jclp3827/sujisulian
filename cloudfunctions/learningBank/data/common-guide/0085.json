[{"id":"chemistry::pure-mixture-contrast","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"纯净物与混合物的区别","content":"只含一种物质的是纯净物，含两种或多种物质的是混合物。二者的分界是组成物质的种类数，与材料看起来是否均匀无直接对应关系。","label":"纯净物与混合物的区别","note":"只含一种物质的是纯净物，含两种或多种物质的是混合物。二者的分界是组成物质的种类数，与材料看起来是否均匀无直接对应关系。","learningGoal":"比较纯净物和混合物的核心区别。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"pure-substance","sourceUnitIds":["cs-16-22-p16-pure-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=pure-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"f4e6c60e","learningSignature":"3eab4616"},{"id":"chemistry::simple-substance-definition","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"单质必须同时满足两个条件","content":"单质是由同种元素组成的纯净物。它必须同时满足元素种类只有一种、物质本身属于纯净物；只满足其中一个条件不能判为单质。","label":"单质必须同时满足两个条件","note":"单质是由同种元素组成的纯净物。它必须同时满足元素种类只有一种、物质本身属于纯净物；只满足其中一个条件不能判为单质。","learningGoal":"说出单质定义中的元素和纯净物条件。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"simple-substance","sourceUnitIds":["cs-16-22-p16-simple-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=simple-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a0db4515","learningSignature":"77e9f1ec"},{"id":"chemistry::simple-within-pure","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"单质属于纯净物","content":"单质是纯净物的下位类别。分类时应先确认材料只含一种物质，再判断它是否只由同种元素组成。","label":"单质属于纯净物","note":"单质是纯净物的下位类别。分类时应先确认材料只含一种物质，再判断它是否只由同种元素组成。","learningGoal":"说明单质与纯净物的包含关系。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"chemistry","tabId":"simple-substance","sourceUnitIds":["cs-16-22-p16-simple-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=simple-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"4440596f","learningSignature":"9ef7883f"},{"id":"chemistry::compound-definition","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"化合物必须含多种元素","content":"化合物是由两种或两种以上元素组成的纯净物。它与单质同属纯净物，但组成元素不少于两种。","label":"化合物必须含多种元素","note":"化合物是由两种或两种以上元素组成的纯净物。它与单质同属纯净物，但组成元素不少于两种。","learningGoal":"说出化合物定义中的元素和纯净物条件。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"chemistry","tabId":"compound","sourceUnitIds":["cs-16-22-p16-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"c4e4fdd","learningSignature":"73698185"},{"id":"chemistry::compound-vs-mixture","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"化合物不等于混合物","content":"化合物虽含多种元素，但只对应一种物质，所以属于纯净物；混合物则含多种物质。元素种类多不能直接推出是混合物。","label":"化合物不等于混合物","note":"化合物虽含多种元素，但只对应一种物质，所以属于纯净物；混合物则含多种物质。元素种类多不能直接推出是混合物。","learningGoal":"区分化合物的多元素组成与混合物的多物质组成。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"compound","sourceUnitIds":["cs-16-22-p16-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"78cdd020","learningSignature":"11ed3931"}]