[{"id":"chemistry::carbon-dioxide-compound","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"二氧化碳属于化合物","content":"二氧化碳由碳、氧两种元素组成，并可作为一种纯净物存在，因此属于化合物。它含碳但仍归入无机化合物的常见例外范围。","label":"二氧化碳属于化合物","note":"二氧化碳由碳、氧两种元素组成，并可作为一种纯净物存在，因此属于化合物。它含碳但仍归入无机化合物的常见例外范围。","learningGoal":"说明二氧化碳的化合物与无机物归属。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"chemistry","tabId":"compound","sourceUnitIds":["cs-16-22-p16-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"df355553"},{"id":"chemistry::sodium-bicarbonate-compound","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"碳酸氢钠属于化合物","content":"碳酸氢钠由多种元素组成且是一种确定物质，因此属于化合物。正文也把碳酸氢盐列入无机化合物范围。","label":"碳酸氢钠属于化合物","note":"碳酸氢钠由多种元素组成且是一种确定物质，因此属于化合物。正文也把碳酸氢盐列入无机化合物范围。","learningGoal":"说明碳酸氢钠的化合物和无机物归属。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"chemistry","tabId":"compound","sourceUnitIds":["cs-16-22-p16-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"885d745a"},{"id":"chemistry::metal-simple-definition","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"金属单质","content":"金属单质是由同种金属元素形成的纯净物。判断时既要确认元素属于金属，也要确认样品只含这一种物质。","label":"金属单质","note":"金属单质是由同种金属元素形成的纯净物。判断时既要确认元素属于金属，也要确认样品只含这一种物质。","learningGoal":"说明金属单质的元素属性和纯净物条件。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"chemistry","tabId":"metal-simple-substance","sourceUnitIds":["cs-16-22-p16-metal-simple-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=metal-simple-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"ca382b24"},{"id":"chemistry::metal-simple-examples","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"金属单质的代表","content":"铜、锌、钠、钾、汞和镉是正文列出的金属单质代表。它们虽然物理状态和性质不同，但都属于金属元素形成的单质。","label":"金属单质的代表","note":"铜、锌、钠、钾、汞和镉是正文列出的金属单质代表。它们虽然物理状态和性质不同，但都属于金属元素形成的单质。","learningGoal":"识别正文列出的金属单质代表。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"chemistry","tabId":"metal-simple-substance","sourceUnitIds":["cs-16-22-p16-metal-simple-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=metal-simple-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"13cc15d2"},{"id":"chemistry::nonmetal-simple-definition","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"非金属单质","content":"非金属单质是由同种非金属元素形成的纯净物。它与金属单质都属于单质，区别在于组成元素的金属或非金属属性。","label":"非金属单质","note":"非金属单质是由同种非金属元素形成的纯净物。它与金属单质都属于单质，区别在于组成元素的金属或非金属属性。","learningGoal":"区分金属单质和非金属单质。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"chemistry","tabId":"nonmetal-simple-substance","sourceUnitIds":["cs-16-22-p16-nonmetal-simple-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=nonmetal-simple-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"35faa8a9"}]