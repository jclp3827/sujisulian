[{"id":"chemistry::nonmetal-simple-examples","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"非金属单质的代表","content":"氢、硼、碳、氮和氧是正文列出的非金属单质代表。分类依据是组成元素的属性，不能仅凭物质在常温下的状态判断。","label":"非金属单质的代表","note":"氢、硼、碳、氮和氧是正文列出的非金属单质代表。分类依据是组成元素的属性，不能仅凭物质在常温下的状态判断。","learningGoal":"识别正文列出的非金属单质代表。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"chemistry","tabId":"nonmetal-simple-substance","sourceUnitIds":["cs-16-22-p16-nonmetal-simple-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=nonmetal-simple-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b8e5809c","learningSignature":"b0a3b5d"},{"id":"chemistry::organic-core","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"有机化合物的基本范围","content":"狭义有机化合物通常是含碳的化合物，并常含氢等元素。但含碳只是必要线索，不是充分条件，因为部分含碳化合物按传统分类属于无机物。","label":"有机化合物的基本范围","note":"狭义有机化合物通常是含碳的化合物，并常含氢等元素。但含碳只是必要线索，不是充分条件，因为部分含碳化合物按传统分类属于无机物。","learningGoal":"判断含碳是否足以确定有机化合物。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"organic-compound","sourceUnitIds":["cs-16-22-p16-organic-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=organic-compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"7f0ba228","learningSignature":"9a7603e"},{"id":"chemistry::organic-life-examples","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"生命体中的有机化合物","content":"脂肪、氨基酸、蛋白质、糖、血红素、叶绿素、酶和激素是正文列出的有机化合物实例。它们可用于识别生命活动中的有机物类别。","label":"生命体中的有机化合物","note":"脂肪、氨基酸、蛋白质、糖、血红素、叶绿素、酶和激素是正文列出的有机化合物实例。它们可用于识别生命活动中的有机物类别。","learningGoal":"识别正文列出的生命体有机化合物实例。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"chemistry","tabId":"organic-compound","sourceUnitIds":["cs-16-22-p16-organic-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=organic-compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"55d55a99","learningSignature":"31ce89c9"},{"id":"chemistry::carbon-oxide-exception","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"碳的氧化物不是有机物","content":"一氧化碳和二氧化碳都含碳，但按传统物质分类属于无机化合物。这个例外说明不能把含碳与有机物直接画等号。","label":"碳的氧化物不是有机物","note":"一氧化碳和二氧化碳都含碳，但按传统物质分类属于无机化合物。这个例外说明不能把含碳与有机物直接画等号。","learningGoal":"说明一氧化碳和二氧化碳的无机物归属。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"chemistry","tabId":"organic-compound","sourceUnitIds":["cs-16-22-p16-organic-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=organic-compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"8e63e767","learningSignature":"d423db85"},{"id":"chemistry::carbonate-exception","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"碳酸及其盐属于无机物","content":"碳酸、碳酸氢盐和碳酸盐虽然都含碳，但按传统分类属于无机化合物。它们是判断含碳物质类别时的重要例外。","label":"碳酸及其盐属于无机物","note":"碳酸、碳酸氢盐和碳酸盐虽然都含碳，但按传统分类属于无机化合物。它们是判断含碳物质类别时的重要例外。","learningGoal":"识别碳酸、碳酸氢盐和碳酸盐的无机物归属。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"chemistry","tabId":"inorganic-compound","sourceUnitIds":["cs-16-22-p16-inorganic-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=inorganic-compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"a93ed58d","learningSignature":"8df2ad50"}]