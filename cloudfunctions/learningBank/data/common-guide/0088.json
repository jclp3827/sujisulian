[{"id":"chemistry::inorganic-core","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"无机化合物的基本范围","content":"无机化合物通常指不属于有机化合物体系的化合物，多数不含碳，但也包括碳的氧化物、碳酸盐等传统无机含碳物质。","label":"无机化合物的基本范围","note":"无机化合物通常指不属于有机化合物体系的化合物，多数不含碳，但也包括碳的氧化物、碳酸盐等传统无机含碳物质。","learningGoal":"概括无机化合物的一般范围和含碳例外。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"inorganic-compound","sourceUnitIds":["cs-16-22-p16-inorganic-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=inorganic-compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"8fa9394b","learningSignature":"14a9f158"},{"id":"chemistry::water-inorganic","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"水属于无机化合物","content":"水是与生命体密切相关的化合物，但仍属于无机化合物。这说明是否与生命体有关不能作为划分有机物和无机物的可靠标准。","label":"水属于无机化合物","note":"水是与生命体密切相关的化合物，但仍属于无机化合物。这说明是否与生命体有关不能作为划分有机物和无机物的可靠标准。","learningGoal":"说明水的无机物归属并排除生命关联判断法。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"inorganic-compound","sourceUnitIds":["cs-16-22-p16-inorganic-compound-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=inorganic-compound","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"b7e2f2d8","learningSignature":"ec52298c"},{"id":"chemistry::classification-sequence","scope":"science-technology","groupId":"chemistry","groupTitle":"物质分类","groupTakeaway":"物质先按组成物质的种类分为纯净物和混合物；纯净物再按组成元素的种类分为单质和化合物。单质可分金属与非金属，化合物还可区分有机和无机。","title":"物质分类的判断顺序","content":"判断物质类别时，先看是一种物质还是多种物质；若为纯净物，再看由一种元素还是多种元素组成；若为化合物，再根据传统范围区分有机与无机。","label":"物质分类的判断顺序","note":"判断物质类别时，先看是一种物质还是多种物质；若为纯净物，再看由一种元素还是多种元素组成；若为化合物，再根据传统范围区分有机与无机。","learningGoal":"运用分层顺序完成物质类别判断。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"chemistry","tabId":"pure-substance","sourceUnitIds":["cs-16-22-p16-pure-substance-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=chemistry&tabId=pure-substance","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"pending-user-sampling","independentFactReview":"pending-independent-review"},"signature":"fcca1fba","learningSignature":"9ff3872c"},{"id":"biology-health::vegetative-organs","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"植物的营养器官","content":"根、茎、叶是植物常见的营养器官，参与吸收、运输和制造有机物等活动。它们与承担繁殖功能的花、果实和种子属于不同的器官类别。","label":"植物的营养器官","note":"根、茎、叶是植物常见的营养器官，参与吸收、运输和制造有机物等活动。它们与承担繁殖功能的花、果实和种子属于不同的器官类别。","learningGoal":"区分植物的营养器官和生殖器官。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"biology-health","tabId":"plants","sourceUnitIds":["cs-16-22-p20-p21-plant-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=plants","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"703d8e05","learningSignature":"b3969f6b"},{"id":"biology-health::reproductive-organs","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"被子植物的生殖器官","content":"花、果实和种子属于被子植物的生殖器官，与根、茎、叶这类营养器官不同。这里的分类针对被子植物，不能推断所有植物都有花和果实。","label":"被子植物的生殖器官","note":"花、果实和种子属于被子植物的生殖器官，与根、茎、叶这类营养器官不同。这里的分类针对被子植物，不能推断所有植物都有花和果实。","learningGoal":"说明被子植物生殖器官的范围和适用对象。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"biology-health","tabId":"plants","sourceUnitIds":["cs-16-22-p20-p21-plant-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=plants","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"34c31c5b","learningSignature":"5dedbb18"}]