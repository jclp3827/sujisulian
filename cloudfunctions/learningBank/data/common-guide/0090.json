[{"id":"biology-health::leaf-water-saving","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"小叶片怎样减少水分散失","content":"植物主要通过叶片气孔进行蒸腾。部分沙漠植物的叶片较小或特化为针状，可减少蒸腾导致的水分散失，有助于适应干旱环境。","label":"小叶片怎样减少水分散失","note":"植物主要通过叶片气孔进行蒸腾。部分沙漠植物的叶片较小或特化为针状，可减少蒸腾导致的水分散失，有助于适应干旱环境。","learningGoal":"说明叶片形态与减少水分散失的关系。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"biology-health","tabId":"plants","sourceUnitIds":["cs-16-22-p20-p21-plant-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=plants","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"e9a2ecaa","learningSignature":"ba2d5ac0"},{"id":"biology-health::vertebrate-classification","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"有无脊柱怎样区分动物","content":"按有无脊柱，可把动物分为脊椎动物和无脊椎动物。鱼类、两栖类、爬行类、鸟类和哺乳类属于脊椎动物，分类依据不在于生活在水中还是陆地。","label":"有无脊柱怎样区分动物","note":"按有无脊柱，可把动物分为脊椎动物和无脊椎动物。鱼类、两栖类、爬行类、鸟类和哺乳类属于脊椎动物，分类依据不在于生活在水中还是陆地。","learningGoal":"说明脊椎动物的分类依据与主要类别。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"biology-health","tabId":"animals","sourceUnitIds":["cs-16-22-p21-animal-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=animals","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"179ec46b","learningSignature":"3f4c0392"},{"id":"biology-health::amphibian-breathing","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"以青蛙为例理解两栖动物呼吸","content":"青蛙幼体蝌蚪生活在水中，主要用鳃呼吸；成体主要用肺呼吸，皮肤也能辅助气体交换。这里描述典型生活史，不能推为所有两栖动物都完全相同。","label":"以青蛙为例理解两栖动物呼吸","note":"青蛙幼体蝌蚪生活在水中，主要用鳃呼吸；成体主要用肺呼吸，皮肤也能辅助气体交换。这里描述典型生活史，不能推为所有两栖动物都完全相同。","learningGoal":"说明典型两栖动物不同发育阶段的呼吸方式。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"biology-health","tabId":"animals","sourceUnitIds":["cs-16-22-p21-animal-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=animals","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"5ca6a3b4","learningSignature":"cd4cd8f0"},{"id":"biology-health::amphibian-examples","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"两栖动物的代表","content":"青蛙、蟾蜍、大鲵和蝾螈属于两栖动物。大鲵俗称娃娃鱼，但名称中带有鱼字不代表它属于鱼类。","label":"两栖动物的代表","note":"青蛙、蟾蜍、大鲵和蝾螈属于两栖动物。大鲵俗称娃娃鱼，但名称中带有鱼字不代表它属于鱼类。","learningGoal":"识别两栖动物并区分俗名和分类。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"biology-health","tabId":"animals","sourceUnitIds":["cs-16-22-p21-animal-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=animals","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"ceb58f57","learningSignature":"40b07f9"},{"id":"biology-health::reptile-features","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"爬行动物的呼吸与体温","content":"爬行动物用肺呼吸，通常属于变温动物，体温随环境条件变化。鳄鱼、蛇、蜥蜴和龟都属于爬行动物，不能因龟可入水就将它归为两栖动物。","label":"爬行动物的呼吸与体温","note":"爬行动物用肺呼吸，通常属于变温动物，体温随环境条件变化。鳄鱼、蛇、蜥蜴和龟都属于爬行动物，不能因龟可入水就将它归为两栖动物。","learningGoal":"说明爬行动物的基本特征并识别代表。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"biology-health","tabId":"animals","sourceUnitIds":["cs-16-22-p21-animal-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=animals","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"91e10ab5","learningSignature":"cb9276c8"}]