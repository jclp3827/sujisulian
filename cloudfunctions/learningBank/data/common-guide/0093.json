[{"id":"biology-health::lactic-acid-fermentation","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"产生乳酸的代谢过程","content":"乳酸菌可通过乳酸发酵分解糖并获得能量，动物细胞在缺氧条件下也可通过乳酸发酵补充能量。这类过程的典型产物是乳酸，不是酒精。","label":"产生乳酸的代谢过程","note":"乳酸菌可通过乳酸发酵分解糖并获得能量，动物细胞在缺氧条件下也可通过乳酸发酵补充能量。这类过程的典型产物是乳酸，不是酒精。","learningGoal":"区分乳酸型代谢与酒精发酵的典型产物。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"biology-health","tabId":"biological-metabolism","sourceUnitIds":["cs-16-22-p21-metabolism-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=biological-metabolism","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"41d3fadb","learningSignature":"3654cb0f"},{"id":"biology-health::yeast-alcohol-fermentation","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"酵母菌的酒精发酵","content":"酵母菌在适宜的缺氧条件下可进行酒精发酵，典型产物是酒精和二氧化碳。它与乳酸菌的乳酸发酵在产物上不同。","label":"酵母菌的酒精发酵","note":"酵母菌在适宜的缺氧条件下可进行酒精发酵，典型产物是酒精和二氧化碳。它与乳酸菌的乳酸发酵在产物上不同。","learningGoal":"识别酵母菌酒精发酵的典型产物。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"biology-health","tabId":"biological-metabolism","sourceUnitIds":["cs-16-22-p21-metabolism-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=biological-metabolism","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"f1666560","learningSignature":"8e35a74b"},{"id":"biology-health::transpiration-process","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"蒸腾作用是水分散失过程","content":"蒸腾作用是水分从活的植物体表面以水蒸气形式散失到大气中的过程，主要通过叶片进行。它属于水分运输与散失过程，不能与光合作用制造有机物混淆。","label":"蒸腾作用是水分散失过程","note":"蒸腾作用是水分从活的植物体表面以水蒸气形式散失到大气中的过程，主要通过叶片进行。它属于水分运输与散失过程，不能与光合作用制造有机物混淆。","learningGoal":"区分蒸腾作用与光合作用的主要过程。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"biology-health","tabId":"biological-metabolism","sourceUnitIds":["cs-16-22-p21-metabolism-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=biological-metabolism","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"48b5801","learningSignature":"b14ee2c0"},{"id":"biology-health::transpiration-functions","scope":"science-technology","groupId":"biology-health","groupTitle":"生物","groupTakeaway":"生物基础包括植物的器官和种子结构、动物的主要类群、遗传物质及代谢活动。知识卡分别说明结构、分类依据和过程，并保留典型实例及必要例外。","title":"蒸腾作用的运输与降温作用","content":"蒸腾使植物表面的水分不断散失，可形成促进根部吸水和向上运输的拉力。水分蒸发还带走热量，因此蒸腾也能帮助降低叶片温度。","label":"蒸腾作用的运输与降温作用","note":"蒸腾使植物表面的水分不断散失，可形成促进根部吸水和向上运输的拉力。水分蒸发还带走热量，因此蒸腾也能帮助降低叶片温度。","learningGoal":"说明蒸腾作用对水分运输和叶片温度的影响。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"biology-health","tabId":"biological-metabolism","sourceUnitIds":["cs-16-22-p21-metabolism-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biology-health&tabId=biological-metabolism","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"301c7e98","learningSignature":"2b1c22d3"},{"id":"life-safety::selection-criteria","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"选择灭火器先看什么","content":"选择灭火器要同时看燃烧物类型、是否带电以及产品标识允许的用途。同叫干粉或泡沫的产品，药剂和适用范围也可能不同，不能只凭名称判断。","label":"选择灭火器先看什么","note":"选择灭火器要同时看燃烧物类型、是否带电以及产品标识允许的用途。同叫干粉或泡沫的产品，药剂和适用范围也可能不同，不能只凭名称判断。","learningGoal":"说明灭火器选择的三个判断维度。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"977f8caf","learningSignature":"b3e99bb8"}]