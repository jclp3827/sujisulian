[{"id":"life-safety::carbon-dioxide-extinguisher","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"二氧化碳灭火器的用途","content":"二氧化碳灭火器通常以高压液态二氧化碳储存灭火剂，喷出后形成气体及固态微粒。它适用于标识允许的液体及部分带电设备初起火灾，并有灭火残留少的特点。","label":"二氧化碳灭火器的用途","note":"二氧化碳灭火器通常以高压液态二氧化碳储存灭火剂，喷出后形成气体及固态微粒。它适用于标识允许的液体及部分带电设备初起火灾，并有灭火残留少的特点。","learningGoal":"说明二氧化碳灭火器的储存形式和适用边界。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"ad79868f"},{"id":"life-safety::carbon-dioxide-risks","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"二氧化碳灭火器的两类风险","content":"二氧化碳灭火器在狭小空间使用可能造成缺氧窒息，喷筒低温还可能冻伤皮肤。选择它时既要看火灾类型，也要考虑通风和持握方式等使用条件。","label":"二氧化碳灭火器的两类风险","note":"二氧化碳灭火器在狭小空间使用可能造成缺氧窒息，喷筒低温还可能冻伤皮肤。选择它时既要看火灾类型，也要考虑通风和持握方式等使用条件。","learningGoal":"区分二氧化碳灭火器的窒息和冻伤风险。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"88ce68d5"},{"id":"life-safety::bc-dry-powder","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"BC干粉的适用范围","content":"BC型干粉主要用于可燃液体、气体及产品标识允许的带电设备初起火灾，不能直接用于一般固体火灾。碳酸氢钠干粉属于常见BC型。","label":"BC干粉的适用范围","note":"BC型干粉主要用于可燃液体、气体及产品标识允许的带电设备初起火灾，不能直接用于一般固体火灾。碳酸氢钠干粉属于常见BC型。","learningGoal":"识别BC型干粉的用途及固体火灾限制。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"c5d2abae"},{"id":"life-safety::abc-dry-powder","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"ABC干粉的适用范围","content":"ABC型干粉除适用于标识允许的液体、气体和带电设备初起火灾外，还可扑救一般固体火灾。常见ABC型药剂为磷酸铵盐干粉。","label":"ABC干粉的适用范围","note":"ABC型干粉除适用于标识允许的液体、气体和带电设备初起火灾外，还可扑救一般固体火灾。常见ABC型药剂为磷酸铵盐干粉。","learningGoal":"说明ABC型干粉相对于BC型增加的用途。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"cd7d757a"},{"id":"life-safety::powder-type-comparison","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"BC与ABC干粉的关键区别","content":"BC和ABC干粉都不能只凭干粉二字互换使用。对一般固体火灾，ABC型具有相应适用性，而BC型不适用；具体选择仍须核对产品标识。","label":"BC与ABC干粉的关键区别","note":"BC和ABC干粉都不能只凭干粉二字互换使用。对一般固体火灾，ABC型具有相应适用性，而BC型不适用；具体选择仍须核对产品标识。","learningGoal":"比较BC与ABC干粉对一般固体火灾的适用性。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"6a4f5110"}]