[{"id":"life-safety::ordinary-powder-metal-boundary","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"普通干粉不适用于金属火灾","content":"普通BC、ABC干粉不适用于金属燃烧火灾，金属火灾需要相应专用灭火剂。因此不能把普通干粉的用途扩大为能扑灭所有可燃物。","label":"普通干粉不适用于金属火灾","note":"普通BC、ABC干粉不适用于金属燃烧火灾，金属火灾需要相应专用灭火剂。因此不能把普通干粉的用途扩大为能扑灭所有可燃物。","learningGoal":"说明普通干粉与金属火灾专用灭火剂的边界。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"90bc0db1","learningSignature":"789511a3"},{"id":"life-safety::chemical-foam-scope","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"化学泡沫只是一种泡沫配方","content":"硫酸铝与碳酸氢钠溶液反应产生泡沫，属于化学泡沫的一种制备方式。泡沫灭火产品还有其他配方，不能把这两种药剂当作全部泡沫灭火器的定义。","label":"化学泡沫只是一种泡沫配方","note":"硫酸铝与碳酸氢钠溶液反应产生泡沫，属于化学泡沫的一种制备方式。泡沫灭火产品还有其他配方，不能把这两种药剂当作全部泡沫灭火器的定义。","learningGoal":"区分化学泡沫配方与泡沫灭火产品总类。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"47362ba8","learningSignature":"3316e036"},{"id":"life-safety::ordinary-foam-scope","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"普通泡沫的用途与限制","content":"普通泡沫可用于标识允许的一般固体和非水溶性可燃液体火灾，但不适用于水溶性可燃液体。选择泡沫时，液体是否溶于水是重要条件。","label":"普通泡沫的用途与限制","note":"普通泡沫可用于标识允许的一般固体和非水溶性可燃液体火灾，但不适用于水溶性可燃液体。选择泡沫时，液体是否溶于水是重要条件。","learningGoal":"判断普通泡沫是否适用于水溶性液体火灾。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"40fa8dfb","learningSignature":"be903f35"},{"id":"life-safety::alcohol-resistant-foam","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"抗溶泡沫与水溶性液体","content":"水溶性可燃液体火灾需要选择明确适用的抗溶泡沫产品。抗溶型与普通泡沫的适用范围不同，不能因为都叫泡沫就将二者混用。","label":"抗溶泡沫与水溶性液体","note":"水溶性可燃液体火灾需要选择明确适用的抗溶泡沫产品。抗溶型与普通泡沫的适用范围不同，不能因为都叫泡沫就将二者混用。","learningGoal":"说明抗溶泡沫相对于普通泡沫的适用特点。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"37bc96f1","learningSignature":"45dc0f22"},{"id":"life-safety::foam-live-equipment","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"普通泡沫不用于带电设备","content":"普通泡沫不应用于仍带电的设备和忌水物质火灾。灭火剂能否使用必须同时考虑燃烧物与带电状态，不能只看火焰是否能被覆盖。","label":"普通泡沫不用于带电设备","note":"普通泡沫不应用于仍带电的设备和忌水物质火灾。灭火剂能否使用必须同时考虑燃烧物与带电状态，不能只看火焰是否能被覆盖。","learningGoal":"识别普通泡沫对带电设备和忌水物质的限制。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"b2b9d37","learningSignature":"b9c51efc"}]