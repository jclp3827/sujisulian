[{"id":"life-safety::aim-at-burning-material","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"干粉为何射向燃烧部位","content":"常见手提式干粉灭火器按说明书射向燃烧部位或火焰根部，是为了让灭火剂作用于燃烧物并抑制燃烧。这与内焰温度较低没有直接因果关系。","label":"干粉为何射向燃烧部位","note":"常见手提式干粉灭火器按说明书射向燃烧部位或火焰根部，是为了让灭火剂作用于燃烧物并抑制燃烧。这与内焰温度较低没有直接因果关系。","learningGoal":"说明干粉射向燃烧部位的目的。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"9a042453"},{"id":"life-safety::liquid-fire-splash-risk","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"液体火灾应避免喷流冲击液面","content":"扑救液体初起火灾时，喷流直接冲击液面可能使燃烧液体飞溅、扩大火势。应按具体灭火器说明书操作，无法安全控制时及时撤离报警。","label":"液体火灾应避免喷流冲击液面","note":"扑救液体初起火灾时，喷流直接冲击液面可能使燃烧液体飞溅、扩大火势。应按具体灭火器说明书操作，无法安全控制时及时撤离报警。","learningGoal":"说明液体火灾中直接冲击液面的危险。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"d9d7aa17"},{"id":"life-safety::equipment-contamination","scope":"science-technology","groupId":"life-safety","groupTitle":"灭火器","groupTakeaway":"灭火器依药剂和适用火灾分类。学习时需分清二氧化碳、普通与抗溶泡沫、BC与ABC干粉，再结合带电、污染和现场环境判断使用边界。","title":"灭火残留与精密设备","content":"二氧化碳灭火残留较少，普通干粉则可能污染精密设备。选型除了要能控制相应火灾，还应考虑设备保护和使用环境，不能把灭火效能当作全部条件。","label":"灭火残留与精密设备","note":"二氧化碳灭火残留较少，普通干粉则可能污染精密设备。选型除了要能控制相应火灾，还应考虑设备保护和使用环境，不能把灭火效能当作全部条件。","learningGoal":"比较二氧化碳与普通干粉的残留污染特点。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"life-safety","tabId":"fire-extinguisher-table","sourceUnitIds":["cs-16-22-p26-fire-extinguisher-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=life-safety&tabId=fire-extinguisher-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"32127cbe"},{"id":"safety-common-sense::pan-fire-cover","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"油锅初起火灾的隔氧原理","content":"油锅初起火灾在能够安全操作时，可关闭热源并用合适锅盖覆盖，使燃烧的油与空气隔开。不能泼水，火势扩大或无法安全接近时应撤离报警。","label":"油锅初起火灾的隔氧原理","note":"油锅初起火灾在能够安全操作时，可关闭热源并用合适锅盖覆盖，使燃烧的油与空气隔开。不能泼水，火势扩大或无法安全接近时应撤离报警。","learningGoal":"说明油锅盖锅盖灭火的原理和安全前提。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"483b6a27"},{"id":"safety-common-sense::fuse-rated-selection","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"保险丝按额定规格选用","content":"保险丝应按规定型号和额定电流选用，熔断后先排查故障。不能用普通铜丝、铁丝代替，也不能为避免再次熔断而擅自提高额定电流。","label":"保险丝按额定规格选用","note":"保险丝应按规定型号和额定电流选用，熔断后先排查故障。不能用普通铜丝、铁丝代替，也不能为避免再次熔断而擅自提高额定电流。","learningGoal":"识别保险丝更换中的错误替代和超额定做法。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"563c45d6"}]