[{"id":"safety-common-sense::electric-blanket-folding","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"电热毯通电时不能折叠","content":"电热毯通电使用时应保持符合说明书要求的展开状态，不得折叠、卷曲或遮挡散热部位。发现破损、异常发热应停用，避免无人看管长期通电。","label":"电热毯通电时不能折叠","note":"电热毯通电使用时应保持符合说明书要求的展开状态，不得折叠、卷曲或遮挡散热部位。发现破损、异常发热应停用，避免无人看管长期通电。","learningGoal":"识别电热毯通电使用中的主要禁忌。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"7e43e9b2"},{"id":"safety-common-sense::carbon-monoxide-rescuer-safety","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"一氧化碳中毒先保障施救者安全","content":"疑似一氧化碳中毒时，不能盲目进入危险环境。先保障施救者安全，在安全处求助；只有具备安全条件时，才通风或将患者移至空气新鲜处。","label":"一氧化碳中毒先保障施救者安全","note":"疑似一氧化碳中毒时，不能盲目进入危险环境。先保障施救者安全，在安全处求助；只有具备安全条件时，才通风或将患者移至空气新鲜处。","learningGoal":"说明中毒救援中自身安全与通风转移的前提。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"865ffd38"},{"id":"safety-common-sense::coma-not-cpr-indication","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"昏迷不等于需要人工呼吸","content":"昏迷者可能仍有正常呼吸，不能仅凭昏迷就实施人工呼吸。对无反应且无正常呼吸者，应按急救调度指导实施心肺复苏；有正常呼吸者保持气道通畅并等待救治。","label":"昏迷不等于需要人工呼吸","note":"昏迷者可能仍有正常呼吸，不能仅凭昏迷就实施人工呼吸。对无反应且无正常呼吸者，应按急救调度指导实施心肺复苏；有正常呼吸者保持气道通畅并等待救治。","learningGoal":"区分昏迷与无反应且无正常呼吸两种处置条件。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"7c8b36aa"},{"id":"safety-common-sense::gas-leak-spark-risk","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"疑有燃气泄漏要避免火花","content":"疑有燃气泄漏时，要避免明火以及开关电器产生火花。中毒救援和防止燃烧爆炸是相关但不同的问题，求助应在安全地点进行。","label":"疑有燃气泄漏要避免火花","note":"疑有燃气泄漏时，要避免明火以及开关电器产生火花。中毒救援和防止燃烧爆炸是相关但不同的问题，求助应在安全地点进行。","learningGoal":"识别疑似燃气泄漏场景中需要避免的点火源。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"ab2c406d"},{"id":"safety-common-sense::fire-route-risk-assessment","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"火灾撤离先判断通道风险","content":"居民楼起火时，应结合门的温度、烟气和疏散通道状态判断退路是否安全。不能把着火层、上层、下层的固定顺序当成所有建筑通用的个人逃生规则。","label":"火灾撤离先判断通道风险","note":"居民楼起火时，应结合门的温度、烟气和疏散通道状态判断退路是否安全。不能把着火层、上层、下层的固定顺序当成所有建筑通用的个人逃生规则。","learningGoal":"说明火灾避险应按现场条件判断的原因。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"4dad9e57"}]