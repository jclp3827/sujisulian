[{"id":"safety-common-sense::fire-smoke-blocked-exit","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"烟气阻断退路时不能盲目冲出","content":"具备安全条件时按疏散指引撤离；门外高温或浓烟阻断退路时，不能盲目冲入，应关门避烟、报警待援。撤离时不乘普通电梯，不贪恋财物。","label":"烟气阻断退路时不能盲目冲出","note":"具备安全条件时按疏散指引撤离；门外高温或浓烟阻断退路时，不能盲目冲入，应关门避烟、报警待援。撤离时不乘普通电梯，不贪恋财物。","learningGoal":"区分安全撤离与烟气阻断时待援的条件。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"e40e5fe8","learningSignature":"c7088ebb"},{"id":"safety-common-sense::lightning-shelter","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"雷雨优先选择合适避险场所","content":"雷雨中应优先进入有防雷设施的建筑物或封闭车辆，远离孤立高物、树木、水边和金属设施。随意钻入积水坑、沟渠并不等于安全避雷。","label":"雷雨优先选择合适避险场所","note":"雷雨中应优先进入有防雷设施的建筑物或封闭车辆，远离孤立高物、树木、水边和金属设施。随意钻入积水坑、沟渠并不等于安全避雷。","learningGoal":"识别雷雨中的合适避险场所与危险位置。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"cfdd313b","learningSignature":"5a117ab9"},{"id":"safety-common-sense::lightning-emergency-posture","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"空旷处来不及避雷时的姿势","content":"在空旷地带来不及进入安全场所时，可双脚并拢蹲下，以降低身体高度和跨步电压风险。不能躺倒，蹲下也不能替代及时进入合适避险场所。","label":"空旷处来不及避雷时的姿势","note":"在空旷地带来不及进入安全场所时，可双脚并拢蹲下，以降低身体高度和跨步电压风险。不能躺倒，蹲下也不能替代及时进入合适避险场所。","learningGoal":"说明紧急避雷姿势及其适用边界。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"af006b63","learningSignature":"94d7b674"},{"id":"safety-common-sense::earthquake-shelter-then-evacuate","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"地震强烈摇晃时就近避险","content":"地震强烈摇晃时应就近寻求结实遮挡、护住头颈，避开玻璃和易倒物；摇晃停止后按指引疏散到开阔地。不要仅因楼层低就在强震中向外奔跑。","label":"地震强烈摇晃时就近避险","note":"地震强烈摇晃时应就近寻求结实遮挡、护住头颈，避开玻璃和易倒物；摇晃停止后按指引疏散到开阔地。不要仅因楼层低就在强震中向外奔跑。","learningGoal":"区分震时就近避险与震后疏散的时机。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"49c94461","learningSignature":"ac5038e3"},{"id":"safety-common-sense::flood-stable-high-ground","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"洪水受困向稳固高处避险","content":"洪水来袭应按预警及时转移；来不及撤离时，向稳固高处避险并等待救援。不能为赶往高处而涉险穿越急流，转移路线也需要安全条件。","label":"洪水受困向稳固高处避险","note":"洪水来袭应按预警及时转移；来不及撤离时，向稳固高处避险并等待救援。不能为赶往高处而涉险穿越急流，转移路线也需要安全条件。","learningGoal":"说明洪水转移与受困待援的安全边界。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"b9d4aa9b","learningSignature":"fadae30d"}]