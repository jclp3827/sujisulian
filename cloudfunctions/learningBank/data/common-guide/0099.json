[{"id":"safety-common-sense::debris-flow-sideways","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"泥石流向两侧稳固高坡撤离","content":"发现泥石流来袭，应向与流动方向大致垂直的两侧稳固高坡撤离，不沿沟道往上游或下游跑。树上、洞穴和不稳巨石下都不是可靠避险位置。","label":"泥石流向两侧稳固高坡撤离","note":"发现泥石流来袭，应向与流动方向大致垂直的两侧稳固高坡撤离，不沿沟道往上游或下游跑。树上、洞穴和不稳巨石下都不是可靠避险位置。","learningGoal":"识别泥石流撤离方向及不可靠躲避位置。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"67f16878","learningSignature":"b4c94758"},{"id":"safety-common-sense::typhoon-preparation-timing","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"台风加固应在风雨到来之前","content":"台风来临前关注预警，在安全条件下加固门窗、收妥易坠物并准备应急物资。危险地区按通知及时转移，不应等到大风暴雨中再到室外加固。","label":"台风加固应在风雨到来之前","note":"台风来临前关注预警，在安全条件下加固门窗、收妥易坠物并准备应急物资。危险地区按通知及时转移，不应等到大风暴雨中再到室外加固。","learningGoal":"说明台风准备与转移的时机。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"7de459b5","learningSignature":"e98e5418"},{"id":"safety-common-sense::typhoon-secondary-hazards","scope":"science-technology","groupId":"safety-common-sense","groupTitle":"安全常识","groupTakeaway":"安全常识涉及家居防火、中毒救援和自然灾害。不同情形需要不同措施，但都要先判断自身安全及现场条件，再区分撤离、待援和适用的处置动作。","title":"台风还可能引发次生灾害","content":"台风风险不仅来自大风，还包括强降雨引起的洪水、滑坡和泥石流。避险时要同时关注这些灾害预警，减少外出并服从当地转移指引。","label":"台风还可能引发次生灾害","note":"台风风险不仅来自大风，还包括强降雨引起的洪水、滑坡和泥石流。避险时要同时关注这些灾害预警，减少外出并服从当地转移指引。","learningGoal":"识别台风相关的主要次生灾害。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"safety-common-sense","tabId":"safety-common-sense-table","sourceUnitIds":["cs-16-22-p26-p27-safety-common-sense-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=safety-common-sense&tabId=safety-common-sense-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed-with-official-corrections","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"88c0aa8c","learningSignature":"5e02c92e"},{"id":"other-life-common-sense::gum-cooling","scope":"science-technology","groupId":"other-life-common-sense","groupTitle":"其他常识","groupTakeaway":"生活中的一些现象可由温度、气压、挥发或生物行为解释。本组保留能讲清直接原因的衣物、出行和动物行为实例，排除缺少条件的最佳做法与未经核实的身体结构断言。","title":"冷冻后较易去除口香糖","content":"口香糖经冷冻后会变硬、变脆，因而较容易从衣物上轻轻剥离。这是利用温度改变黏附状态；实际处理还要考虑衣物材质是否允许冷冻和轻搓。","label":"冷冻后较易去除口香糖","note":"口香糖经冷冻后会变硬、变脆，因而较容易从衣物上轻轻剥离。这是利用温度改变黏附状态；实际处理还要考虑衣物材质是否允许冷冻和轻搓。","learningGoal":"说明冷冻帮助去除口香糖的物理原因。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"other-life-common-sense","tabId":"life-clothing-travel","sourceUnitIds":["cs-16-22-p27-life-gum-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=other-life-common-sense&tabId=life-clothing-travel","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"5ad4e7bb","learningSignature":"756a0a7"},{"id":"other-life-common-sense::flight-pressure","scope":"science-technology","groupId":"other-life-common-sense","groupTitle":"其他常识","groupTakeaway":"生活中的一些现象可由温度、气压、挥发或生物行为解释。本组保留能讲清直接原因的衣物、出行和动物行为实例，排除缺少条件的最佳做法与未经核实的身体结构断言。","title":"飞机升降时咀嚼与气压变化","content":"飞机升降时外界气压变化可能引起耳部不适，咀嚼、吞咽有助于耳内外压力平衡。这是与气压差有关的现象，不能理解为口香糖本身具有药物作用。","label":"飞机升降时咀嚼与气压变化","note":"飞机升降时外界气压变化可能引起耳部不适，咀嚼、吞咽有助于耳内外压力平衡。这是与气压差有关的现象，不能理解为口香糖本身具有药物作用。","learningGoal":"说明飞机升降时咀嚼动作与气压差的关系。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"other-life-common-sense","tabId":"life-clothing-travel","sourceUnitIds":["cs-16-22-p27-life-flight-gum-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=other-life-common-sense&tabId=life-clothing-travel","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"1d1a1b02","learningSignature":"b81ea268"}]