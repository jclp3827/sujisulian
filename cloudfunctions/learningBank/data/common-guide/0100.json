[{"id":"other-life-common-sense::wine-swirling","scope":"science-technology","groupId":"other-life-common-sense","groupTitle":"其他常识","groupTakeaway":"生活中的一些现象可由温度、气压、挥发或生物行为解释。本组保留能讲清直接原因的衣物、出行和动物行为实例，排除缺少条件的最佳做法与未经核实的身体结构断言。","title":"摇杯为什么有助于散香","content":"摇动酒杯会增加酒液与空气的接触并促进挥发，使香气更容易散发，同时也会影响氧化过程。该解释针对物理化学现象，不表示摇得越久品质就越好。","label":"摇杯为什么有助于散香","note":"摇动酒杯会增加酒液与空气的接触并促进挥发，使香气更容易散发，同时也会影响氧化过程。该解释针对物理化学现象，不表示摇得越久品质就越好。","learningGoal":"说明摇杯与接触空气、香气挥发的关系。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"other-life-common-sense","tabId":"life-food","sourceUnitIds":["cs-16-22-p27-life-wine-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=other-life-common-sense&tabId=life-food","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"6ee18f5c","learningSignature":"bb4ab26c"},{"id":"other-life-common-sense::blinking-protection","scope":"science-technology","groupId":"other-life-common-sense","groupTitle":"其他常识","groupTakeaway":"生活中的一些现象可由温度、气压、挥发或生物行为解释。本组保留能讲清直接原因的衣物、出行和动物行为实例，排除缺少条件的最佳做法与未经核实的身体结构断言。","title":"眨眼的保护作用","content":"眨眼能帮助泪液铺展，使眼表保持湿润并减少摩擦，是眼睛的自我保护活动。它既涉及湿润，也有助于维持眼表的清洁和舒适。","label":"眨眼的保护作用","note":"眨眼能帮助泪液铺展，使眼表保持湿润并减少摩擦，是眼睛的自我保护活动。它既涉及湿润，也有助于维持眼表的清洁和舒适。","learningGoal":"说明眨眼对湿润和减少摩擦的作用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"other-life-common-sense","tabId":"life-animal-behavior","sourceUnitIds":["cs-16-22-p27-life-blink-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=other-life-common-sense&tabId=life-animal-behavior","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"92e2b3b4","learningSignature":"a936d699"},{"id":"other-life-common-sense::dragonfly-oviposition","scope":"science-technology","groupId":"other-life-common-sense","groupTitle":"其他常识","groupTakeaway":"生活中的一些现象可由温度、气压、挥发或生物行为解释。本组保留能讲清直接原因的衣物、出行和动物行为实例，排除缺少条件的最佳做法与未经核实的身体结构断言。","title":"蜻蜓点水与产卵","content":"常见的蜻蜓点水是产卵行为，卵可直接进入水中或附着在水草上。这类接触水面的行为服务于繁殖，不能简单解释为蜻蜓在饮水。","label":"蜻蜓点水与产卵","note":"常见的蜻蜓点水是产卵行为，卵可直接进入水中或附着在水草上。这类接触水面的行为服务于繁殖，不能简单解释为蜻蜓在饮水。","learningGoal":"识别蜻蜓点水的典型生物学含义。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"other-life-common-sense","tabId":"life-animal-behavior","sourceUnitIds":["cs-16-22-p27-life-dragonfly-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=other-life-common-sense&tabId=life-animal-behavior","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"6c9193a","learningSignature":"b49c322f"},{"id":"biotech-new-energy::biotechnology-fields","scope":"science-technology","groupId":"biotech-new-energy","groupTitle":"生物技术","groupTakeaway":"生物技术综合运用生命科学方法服务生产。基因、细胞、发酵和酶工程是代表方向，应先分清各自的主要操作对象，再理解它们之间的配合。","title":"生物技术的四类代表工程","content":"基因工程、细胞工程、发酵工程和酶工程是生物技术的四类代表。它们分别侧重遗传信息、细胞操作、微生物生产过程和酶催化，具体技术可以相互配合。","label":"生物技术的四类代表工程","note":"基因工程、细胞工程、发酵工程和酶工程是生物技术的四类代表。它们分别侧重遗传信息、细胞操作、微生物生产过程和酶催化，具体技术可以相互配合。","learningGoal":"区分四类生物技术的主要操作对象。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"biotech-new-energy","tabId":"biotechnology-overview","sourceUnitIds":["cs-16-22-p28-biotechnology-overview-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=biotech-new-energy&tabId=biotechnology-overview","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"4f5e9433","learningSignature":"9b1f7334"},{"id":"gene-engineering::recombinant-dna","scope":"science-technology","groupId":"gene-engineering","groupTitle":"基因工程","groupTakeaway":"基因工程以遗传信息操作为重点，DNA重组是代表技术。农业和医学是其应用方向，蛋白质工程则利用相关技术进一步面向蛋白质性能改进。","title":"基因工程与DNA重组","content":"基因工程以DNA重组等操作为代表，通过操作遗传信息获得需要的生物学功能。它以基因为主要对象，与直接操作细胞的细胞工程侧重点不同。","label":"基因工程与DNA重组","note":"基因工程以DNA重组等操作为代表，通过操作遗传信息获得需要的生物学功能。它以基因为主要对象，与直接操作细胞的细胞工程侧重点不同。","learningGoal":"说明基因工程的操作对象和代表技术。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"gene-engineering","tabId":"gene-definition","sourceUnitIds":["cs-16-22-p28-gene-engineering-definition-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=gene-engineering&tabId=gene-definition","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"82c765aa","learningSignature":"2ea6570b"}]