[{"id":"gene-engineering::gene-applications","scope":"science-technology","groupId":"gene-engineering","groupTitle":"基因工程","groupTakeaway":"基因工程以遗传信息操作为重点，DNA重组是代表技术。农业和医学是其应用方向，蛋白质工程则利用相关技术进一步面向蛋白质性能改进。","title":"基因工程的农业和医学应用","content":"转基因农作物和基因治疗是基因工程的应用方向，分别面向农业性状改良和特定疾病研究、治疗。医学用途需要具体技术与适应证，不能推出所有疾病都能用基因治疗。","label":"基因工程的农业和医学应用","note":"转基因农作物和基因治疗是基因工程的应用方向，分别面向农业性状改良和特定疾病研究、治疗。医学用途需要具体技术与适应证，不能推出所有疾病都能用基因治疗。","learningGoal":"识别基因工程的农业和医学应用方向。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"gene-engineering","tabId":"gene-application","sourceUnitIds":["cs-16-22-p28-gene-engineering-application-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=gene-engineering&tabId=gene-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"c21093a1"},{"id":"gene-engineering::protein-engineering-relation","scope":"science-technology","groupId":"gene-engineering","groupTitle":"基因工程","groupTakeaway":"基因工程以遗传信息操作为重点，DNA重组是代表技术。农业和医学是其应用方向，蛋白质工程则利用相关技术进一步面向蛋白质性能改进。","title":"蛋白质工程与基因工程的关系","content":"蛋白质工程在基因工程的基础上发展，利用遗传信息与蛋白质结构、功能的联系改进蛋白质性能。因此两者有技术联系，但讨论的目标层次有所不同。","label":"蛋白质工程与基因工程的关系","note":"蛋白质工程在基因工程的基础上发展，利用遗传信息与蛋白质结构、功能的联系改进蛋白质性能。因此两者有技术联系，但讨论的目标层次有所不同。","learningGoal":"说明蛋白质工程与基因工程的技术联系。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"gene-engineering","tabId":"protein-engineering","sourceUnitIds":["cs-16-22-p28-protein-engineering-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=gene-engineering&tabId=protein-engineering","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"a06a7537"},{"id":"cell-engineering::somatic-cell-hybrid","scope":"science-technology","groupId":"cell-engineering","groupTitle":"细胞工程","groupTakeaway":"细胞工程以细胞层面的操作和培养为重点。体细胞杂交、核移植和干细胞技术是代表方向，学习时要区分操作对象、繁殖方式和研究用途。","title":"体细胞杂交属于细胞工程","content":"体细胞杂交以细胞为操作对象，通过细胞融合等方式结合不同细胞的特点。它属于细胞工程，与把不同植株组织接在一起的嫁接不是同一种技术。","label":"体细胞杂交属于细胞工程","note":"体细胞杂交以细胞为操作对象，通过细胞融合等方式结合不同细胞的特点。它属于细胞工程，与把不同植株组织接在一起的嫁接不是同一种技术。","learningGoal":"识别体细胞杂交的技术类别并与嫁接区分。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"cell-engineering","tabId":"cell-application","sourceUnitIds":["cs-16-22-p28-cell-engineering-application-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=cell-engineering&tabId=cell-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"8484c070"},{"id":"cell-engineering::nuclear-transfer-cloning","scope":"science-technology","groupId":"cell-engineering","groupTitle":"细胞工程","groupTakeaway":"细胞工程以细胞层面的操作和培养为重点。体细胞杂交、核移植和干细胞技术是代表方向，学习时要区分操作对象、繁殖方式和研究用途。","title":"核移植与克隆","content":"核移植技术属于细胞工程，也是建立某些克隆个体的重要途径。它通过转移细胞核实现特定操作，不能据此认为克隆个体的所有性状和经历都会与供体相同。","label":"核移植与克隆","note":"核移植技术属于细胞工程，也是建立某些克隆个体的重要途径。它通过转移细胞核实现特定操作，不能据此认为克隆个体的所有性状和经历都会与供体相同。","learningGoal":"说明核移植的技术归属并限定克隆相同的含义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"cell-engineering","tabId":"cell-application","sourceUnitIds":["cs-16-22-p28-cell-engineering-application-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=cell-engineering&tabId=cell-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"16922980"},{"id":"cell-engineering::stem-cell-direction","scope":"science-technology","groupId":"cell-engineering","groupTitle":"细胞工程","groupTakeaway":"细胞工程以细胞层面的操作和培养为重点。体细胞杂交、核移植和干细胞技术是代表方向，学习时要区分操作对象、繁殖方式和研究用途。","title":"干细胞技术的研究方向","content":"干细胞技术是细胞工程的重要方向，可用于细胞分化、组织修复和再生医学等研究。研究方向不等于任意商业治疗已获验证或批准。","label":"干细胞技术的研究方向","note":"干细胞技术是细胞工程的重要方向，可用于细胞分化、组织修复和再生医学等研究。研究方向不等于任意商业治疗已获验证或批准。","learningGoal":"识别干细胞技术的研究方向与临床准入区别。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"cell-engineering","tabId":"cell-application","sourceUnitIds":["cs-16-22-p28-cell-engineering-application-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=cell-engineering&tabId=cell-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"3402653b"}]