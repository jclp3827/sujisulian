[{"id":"fermentation-engineering::microbial-production","scope":"science-technology","groupId":"fermentation-engineering","groupTitle":"发酵工程","groupTakeaway":"发酵工程通过生产菌与过程控制制造产品。食品中的酵母菌、乳酸菌、霉菌、米曲霉和醋酸菌可作为代表实例，但完整工艺可能包含多类微生物。","title":"发酵工程如何生产产品","content":"发酵工程又称微生物工程，通过选择、研究或改造生产菌，并控制培养和发酵过程，实现产品的规模化生产。它强调菌种、过程条件与工业化三个环节。","label":"发酵工程如何生产产品","note":"发酵工程又称微生物工程，通过选择、研究或改造生产菌，并控制培养和发酵过程，实现产品的规模化生产。它强调菌种、过程条件与工业化三个环节。","learningGoal":"说明发酵工程的菌种和过程控制特点。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"fermentation-engineering","tabId":"fermentation-definition","sourceUnitIds":["cs-16-22-p28-fermentation-engineering-definition-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fermentation-engineering&tabId=fermentation-definition","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"c351abe3"},{"id":"fermentation-engineering::yeast-rice-wine","scope":"science-technology","groupId":"fermentation-engineering","groupTitle":"发酵工程","groupTakeaway":"发酵工程通过生产菌与过程控制制造产品。食品中的酵母菌、乳酸菌、霉菌、米曲霉和醋酸菌可作为代表实例，但完整工艺可能包含多类微生物。","title":"酵母菌与酒酿","content":"酒酿制作涉及酵母菌发酵，是微生物参与食品生产的实例。传统食品可能存在多种微生物共同作用，识别代表菌不等于整个工艺只有一种菌。","label":"酵母菌与酒酿","note":"酒酿制作涉及酵母菌发酵，是微生物参与食品生产的实例。传统食品可能存在多种微生物共同作用，识别代表菌不等于整个工艺只有一种菌。","learningGoal":"识别酒酿发酵中的代表微生物。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"fermentation-engineering","tabId":"fermentation-application","sourceUnitIds":["cs-16-22-p28-fermentation-engineering-application-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fermentation-engineering&tabId=fermentation-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"c36f3882"},{"id":"fermentation-engineering::lactic-fermentation-foods","scope":"science-technology","groupId":"fermentation-engineering","groupTitle":"发酵工程","groupTakeaway":"发酵工程通过生产菌与过程控制制造产品。食品中的酵母菌、乳酸菌、霉菌、米曲霉和醋酸菌可作为代表实例，但完整工艺可能包含多类微生物。","title":"酸奶和泡菜中的乳酸菌","content":"酸奶和泡菜都与乳酸菌发酵有关，但原料、菌群和工艺不同。共同的代表菌类可以帮助识别发酵原理，不能把两种食品的生产条件直接互换。","label":"酸奶和泡菜中的乳酸菌","note":"酸奶和泡菜都与乳酸菌发酵有关，但原料、菌群和工艺不同。共同的代表菌类可以帮助识别发酵原理，不能把两种食品的生产条件直接互换。","learningGoal":"识别酸奶与泡菜共同关联的微生物类群。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"fermentation-engineering","tabId":"fermentation-application","sourceUnitIds":["cs-16-22-p28-fermentation-engineering-application-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fermentation-engineering&tabId=fermentation-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"9142cef8"},{"id":"fermentation-engineering::mold-fermented-tofu","scope":"science-technology","groupId":"fermentation-engineering","groupTitle":"发酵工程","groupTakeaway":"发酵工程通过生产菌与过程控制制造产品。食品中的酵母菌、乳酸菌、霉菌、米曲霉和醋酸菌可作为代表实例，但完整工艺可能包含多类微生物。","title":"腐乳与霉菌发酵","content":"腐乳制作涉及霉菌发酵，是霉菌在食品加工中的应用实例。可用于食品生产的受控菌种，与食品失控霉变并不能等同。","label":"腐乳与霉菌发酵","note":"腐乳制作涉及霉菌发酵，是霉菌在食品加工中的应用实例。可用于食品生产的受控菌种，与食品失控霉变并不能等同。","learningGoal":"区分腐乳受控发酵与一般食物霉变。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"fermentation-engineering","tabId":"fermentation-application","sourceUnitIds":["cs-16-22-p28-fermentation-engineering-application-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fermentation-engineering&tabId=fermentation-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"e3ca686e"},{"id":"fermentation-engineering::soy-sauce-koji","scope":"science-technology","groupId":"fermentation-engineering","groupTitle":"发酵工程","groupTakeaway":"发酵工程通过生产菌与过程控制制造产品。食品中的酵母菌、乳酸菌、霉菌、米曲霉和醋酸菌可作为代表实例，但完整工艺可能包含多类微生物。","title":"酱油生产中的米曲霉","content":"米曲霉是酱油发酵的重要微生物，可通过产生酶参与原料分解。它是代表生产菌，完整工艺还可能有其他微生物参与。","label":"酱油生产中的米曲霉","note":"米曲霉是酱油发酵的重要微生物，可通过产生酶参与原料分解。它是代表生产菌，完整工艺还可能有其他微生物参与。","learningGoal":"识别酱油生产中的代表菌及其作用边界。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"fermentation-engineering","tabId":"fermentation-application","sourceUnitIds":["cs-16-22-p28-fermentation-engineering-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fermentation-engineering&tabId=fermentation-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"d72bb9c0"}]