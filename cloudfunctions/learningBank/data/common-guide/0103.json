[{"id":"fermentation-engineering::vinegar-acetic-bacteria","scope":"science-technology","groupId":"fermentation-engineering","groupTitle":"发酵工程","groupTakeaway":"发酵工程通过生产菌与过程控制制造产品。食品中的酵母菌、乳酸菌、霉菌、米曲霉和醋酸菌可作为代表实例，但完整工艺可能包含多类微生物。","title":"醋生产中的醋酸菌","content":"醋的生产与醋酸菌有关，是发酵工程的食品应用实例。醋酸菌与酒酿关联的酵母菌、酸奶关联的乳酸菌属于不同的代表微生物类群。","label":"醋生产中的醋酸菌","note":"醋的生产与醋酸菌有关，是发酵工程的食品应用实例。醋酸菌与酒酿关联的酵母菌、酸奶关联的乳酸菌属于不同的代表微生物类群。","learningGoal":"区分醋、酒酿和酸奶的代表微生物。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"fermentation-engineering","tabId":"fermentation-application","sourceUnitIds":["cs-16-22-p28-fermentation-engineering-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=fermentation-engineering&tabId=fermentation-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"b900f2ad"},{"id":"enzyme-engineering::enzyme-catalysis","scope":"science-technology","groupId":"enzyme-engineering","groupTitle":"酶工程","groupTakeaway":"酶工程围绕酶的获得、处理和催化应用展开。它可以服务食品、轻工等生产，蛋白酶洗涤剂是日常实例，具体效果仍取决于底物和使用条件。","title":"酶工程的主要工作","content":"酶工程通过分离、提纯、固定化或改造酶，利用其催化功能服务生产。它以酶的催化作用为重点，与以整个微生物生产过程为重点的发酵工程不同。","label":"酶工程的主要工作","note":"酶工程通过分离、提纯、固定化或改造酶，利用其催化功能服务生产。它以酶的催化作用为重点，与以整个微生物生产过程为重点的发酵工程不同。","learningGoal":"区分酶工程与发酵工程的主要操作对象。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"enzyme-engineering","tabId":"enzyme-definition","sourceUnitIds":["cs-16-22-p29-enzyme-engineering-definition-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=enzyme-engineering&tabId=enzyme-definition","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"e7c10a43"},{"id":"enzyme-engineering::protease-detergent","scope":"science-technology","groupId":"enzyme-engineering","groupTitle":"酶工程","groupTakeaway":"酶工程围绕酶的获得、处理和催化应用展开。它可以服务食品、轻工等生产，蛋白酶洗涤剂是日常实例，具体效果仍取决于底物和使用条件。","title":"蛋白酶用于加酶洗涤剂","content":"蛋白酶可用于洗涤剂工业，帮助分解相应的蛋白质污渍。加酶洗衣粉体现了酶催化在日常产品中的应用，不表示一种酶能分解所有类型污渍。","label":"蛋白酶用于加酶洗涤剂","note":"蛋白酶可用于洗涤剂工业，帮助分解相应的蛋白质污渍。加酶洗衣粉体现了酶催化在日常产品中的应用，不表示一种酶能分解所有类型污渍。","learningGoal":"说明蛋白酶在洗涤剂中的应用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"enzyme-engineering","tabId":"enzyme-application","sourceUnitIds":["cs-16-22-p29-enzyme-engineering-application-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=enzyme-engineering&tabId=enzyme-application","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"58543145"},{"id":"current-main-energy::fission-definition","scope":"science-technology","groupId":"current-main-energy","groupTitle":"当前主要能源","groupTakeaway":"核裂变和核聚变通过不同的原子核变化释放能量；太阳能则可经自然过程间接利用或直接转换。本组区分反应原理、发电转换和利用方式，不以实验进展代替商业化结论。","title":"核裂变释放能量","content":"核裂变是较重原子核分裂并释放能量的过程。裂变核电站让链式反应在受控条件下进行，以持续获得热量；它与轻原子核结合的聚变过程不同。","label":"核裂变释放能量","note":"核裂变是较重原子核分裂并释放能量的过程。裂变核电站让链式反应在受控条件下进行，以持续获得热量；它与轻原子核结合的聚变过程不同。","learningGoal":"区分裂变与聚变的原子核变化。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"current-main-energy","tabId":"nuclear-energy","sourceUnitIds":["cs-16-22-p29-nuclear-energy-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=current-main-energy&tabId=nuclear-energy","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"64f5128d"},{"id":"current-main-energy::fission-electricity","scope":"science-technology","groupId":"current-main-energy","groupTitle":"当前主要能源","groupTakeaway":"核裂变和核聚变通过不同的原子核变化释放能量；太阳能则可经自然过程间接利用或直接转换。本组区分反应原理、发电转换和利用方式，不以实验进展代替商业化结论。","title":"裂变核电站的能量转换","content":"裂变核电站先把核能转化为热量，再利用蒸汽推动汽轮机，带动发电机发电。核能到电能之间经过热能和机械能环节，并非原子核直接输出电流。","label":"裂变核电站的能量转换","note":"裂变核电站先把核能转化为热量，再利用蒸汽推动汽轮机，带动发电机发电。核能到电能之间经过热能和机械能环节，并非原子核直接输出电流。","learningGoal":"说明裂变核电站从核能到电能的转换链。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"current-main-energy","tabId":"nuclear-energy","sourceUnitIds":["cs-16-22-p29-nuclear-energy-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=current-main-energy&tabId=nuclear-energy","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"a7f075b"}]