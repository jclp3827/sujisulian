[{"id":"shenzhou-spacecraft::sz20","scope":"science-technology","groupId":"shenzhou-spacecraft","groupTitle":"神舟飞船总结","groupTakeaway":"神舟五号至二十号展示了我国载人航天从首次载人、出舱、交会对接到空间站建造和应用的历史进程。任务年份、乘组和已完成的历史节点分别呈现，动态纪录不作为当前排名。","title":"神舟二十号乘组","content":"2025年，陈冬、陈中瑞、王杰执行神舟二十号任务。陈冬此前参加过神舟十一号和神舟十四号，陈中瑞、王杰为我国第三批航天员。","label":"神舟二十号乘组","note":"2025年，陈冬、陈中瑞、王杰执行神舟二十号任务。陈冬此前参加过神舟十一号和神舟十四号，陈中瑞、王杰为我国第三批航天员。","learningGoal":"识别本次神舟任务的乘组和历史定位。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"shenzhou-spacecraft","tabId":"shenzhou-5-20","sourceUnitIds":["cs-16-22-p31-p32-shenzhou-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=shenzhou-spacecraft&tabId=shenzhou-5-20","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"6768afbc","learningSignature":"2c31536b"},{"id":"satellite-launch-centers::jiuquan","scope":"science-technology","groupId":"satellite-launch-centers","groupTitle":"五大卫星发射中心","groupTakeaway":"不同发射设施承担的代表任务与轨道、地理条件和发射方式有关。本组介绍酒泉、太原、西昌、文昌及东方航天港的特点，不把不同组织形式合并为固定数量排名。","title":"酒泉卫星发射中心","content":"酒泉卫星发射中心承担我国载人航天等发射任务，神舟系列载人飞船从这里发射。它属于航天发射基地，与供航天员在轨工作生活的空间站承担不同任务。","label":"酒泉卫星发射中心","note":"酒泉卫星发射中心承担我国载人航天等发射任务，神舟系列载人飞船从这里发射。它属于航天发射基地，与供航天员在轨工作生活的空间站承担不同任务。","learningGoal":"识别该发射设施的代表任务方向。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"satellite-launch-centers","tabId":"launch-centers-table","sourceUnitIds":["cs-16-22-p32-launch-centers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=satellite-launch-centers&tabId=launch-centers-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"58022624","learningSignature":"dccf1c12"},{"id":"satellite-launch-centers::taiyuan","scope":"science-technology","groupId":"satellite-launch-centers","groupTitle":"五大卫星发射中心","groupTakeaway":"不同发射设施承担的代表任务与轨道、地理条件和发射方式有关。本组介绍酒泉、太原、西昌、文昌及东方航天港的特点，不把不同组织形式合并为固定数量排名。","title":"太原卫星发射中心","content":"太原卫星发射中心承担太阳同步轨道等多类型卫星发射任务，包括气象、资源等中低轨道卫星。其特点应结合任务轨道理解，不能只从城市名称推断用途。","label":"太原卫星发射中心","note":"太原卫星发射中心承担太阳同步轨道等多类型卫星发射任务，包括气象、资源等中低轨道卫星。其特点应结合任务轨道理解，不能只从城市名称推断用途。","learningGoal":"识别该发射设施的代表任务方向。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"satellite-launch-centers","tabId":"launch-centers-table","sourceUnitIds":["cs-16-22-p32-launch-centers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=satellite-launch-centers&tabId=launch-centers-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"732fa566","learningSignature":"c19351a7"},{"id":"satellite-launch-centers::xichang","scope":"science-technology","groupId":"satellite-launch-centers","groupTitle":"五大卫星发射中心","groupTakeaway":"不同发射设施承担的代表任务与轨道、地理条件和发射方式有关。本组介绍酒泉、太原、西昌、文昌及东方航天港的特点，不把不同组织形式合并为固定数量排名。","title":"西昌卫星发射中心","content":"西昌卫星发射中心主要承担地球同步轨道等航天发射任务，广播、通信和气象卫星是代表对象。这里说明的是代表任务方向，不意味着其他中心不能发射相关卫星。","label":"西昌卫星发射中心","note":"西昌卫星发射中心主要承担地球同步轨道等航天发射任务，广播、通信和气象卫星是代表对象。这里说明的是代表任务方向，不意味着其他中心不能发射相关卫星。","learningGoal":"识别该发射设施的代表任务方向。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"satellite-launch-centers","tabId":"launch-centers-table","sourceUnitIds":["cs-16-22-p32-launch-centers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=satellite-launch-centers&tabId=launch-centers-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"de965aeb","learningSignature":"59e140a9"},{"id":"satellite-launch-centers::wenchang","scope":"science-technology","groupId":"satellite-launch-centers","groupTitle":"五大卫星发射中心","groupTakeaway":"不同发射设施承担的代表任务与轨道、地理条件和发射方式有关。本组介绍酒泉、太原、西昌、文昌及东方航天港的特点，不把不同组织形式合并为固定数量排名。","title":"文昌航天发射场","content":"文昌航天发射场是我国低纬度滨海航天发射基地，可承担大吨位空间站舱段和深空探测等任务。滨海位置与内陆发射场不同，是理解其任务条件的重要特征。","label":"文昌航天发射场","note":"文昌航天发射场是我国低纬度滨海航天发射基地，可承担大吨位空间站舱段和深空探测等任务。滨海位置与内陆发射场不同，是理解其任务条件的重要特征。","learningGoal":"识别该发射设施的代表任务方向。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"satellite-launch-centers","tabId":"launch-centers-table","sourceUnitIds":["cs-16-22-p32-launch-centers-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=satellite-launch-centers&tabId=launch-centers-table","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"55425b04","learningSignature":"9c742a0"}]