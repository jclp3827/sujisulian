[{"id":"information-technology-applications::cloud-resource-pool","scope":"science-technology","groupId":"information-technology-applications","groupTitle":"信息技术应用","groupTakeaway":"大数据关注数据集合及处理挑战，云计算提供可按需调度的资源，物联网连接设备与物理世界，人工智能研究机器执行智能任务。数据质量、服务条件和任务边界分别影响这些技术的实际效果。","title":"云计算：按需使用资源池","content":"云计算通过网络按需提供共享的计算资源池，可快速分配和释放资源。资源池、按需服务与弹性是关键特征，成本、可靠性和访问权限仍取决于具体条件。","label":"云计算：按需使用资源池","note":"云计算通过网络按需提供共享的计算资源池，可快速分配和释放资源。资源池、按需服务与弹性是关键特征，成本、可靠性和访问权限仍取决于具体条件。","learningGoal":"说明云计算资源池与按需服务的关系。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"information-technology-applications","tabId":"cloud-computing","sourceUnitIds":["cs-23-30-p2-cloud-computing-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=information-technology-applications&tabId=cloud-computing","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"54db0086","learningSignature":"ef61e2e0"},{"id":"information-technology-applications::cloud-elasticity","scope":"science-technology","groupId":"information-technology-applications","groupTitle":"信息技术应用","groupTakeaway":"大数据关注数据集合及处理挑战，云计算提供可按需调度的资源，物联网连接设备与物理世界，人工智能研究机器执行智能任务。数据质量、服务条件和任务边界分别影响这些技术的实际效果。","title":"云计算的弹性与使用条件","content":"云计算的弹性是根据需求调整所使用的计算、存储等资源，需求降低时也可释放资源。它不表示物理资源没有上限，访问和服务表现还受网络、权限及具体方案约束。","label":"云计算的弹性与使用条件","note":"云计算的弹性是根据需求调整所使用的计算、存储等资源，需求降低时也可释放资源。它不表示物理资源没有上限，访问和服务表现还受网络、权限及具体方案约束。","learningGoal":"说明云资源伸缩的含义和条件。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"information-technology-applications","tabId":"cloud-computing","sourceUnitIds":["cs-23-30-p2-cloud-computing-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=information-technology-applications&tabId=cloud-computing","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"a8cc06d1","learningSignature":"653bfdca"},{"id":"information-technology-applications::iot-devices","scope":"science-technology","groupId":"information-technology-applications","groupTitle":"信息技术应用","groupTakeaway":"大数据关注数据集合及处理挑战，云计算提供可按需调度的资源，物联网连接设备与物理世界，人工智能研究机器执行智能任务。数据质量、服务条件和任务边界分别影响这些技术的实际效果。","title":"物联网：设备感知与数据交换","content":"物联网使设备通过传感、计算与网络连接同物理世界交互并交换数据。传感器、控制器、家用设备等可以成为连接对象，但需要相应设备、接口、协议与网络条件。","label":"物联网：设备感知与数据交换","note":"物联网使设备通过传感、计算与网络连接同物理世界交互并交换数据。传感器、控制器、家用设备等可以成为连接对象，但需要相应设备、接口、协议与网络条件。","learningGoal":"说明物联网连接对象与基本实现条件。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"information-technology-applications","tabId":"internet-of-things","sourceUnitIds":["cs-23-30-p2-iot-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=information-technology-applications&tabId=internet-of-things","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"ce0067db","learningSignature":"c6d9d74b"},{"id":"information-technology-applications::ai-definition","scope":"science-technology","groupId":"information-technology-applications","groupTitle":"信息技术应用","groupTakeaway":"大数据关注数据集合及处理挑战，云计算提供可按需调度的资源，物联网连接设备与物理世界，人工智能研究机器执行智能任务。数据质量、服务条件和任务边界分别影响这些技术的实际效果。","title":"人工智能的研究目标","content":"人工智能是研究如何应用计算机软硬件模拟人类某些智能行为的理论、方法和技术，其目标是让机器完成一些通常需要人类智能才能完成的复杂工作。","label":"人工智能的研究目标","note":"人工智能是研究如何应用计算机软硬件模拟人类某些智能行为的理论、方法和技术，其目标是让机器完成一些通常需要人类智能才能完成的复杂工作。","learningGoal":"说明人工智能的研究对象和任务目标。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"information-technology-applications","tabId":"artificial-intelligence","sourceUnitIds":["cs-23-30-p2-ai-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=information-technology-applications&tabId=artificial-intelligence","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"daeeddec","learningSignature":"8d8e3f80"},{"id":"information-technology-applications::ai-capability-boundary","scope":"science-technology","groupId":"information-technology-applications","groupTitle":"信息技术应用","groupTakeaway":"大数据关注数据集合及处理挑战，云计算提供可按需调度的资源，物联网连接设备与物理世界，人工智能研究机器执行智能任务。数据质量、服务条件和任务边界分别影响这些技术的实际效果。","title":"人工智能能力有任务边界","content":"人工智能可以在特定任务中表现出识别、预测或决策等能力，具体表现取决于所用方法、数据和应用条件。某一任务完成得好，并不能直接推出机器具备人类在各方面的智能。","label":"人工智能能力有任务边界","note":"人工智能可以在特定任务中表现出识别、预测或决策等能力，具体表现取决于所用方法、数据和应用条件。某一任务完成得好，并不能直接推出机器具备人类在各方面的智能。","learningGoal":"区分特定智能任务能力与全面人类智能。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"information-technology-applications","tabId":"artificial-intelligence","sourceUnitIds":["cs-23-30-p2-ai-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=information-technology-applications&tabId=artificial-intelligence","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"c42128ad","learningSignature":"70086cd"}]