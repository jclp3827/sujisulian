[{"id":"market-economy::scarcity-allocation","scope":"economics","groupId":"market-economy","groupTitle":"资源配置的方式","groupTakeaway":"资源配置处理有限资源在不同用途之间的分配，目标是提高资源使用效率。计划安排与市场机制是两种主要配置方式，现实经济可以结合两者的作用。","title":"资源稀缺与资源配置","content":"资源配置是把有限资源分配到不同用途。资源有限而需求多样，意味着一种用途占用资源后，其他用途可用的资源会减少，因此经济活动需要比较用途并提高资源使用效率。","label":"资源稀缺与资源配置","note":"资源配置是把有限资源分配到不同用途。资源有限而需求多样，意味着一种用途占用资源后，其他用途可用的资源会减少，因此经济活动需要比较用途并提高资源使用效率。","learningGoal":"说明资源稀缺为何要求配置资源。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"market-economy","tabId":"resource-allocation-overview","sourceUnitIds":["cs-23-30-p2-resource-allocation-overview-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=market-economy&tabId=resource-allocation-overview","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"7ec7c204","learningSignature":"bbb4775a"},{"id":"market-economy::allocation-two-mechanisms","scope":"economics","groupId":"market-economy","groupTitle":"资源配置的方式","groupTakeaway":"资源配置处理有限资源在不同用途之间的分配，目标是提高资源使用效率。计划安排与市场机制是两种主要配置方式，现实经济可以结合两者的作用。","title":"计划配置与市场配置","content":"现代经济中的资源配置主要有计划配置和市场配置两种方式，也称计划调节和市场调节。两者分别强调计划安排与市场机制的作用，并不意味着现实经济只能采用其中一种。","label":"计划配置与市场配置","note":"现代经济中的资源配置主要有计划配置和市场配置两种方式，也称计划调节和市场调节。两者分别强调计划安排与市场机制的作用，并不意味着现实经济只能采用其中一种。","learningGoal":"说明计划配置与市场配置的含义。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"market-economy","tabId":"resource-allocation-overview","sourceUnitIds":["cs-23-30-p2-resource-allocation-overview-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=market-economy&tabId=resource-allocation-overview","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"be0fe621","learningSignature":"d1affd8c"},{"id":"planned-allocation::planned-definition","scope":"economics","groupId":"planned-allocation","groupTitle":"计划配置","groupTakeaway":"计划配置通过事先制定目标、指标和相应安排影响资源使用。计划机制与政府作用的比喻分别说明调节方式和主体作用，不把所有政府活动等同于直接生产指令。","title":"计划配置是什么","content":"计划配置即计划调节，是指政府计划部门根据社会需要和可能，通过计划机制的作用过程来实现资源配置的方式。","label":"计划配置是什么","note":"计划配置即计划调节，是指政府计划部门根据社会需要和可能，通过计划机制的作用过程来实现资源配置的方式。","learningGoal":"说出计划配置的实施主体与基本方式。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"planned-allocation","tabId":"planned-definition","sourceUnitIds":["cs-23-30-p2-planned-allocation-definition-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=planned-allocation&tabId=planned-definition","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"eba0abd","learningSignature":"8d08ecc4"},{"id":"planned-allocation::planned-mechanism","scope":"economics","groupId":"planned-allocation","groupTitle":"计划配置","groupTakeaway":"计划配置通过事先制定目标、指标和相应安排影响资源使用。计划机制与政府作用的比喻分别说明调节方式和主体作用，不把所有政府活动等同于直接生产指令。","title":"计划机制的构成","content":"计划机制由计划指标、经济杠杆和经济政策等要素相互联系、相互作用形成。它通过事先确定目标和安排调节经济活动，因此具有事前调节的特点。","label":"计划机制的构成","note":"计划机制由计划指标、经济杠杆和经济政策等要素相互联系、相互作用形成。它通过事先确定目标和安排调节经济活动，因此具有事前调节的特点。","learningGoal":"说出计划机制的构成与调节时点。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"planned-allocation","tabId":"planned-mechanism","sourceUnitIds":["cs-23-30-p2-planned-mechanism-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=planned-allocation&tabId=planned-mechanism","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"e2a44ffe","learningSignature":"69b79584"},{"id":"planned-allocation::visible-hand","scope":"economics","groupId":"planned-allocation","groupTitle":"计划配置","groupTakeaway":"计划配置通过事先制定目标、指标和相应安排影响资源使用。计划机制与政府作用的比喻分别说明调节方式和主体作用，不把所有政府活动等同于直接生产指令。","title":"“看得见的手”指什么","content":"“看得见的手”通常用来比喻政府在经济活动中的作用，“看不见的手”通常用来比喻市场机制。政府作用有多种实现方式，不能把一切政府经济活动都等同于直接下达生产指令。","label":"“看得见的手”指什么","note":"“看得见的手”通常用来比喻政府在经济活动中的作用，“看不见的手”通常用来比喻市场机制。政府作用有多种实现方式，不能把一切政府经济活动都等同于直接下达生产指令。","learningGoal":"区分政府作用与市场机制两个比喻。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"planned-allocation","tabId":"visible-hand","sourceUnitIds":["cs-23-30-p2-visible-hand-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=planned-allocation&tabId=visible-hand","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"2949655","learningSignature":"81659322"}]