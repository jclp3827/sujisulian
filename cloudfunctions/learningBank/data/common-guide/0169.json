[{"id":"constitution-concept-features::fundamental-law","scope":"law","groupId":"constitution-concept-features","groupTitle":"概念和特征","groupTakeaway":"宪法是国家根本法，规定根本制度和任务并保障基本权利。学习时区分根本制度、根本政治制度与严格修宪程序，尤其注意提议主体和通过门槛的不同。","title":"宪法：国家根本法","content":"宪法是具有最高法律效力的国家根本法，它规定国家的根本制度和根本任务，保障公民的基本权利，集中体现各种政治力量的对比关系的法律。","label":"宪法：国家根本法","note":"宪法是具有最高法律效力的国家根本法，它规定国家的根本制度和根本任务，保障公民的基本权利，集中体现各种政治力量的对比关系的法律。","learningGoal":"说明宪法：国家根本法的内容与判断条件。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"constitution-concept-features","tabId":"constitution-concept","sourceUnitIds":["cs-23-30-p24-constitution-concept-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=constitution-concept-features&tabId=constitution-concept","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"bd99fe53","learningSignature":"e88c0a1"},{"id":"constitution-concept-features::two-systems","scope":"law","groupId":"constitution-concept-features","groupTitle":"概念和特征","groupTakeaway":"宪法是国家根本法，规定根本制度和任务并保障基本权利。学习时区分根本制度、根本政治制度与严格修宪程序，尤其注意提议主体和通过门槛的不同。","title":"根本制度与根本政治制度","content":"我国的根本制度是社会主义制度，根本政治制度是人民代表大会制度。两种名称回答的问题不同，看到“根本”二字不能将它们互换；判断题需要把完整限定语一起读清。","label":"根本制度与根本政治制度","note":"我国的根本制度是社会主义制度，根本政治制度是人民代表大会制度。两种名称回答的问题不同，看到“根本”二字不能将它们互换；判断题需要把完整限定语一起读清。","learningGoal":"说明根本制度与根本政治制度的内容与判断条件。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"constitution-concept-features","tabId":"constitution-concept","sourceUnitIds":["cs-23-30-p24-constitution-concept-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=constitution-concept-features&tabId=constitution-concept","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"1b994d62","learningSignature":"cd96f0dc"},{"id":"constitution-concept-features::features","scope":"law","groupId":"constitution-concept-features","groupTitle":"概念和特征","groupTakeaway":"宪法是国家根本法，规定根本制度和任务并保障基本权利。学习时区分根本制度、根本政治制度与严格修宪程序，尤其注意提议主体和通过门槛的不同。","title":"根本法的三方面表现","content":"宪法作为国家根本法，通常从内容根本、效力最高、制定和修改程序更严格三方面理解。它不仅规定根本制度任务，也保障基本权利，不能只按法律名称或篇幅识别其地位。","label":"根本法的三方面表现","note":"宪法作为国家根本法，通常从内容根本、效力最高、制定和修改程序更严格三方面理解。它不仅规定根本制度任务，也保障基本权利，不能只按法律名称或篇幅识别其地位。","learningGoal":"说明根本法的三方面表现的内容与判断条件。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"constitution-concept-features","tabId":"constitution-features","sourceUnitIds":["cs-23-30-p25-constitution-features-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=constitution-concept-features&tabId=constitution-features","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"f59b9a00","learningSignature":"c2bd5d16"},{"id":"constitution-concept-features::amendment-proposal","scope":"law","groupId":"constitution-concept-features","groupTitle":"概念和特征","groupTakeaway":"宪法是国家根本法，规定根本制度和任务并保障基本权利。学习时区分根本制度、根本政治制度与严格修宪程序，尤其注意提议主体和通过门槛的不同。","title":"修宪提议：主体与人数门槛","content":"宪法修改由全国人大常委会或者1/5以上的全国人大代表提议。提议权与最终通过权不同，不能把全国人大常委会可以提出修宪议案，理解为常委会可以独自通过宪法修改。","label":"修宪提议：主体与人数门槛","note":"宪法修改由全国人大常委会或者1/5以上的全国人大代表提议。提议权与最终通过权不同，不能把全国人大常委会可以提出修宪议案，理解为常委会可以独自通过宪法修改。","learningGoal":"说明修宪提议：主体与人数门槛的内容与判断条件。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"constitution-concept-features","tabId":"constitution-features","sourceUnitIds":["cs-23-30-p25-constitution-features-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=constitution-concept-features&tabId=constitution-features","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"446ed4f2","learningSignature":"a9cd8249"},{"id":"constitution-concept-features::amendment-vote","scope":"law","groupId":"constitution-concept-features","groupTitle":"概念和特征","groupTakeaway":"宪法是国家根本法，规定根本制度和任务并保障基本权利。学习时区分根本制度、根本政治制度与严格修宪程序，尤其注意提议主体和通过门槛的不同。","title":"修宪通过：以全体代表为分母","content":"宪法修改由全国人民代表大会以全体代表的2/3以上多数通过。这里的分母是全体代表，不是仅指出席或投票代表；提议的1/5门槛和通过的2/3门槛也不能混用。","label":"修宪通过：以全体代表为分母","note":"宪法修改由全国人民代表大会以全体代表的2/3以上多数通过。这里的分母是全体代表，不是仅指出席或投票代表；提议的1/5门槛和通过的2/3门槛也不能混用。","learningGoal":"说明修宪通过：以全体代表为分母的内容与判断条件。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"constitution-concept-features","tabId":"constitution-features","sourceUnitIds":["cs-23-30-p25-constitution-features-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=constitution-concept-features&tabId=constitution-features","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"e0425a6e","learningSignature":"d94862eb"}]