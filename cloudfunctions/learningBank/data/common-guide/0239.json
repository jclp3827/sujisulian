[{"id":"administrative-law-overview::law","scope":"law","groupId":"administrative-law-overview","groupTitle":"行政法概述","groupTakeaway":"行政职权行使须同时看合法依据、合理裁量、程序、信赖与权责。主体和相对人不同，特定处理与普遍规则不同，救济与制定权限分别按法律判断。","title":"行政法：规范行政职权行使的法律","content":"行政法是调整行政机关或法律、法规授权的组织行使行政职权而发生的各种社会关系的法律规范的总称。","label":"行政法：规范行政职权行使的法律","note":"行政法是调整行政机关或法律、法规授权的组织行使行政职权而发生的各种社会关系的法律规范的总称。","learningGoal":"说明行政法：规范行政职权行使的法律的对象、法定依据与边界。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"administrative-law-overview","tabId":"administrative-law-concept","sourceUnitIds":["cs-scan-114-165-administrative-law-overview-kp-1"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=administrative-law-overview&tabId=administrative-law-concept","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"9c67e8aa","learningSignature":"e5d4b1ff"},{"id":"administrative-law-overview::lawful","scope":"law","groupId":"administrative-law-overview","groupTitle":"行政法概述","groupTakeaway":"行政职权行使须同时看合法依据、合理裁量、程序、信赖与权责。主体和相对人不同，特定处理与普遍规则不同，救济与制定权限分别按法律判断。","title":"合法行政：先核对职权与法律依据","content":"行政活动须遵守法律，并有相应职权依据。目标被认为合理、办事速度快，不能替代法定权限和法律规定；判断合法行政时，须区分机关想做什么与依法能够做什么。","label":"合法行政：先核对职权与法律依据","note":"行政活动须遵守法律，并有相应职权依据。目标被认为合理、办事速度快，不能替代法定权限和法律规定；判断合法行政时，须区分机关想做什么与依法能够做什么。","learningGoal":"说明合法行政：先核对职权与法律依据的对象、法定依据与边界。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"administrative-law-overview","tabId":"administrative-law-principles","sourceUnitIds":["cs-scan-114-165-administrative-law-overview-kp-2"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=administrative-law-overview&tabId=administrative-law-principles","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"43a4663b","learningSignature":"a9a9ab0"},{"id":"administrative-law-overview::reasonable","scope":"law","groupId":"administrative-law-overview","groupTitle":"行政法概述","groupTakeaway":"行政职权行使须同时看合法依据、合理裁量、程序、信赖与权责。主体和相对人不同，特定处理与普遍规则不同，救济与制定权限分别按法律判断。","title":"合理行政：相关因素、公平与比例","content":"行政裁量须公平公正，考虑与事项相关的因素，并符合比例要求。即使具有法定职权，也不能用无关因素作决定，或采用不必要的过重手段；有权处理与处理方式合理是不同问题。","label":"合理行政：相关因素、公平与比例","note":"行政裁量须公平公正，考虑与事项相关的因素，并符合比例要求。即使具有法定职权，也不能用无关因素作决定，或采用不必要的过重手段；有权处理与处理方式合理是不同问题。","learningGoal":"说明合理行政：相关因素、公平与比例的对象、法定依据与边界。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"administrative-law-overview","tabId":"administrative-law-principles","sourceUnitIds":["cs-scan-114-165-administrative-law-overview-kp-2"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=administrative-law-overview&tabId=administrative-law-principles","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"72c41bd8","learningSignature":"77c4640c"},{"id":"administrative-law-overview::procedure","scope":"law","groupId":"administrative-law-overview","groupTitle":"行政法概述","groupTakeaway":"行政职权行使须同时看合法依据、合理裁量、程序、信赖与权责。主体和相对人不同，特定处理与普遍规则不同，救济与制定权限分别按法律判断。","title":"程序正当：公开、参与与回避","content":"行政活动应依法保障公开、公众参与和回避等程序，法定不公开事项依相应规则处理。程序保护与实体处理结果不同，不能仅因认为结论正确或办事紧急，就省略必要的参与和回避程序。","label":"程序正当：公开、参与与回避","note":"行政活动应依法保障公开、公众参与和回避等程序，法定不公开事项依相应规则处理。程序保护与实体处理结果不同，不能仅因认为结论正确或办事紧急，就省略必要的参与和回避程序。","learningGoal":"说明程序正当：公开、参与与回避的对象、法定依据与边界。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"administrative-law-overview","tabId":"administrative-law-principles","sourceUnitIds":["cs-scan-114-165-administrative-law-overview-kp-2"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=administrative-law-overview&tabId=administrative-law-principles","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"2735beb4","learningSignature":"1be7254b"},{"id":"administrative-law-overview::trust","scope":"law","groupId":"administrative-law-overview","groupTitle":"行政法概述","groupTakeaway":"行政职权行使须同时看合法依据、合理裁量、程序、信赖与权责。主体和相对人不同，特定处理与普遍规则不同，救济与制定权限分别按法律判断。","title":"诚实守信：真实信息与信赖保护","content":"行政信息应真实，依法保护相对人的信赖利益。已生效的许可等依法需要变更或撤回时，应按法定条件和补偿规则处理；保护信赖不等于任何行政决定都永远不得调整。","label":"诚实守信：真实信息与信赖保护","note":"行政信息应真实，依法保护相对人的信赖利益。已生效的许可等依法需要变更或撤回时，应按法定条件和补偿规则处理；保护信赖不等于任何行政决定都永远不得调整。","learningGoal":"说明诚实守信：真实信息与信赖保护的对象、法定依据与边界。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"administrative-law-overview","tabId":"administrative-law-principles","sourceUnitIds":["cs-scan-114-165-administrative-law-overview-kp-2"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=administrative-law-overview&tabId=administrative-law-principles","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"2b35e6e1","learningSignature":"a2d9d8ec"}]