[{"id":"legendary-xia-shang::guiling-maling","scope":"humanities-history","groupId":"legendary-xia-shang","groupTitle":"先秦时期","groupTakeaway":"先秦包括夏商西周与春秋战国。本组分别说明王朝更替、诸侯变化、制度功能和社会经济，区分历史记载、考古材料与后世典故。","title":"桂陵与马陵之战","content":"桂陵之战与齐国援赵抗魏、“围魏救赵”相联系。马陵之战与齐国援韩抗魏、孙膑减灶诱敌相联系。两场战役的援助对象和战术线索不同，不能只因都有齐魏就混用。","label":"桂陵与马陵之战","note":"桂陵之战与齐国援赵抗魏、“围魏救赵”相联系。马陵之战与齐国援韩抗魏、孙膑减灶诱敌相联系。两场战役的援助对象和战术线索不同，不能只因都有齐魏就混用。","learningGoal":"说明桂陵与马陵之战的基本含义，并区分相关人物、事件或适用范围。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"legendary-xia-shang","tabId":"transition","sourceUnitIds":["cs-1-9-p3-spring-autumn-warring-states-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=legendary-xia-shang&tabId=transition","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"87410a28","learningSignature":"ed95d216"},{"id":"legendary-xia-shang::changping-qin-zhao","scope":"humanities-history","groupId":"legendary-xia-shang","groupTitle":"先秦时期","groupTakeaway":"先秦包括夏商西周与春秋战国。本组分别说明王朝更替、诸侯变化、制度功能和社会经济，区分历史记载、考古材料与后世典故。","title":"长平之战","content":"长平之战发生于秦国与赵国之间，与赵括及“纸上谈兵”的后世典故相联系。它不同于齐国抗魏的桂陵、马陵之战，辨认时应明确交战双方。","label":"长平之战","note":"长平之战发生于秦国与赵国之间，与赵括及“纸上谈兵”的后世典故相联系。它不同于齐国抗魏的桂陵、马陵之战，辨认时应明确交战双方。","learningGoal":"说明长平之战的基本含义，并区分相关人物、事件或适用范围。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"legendary-xia-shang","tabId":"transition","sourceUnitIds":["cs-1-9-p3-spring-autumn-warring-states-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=legendary-xia-shang&tabId=transition","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"c20eef89","learningSignature":"c9f24f15"},{"id":"legendary-xia-shang::zhou-institution-functions","scope":"humanities-history","groupId":"legendary-xia-shang","groupTitle":"先秦时期","groupTakeaway":"先秦包括夏商西周与春秋战国。本组分别说明王朝更替、诸侯变化、制度功能和社会经济，区分历史记载、考古材料与后世典故。","title":"西周四类重要制度","content":"分封安排政治统属和地域治理，宗法维系血缘继承秩序，井田涉及土地耕作制度，礼乐规范等级仪礼。四者分别回答治理、继承、土地和礼仪问题，彼此联系但含义不同。","label":"西周四类重要制度","note":"分封安排政治统属和地域治理，宗法维系血缘继承秩序，井田涉及土地耕作制度，礼乐规范等级仪礼。四者分别回答治理、继承、土地和礼仪问题，彼此联系但含义不同。","learningGoal":"说明西周四类重要制度的基本含义，并区分相关人物、事件或适用范围。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"legendary-xia-shang","tabId":"pre-qin-institutions","sourceUnitIds":["cs-1-9-p3-p4-pre-qin-institutions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=legendary-xia-shang&tabId=pre-qin-institutions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"2d0e9772","learningSignature":"72f06599"},{"id":"legendary-xia-shang::zongfa-relative-hierarchy","scope":"humanities-history","groupId":"legendary-xia-shang","groupTitle":"先秦时期","groupTakeaway":"先秦包括夏商西周与春秋战国。本组分别说明王朝更替、诸侯变化、制度功能和社会经济，区分历史记载、考古材料与后世典故。","title":"宗法与大宗小宗","content":"宗法以血缘关系为纽带，以嫡长子继承制为核心。大宗、小宗是随宗族层级变化的相对关系：同一支系对下可为大宗，对上又为小宗，不能把全部嫡子与庶子各归成一个固定集团。","label":"宗法与大宗小宗","note":"宗法以血缘关系为纽带，以嫡长子继承制为核心。大宗、小宗是随宗族层级变化的相对关系：同一支系对下可为大宗，对上又为小宗，不能把全部嫡子与庶子各归成一个固定集团。","learningGoal":"说明宗法与大宗小宗的基本含义，并区分相关人物、事件或适用范围。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"legendary-xia-shang","tabId":"pre-qin-institutions","sourceUnitIds":["cs-1-9-p3-p4-pre-qin-institutions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=legendary-xia-shang&tabId=pre-qin-institutions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"d868734a","learningSignature":"a3fdbcde"},{"id":"legendary-xia-shang::ritual-bayi","scope":"humanities-history","groupId":"legendary-xia-shang","groupTitle":"先秦时期","groupTakeaway":"先秦包括夏商西周与春秋战国。本组分别说明王朝更替、诸侯变化、制度功能和社会经济，区分历史记载、考古材料与后世典故。","title":"礼乐与“八佾舞于庭”","content":"孔子批评季氏“八佾舞于庭”，是因为季氏僭用了天子等级的舞乐仪式，反映礼乐中的等级秩序。“八佾”不是任何礼乐队伍的泛称，理解时需保留越级使用礼仪这一条件。","label":"礼乐与“八佾舞于庭”","note":"孔子批评季氏“八佾舞于庭”，是因为季氏僭用了天子等级的舞乐仪式，反映礼乐中的等级秩序。“八佾”不是任何礼乐队伍的泛称，理解时需保留越级使用礼仪这一条件。","learningGoal":"说明礼乐与“八佾舞于庭”的基本含义，并区分相关人物、事件或适用范围。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"legendary-xia-shang","tabId":"pre-qin-institutions","sourceUnitIds":["cs-1-9-p3-p4-pre-qin-institutions-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=legendary-xia-shang&tabId=pre-qin-institutions","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"318ee450","learningSignature":"41bc28b7"}]