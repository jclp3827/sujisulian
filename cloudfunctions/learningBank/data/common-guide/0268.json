[{"id":"pre-industrial-world-science::thales-ancient-research","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"泰勒斯与古希腊自然研究","content":"泰勒斯是古希腊自然研究和数学史中的代表人物，通常列为希腊七贤之一。“科学之父”等称号属于后世评价，不表示已经按统一标准比较出他是所有科学成果的世界首创者。","label":"泰勒斯与古希腊自然研究","note":"泰勒斯是古希腊自然研究和数学史中的代表人物，通常列为希腊七贤之一。“科学之父”等称号属于后世评价，不表示已经按统一标准比较出他是所有科学成果的世界首创者。","learningGoal":"区分泰勒斯与古希腊自然研究涉及的代表人物、观点与贡献。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-scientists-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"d90d249e"},{"id":"pre-industrial-world-science::archimedes-achievements","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"阿基米德的主要成就","content":"古希腊科学家阿基米德提出杠杆原理和浮力定律，著有《论杠杆》和《论浮体》。“给我一个支点，我可以撬动整个地球”常用来说明杠杆原理。","label":"阿基米德的主要成就","note":"古希腊科学家阿基米德提出杠杆原理和浮力定律，著有《论杠杆》和《论浮体》。“给我一个支点，我可以撬动整个地球”常用来说明杠杆原理。","learningGoal":"将阿基米德与杠杆原理、浮力定律相对应。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-scientists-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"golden-candidate","sourceFidelity":"self-reviewed","noviceReadability":"accepted-by-user","independentFactReview":"pending-independent-review"},"signature":"9fe18f7"},{"id":"pre-industrial-world-science::aristarchus-early-solar-model","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"阿利斯塔克与古代日心思想","content":"古希腊的阿利斯塔克曾提出以太阳为中心的古代宇宙设想，属于日心思想的早期探索。这与后来哥白尼建立的天文学体系分属不同时代，不能把二者合为同一个人的同一成果。","label":"阿利斯塔克与古代日心思想","note":"古希腊的阿利斯塔克曾提出以太阳为中心的古代宇宙设想，属于日心思想的早期探索。这与后来哥白尼建立的天文学体系分属不同时代，不能把二者合为同一个人的同一成果。","learningGoal":"区分阿利斯塔克与古代日心思想涉及的代表人物、观点与贡献。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-scientists-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"a9556767"},{"id":"pre-industrial-world-science::copernicus-heliocentrism","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"哥白尼与日心说","content":"波兰天文学家哥白尼于1543年发表《天体运行论》，提出日心说。这一成果挑战了传统宇宙观，成为近代自然科学发展的重要节点。","label":"哥白尼与日心说","note":"波兰天文学家哥白尼于1543年发表《天体运行论》，提出日心说。这一成果挑战了传统宇宙观，成为近代自然科学发展的重要节点。","learningGoal":"将哥白尼、《天体运行论》和日心说相对应。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-scientists-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"golden-candidate","sourceFidelity":"self-reviewed","noviceReadability":"accepted-by-user","independentFactReview":"pending-independent-review"},"signature":"85efe3e2"},{"id":"pre-industrial-world-science::galileo-observation-and-improvement","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"伽利略与望远镜观测","content":"伽利略改进已有望远镜并用于天文观测，观测木星卫星和太阳黑子等现象，也研究自由落体等运动问题。望远镜在他之前已有荷兰制造记录，不能把他的改进和应用说成首次发明望远镜。","label":"伽利略与望远镜观测","note":"伽利略改进已有望远镜并用于天文观测，观测木星卫星和太阳黑子等现象，也研究自由落体等运动问题。望远镜在他之前已有荷兰制造记录，不能把他的改进和应用说成首次发明望远镜。","learningGoal":"区分伽利略与望远镜观测涉及的代表人物、观点与贡献。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-scientists-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"3f9e1f99"}]