[{"id":"pre-industrial-world-science::descartes-geometry-motion","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"笛卡尔与解析几何","content":"笛卡尔与解析几何的发展相联系，也研究光学和运动问题。他讨论的“运动量”涉及速率和物体大小，不能直接等同于现代包含方向的动量，更不能把两种守恒表述混成同一定律。","label":"笛卡尔与解析几何","note":"笛卡尔与解析几何的发展相联系，也研究光学和运动问题。他讨论的“运动量”涉及速率和物体大小，不能直接等同于现代包含方向的动量，更不能把两种守恒表述混成同一定律。","learningGoal":"区分笛卡尔与解析几何涉及的代表人物、观点与贡献。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-scientists-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"f9b8885d","learningSignature":"7398091b"},{"id":"pre-industrial-world-science::kepler-three-laws","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"开普勒行星运动三定律","content":"开普勒三定律说明行星轨道为椭圆、行星与太阳的连线在相等时间扫过相等面积，以及公转周期平方与轨道半长轴立方成正比。它们描述行星如何运动，与牛顿后来提出的力学和引力解释不同。","label":"开普勒行星运动三定律","note":"开普勒三定律说明行星轨道为椭圆、行星与太阳的连线在相等时间扫过相等面积，以及公转周期平方与轨道半长轴立方成正比。它们描述行星如何运动，与牛顿后来提出的力学和引力解释不同。","learningGoal":"区分开普勒行星运动三定律涉及的代表人物、观点与贡献。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-scientists-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"70c6d658","learningSignature":"579cca9d"},{"id":"pre-industrial-world-science::newton-classical-mechanics","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"牛顿与经典力学","content":"英国科学家牛顿于1687年出版《自然哲学的数学原理》，提出运动定律和万有引力定律，建立经典力学体系。","label":"牛顿与经典力学","note":"英国科学家牛顿于1687年出版《自然哲学的数学原理》，提出运动定律和万有引力定律，建立经典力学体系。","learningGoal":"将牛顿与《自然哲学的数学原理》和经典力学体系相对应。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-scientists-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"golden-candidate","sourceFidelity":"self-reviewed","noviceReadability":"accepted-by-user","independentFactReview":"pending-independent-review"},"signature":"d977cdc1","learningSignature":"694968b2"},{"id":"pre-industrial-world-science::ptolemy-geocentrism","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"托勒密与地心说","content":"托勒密是古代地心说的集大成者。地心说以地球为宇宙中心解释天体运动，与以太阳居于中心的日心思想不同；辨认人物与观点时，不能把托勒密和哥白尼对调。","label":"托勒密与地心说","note":"托勒密是古代地心说的集大成者。地心说以地球为宇宙中心解释天体运动，与以太阳居于中心的日心思想不同；辨认人物与观点时，不能把托勒密和哥白尼对调。","learningGoal":"区分托勒密与地心说涉及的代表人物、观点与贡献。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-supplement-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"29e1d2cd","learningSignature":"6398d90d"},{"id":"pre-industrial-world-science::astronomy-observation-description-explanation","scope":"science-technology","groupId":"pre-industrial-world-science","groupTitle":"前工业革命时期","groupTakeaway":"古希腊自然研究、近代天文学变革和经典力学形成各有代表人物。本组说明具体成果与观点，区分技术改进、实际观测、运动规律和力学解释。","title":"观测、运动规律与力学解释","content":"哥白尼提出日心体系，伽利略通过望远镜观测提供新材料，开普勒用三定律描述行星运动，牛顿以运动定律和万有引力建立经典力学。提出体系、取得观测、描述规律与作出力学解释是不同贡献。","label":"观测、运动规律与力学解释","note":"哥白尼提出日心体系，伽利略通过望远镜观测提供新材料，开普勒用三定律描述行星运动，牛顿以运动定律和万有引力建立经典力学。提出体系、取得观测、描述规律与作出力学解释是不同贡献。","learningGoal":"区分观测、运动规律与力学解释涉及的代表人物、观点与贡献。","productionMode":"synthesized","productionLabel":"综合总结","semanticRevision":1,"pointId":"pre-industrial-world-science","tabId":"pre-industrial-scientists","sourceUnitIds":["cs-10-15-p26-pre-industrial-scientists-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=pre-industrial-world-science&tabId=pre-industrial-scientists","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"f9b299c4","learningSignature":"a9205086"}]