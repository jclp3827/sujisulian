[{"id":"taiping-heavenly-kingdom::jintian-founding-1851","scope":"humanities-history","groupId":"taiping-heavenly-kingdom","groupTitle":"太平天国运动","groupTakeaway":"太平天国经历金田起义、定都天京、天京事变与最终失败。本组区分事件阶段，同时说明两部纲领的具体主张，以及提出方案与实际实施的区别。","title":"金田起义","content":"1851年，洪秀全等在广西金田发动起义，建号太平天国。金田是起义地点，南京则是1853年攻克后改称天京并定都的城市；起义、建号与后来定都不是同一时间和地点。","label":"金田起义","note":"1851年，洪秀全等在广西金田发动起义，建号太平天国。金田是起义地点，南京则是1853年攻克后改称天京并定都的城市；起义、建号与后来定都不是同一时间和地点。","learningGoal":"说明金田起义的历史对象、时间联系与结论范围。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"taiping-heavenly-kingdom","tabId":"jintian-uprising","sourceUnitIds":["cs-1-9-p14-jintian-uprising-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=taiping-heavenly-kingdom&tabId=jintian-uprising","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"80ecc7e","learningSignature":"10d9827b"},{"id":"taiping-heavenly-kingdom::tianjing-capital-1853","scope":"humanities-history","groupId":"taiping-heavenly-kingdom","groupTitle":"太平天国运动","groupTakeaway":"太平天国经历金田起义、定都天京、天京事变与最终失败。本组区分事件阶段，同时说明两部纲领的具体主张，以及提出方案与实际实施的区别。","title":"定都天京","content":"1853年，太平军攻克南京，改称天京并定都，太平天国由此拥有重要政治中心。天京是南京在太平天国时期的名称，不能把1853年定都同1851年金田起义合为同一事件。","label":"定都天京","note":"1853年，太平军攻克南京，改称天京并定都，太平天国由此拥有重要政治中心。天京是南京在太平天国时期的名称，不能把1853年定都同1851年金田起义合为同一事件。","learningGoal":"说明定都天京的历史对象、时间联系与结论范围。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"taiping-heavenly-kingdom","tabId":"jintian-uprising","sourceUnitIds":["cs-1-9-p14-jintian-uprising-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=taiping-heavenly-kingdom&tabId=jintian-uprising","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"6d8d8504","learningSignature":"c246a954"},{"id":"taiping-heavenly-kingdom::tianjing-incident-1856","scope":"humanities-history","groupId":"taiping-heavenly-kingdom","groupTitle":"太平天国运动","groupTakeaway":"太平天国经历金田起义、定都天京、天京事变与最终失败。本组区分事件阶段，同时说明两部纲领的具体主张，以及提出方案与实际实施的区别。","title":"天京事变","content":"1856年，太平天国领导集团发生内讧，杨秀清、韦昌辉先后被杀，石达开后来率部出走，领导和军事力量受到削弱。天京事变是由盛转衰的重要转折，不是运动当年结束。","label":"天京事变","note":"1856年，太平天国领导集团发生内讧，杨秀清、韦昌辉先后被杀，石达开后来率部出走，领导和军事力量受到削弱。天京事变是由盛转衰的重要转折，不是运动当年结束。","learningGoal":"说明天京事变的历史对象、时间联系与结论范围。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"taiping-heavenly-kingdom","tabId":"tianjing-incident","sourceUnitIds":["cs-1-9-p14-tianjing-incident-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=taiping-heavenly-kingdom&tabId=tianjing-incident","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"22d0603f","learningSignature":"3a53fb7b"},{"id":"taiping-heavenly-kingdom::taiping-failure-1864","scope":"humanities-history","groupId":"taiping-heavenly-kingdom","groupTitle":"太平天国运动","groupTakeaway":"太平天国经历金田起义、定都天京、天京事变与最终失败。本组区分事件阶段，同时说明两部纲领的具体主张，以及提出方案与实际实施的区别。","title":"太平天国运动失败","content":"1864年洪秀全去世，同年天京被湘军攻破，标志太平天国运动失败。应区分1856年天京事变造成的转衰，与1864年天京陷落所标志的失败。","label":"太平天国运动失败","note":"1864年洪秀全去世，同年天京被湘军攻破，标志太平天国运动失败。应区分1856年天京事变造成的转衰，与1864年天京陷落所标志的失败。","learningGoal":"说明太平天国运动失败的历史对象、时间联系与结论范围。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"taiping-heavenly-kingdom","tabId":"taiping-failure","sourceUnitIds":["cs-1-9-p14-taiping-failure-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=taiping-heavenly-kingdom&tabId=taiping-failure","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"8b64a871","learningSignature":"6289c279"},{"id":"taiping-heavenly-kingdom::heavenly-land-proposal","scope":"humanities-history","groupId":"taiping-heavenly-kingdom","groupTitle":"太平天国运动","groupTakeaway":"太平天国经历金田起义、定都天京、天京事变与最终失败。本组区分事件阶段，同时说明两部纲领的具体主张，以及提出方案与实际实施的区别。","title":"《天朝田亩制度》","content":"《天朝田亩制度》：提出按人口和年龄平均分配土地等设想，追求有田同耕、有饭同食等理想社会。其平均分田等方案带有空想性，在战争环境等条件下未真正实行；不能将纲领提出等同于已经完成全国土地分配。","label":"《天朝田亩制度》","note":"《天朝田亩制度》：提出按人口和年龄平均分配土地等设想，追求有田同耕、有饭同食等理想社会。其平均分田等方案带有空想性，在战争环境等条件下未真正实行；不能将纲领提出等同于已经完成全国土地分配。","learningGoal":"说明《天朝田亩制度》的历史对象、时间联系与结论范围。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"taiping-heavenly-kingdom","tabId":"heavenly-land-system","sourceUnitIds":["cs-1-9-p14-heavenly-land-system-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=taiping-heavenly-kingdom&tabId=heavenly-land-system","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"c33e33ef","learningSignature":"43fd6c92"}]