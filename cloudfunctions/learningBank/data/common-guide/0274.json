[{"id":"self-strengthening-movement::self-strengthening-purpose","scope":"humanities-history","groupId":"self-strengthening-movement","groupTitle":"洋务运动","groupTakeaway":"洋务运动引进西方技术，建设军事工业、民用企业、海军和新式教育。本组说明人物、企业用途与运动目标，区分具体建设作用和富强目标未实现。","title":"洋务运动与代表人物","content":"洋务运动是晚清部分官员引进西方军事技术、兴办近代工业和教育的活动，目标是维护清朝统治。中央代表有奕䜣，地方代表有曾国藩、李鸿章、左宗棠、张之洞；不能与康有为、梁启超等维新人士混同。","label":"洋务运动与代表人物","note":"洋务运动是晚清部分官员引进西方军事技术、兴办近代工业和教育的活动，目标是维护清朝统治。中央代表有奕䜣，地方代表有曾国藩、李鸿章、左宗棠、张之洞；不能与康有为、梁启超等维新人士混同。","learningGoal":"说明洋务运动与代表人物涉及的对象、人物、阶段或作用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"self-strengthening-movement","tabId":"self-strengthening-faction","sourceUnitIds":["cs-1-9-p15-self-strengthening-faction-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=self-strengthening-movement&tabId=self-strengthening-faction","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"84bbd3a9","learningSignature":"9c508026"},{"id":"self-strengthening-movement::self-strengthening-principle","scope":"humanities-history","groupId":"self-strengthening-movement","groupTitle":"洋务运动","groupTakeaway":"洋务运动引进西方技术，建设军事工业、民用企业、海军和新式教育。本组说明人物、企业用途与运动目标，区分具体建设作用和富强目标未实现。","title":"中体西用与自强求富","content":"“中学为体，西学为用”概括洋务派在维护原有统治秩序的基础上学习西方技术。前期侧重自强、兴办军事工业，后来为求富兴办民用企业；自强与求富不是互相排斥的目标。","label":"中体西用与自强求富","note":"“中学为体，西学为用”概括洋务派在维护原有统治秩序的基础上学习西方技术。前期侧重自强、兴办军事工业，后来为求富兴办民用企业；自强与求富不是互相排斥的目标。","learningGoal":"说明中体西用与自强求富涉及的对象、人物、阶段或作用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"self-strengthening-movement","tabId":"self-strengthening-thought","sourceUnitIds":["cs-1-9-p15-self-strengthening-thought-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=self-strengthening-movement&tabId=self-strengthening-thought","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"96c5b891","learningSignature":"8b248ab2"},{"id":"self-strengthening-movement::zeng-anqing","scope":"humanities-history","groupId":"self-strengthening-movement","groupTitle":"洋务运动","groupTakeaway":"洋务运动引进西方技术，建设军事工业、民用企业、海军和新式教育。本组说明人物、企业用途与运动目标，区分具体建设作用和富强目标未实现。","title":"曾国藩与安庆内军械所","content":"安庆内军械所在安徽，由曾国藩创办，属于洋务军事工业，主要联系军械制造。它不同于生产民用商品或经营运输的企业，也不能把创办人物换成张之洞或李鸿章。","label":"曾国藩与安庆内军械所","note":"安庆内军械所在安徽，由曾国藩创办，属于洋务军事工业，主要联系军械制造。它不同于生产民用商品或经营运输的企业，也不能把创办人物换成张之洞或李鸿章。","learningGoal":"说明曾国藩与安庆内军械所涉及的对象、人物、阶段或作用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"self-strengthening-movement","tabId":"self-strengthening-industry","sourceUnitIds":["cs-1-9-p15-self-strengthening-industry-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=self-strengthening-movement&tabId=self-strengthening-industry","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"8174d0cd","learningSignature":"aa8617ab"},{"id":"self-strengthening-movement::li-jiangnan-jinling","scope":"humanities-history","groupId":"self-strengthening-movement","groupTitle":"洋务运动","groupTakeaway":"洋务运动引进西方技术，建设军事工业、民用企业、海军和新式教育。本组说明人物、企业用途与运动目标，区分具体建设作用和富强目标未实现。","title":"李鸿章与军械制造","content":"江南制造总局位于上海，金陵机器局位于南京，都与李鸿章兴办的军事工业相联系。企业名称、所在城市和用途分别辨认，不能把江南制造总局说成民用航运企业。","label":"李鸿章与军械制造","note":"江南制造总局位于上海，金陵机器局位于南京，都与李鸿章兴办的军事工业相联系。企业名称、所在城市和用途分别辨认，不能把江南制造总局说成民用航运企业。","learningGoal":"说明李鸿章与军械制造涉及的对象、人物、阶段或作用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"self-strengthening-movement","tabId":"self-strengthening-industry","sourceUnitIds":["cs-1-9-p15-self-strengthening-industry-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=self-strengthening-movement&tabId=self-strengthening-industry","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"3e595b1f","learningSignature":"d15ea66f"},{"id":"self-strengthening-movement::li-civilian-enterprises","scope":"humanities-history","groupId":"self-strengthening-movement","groupTitle":"洋务运动","groupTakeaway":"洋务运动引进西方技术，建设军事工业、民用企业、海军和新式教育。本组说明人物、企业用途与运动目标，区分具体建设作用和富强目标未实现。","title":"李鸿章与民用企业","content":"轮船招商局联系上海的航运，开平矿务局联系河北的采矿，天津电报局联系天津的通信，均属于李鸿章相关的洋务民用企业。民用企业与军械制造厂的用途不同，不能只按同一创办人物合为一种生产。","label":"李鸿章与民用企业","note":"轮船招商局联系上海的航运，开平矿务局联系河北的采矿，天津电报局联系天津的通信，均属于李鸿章相关的洋务民用企业。民用企业与军械制造厂的用途不同，不能只按同一创办人物合为一种生产。","learningGoal":"说明李鸿章与民用企业涉及的对象、人物、阶段或作用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"self-strengthening-movement","tabId":"self-strengthening-industry","sourceUnitIds":["cs-1-9-p15-self-strengthening-industry-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=self-strengthening-movement&tabId=self-strengthening-industry","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"5ce41cfc","learningSignature":"8869e14e"}]