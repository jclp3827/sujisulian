[{"id":"self-strengthening-movement::zuo-fuzhou-shipbuilding","scope":"humanities-history","groupId":"self-strengthening-movement","groupTitle":"洋务运动","groupTakeaway":"洋务运动引进西方技术，建设军事工业、民用企业、海军和新式教育。本组说明人物、企业用途与运动目标，区分具体建设作用和富强目标未实现。","title":"左宗棠与福州船政","content":"福州船政局位于福州，与左宗棠相联系，是洋务军事工业中的造船代表。它不是上海的轮船招商局：船政建设与民用航运经营在企业地点、人物和主要用途上不同。","label":"左宗棠与福州船政","note":"福州船政局位于福州，与左宗棠相联系，是洋务军事工业中的造船代表。它不是上海的轮船招商局：船政建设与民用航运经营在企业地点、人物和主要用途上不同。","learningGoal":"说明左宗棠与福州船政涉及的对象、人物、阶段或作用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"self-strengthening-movement","tabId":"self-strengthening-industry","sourceUnitIds":["cs-1-9-p15-self-strengthening-industry-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=self-strengthening-movement&tabId=self-strengthening-industry","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"bed48600","learningSignature":"fca62f44"},{"id":"self-strengthening-movement::chonghou-tianjin-machinery","scope":"humanities-history","groupId":"self-strengthening-movement","groupTitle":"洋务运动","groupTakeaway":"洋务运动引进西方技术，建设军事工业、民用企业、海军和新式教育。本组说明人物、企业用途与运动目标，区分具体建设作用和富强目标未实现。","title":"崇厚与天津机器制造总局","content":"天津机器制造总局位于天津，与崇厚相联系，属于洋务军事工业。它与李鸿章相关的天津电报局虽同在天津，却不是同一企业，机器军工制造与通信业务的用途不同。","label":"崇厚与天津机器制造总局","note":"天津机器制造总局位于天津，与崇厚相联系，属于洋务军事工业。它与李鸿章相关的天津电报局虽同在天津，却不是同一企业，机器军工制造与通信业务的用途不同。","learningGoal":"说明崇厚与天津机器制造总局涉及的对象、人物、阶段或作用。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"self-strengthening-movement","tabId":"self-strengthening-industry","sourceUnitIds":["cs-1-9-p15-self-strengthening-industry-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=self-strengthening-movement&tabId=self-strengthening-industry","mapping":"source-overlap","