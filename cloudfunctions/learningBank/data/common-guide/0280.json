[{"id":"revolution-and-may-fourth::tongmenghui-four-part-platform","scope":"humanities-history","groupId":"revolution-and-may-fourth","groupTitle":"辛亥革命","groupTakeaway":"辛亥革命从革命团体与共和纲领发展到武昌起义、民国成立和清帝退位。本组区分组织、政权与政体变化，以及后来二次革命和护国运动的不同目标。","title":"同盟会纲领","content":"同盟会纲领是“驱除鞑虏，恢复中华，创立民国，平均地权”，涉及当时反清民族诉求、共和政体与土地问题。历史纲领有其政治语境，不直接替代现代民族关系和土地法律概念。","label":"同盟会纲领","note":"同盟会纲领是“驱除鞑虏，恢复中华，创立民国，平均地权”，涉及当时反清民族诉求、共和政体与土地问题。历史纲领有其政治语境，不直接替代现代民族关系和土地法律概念。","learningGoal":"说明同盟会纲领的含义、人物活动与历史阶段。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"revolution-and-may-fourth","tabId":"tongmenghui-platform","sourceUnitIds":["cs-1-9-p16-tongmenghui-platform-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=revolution-and-may-fourth&tabId=tongmenghui-platform","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"d3041e01","learningSignature":"dd66d9e7"},{"id":"revolution-and-may-fourth::three-principles-meaning","scope":"humanities-history","groupId":"revolution-and-may-fourth","groupTitle":"辛亥革命","groupTakeaway":"辛亥革命从革命团体与共和纲领发展到武昌起义、民国成立和清帝退位。本组区分组织、政权与政体变化，以及后来二次革命和护国运动的不同目标。","title":"三民主义","content":"三民主义包括民族、民权、民生，以民权主义为核心。旧三民主义中的民权主张推翻君主专制、建立民主共和国，民生与平均地权相联系；这里的内容不能与1924年新三民主义不加区别地混用。","label":"三民主义","note":"三民主义包括民族、民权、民生，以民权主义为核心。旧三民主义中的民权主张推翻君主专制、建立民主共和国，民生与平均地权相联系；这里的内容不能与1924年新三民主义不加区别地混用。","learningGoal":"说明三民主义的含义、人物活动与历史阶段。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"revolution-and-may-fourth","tabId":"three-principles","sourceUnitIds":["cs-1-9-p16-three-principles-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=revolution-and-may-fourth&tabId=three-principles","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"6cd9f8dd","learningSignature":"c045e1d7"},{"id":"revolution-and-may-fourth::wuchang-1911","scope":"humanities-history","groupId":"revolution-and-may-fourth","groupTitle":"辛亥革命","groupTakeaway":"辛亥革命从革命团体与共和纲领发展到武昌起义、民国成立和清帝退位。本组区分组织、政权与政体变化，以及后来二次革命和护国运动的不同目标。","title":"武昌起义","content":"1911年10月10日，武昌新军中的革命力量发动起义，随后成立湖北军政府，各省相继响应，推动辛亥革命发展。武昌起义爆发、中华民国成立、清帝退位是前后相关的不同事件。","label":"武昌起义","note":"1911年10月10日，武昌新军中的革命力量发动起义，随后成立湖北军政府，各省相继响应，推动辛亥革命发展。武昌起义爆发、中华民国成立、清帝退位是前后相关的不同事件。","learningGoal":"说明武昌起义的含义、人物活动与历史阶段。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"revolution-and-may-fourth","tabId":"wuchang-uprising","sourceUnitIds":["cs-1-9-p16-wuchang-uprising-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=revolution-and-may-fourth&tabId=wuchang-uprising","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"e9d70ba8","learningSignature":"26784f8f"},{"id":"revolution-and-may-fourth::huanghuagang-guangzhou","scope":"humanities-history","groupId":"revolution-and-may-fourth","groupTitle":"辛亥革命","groupTakeaway":"辛亥革命从革命团体与共和纲领发展到武昌起义、民国成立和清帝退位。本组区分组织、政权与政体变化，以及后来二次革命和护国运动的不同目标。","title":"黄花岗起义","content":"1911年，黄兴等在广州发动黄花岗起义，早于同年的武昌起义。两者都与辛亥革命前后的革命活动相联系，但地点、人物与结果不同，不能把黄花岗起义的广州换成武昌。","label":"黄花岗起义","note":"1911年，黄兴等在广州发动黄花岗起义，早于同年的武昌起义。两者都与辛亥革命前后的革命活动相联系，但地点、人物与结果不同，不能把黄花岗起义的广州换成武昌。","learningGoal":"说明黄花岗起义的含义、人物活动与历史阶段。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"revolution-and-may-fourth","tabId":"wuchang-uprising","sourceUnitIds":["cs-1-9-p16-wuchang-uprising-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=revolution-and-may-fourth&tabId=wuchang-uprising","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"2ba792bb","learningSignature":"932182c8"},{"id":"revolution-and-may-fourth::second-revolution-1913","scope":"humanities-history","groupId":"revolution-and-may-fourth","groupTitle":"辛亥革命","groupTakeaway":"辛亥革命从革命团体与共和纲领发展到武昌起义、民国成立和清帝退位。本组区分组织、政权与政体变化，以及后来二次革命和护国运动的不同目标。","title":"二次革命","content":"1913年宋教仁被刺案、袁世凯加强专制及武力镇压国民党等引发政治危机，孙中山等发动讨袁斗争，最终失败。这是二次革命，不是1911年反清起义，也不是后来反对称帝的护国运动。","label":"二次革命","note":"1913年宋教仁被刺案、袁世凯加强专制及武力镇压国民党等引发政治危机，孙中山等发动讨袁斗争，最终失败。这是二次革命，不是1911年反清起义，也不是后来反对称帝的护国运动。","learningGoal":"说明二次革命的含义、人物活动与历史阶段。","productionMode":"light-edit","productionLabel":"轻度整理","semanticRevision":1,"pointId":"revolution-and-may-fourth","tabId":"second-revolution","sourceUnitIds":["cs-1-9-p16-second-revolution-list"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=revolution-and-may-fourth&tabId=second-revolution","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"5f0896fb","learningSignature":"bb70c2ff"}]