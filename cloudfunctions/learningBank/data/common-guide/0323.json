[{"id":"acid-base-salt::salts-concept-2","scope":"science-technology","groupId":"acid-base-salt","groupTitle":"酸碱盐","groupTakeaway":"酸、碱、盐是化学分类，俗名和溶液酸碱性不能直接替代分类。本组逐项说明常见物质的名称、性质与用途，特别区分苏打、石灰和钡餐。","title":"碳酸镁（MgCO₃）","content":"镁粉类运动防滑用品利用吸湿等作用，使手部不易打滑；实际用品可含碱式碳酸镁，不能将所有产品都当成纯碳酸镁。","label":"碳酸镁（MgCO₃）","note":"镁粉类运动防滑用品利用吸湿等作用，使手部不易打滑；实际用品可含碱式碳酸镁，不能将所有产品都当成纯碳酸镁。","learningGoal":"说明碳酸镁（MgCO₃）的物质类别、性质和用途边界。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"acid-base-salt","tabId":"salts","sourceUnitIds":["cs-16-22-p18-salt-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=acid-base-salt&tabId=salts","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"9d24970e","learningSignature":"abe1bf21"},{"id":"acid-base-salt::salts-concept-3","scope":"science-technology","groupId":"acid-base-salt","groupTitle":"酸碱盐","groupTakeaway":"酸、碱、盐是化学分类，俗名和溶液酸碱性不能直接替代分类。本组逐项说明常见物质的名称、性质与用途，特别区分苏打、石灰和钡餐。","title":"碳酸钾（K₂CO₃）","content":"草木灰中常含碳酸钾等钾盐，可联系钾肥；草木灰是成分随来源变化的混合物，不等于纯碳酸钾。","label":"碳酸钾（K₂CO₃）","note":"草木灰中常含碳酸钾等钾盐，可联系钾肥；草木灰是成分随来源变化的混合物，不等于纯碳酸钾。","learningGoal":"说明碳酸钾（K₂CO₃）的物质类别、性质和用途边界。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"acid-base-salt","tabId":"salts","sourceUnitIds":["cs-16-22-p18-salt-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=acid-base-salt&tabId=salts","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"1e4be75","learningSignature":"ad6dd67e"},{"id":"acid-base-salt::salts-concept-4","scope":"science-technology","groupId":"acid-base-salt","groupTitle":"酸碱盐","groupTakeaway":"酸、碱、盐是化学分类，俗名和溶液酸碱性不能直接替代分类。本组逐项说明常见物质的名称、性质与用途，特别区分苏打、石灰和钡餐。","title":"氯化钠（NaCl）","content":"食盐主要成分是氯化钠。盐水凝固点在相应条件下低于纯水，可用于融雪；并不意味着任意低温或任意用量都能融冰。","label":"氯化钠（NaCl）","note":"食盐主要成分是氯化钠。盐水凝固点在相应条件下低于纯水，可用于融雪；并不意味着任意低温或任意用量都能融冰。","learningGoal":"说明氯化钠（NaCl）的物质类别、性质和用途边界。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"acid-base-salt","tabId":"salts","sourceUnitIds":["cs-16-22-p18-salt-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=acid-base-salt&tabId=salts","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"c5fbd74c","learningSignature":"3c653d57"},{"id":"acid-base-salt::salts-concept-5","scope":"science-technology","groupId":"acid-base-salt","groupTitle":"酸碱盐","groupTakeaway":"酸、碱、盐是化学分类，俗名和溶液酸碱性不能直接替代分类。本组逐项说明常见物质的名称、性质与用途，特别区分苏打、石灰和钡餐。","title":"硫酸钡（BaSO₄）","content":"硫酸钡难溶于水，符合医用要求的硫酸钡混悬制剂可作消化道X线造影剂，称钡餐。它不是硫酸钡溶液，也不能将可溶性钡盐替代为钡餐。","label":"硫酸钡（BaSO₄）","note":"硫酸钡难溶于水，符合医用要求的硫酸钡混悬制剂可作消化道X线造影剂，称钡餐。它不是硫酸钡溶液，也不能将可溶性钡盐替代为钡餐。","learningGoal":"说明硫酸钡（BaSO₄）的物质类别、性质和用途边界。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"acid-base-salt","tabId":"salts","sourceUnitIds":["cs-16-22-p18-salt-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=acid-base-salt&tabId=salts","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"99a963f","learningSignature":"bc1f163"},{"id":"acid-base-salt::salts-concept-6","scope":"science-technology","groupId":"acid-base-salt","groupTitle":"酸碱盐","groupTakeaway":"酸、碱、盐是化学分类，俗名和溶液酸碱性不能直接替代分类。本组逐项说明常见物质的名称、性质与用途，特别区分苏打、石灰和钡餐。","title":"亚硝酸钠（NaNO₂）","content":"食品生产中允许的亚硝酸盐用途受标准限量约束，过量摄入可造成中毒。某些条件下还可与胺形成亚硝胺，不能概括为所有腌制食品都含高量或每次食用都会致癌。","label":"亚硝酸钠（NaNO₂）","note":"食品生产中允许的亚硝酸盐用途受标准限量约束，过量摄入可造成中毒。某些条件下还可与胺形成亚硝胺，不能概括为所有腌制食品都含高量或每次食用都会致癌。","learningGoal":"说明亚硝酸钠（NaNO₂）的物质类别、性质和用途边界。","productionMode":"reuse","productionLabel":"直接复用","semanticRevision":1,"pointId":"acid-base-salt","tabId":"salts","sourceUnitIds":["cs-16-22-p18-salt-table"],"sourceUrl":"/subpackages/common-sense/detail/index?moduleId=common-sense&pointId=acid-base-salt&tabId=salts","mapping":"source-overlap","review":{"admission":"expansion-candidate","sourceFidelity":"self-reviewed","noviceReadability":"stage-level-sampling-deferred","independentFactReview":"pending-independent-review"},"signature":"4e38bf24","learningSignature":"5636f6ab"}]