[{"id":"spring-warring-memory","revision":2,"status":"review","scope":"humanities-history","title":"春秋战国骨架","purpose":"帮助回忆春秋战国骨架。","text":"平王洛邑启东周；齐楚燕韩赵魏秦；商鞅在秦推县、奖军功耕织；三家分晋与田氏代齐是不同政治变化。","method":"朝代节点与集合串联","coverage":"平王迁都洛邑，开始东周历史。；齐楚燕韩赵魏秦合称战国七雄。；废井田开阡陌、奖励军功、建立县制、奖励耕织。；正文把三家分晋、田氏代齐列为春秋战国分水岭。","conditions":["按正文骨架记忆。"],"excludes":["故事化补充","具体战役典故"],"phrases":[{"id":"cs-target-pingwang-east-memory","phrase":"平王洛邑启东周","meaning":"平王迁都洛邑，开始东周历史。","targetIds":["cs-target-pingwang-east"],"coverageType":"east","conditionRefs":[],"refs":[{"pointId":"legendary-xia-shang","tabId":"transition","sourceUnitIds":["cs-1-9-p3-spring-autumn-warring-states-list"],"fingerprint":"26b9c3a","label":"先秦时期 · 春秋战国","auditStatus":"ready-for-user-acceptance"}],"questionIds":["transition-pingwang-east","transition-full"],"checks":[{"questionId":"transition-pingwang-east","checkPurpose":"east","reviewTarget":"phrase","reviewAnchorId":"cs-target-pingwang-east-memory"},{"questionId":"transition-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-pingwang-east-memory"}]},{"id":"cs-target-warring-seven-memory","phrase":"齐楚燕韩赵魏秦","meaning":"齐楚燕韩赵魏秦合称战国七雄。","targetIds":["cs-target-warring-seven"],"coverageType":"seven","conditionRefs":[],"refs":[{"pointId":"legendary-xia-shang","tabId":"transition","sourceUnitIds":["cs-1-9-p3-spring-autumn-warring-states-list"],"fingerprint":"26b9c3a","label":"先秦时期 · 春秋战国","auditStatus":"ready-for-user-acceptance"}],"questionIds":["transition-warring-seven","transition-full"],"checks":[{"questionId":"transition-warring-seven","checkPurpose":"seven","reviewTarget":"phrase","reviewAnchorId":"cs-target-warring-seven-memory"},{"questionId":"transition-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-warring-seven-memory"}]},{"id":"cs-target-shangyang-reform-memory","phrase":"商鞅在秦推县、奖军功耕织","meaning":"商鞅在秦推行县制、奖励军功和耕织，推动土地制度改革；并非首次创立县。","targetIds":["cs-target-shangyang-reform"],"coverageType":