[{"id":"eastern-han-memory","revision":2,"status":"review","scope":"humanities-history","title":"东汉三段主线","purpose":"帮助回忆东汉三段主线。","text":"刘秀洛阳建东汉；恢复生产光武兴；张角黄巾东汉末；建立中兴到黄巾。","method":"人物、事件与技术配对串联","coverage":"公元25年刘秀即皇帝位，后定都洛阳，史称东汉。；刘秀称帝后采取安抚的统治方法，社会繁荣，史称光武中兴。；东汉末年张角号召百姓起义，起义者头扎黄巾，史称黄巾起义。；主线顺序为刘秀建立东汉、光武中兴、张角发动黄巾起义。","conditions":["按正文主线记忆。"],"excludes":["补充典故与宣传性评价","未列入正文的技术细节"],"phrases":[{"id":"cs-target-eastern-han-founding-memory","phrase":"刘秀洛阳建东汉","meaning":"公元25年刘秀即皇帝位，后定都洛阳，史称东汉。","targetIds":["cs-target-eastern-han-founding"],"coverageType":"founding","conditionRefs":[],"refs":[{"pointId":"qin-han","tabId":"eastern-han","sourceUnitIds":["cs-1-9-p5-eastern-han-list"],"fingerprint":"67289fc8","label":"秦汉 · 东汉","auditStatus":"ready-for-user-acceptance"}],"questionIds":["eastern-han-founding","eastern-han-full"],"checks":[{"questionId":"eastern-han-founding","checkPurpose":"founding","reviewTarget":"phrase","reviewAnchorId":"cs-target-eastern-han-founding-memory"},{"questionId":"eastern-han-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-eastern-han-founding-memory"}]},{"id":"cs-target-guangwu-revival-memory","phrase":"恢复生产光武兴","meaning":"刘秀建立东汉后调整政策、缓和矛盾，恢复生产和社会秩序，出现光武中兴。","targetIds":["cs-target-guangwu-revival"],"coverageType":"revival","conditionRefs":[],"refs":[{"pointId":"qin-han","tabId":"eastern-han","sourceUnitIds":["cs-1-9-p5-eastern-han-list"],"fingerprint":"67289fc8","label":"秦汉 · 东汉","auditStatus":"ready-for-user-acceptance"}],"questionIds":["guangwu-revival","eastern-han-full"],"checks":[{"questionId":"guangwu-revival","checkPurpose":"revival","reviewTarget":"phrase","reviewAnchorId":"cs-target-guangwu-revival-memory"},{"questionId":"eastern-han-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-guangwu-revival-memory"}]},{"id":"cs-target-yellow-turban-memory","phrase":"张角黄巾东汉末","meaning":"东汉末年张角号召百姓起义，起义者头扎黄巾，史称黄巾起义。","targetIds":["cs-target-yellow-turban"],"coverageTyp