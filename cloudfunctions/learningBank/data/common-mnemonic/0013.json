itionRefs":[],"refs":[{"pointId":"qin-han","tabId":"qin-han-economy","sourceUnitIds":["cs-1-9-p5-qin-han-economy-list"],"fingerprint":"968f4b9a","label":"秦汉 · 秦汉时期的社会经济","auditStatus":"ready-for-user-acceptance"}],"questionIds":["qin-han-agriculture","qin-han-economy-full"],"checks":[{"questionId":"qin-han-agriculture","checkPurpose":"agriculture","reviewTarget":"phrase","reviewAnchorId":"cs-target-qin-han-agriculture-memory"},{"questionId":"qin-han-economy-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-qin-han-agriculture-memory"}]},{"id":"cs-target-qin-han-water-blast-memory","phrase":"杜诗水排助冶铁","meaning":"东汉杜诗发明水排，利用水力鼓风冶铁。","targetIds":["cs-target-qin-han-water-blast"],"coverageType":"water-blast","conditionRefs":[],"refs":[{"pointId":"qin-han","tabId":"qin-han-economy","sourceUnitIds":["cs-1-9-p5-qin-han-economy-list"],"fingerprint":"968f4b9a","label":"秦汉 · 秦汉时期的社会经济","auditStatus":"ready-for-user-acceptance"}],"questionIds":["qin-han-water-blast","qin-han-economy-full"],"checks":[{"questionId":"qin-han-water-blast","checkPurpose":"water-blast","reviewTarget":"phrase","reviewAnchorId":"cs-target-qin-han-water-blast-memory"},{"questionId":"qin-han-economy-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-qin-han-water-blast-memory"}]},{"id":"cs-target-qin-han-paper-memory","phrase":"西汉麻纸蔡伦改","meaning":"西汉时期已有麻纸，东汉蔡伦进一步改进造纸术。","targetIds":["cs-target-qin-han-paper"],"coverageType":"paper","conditionRefs":[],"refs":[{"pointId":"qin-han","tabId":"qin-han-economy","sourceUnitIds":["cs-1-9-p5-qin-han-economy-list"],"fingerprint":"968f4b9a","label":"秦汉 · 秦汉时期的社会经济","auditStatus":"ready-for-user-acceptance"}],"questionIds":["qin-han-paper","qin-han-economy-full"],"checks":[{"questionId":"qin-han-paper","checkPurpose":"paper","reviewTarget":"phrase","reviewAnchorId":"cs-target-qin-han-paper-memory"},{"questionId":"qin-han-economy-full","checkPurpose":"full-recheck","reviewTarget":"meaning","