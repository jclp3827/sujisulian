[{"id":"three-kingdoms-economy-memory","revision":1,"status":"review","scope":"humanities-history","title":"魏晋南北朝经济线索","purpose":"帮助回忆魏晋南北朝经济线索。","text":"江南扩展趋平衡；南北青瓷北白瓷；曹魏襄邑洛阳织；吴蚕丝好蜀锦销。","method":"政权演变与产业配对串联","coverage":"江南农业开发由江东扩至长江流域并波及岭南、闽江流域，推动南北经济趋向平衡，为经济重心南移奠基。；南北所烧青瓷各具特色，北朝可以烧出成熟白瓷。；曹魏在纺织业中心襄邑、洛阳等地设置专门制造机构。；吴国八辈之蚕的缫丝质量很高，蜀锦行销吴、魏。","conditions":["按正文主线记忆。"],"excludes":["补充典故与超出正文的评价","未纳入本组的三国两晋节点"],"phrases":[{"id":"cs-target-jiangnan-development-memory","phrase":"江南扩展趋平衡","meaning":"江南农业开发由江东扩至长江流域并波及岭南、闽江流域，推动南北经济趋向平衡，为经济重心南移奠基。","targetIds":["cs-target-jiangnan-development"],"coverageType":"development","conditionRefs":[],"refs":[{"pointId":"three-kingdoms-sui-tang","tabId":"three-kingdoms-economy","sourceUnitIds":["cs-1-9-p6-three-kingdoms-northern-southern-economy-list"],"fingerprint":"90f3bee9","label":"三国两晋南北朝 · 三国两晋南北朝的社会经济","auditStatus":"ready-for-user-acceptance"}],"questionIds":["jiangnan-development","three-kingdoms-economy-full"],"checks":[{"questionId":"jiangnan-development","checkPurpose":"development","reviewTarget":"phrase","reviewAnchorId":"cs-target-jiangnan-development-memory"},{"questionId":"three-kingdoms-economy-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-jiangnan-development-memory"}]},{"id":"cs-target-period-ceramics-memory","phrase":"南北青瓷北白瓷","meaning":"南北所烧青瓷各具特色，北朝可以烧出成熟白瓷。","targetIds":["cs-target-period-ceramics"],"coverageType":"ceramics","conditionRefs":[],"refs":[{"pointId":"three-kingdoms-sui-tang","tabId":"three-kingdoms-economy","sourceUnitIds":["cs-1-9-p6-three-kingdoms-northern-southern-economy-list"],"fingerprint":"90f3bee9","label":"三国两晋南北朝 · 三国两晋南北朝的社会经济","auditStatus":"ready-for-user-acceptance"}],"questionIds":["period-ceramics","three-kingdoms-economy-full"],"checks":[{"questionId":"period-ceramics","checkPurpose":"ceramics","reviewTarget":"phrase","reviewAnchorId":"cs-target-period-ceramics-memory"},{"questionId":"three-kingdoms-economy-full","checkPurpose":"full-rec