佛教事务和西藏地区行政事务。","conditions":["按正文主线记忆。"],"excludes":["疆域最大评价、等级排序和过细工艺词","未纳入本组的政治轶事与产业全史"],"phrases":[{"id":"cs-target-mongol-unification-memory","phrase":"一二零六铁木真蒙古统","meaning":"1206年铁木真统一蒙古各部，建立蒙古政权，被尊称为成吉思汗。","targetIds":["cs-target-mongol-unification"],"coverageType":"founding-timeline","conditionRefs":[],"refs":[{"pointId":"five-dynasties-yuan","tabId":"yuan","sourceUnitIds":["cs-1-9-p11-yuan-list"],"fingerprint":"d668f092","label":"五代、辽、宋、夏、金、元 · 元","auditStatus":"ready-for-user-acceptance"}],"questionIds":["yuan-founding-timeline","yuan-full"],"checks":[{"questionId":"yuan-founding-timeline","checkPurpose":"founding-timeline","reviewTarget":"phrase","reviewAnchorId":"cs-target-mongol-unification-memory"},{"questionId":"yuan-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-mongol-unification-memory"}]},{"id":"cs-target-yuan-founding-memory","phrase":"一二七一忽必烈大都元","meaning":"1271年忽必烈建立大元，定都大都。","targetIds":["cs-target-yuan-founding"],"coverageType":"founding-timeline","conditionRefs":[],"refs":[{"pointId":"five-dynasties-yuan","tabId":"yuan","sourceUnitIds":["cs-1-9-p11-yuan-list"],"fingerprint":"d668f092","label":"五代、辽、宋、夏、金、元 · 元","auditStatus":"ready-for-user-acceptance"}],"questionIds":["yuan-founding-timeline","yuan-full"],"checks":[{"questionId":"yuan-founding-timeline","checkPurpose":"founding-timeline","reviewTarget":"phrase","reviewAnchorId":"cs-target-yuan-founding-memory"},{"questionId":"yuan-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-yuan-founding-memory"}]},{"id":"cs-target-yuan-fall-memory","phrase":"一三六八大都破元亡","meaning":"1368年朱元璋北伐军攻占元大都，元朝灭亡。","targetIds":["cs-target-yuan-fall"],"coverageType":"fall","conditionRefs":[],"refs":[{"pointId":"five-dynasties-yuan","tabId":"yuan","sourceUnitIds":["cs-1-9-p11-yuan-list"],"fingerprint":"d668f092","label":"五代、辽、宋、夏、金、元 · 元","auditStatus":"ready-for-user-acceptance"}],"questionIds":["yuan-fall","yuan-full"],"checks":[{"