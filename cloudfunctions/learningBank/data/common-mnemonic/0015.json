bId":"yuan","sourceUnitIds":["cs-1-9-p11-yuan-list"],"fingerprint":"d668f092","label":"五代、辽、宋、夏、金、元 · 元","auditStatus":"ready-for-user-acceptance"}],"questionIds":["yuan-frontier-institutions","yuan-full"],"checks":[{"questionId":"yuan-frontier-institutions","checkPurpose":"institution-contrast","reviewTarget":"phrase","reviewAnchorId":"cs-target-yuan-xuanzheng-memory"},{"questionId":"yuan-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-yuan-xuanzheng-memory"}]}],"questionIds":["yuan-founding-timeline","yuan-fall","yuan-province-system","yuan-frontier-institutions","yuan-full"],"learningForm":"study-outline","formLabel":"速记提纲"},{"id":"song-yuan-economy-memory","revision":2,"status":"review","scope":"humanities-history","title":"宋元社会经济主线","purpose":"帮助回忆宋元社会经济主线。","text":"苏湖粮仓占城稻；汝官哥钧定，哥线钧纹定白瓷；黄道婆松江棉纺；宋船东南广泉明；交子破坊时，元泉州外贸。","method":"年份、人物、制度、地区与产业线索串联","coverage":"宋代有“苏湖熟，天下足”；从越南引入占城稻，水稻跃居粮食产量首位。；宋代五大名窑为汝、官、哥、钧、定；哥窑见金丝铁线，钧窑见蚯蚓走泥纹，定窑以白瓷为代表。；元成宗时期黄道婆带来棉纺织技术和工具，使松江棉纺织品声名远扬。；宋代造船业水平先进，主要集中在东南沿海，广州、泉州、明州等地发达。；北宋交子是中国最早由政府正式发行的纸币；宋代坊市和经营时间限制被打破；元代泉州是重要对外贸易港口。","conditions":["按正文主线记忆。"],"excludes":["疆域最大评价、等级排序和过细工艺词","未纳入本组的政治轶事与产业全史"],"phrases":[{"id":"cs-target-song-agriculture-memory","phrase":"苏湖粮仓占城稻","meaning":"宋代有“苏湖熟，天下足”；从越南引入占城稻，水稻跃居粮食产量首位。","targetIds":["cs-target-song-agriculture"],"coverageType":"agriculture","conditionRefs":[],"refs":[{"pointId":"five-dynasties-yuan","tabId":"five-dynasties-yuan-economy","sourceUnitIds":["cs-1-9-p11-five-dynasties-yuan-economy-list"],"fingerprint":"3d289f28","label":"五代、辽、宋、夏、金、元 · 五代、辽、宋、夏、金、元的社会经济","auditStatus":"ready-for-user-acceptance"}],"questionIds":["song-agriculture","song-yuan-economy-full"],"checks":[{"questionId":"song-agriculture","checkPurpose":"agriculture","reviewTarget":"phrase","reviewAnchorId":"cs-target-song-agriculture-memory"},{"questionId":"song-yuan-economy-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-song-agricultur