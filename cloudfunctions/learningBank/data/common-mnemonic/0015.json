[{"id":"jin-memory","revision":1,"status":"review","scope":"humanities-history","title":"金朝建立区域与灭亡","purpose":"帮助回忆金朝建立区域与灭亡。","text":"女真阿骨打一一一五金；东北华北是金域；会宁建都号大金；一二三四宋蒙夹。","method":"民族、人物、年份、地点与政权关系串联","coverage":"金朝由女真族建立；完颜阿骨打统一女真诸部后，于1115年建立大金。；金朝是统治中国东北和华北地区的封建王朝。；完颜阿骨打于会宁府建都立国，国号大金。；1234年，金朝在南宋和蒙古南北夹击之下灭亡。","conditions":["按正文主线记忆。"],"excludes":["和议银绢数额、战争过程和人物轶事","未纳入本组的北宋、西夏、元朝制度内容"],"phrases":[{"id":"cs-target-jin-identity-founding-memory","phrase":"女真阿骨打一一一五金","meaning":"金朝由女真族建立；完颜阿骨打统一女真诸部后，于1115年建立大金。","targetIds":["cs-target-jin-identity-founding"],"coverageType":"founding","conditionRefs":[],"refs":[{"pointId":"five-dynasties-yuan","tabId":"jin","sourceUnitIds":["cs-1-9-p10-jin-list"],"fingerprint":"cb9fb880","label":"五代、辽、宋、夏、金、元 · 金","auditStatus":"ready-for-user-acceptance"}],"questionIds":["jin-founding","jin-full"],"checks":[{"questionId":"jin-founding","checkPurpose":"founding","reviewTarget":"phrase","reviewAnchorId":"cs-target-jin-identity-founding-memory"},{"questionId":"jin-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-jin-identity-founding-memory"}]},{"id":"cs-target-jin-region-memory","phrase":"东北华北是金域","meaning":"金朝是统治中国东北和华北地区的封建王朝。","targetIds":["cs-target-jin-region"],"coverageType":"region","conditionRefs":[],"refs":[{"pointId":"five-dynasties-yuan","tabId":"jin","sourceUnitIds":["cs-1-9-p10-jin-list"],"fingerprint":"cb9fb880","label":"五代、辽、宋、夏、金、元 · 金","auditStatus":"ready-for-user-acceptance"}],"questionIds":["jin-region","jin-full"],"checks":[{"questionId":"jin-region","checkPurpose":"region","reviewTarget":"phrase","reviewAnchorId":"cs-target-jin-region-memory"},{"questionId":"jin-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-jin-region-memory"}]},{"id":"cs-target-jin-capital-name-memory","phrase":"会宁建都号大金","meaning":"完颜阿骨打于会宁府建都立国，国号大金。","targetIds":["cs-target-jin-capital-name"],"coverageType":"capital-name","conditionRefs":[],"refs":[{"pointId":