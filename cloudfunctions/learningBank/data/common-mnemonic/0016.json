[{"id":"qing-memory","revision":2,"status":"review","scope":"humanities-history","title":"清朝建立治理与制度","purpose":"帮助回忆清朝建立治理与制度。","text":"一六一六后金，三六改清，四四入关；六一成功复台，八四清设台湾府；一六八九尼布楚；康雍乾三朝盛；努尔哈赤八旗，雍正军机摊丁，理藩管边疆。","method":"年份、人物、事件与制度线索串联","coverage":"1616年努尔哈赤建后金；1636年皇太极改国号为清；1644年清军入关并迁都北京。；1661年郑成功击败荷兰殖民者；1684年清政府正式设台湾府。；1689年中俄经平等协商签订《尼布楚条约》，从法律上肯定相关地区属于中国。；康熙、雍正、乾隆时期经济繁荣、国力强盛，史称康乾盛世。；八旗制度源于努尔哈赤；雍正设军机处并推行摊丁入亩；理藩院管理蒙古、回部及西藏等事务。","conditions":["按正文主线记忆。"],"excludes":["传说、兵器细节、战争过程和冗长制度全称","未纳入本组的明清社会经济"],"phrases":[{"id":"cs-target-qing-founding-memory","phrase":"一六一六后金，三六改清，四四入关","meaning":"1616年努尔哈赤建后金；1636年皇太极改国号为清；1644年清军入关并迁都北京。","targetIds":["cs-target-qing-founding"],"coverageType":"founding-timeline","conditionRefs":[],"refs":[{"pointId":"ming-qing","tabId":"qing","sourceUnitIds":["cs-1-9-p13-qing-list"],"fingerprint":"728884dc","label":"明清 · 清","auditStatus":"ready-for-user-acceptance"}],"questionIds":["qing-founding","qing-full"],"checks":[{"questionId":"qing-founding","checkPurpose":"founding-timeline","reviewTarget":"phrase","reviewAnchorId":"cs-target-qing-founding-memory"},{"questionId":"qing-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-qing-founding-memory"}]},{"id":"cs-target-qing-taiwan-memory","phrase":"六一成功复台，八四清设台湾府","meaning":"1661年郑成功击败荷兰殖民者；1684年清政府正式设台湾府。","targetIds":["cs-target-qing-taiwan"],"coverageType":"taiwan-timeline","conditionRefs":[],"refs":[{"pointId":"ming-qing","tabId":"qing","sourceUnitIds":["cs-1-9-p13-qing-list"],"fingerprint":"728884dc","label":"明清 · 清","auditStatus":"ready-for-user-acceptance"}],"questionIds":["qing-taiwan","qing-full"],"checks":[{"questionId":"qing-taiwan","checkPurpose":"taiwan-timeline","reviewTarget":"phrase","reviewAnchorId":"cs-target-qing-taiwan-memory"},{"questionId":"qing-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-qing-taiwan-memory"}]},{"id":"cs-target-nerchinsk-treaty-memory","phrase":"一六八九尼布楚","meaning":"1689年中俄