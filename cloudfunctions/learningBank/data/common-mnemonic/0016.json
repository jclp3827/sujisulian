viewAnchorId":"cs-target-qing-ceramics-memory"},{"questionId":"ming-qing-economy-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-qing-ceramics-memory"}]},{"id":"cs-target-ming-capitalism-sprout-memory","phrase":"机户商品雇工萌芽","meaning":"明中后期纺织业出现以商品生产为目的的机户，雇佣工人为其劳动，被视为资本主义萌芽。","targetIds":["cs-target-ming-capitalism-sprout"],"coverageType":"production-relation","conditionRefs":[],"refs":[{"pointId":"ming-qing","tabId":"ming-qing-economy","sourceUnitIds":["cs-1-9-p13-ming-qing-economy-list"],"fingerprint":"9ee5629c","label":"明清 · 明清时期的社会经济","auditStatus":"ready-for-user-acceptance"}],"questionIds":["ming-capitalism-sprout","ming-qing-economy-full"],"checks":[{"questionId":"ming-capitalism-sprout","checkPurpose":"production-relation","reviewTarget":"phrase","reviewAnchorId":"cs-target-ming-capitalism-sprout-memory"},{"questionId":"ming-qing-economy-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-ming-capitalism-sprout-memory"}]}],"questionIds":["ming-qing-crops","qing-ceramics","ming-capitalism-sprout","ming-qing-economy-full"]},{"id":"opium-war-opening-memory","revision":3,"status":"review","scope":"humanities-history","title":"鸦片战争前后关键节点","purpose":"帮助回忆鸦片战争前后关键节点。","text":"一八三九林则徐虎门销烟；一八四一三元里民众抗英；一八四二南京首个不平等；割港岛、协关税，五口福广上下宁；林四洲开眼，魏海国师夷。","method":"时期、人物、事件、条约与产业线索串联","coverage":"1839年林则徐在广州虎门销毁鸦片，是鸦片战争爆发的导火索和直接原因。；1841年广州三元里百姓抗英，是近代史上第一次民众大规模自发抵抗外来侵略的战斗。；1842年中英签订近代史上第一个不平等条约《南京条约》，中国开始沦为半殖民地半封建社会。；《南京条约》割让香港岛、开放广州厦门福州宁波上海、规定协定关税；五口可用“福广上下宁”辅助记忆。；林则徐组织编写《四洲志》，被称为开眼看世界第一人；魏源编《海国图志》，提出师夷长技以制夷。","conditions":["按正文主线记忆。"],"excludes":["赔款数额、完整作物名单和瓷器工艺细节","未纳入本组的战争过程和后续运动"],"phrases":[{"id":"cs-target-humen-opium-memory","phrase":"一八三九林则徐虎门销烟","meaning":"1839年林则徐在广东虎门主持销毁鸦片；英国以中国禁烟为借口发动战争，目的在于维护鸦片贸易利益、打开中国市场。","targetIds":["cs-target-humen-opium"],"coverageType":"event","conditionRefs":[],"refs":[{"pointId":"late-qing-invasions","tabId":"humen-opium-destruction","sourceUnitIds":["cs-1-9-p14-humen-opium-destruction-list"],"fingerprint":"f74291c8","label":"鸦片战争 · 虎门销烟","auditStatus":"ready-for-user-acceptance"}],"questionIds":["humen-opium","opium-war-opening-full"],"checks":[{"questionId":"humen-opium","checkPurpose":"event","reviewTarget":"phrase","reviewAnchorId":"cs-target-humen-opium-memory"},{"questionId":"opium-war-opening-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-humen-opium-memory"}]},{"id":"cs-target-sanyuanli-resistance-memory","phrase":"一八四一三元里民众抗英","meaning":"1841年广州三元里及附近乡民自发组织抗击英军，是民众保卫家园、抵抗外来侵略的代表性斗争。","targetIds":["cs-target-sanyuanli-resistance"],"coverageType":"event-nature","conditionRefs":[],"refs":[{"pointId":"late-qing-invasions","tabId":"sanyuanli-resistance","sourceUnitIds":["cs-1-9-p14-sanyuanli-resistance-list"],"fingerprint":"b9ca1c28","label":"鸦片战争 · 三元里抗英","auditStatus":"ready-for-user-acceptance"}],"questionIds":["sanyuanli-resistance","opium-war-opening-full"],"checks":[{"questionId":"sanyuanli-resistance","checkPurpose":"event-nature","reviewTarget":"phrase","reviewAnchorId":"cs-target-sanyuanli-resistance-memory"},{"questionId":"opium-war-opening-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-sanyuanli-resistance-memory"}]},{"id":"cs-target-nanjing-treaty-memory","phrase":"一八四二南京首个不平等","meaning":"1842年中英签订近代史上第一个不平等条约《南京条约》，中国开始沦为半殖民地半封建社会。","targetIds":["cs-target-nanjing-treaty"],"coverageType":"treaty","conditionRefs":[],"refs":[{"pointId":"late-qing-invasions","tabId":"treaty-of-nanjing","sourceUnitIds":["cs-1-9-p14-treaty-of-nanjing-list"],"fingerprint":"d88bdc41","label":"鸦片战争 · 《南京条约》","auditStatus":"ready-for-user-acceptance"}],"questionIds":["nanjing-treaty","opium-war-opening-full"],"checks":[{"questionId":"nanjing-treaty","checkPurpose":"treaty","reviewTarget":"phrase","reviewAnchorId":"cs-target-nanjing-treaty-memory"},{"questionId":"opium-war-opening-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnch