与条约线索串联","coverage":"1851年洪秀全在广西金田起义并建号太平天国；1853年攻克南京，改名天京并定都。；1856年天京事变严重削弱领导和军事力量，是太平天国由盛而衰的分水岭。；1864年洪秀全病故，随后天京被湘军攻破，太平天国运动失败。；《天朝田亩制度》强调平均主义，但具有空想性，最终没有实现。；洪仁玕提出《资政新篇》，主张学习西方，是近代中国最早提出的发展资本主义近代化纲领。","conditions":["按正文主线记忆。"],"excludes":["赔款、领土面积和人物遭遇等过密数字","未纳入本组的后续晚清运动"],"phrases":[{"id":"cs-target-taiping-founding-memory","phrase":"五一金田建号，五三南京改天京","meaning":"1851年洪秀全在广西金田起义并建号太平天国；1853年攻克南京，改名天京并定都。","targetIds":["cs-target-taiping-founding"],"coverageType":"founding-timeline","conditionRefs":[],"refs":[{"pointId":"taiping-heavenly-kingdom","tabId":"jintian-uprising","sourceUnitIds":["cs-1-9-p14-jintian-uprising-list"],"fingerprint":"8fee2978","label":"太平天国运动 · 金田起义","auditStatus":"ready-for-user-acceptance"}],"questionIds":["taiping-founding","taiping-full"],"checks":[{"questionId":"taiping-founding","checkPurpose":"founding-timeline","reviewTarget":"phrase","reviewAnchorId":"cs-target-taiping-founding-memory"},{"questionId":"taiping-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-taiping-founding-memory"}]},{"id":"cs-target-tianjing-incident-memory","phrase":"五六天京事变转衰","meaning":"1856年天京事变严重削弱领导和军事力量，是太平天国由盛而衰的分水岭。","targetIds":["cs-target-tianjing-incident"],"coverageType":"turn-failure","conditionRefs":[],"refs":[{"pointId":"taiping-heavenly-kingdom","tabId":"tianjing-incident","sourceUnitIds":["cs-1-9-p14-tianjing-incident-list"],"fingerprint":"27215732","label":"太平天国运动 · 天京事变","auditStatus":"ready-for-user-acceptance"}],"questionIds":["taiping-turn-failure","taiping-full"],"checks":[{"questionId":"taiping-turn-failure","checkPurpose":"turn-failure","reviewTarget":"phrase","reviewAnchorId":"cs-target-tianjing-incident-memory"},{"questionId":"taiping-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-tianjing-incident-memory"}]},{"id":"cs-target-taiping-failure-memory","phrase":"六四洪亡天京破","meaning":"1864年洪秀全病故，随后天京被湘军攻破，太平天国运动失败。","targetIds":["cs-target-taiping-failure"],"covera