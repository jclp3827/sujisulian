[{"id":"self-strengthening-memory","revision":3,"status":"review","scope":"humanities-history","title":"洋务运动人物与事业","purpose":"帮助回忆洋务运动人物与事业。","text":"中央奕䜣，地方曾李左张；自强求富中体西用；曾安庆、李江南轮船、张汉阳；海军北洋南洋福建广东；新式学堂同文馆；甲午失败，富强目标未达成。","method":"人物、口号、企业、战役与条约线索串联","coverage":"洋务派中央以奕䜣为代表，地方以曾国藩、李鸿章、左宗棠、张之洞为代表。；洋务运动前期以自强为旗号、后期以求富为旗号；正文把中学为体、西学为用与冯桂芬对应。；安庆内军械所是曾国藩在安徽创办的第一个近代军工厂，江南制造总局由李鸿章在上海创办且规模最大；轮船招商局属民用工业，汉阳铁厂由张之洞创办。；19世纪80年代中期初步建成北洋、南洋、福建三支海军，其中北洋舰队实力最强。；洋务运动的新式学堂代表是京师同文馆。；甲午中日战争中北洋海军全军覆没，标志洋务运动宣告破产。","conditions":["按正文主线记忆。"],"excludes":["完整企业名单、赔款和赎辽费数字","正文未展开的战争过程与评价"],"phrases":[{"id":"cs-target-self-strengthening-faction-memory","phrase":"中央奕䜣，地方曾李左张","meaning":"洋务派中央以奕䜣为代表，地方以曾国藩、李鸿章、左宗棠、张之洞为代表。","targetIds":["cs-target-self-strengthening-faction"],"coverageType":"figure-contrast","conditionRefs":[],"refs":[{"pointId":"self-strengthening-movement","tabId":"self-strengthening-faction","sourceUnitIds":["cs-1-9-p15-self-strengthening-faction-list"],"fingerprint":"e5fd3c9a","label":"洋务运动 · 洋务派","auditStatus":"ready-for-user-acceptance"}],"questionIds":["self-strengthening-faction","self-strengthening-full"],"checks":[{"questionId":"self-strengthening-faction","checkPurpose":"figure-contrast","reviewTarget":"phrase","reviewAnchorId":"cs-target-self-strengthening-faction-memory"},{"questionId":"self-strengthening-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-self-strengthening-faction-memory"}]},{"id":"cs-target-self-strengthening-thought-memory","phrase":"前自强、后求富，中体西用冯桂芬","meaning":"洋务派维护原有统治秩序并学习西方技术；前期侧重自强，后来以求富兴办民用企业，两者不互相排斥。","targetIds":["cs-target-self-strengthening-thought"],"coverageType":"thought-slogan","conditionRefs":[],"refs":[{"pointId":"self-strengthening-movement","tabId":"self-strengthening-thought","sourceUnitIds":["cs-1-9-p15-self-strengthening-thought-list"],"fingerprint":"84fffcce","label":"洋务运动 · 指导思想","auditStatus":"ready-for-user-acceptance"}],"questionIds":["self-strengthening-thought","self-strengthening-full"],"checks":[{"questionId":"self-strengthening-thought","checkPurpose":"thought-slogan","reviewTarget":"phrase","reviewAnchorId":"cs-target-self-strengthening-thought-memory"},{"questionId":"self-strengthening-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-self-strengthening-thought-memory"}]},{"id":"cs-target-self-strengthening-industry-memory","phrase":"曾安庆、李江南轮船、张汉阳","meaning":"曾国藩联系安庆内军械所，李鸿章联系江南制造总局及轮船招商局，张之洞联系汉阳铁厂；分别区分军械制造与民用企业，不用无限定规模排名。","targetIds":["cs-target-self-strengthening-industry"],"coverageType":"industry-pairing","conditionRefs":[],"refs":[{"pointId":"self-strengthening-movement","tabId":"self-strengthening-industry","sourceUnitIds":["cs-1-9-p15-self-strengthening-industry-table"],"fingerprint":"ccdb6ea4","label":"洋务运动 · 军事工业与民用工业","auditStatus":"ready-for-user-acceptance"}],"questionIds":["self-strengthening-industry","self-strengthening-full"],"checks":[{"questionId":"self-strengthening-industry","checkPurpose":"industry-pairing","reviewTarget":"phrase","reviewAnchorId":"cs-target-self-strengthening-industry-memory"},{"questionId":"self-strengthening-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-self-strengthening-industry-memory"}]},{"id":"cs-target-self-strengthening-navy-memory","phrase":"海军北洋南洋福建广东","meaning":"晚清逐步形成北洋、南洋、福建、广东等舰队，建设计划与实际形成范围不同；北洋海军在甲午威海卫之战覆灭。","targetIds":["cs-target-self-strengthening-navy"],"coverageType":"navy-school-outcome","conditionRefs":[],"refs":[{"pointId":"self-strengthening-movement","tabId":"modern-navy","sourceUnitIds":["cs-1-9-p15-modern-navy-list"],"fingerprint":"d92f4f6e","label":"洋务运动 · 近代海军","auditStatus":"ready-for-user-acceptance"}],"questionIds":["self-strengthening-support-outcome","self-strengthening-full"],"checks":[{"questionId":"self-strengthening-support-outcome","checkPurpose":"navy-school-outcome","reviewTarget":"phrase","reviewAnchorId":"cs-target-self-strengthening-navy-memory"},{"questionId":"self-strengthening-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-self-strengthening-navy-memory"}]},{"id":"cs-target-self-strengthening-school-memory","phrase":"新式学堂同文馆","meaning":"洋务运动的新式学堂代表是京师同文馆。","targetIds":["cs-target-self-strengthening-school"],"coverageType":"navy-school-outcome","conditionRefs":[],"refs":[{"pointId":"self-strengthening-movement","tabId":"new-school","sourceUnitIds":["cs-1-9-p15-new-school-list"],"fingerprint":"50145375","label":"洋务运动 · 新式学堂","auditStatus":"ready-for-user-acceptance"}],"questionIds":["self-strengthening-support-outcome","self-strengthening-full"],"checks":[{"questionId":"self-strengthening-support-outcome","checkPurpose":"navy-school-outcome","reviewTarget":"phrase","reviewAnchorId":"cs-target-self-strengthening-school-memory"},{"questionId":"self-strengthening-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-self-strengthening-school-memory"}]},{"id":"cs-target-self-strengthening-outcome-memory","phrase":"甲午失败，富强目标未达成","meaning":"甲午战争北洋覆灭表明洋务运动未能达到富强与有效抵御外侮的目标，不等于工业、技术和教育建设没有历史作用。","targetIds":["cs-target-self-strengthening-outcome"],"coverageType":"navy-school-outcome","conditionRefs":[],"refs":[{"pointId":"self-strengthening-movement","tabId":"self-strengthening-outcome","sourceUnitIds":["cs-1-9-p15-self-strengthening-outcome-list"],"fingerprint":"b1e312a","label":"洋务运动 · 运动结局","auditStatus":"ready-for-user-acceptance"}],"questionIds":["self-strengthening-support-outcome","self-strengthening-full"],"checks":[{"questionId":"self-strengthening-support-outcome","checkPurpose":"navy-school-outcome","reviewTarget":"phrase","reviewAnchorId":"cs-target-self-strengthening-outcome-memory"},{"questionId":"self-strengthening-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-self-strengthening-outcome-memory"}]}],"questionIds":["self-strengthening-faction","self-strengthening-thought","self-strengthening-industry","self-strengthening-support-outcome","self-strengthening-full"],"learningForm":"study-outline","formLabel":"速记提纲"},{"id":"sino-japanese-memory","revision":3,"status":"review","scope":"humanities-history","title":"甲午战役与马关条约","purpose":"帮助回忆甲午战役与马关条约。","text":"黄海邓世昌，威海丁汝昌；黄海非当日全军覆灭；马关割辽台澎，开沙重苏杭，口岸可设厂；俄法德干涉还辽。","method":"人物、口号、企业、战役与条约线索串联","coverage":"黄海海战中致远舰管带邓世昌牺牲；威海卫之战中北洋海军提督丁汝昌牺牲。；黄海海战结束后，北洋水师退守威海卫，黄海制海权丧失。；1895年《马关条约》规定割辽东半岛、台湾、澎湖列岛，赔白银2亿两，开放沙市、重庆、苏州、杭州，并允许日本在口岸设厂。；俄、法、德三国干涉还辽，日本最终将辽东半岛归还清政府。","conditions":["按正文主线记忆。"],"excludes":["完整企业名单、赔款和赎辽费数字","正文未展开的战争过程与评价"],"phrases":[{"id":"cs-target-sino-japanese-battles-memory","phrase":"黄海邓世昌，威海丁汝昌","meaning":"黄海海战中致远舰管带邓世昌牺牲；威海卫之战中北洋海军提督丁汝昌牺牲。","targetIds":["cs-target-sino-japanese-battles"],"coverageType":"battle-figure","conditionRefs":[],"refs":[{"pointId":"first-sino-japanese-war","tabId":"first-sino-japanese-war-battles","sourceUnitIds":["cs-1-9-p15-first-sino-japanese-war-battles-list"],"fingerprint":"b193da29","label":"甲午中日战争 · 主要战役","auditStatus":"ready-for-user-acceptance"}],"questionIds":["sino-japanese-battles","sino-japanese-full"],"checks":[{"questionId":"sino-japanese-battles","checkPurpose":"battle-figure","reviewTarget":"phrase","reviewAnchorId":"cs-target-sino-japanese-battles-memory"},{"questionId":"sino-japanese-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-sino-japanese-battles-memory"}]},{"id":"cs-target-sino-japanese-sea-control-memory","phrase":"黄海非当日全军覆灭","meaning":"黄海海战与后来威海卫之战不同，不能把黄海海战当天直接写成北洋舰队已全部覆灭。","targetIds":["cs-target-sino-japanese-sea-control"],"coverageType":"battle-result","conditionRefs":[],"refs":[{"pointId":"first-sino-japanese-war","tabId":"first-sino-japanese-war-battles","sourceUnitIds":["cs-1-9-p15-first-sino-japanese-war-battles-list"],"fingerprint":"b193da29","label":"甲午中日战争 · 主要战役","auditStatus":"ready-for-user-acceptance"}],"questionIds":["sino-japanese-sea-control","sino-japanese-full"],"checks":[{"questionId":"sino-japanese-sea-control"