e-sea-control","shimonoseki-treaty","triple-intervention","sino-japanese-full"],"learningForm":"study-outline","formLabel":"速记提纲"},{"id":"hundred-days-memory","revision":2,"status":"review","scope":"humanities-history","title":"戊戌变法四节点","purpose":"帮助回忆戊戌变法四节点。","text":"九五公车康梁揭幕；九八光绪定国是，百日一零三；京师大学堂为北大前身；六君子谭嗣同狱中题壁。","method":"年份、人物、事件与条约线索串联","coverage":"1895年康有为、梁启超等组织公车上书，揭开戊戌变法序幕。；1898年光绪帝颁布《定国是诏》开始变法，新政持续103天，故称百日维新。；京师大学堂是中国近代第一所国立大学，也是近代国立高等教育的开端。；戊戌六君子包括谭嗣同等六人；我自横刀向天笑等句出自谭嗣同《狱中题壁》。","conditions":["按正文主线记忆。"],"excludes":["完整人物和国家名单、赔款利息数字","正文未展开的政治争议"],"phrases":[{"id":"cs-target-gongche-memorial-memory","phrase":"九五公车康梁揭幕","meaning":"1895年康有为、梁启超等组织公车上书，揭开戊戌变法序幕。","targetIds":["cs-target-gongche-memorial"],"coverageType":"opening-event","conditionRefs":[],"refs":[{"pointId":"hundred-days-reform","tabId":"gongche-memorial","sourceUnitIds":["cs-1-9-p15-p16-gongche-memorial-list"],"fingerprint":"eba38070","label":"戊戌变法 · 公车上书","auditStatus":"ready-for-user-acceptance"}],"questionIds":["gongche-memorial","hundred-days-full"],"checks":[{"questionId":"gongche-memorial","checkPurpose":"opening-event","reviewTarget":"phrase","reviewAnchorId":"cs-target-gongche-memorial-memory"},{"questionId":"hundred-days-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-gongche-memorial-memory"}]},{"id":"cs-target-hundred-days-reform-memory","phrase":"九八光绪定国是，百日一零三","meaning":"1898年光绪帝颁布《定国是诏》开始变法，新政持续103天，故称百日维新。","targetIds":["cs-target-hundred-days-reform"],"coverageType":"reform-start","conditionRefs":[],"refs":[{"pointId":"hundred-days-reform","tabId":"hundred-days-reform","sourceUnitIds":["cs-1-9-p16-hundred-days-reform-list"],"fingerprint":"7f8191e","label":"戊戌变法 · 百日维新","auditStatus":"ready-for-user-acceptance"}],"questionIds":["hundred-days-reform","hundred-days-full"],"checks":[{"questionId":"hundred-days-reform","checkPurpose":"reform-start","reviewTarget":"phrase","reviewAnchorId":"cs-target-hundred-days-reform-memory"},{"questionId