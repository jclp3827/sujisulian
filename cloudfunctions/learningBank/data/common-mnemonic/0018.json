[{"id":"xinhai-process-memory","revision":3,"status":"review","scope":"humanities-history","title":"辛亥进程与影响","purpose":"帮助回忆辛亥进程与影响。","text":"双十武昌第一枪；一二一月民国立，二月退位三月袁；一三二次讨袁败，复辟护国一六停；倒清止帝制，共和入人心；任务未完性质未改。","method":"用年份、组织、事件和影响边界串联","coverage":"1911年10月10日武昌起义打响第一枪，次日湖北军政府成立。；1912年1月1日中华民国在南京成立，孙中山任临时大总统；2月清帝退位，3月袁世凯就任临时大总统。；1913年二次革命讨袁失败；袁世凯复辟帝制后爆发护国运动，并于1916年被迫取消帝制。；辛亥革命推翻清王朝、结束封建君主专制并传播民主共和观念，但未完成反帝反封建任务，社会性质未根本改变。","conditions":["按正文主线记忆，口诀只作检索线索。"],"excludes":["完整人物名单、战争过程和过密日期","正文未展开的史学争议"],"phrases":[{"id":"cs-target-wuchang-uprising-memory","phrase":"双十武昌第一枪","meaning":"1911年10月10日武昌起义打响第一枪，次日湖北军政府成立。","targetIds":["cs-target-wuchang-uprising"],"coverageType":"uprising-marker","conditionRefs":[],"refs":[{"pointId":"revolution-and-may-fourth","tabId":"wuchang-uprising","sourceUnitIds":["cs-1-9-p16-wuchang-uprising-list"],"fingerprint":"74b00c5f","label":"辛亥革命 · 武昌起义","auditStatus":"ready-for-user-acceptance"}],"questionIds":["wuchang-uprising-core","xinhai-process-full"],"checks":[{"questionId":"wuchang-uprising-core","checkPurpose":"uprising-marker","reviewTarget":"phrase","reviewAnchorId":"cs-target-wuchang-uprising-memory"},{"questionId":"xinhai-process-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-wuchang-uprising-memory"}]},{"id":"cs-target-republic-result-memory","phrase":"一二一月民国立，二月退位三月袁","meaning":"1912年1月1日中华民国在南京成立，孙中山任临时大总统；2月清帝退位，3月袁世凯就任临时大总统。","targetIds":["cs-target-republic-result"],"coverageType":"republic-timeline","conditionRefs":[],"refs":[{"pointId":"revolution-and-may-fourth","tabId":"republic-of-china","sourceUnitIds":["cs-1-9-p17-republic-of-china-list"],"fingerprint":"a5637557","label":"辛亥革命 · 中华民国成立","auditStatus":"ready-for-user-acceptance"}],"questionIds":["republic-result-timeline","xinhai-process-full"],"checks":[{"questionId":"republic-result-timeline","checkPurpose":"republic-timeline","reviewTarget":"phrase","reviewAnchorId":"cs-target-republic-result-memory"},{"questionId":"xinhai-process-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-republic-result-memory"}]},{"id":"cs-target-second-protection-memory","phrase":"一三二次讨袁败，复辟护国一六停","meaning":"1913年二次革命讨袁失败；1915年底护国运动反对袁世凯称帝，1916年袁取消帝制，两个阶段不能合并。","targetIds":["cs-target-second-protection"],"coverageType":"anti-yuan-movements","conditionRefs":[],"refs":[{"pointId":"revolution-and-may-fourth","tabId":"second-revolution","sourceUnitIds":["cs-1-9-p16-second-revolution-list"],"fingerprint":"f988a651","label":"辛亥革命 · 二次革命","auditStatus":"ready-for-user-acceptance"}],"questionIds":["second-protection-core","xinhai-process-full"],"checks":[{"questionId":"second-protection-core","checkPurpose":"anti-yuan-movements","reviewTarget":"phrase","reviewAnchorId":"cs-target-second-protection-memory"},{"questionId":"xinhai-process-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-second-protection-memory"}]},{"id":"cs-target-xinhai-impact-memory","phrase":"倒清止帝制，共和入人心；任务未完性质未改","meaning":"辛亥革命推翻清王朝、结束封建君主专制并传播民主共和观念，但未完成反帝反封建任务，社会性质未根本改变。","targetIds":["cs-target-xinhai-impact"],"coverageType":"impact-boundary","conditionRefs":[],"refs":[{"pointId":"revolution-and-may-fourth","tabId":"xinhai-influence","sourceUnitIds":["cs-1-9-p17-xinhai-influence-list"],"fingerprint":"d842cae4","label":"辛亥革命 · 影响","auditStatus":"ready-for-user-acceptance"}],"questionIds":["xinhai-impact-boundary","xinhai-process-full"],"checks":[{"questionId":"xinhai-impact-boundary","checkPurpose":"impact-boundary","reviewTarget":"phrase","reviewAnchorId":"cs-target-xinhai-impact-memory"},{"questionId":"xinhai-process-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-xinhai-impact-memory"}]}],"questionIds":["wuchang-uprising-core","republic-result-timeline","second-protection-core","xinhai-impact-boundary","xinhai-process-full"],"learningForm":"study-outline","formLabel":"速记提纲"},{"id":"new-culture-memory","revision":4,"status":"review","scope":"humanities-history","title":"新文化运动主线","purpose":"帮助回忆新文化运动主线。","text":"一五独秀青年刊，第二卷起改新青；民主科学新德新文；陈办刊倡民主，蔡自由兼容；胡适白话，李大钊传马克思。","method":"用时间、人物、主张、力量和意义串联","coverage":"1915年陈独秀在上海创办《青年杂志》，第二卷起改名《新青年》，不是第二期；刊物与北大分别是思想阵地和活动基地。；新文化运动提倡科学与民主、新道德、新文学，分别反对愚昧与专制、旧道德、旧文学。；陈独秀创办刊物、倡导民主科学并批判旧礼教，蔡元培在北大倡导思想自由、兼容并包。；胡适发表《文学改良刍议》并提倡白话文，李大钊是中国传播马克思主义的先驱。","conditions":["按正文主线记忆，口诀只作检索线索。"],"excludes":["完整文章、口号和人物名单","正文未展开的思想史争议"],"phrases":[{"id":"cs-target-new-culture-origin-memory","phrase":"一五独秀青年刊，新青阵地北大站","meaning":"1915年陈独秀在上海创办《青年杂志》，第二卷起改名《新青年》，不是第二期；刊物与北大分别是思想阵地和活动基地。","targetIds":["cs-target-new-culture-origin"],"coverageType":"origin","conditionRefs":[],"refs":[{"pointId":"new-culture-may-fourth","tabId":"new-culture-movement","sourceUnitIds":["cs-1-9-p17-new-culture-movement-list"],"fingerprint":"aba7ceed","label":"新文化运动与五四运动 · 新文化运动","auditStatus":"ready-for-user-acceptance"}],"questionIds":["new-culture-origin","new-culture-full"],"checks":[{"questionId":"new-culture-origin","checkPurpose":"origin","reviewTarget":"phrase","reviewAnchorId":"cs-target-new-culture-origin-memory"},{"questionId":"new-culture-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-new-culture-origin-memory"}]},{"id":"cs-target-new-culture-propositions-memory","phrase":"科学民主，新德新文","meaning":"新文化运动提倡科学与民主、新道德、新文学，分别反对愚昧与专制、旧道德、旧文学。","targetIds":["cs-target-new-culture-propositions"],"coverageType":"propositions","conditionRefs":[],"refs":[{"pointId":"new-culture-may-fourth","tabId":"new-culture-movement","sourceUnitIds":["cs-1-9-p17-new-culture-movement-list"],"fingerprint":"aba7ceed","label":"新文化运动与五四运动 · 新文化运动","auditStatus":"ready-for-user-acceptance"}],"questionIds":["new-culture-propositions","new-culture-full"],"checks":[{"questionId":"new-culture-propositions","checkPurpose":"propositions","reviewTarget":"phrase","reviewAnchorId":"cs-target-new-culture-propositions-memory"},{"questionId":"new-culture-full","checkPurpose":"full-recheck","