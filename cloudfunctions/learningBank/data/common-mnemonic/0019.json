[{"id":"national-cooperation-memory","revision":3,"status":"review","scope":"humanities-history","title":"合作形成与群众运动","purpose":"帮助回忆合作形成与群众运动。","text":"三大个人合作保持独立；国民党一大合作形成；四大领导权工农联盟与支部建设；五卅反帝，省港工人长期罢工。","method":"用会议、政策、运动、战争和破裂节点串联","coverage":"1923年中共三大在广州召开，决定共产党员以个人身份加入国民党实现合作，同时保持政治、思想和组织独立。；1924年国民党一大确立联俄、联共、扶助农工三大政策，发展新三民主义，标志第一次国共合作正式形成。；1925年中共四大在上海召开，提出无产阶级领导权和农民同盟军问题，并规定党员3人以上可成立党支部。；1925年五卅运动以工人阶级为主力掀起反帝爱国运动高潮，其中省港大罢工影响最大且持续1年零4个月。","conditions":["按正文主线记忆，口诀只作检索线索。"],"excludes":["完整人物名单和战争镇压过程","正文未展开的党史争议"],"phrases":[{"id":"cs-target-cpc-third-memory","phrase":"三大个人入党合作，三独立","meaning":"1923年中共三大在广州召开，决定共产党员以个人身份加入国民党实现合作，同时保持政治、思想和组织独立。","targetIds":["cs-target-cpc-third"],"coverageType":"cooperation-form","conditionRefs":[],"refs":[{"pointId":"national-revolution","tabId":"cpc-third-congress","sourceUnitIds":["cs-1-9-p18-cpc-third-congress-list"],"fingerprint":"50d0d8dc","label":"国民大革命 · 中共三大","auditStatus":"ready-for-user-acceptance"}],"questionIds":["cpc-third-core","national-cooperation-full"],"checks":[{"questionId":"cpc-third-core","checkPurpose":"cooperation-form","reviewTarget":"phrase","reviewAnchorId":"cs-target-cpc-third-memory"},{"questionId":"national-cooperation-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-cpc-third-memory"}]},{"id":"cs-target-kmt-first-memory","phrase":"国一联俄联共扶农工，合作成","meaning":"1924年国民党一大确立联俄、联共、扶助农工三大政策，发展新三民主义，标志第一次国共合作正式形成。","targetIds":["cs-target-kmt-first"],"coverageType":"cooperation-formation","conditionRefs":[],"refs":[{"pointId":"national-revolution","tabId":"kmt-first-congress","sourceUnitIds":["cs-1-9-p19-kmt-first-congress-list"],"fingerprint":"41a01d75","label":"国民大革命 · 国民党一大","auditStatus":"ready-for-user-acceptance"}],"questionIds":["kmt-first-core","national-cooperation-full"],"checks":[{"questionId":"kmt-first-core","checkPurpose":"cooperation-formation","reviewTarget":"phrase","reviewAnchorId":"cs-target-kmt-first-memory"},{"questionId":"national-cooperation-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-kmt-first-memory"}]},{"id":"cs-target-cpc-fourth-memory","phrase":"四大领导工农忙，三人成支部","meaning":"1925年上海中共四大提出无产阶级领导权和工农联盟问题，规定以支部为基本组织；三人以上等历史表述不直接替代全部现行成立程序。","targetIds":["cs-target-cpc-fourth"],"coverageType":"leadership-alliance","conditionRefs":[],"refs":[{"pointId":"national-revolution","tabId":"cpc-fourth-congress","sourceUnitIds":["cs-1-9-p19-cpc-fourth-congress-list"],"fingerprint":"f88330be","label":"国民大革命 · 中共四大","auditStatus":"ready-for-user-acceptance"}],"questionIds":["cpc-fourth-core","national-cooperation-full"],"checks":[{"questionId":"cpc-fourth-core","checkPurpose":"leadership-alliance","reviewTarget":"phrase","reviewAnchorId":"cs-target-cpc-fourth-memory"},{"questionId":"national-cooperation-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-cpc-fourth-memory"}]},{"id":"cs-target-may30-strike-memory","phrase":"五卅反帝，省港工人长期罢工","meaning":"五卅运动引发反帝爱国高潮，广州和香港工人在1925年至1926年开展持续一年多的省港大罢工。","targetIds":["cs-target-may30-strike"],"coverageType":"workers-movement","conditionRefs":[],"refs":[{"pointId":"national-revolution","tabId":"may-thirtieth-movement","sourceUnitIds":["cs-1-9-p19-may-thirtieth-movement-list"],"fingerprint":"24fe7d19","label":"国民大革命 · 五卅运动","auditStatus":"ready-for-user-acceptance"}],"questionIds":["may30-strike-core","national-cooperation-full"],"checks":[{"questionId":"may30-strike-core","checkPurpose":"workers-movement","reviewTarget":"phrase","reviewAnchorId":"cs-target-may30-strike-memory"},{"questionId":"national-cooperation-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-may30-strike-memory"}]}],"questionIds":["cpc-third-core","kmt-first-core","cpc-fourth-core","may30-strike-core","national-cooperation-full"],"learningForm":"study-outline","formLabel":"速记提纲"},{"id":"national-end-memory","revision":2,"status":"review","scope":"humanities-history","title":"北伐与合作破裂","purpose":"帮助回忆北伐与合作破裂。","text":"二六北伐吴孙张；四一二蒋在南京建政，七一五汪在武汉政变，合作全面破裂；二七武汉五大讨论土地革命。","method":"用会议、政策、运动、战争和破裂节点串联","coverage":"1926年国民政府出师北伐，主要对象为吴佩孚、孙传芳和张作霖。；蒋介石、汪精卫先后发动四一二和七一五反革命政变。；政变后南京国民政府建立，第一次国共合作全面破裂。；1927年中共五大在武汉召开，讨论土地革命和革命发展方向，并批评陈独秀报告中的错误。","conditions":["按正文主线记忆，口诀只作检索线索。"],"excludes":["完整人物名单和战争镇压过程","正文未展开的党史争议"],"phrases":[{"id":"cs-target-northern-expedition-memory","phrase":"二六北伐吴孙张","meaning":"1926年国民政府出师北伐，主要对象为吴佩孚、孙传芳和张作霖。","targetIds":["cs-target-northern-expedition"],"coverageType":"expedition-targets","conditionRefs":[],"refs":[{"pointId":"national-revolution","tabId":"northern-expedition","sourceUnitIds":["cs-1-9-p19-northern-expedition-list"],"fingerprint":"a37fc1fb","label":"国民大革命 · 北伐战争","auditStatus":"ready-for-user-acceptance"}],"questionIds":["northern-expedition-core","national-end-full"],"checks":[{"questionId":"northern-expedition-core","checkPurpose":"expedition-targets","reviewTarget":"phrase","reviewAnchorId":"cs-target-northern-expedition-memory"},{"questionId":"national-end-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-northern-expedition-memory"}]},{"id":"cs-target-cooperation-coups-memory","phrase":"四一二七一五政变","meaning":"蒋介石、汪精卫先后发动四一二和七一五反革命政变。","targetIds":["cs-target-cooperation-coups"],"coverageType":"rupture-coups","conditionRefs":[],"refs":[{"pointId":"national-revolution","tabId":"first-cooperation-break","sourceUnitIds":["cs-1-9-p19-first-cooperation-break-list"],"fingerprint":"be1fe1d4","label":"国民大革命 · 第一次国共合作破裂","auditStatus":"ready-for-user-acceptance"}],"questionIds":["cooperation-coups","national-end-full"],"checks":[{"questionId":"cooperation-coups","checkPurpose":"rupture-coups","reviewTarget":"phrase","reviewAnchorId":"cs-target-cooperation-coups-memory"},{"questionId":"national-end-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-cooperation-coups-memory"}]},{"id":"cs-target-cooperation-break-memory","phrase":"南京建政、武汉政变，合作全面破裂","meaning":"1927年四一二政变后蒋介石在南京建政，随后汪精卫在武汉发动七一五政变，第一次国共合作全面破裂。","targetIds":["cs-target-cooperation-break"],"coverageType":"rupture-result","conditionRefs":[],"refs":[{"pointId":"national-revolution","tabId":"first-cooperation-break","sourceUnitIds":["cs-1-9-p19-first-cooperation-break-list"],"fingerprint":"be1fe1d4","label":"国民大革命 · 第一次国共合作破裂","auditStatus":"ready-for-user-acceptance"}],"questionIds":["cooperation-break-core","national-end-full"],"checks":[{"questionId":"cooperation-break-core","checkPurpose":"rupture-result","reviewTarget":"phrase","reviewAnchorId":"cs-target-cooperation-break-memory"},{"questionId":"national-end-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-cooperation-break-memory"}]},{"id":"cs-target-cpc-fifth-memory","phrase":"二七武汉五大，土地方向批陈误","meaning":"1927年中共五大在武汉召开，讨论土地革命和革命发展方向，并批评陈独秀报告中的错误。","targetIds":["cs-target-cpc-fifth"],"coverageType":"fifth-congress","conditionRefs":[],"refs":[{"pointId":"national-revolution","tabId":"cpc-fifth-congress","sourceUnitIds":["cs-1-9-p19-cpc-fifth-congress-list"],"fingerprint":"47483a76","label":"国民大革命 · 中共五大","auditStatus":"ready-for-user-acceptance"}],"questionIds":["cpc-fifth-core","national-end-full"],"checks":[{"questionId":"cpc-fifth-core","checkPurpose":"fifth-congress","reviewTarget":"phrase","reviewAnchorId":"cs-target-cpc-fifth-memory"},{"questionId":"national-end-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-cpc-fifth-memory"}]}],"questionIds":["northern-expedition-core","cooperation-coups","cooperation-break-core","cpc-fifth-core","national-end-full"]},{"id":"land-uprisings-memory","revision":1,"status":"review","scope":"humanities-history","title":"土地革命早期四节点","purpose":"帮助回忆土地革命早期四节点。","text":"八一南昌第一枪；八七汉口定土革武装；九月秋收举工农旗；十月井冈首农村。","method":"用时间、第一项、建军节点和根据地地位串联","coverage":"1927年8月1日南昌起义打响武装反抗国民党的第一枪，是党独立领导革命战争、创建人民军队和武装夺取政权的开端。；1927年8月7日汉口八七会议确定土地革命和武装反抗国民党的总方针，毛泽东提出政权由枪杆子中取得。；1927年9月毛泽东领导湘赣边界秋收起义，党第一次在武装斗争中公开打出工农革命军旗号。；1927年10月毛泽东创建井冈山革命根据地，是第一个农村革命根据地。","conditions":["按正文主线记忆，口诀只作检索线索。"],"excludes":["完整战斗过程和组织数字","正文未展开的党史争议"],"phrases":[{"id":"cs-target-nanchang-uprising-memory","phrase":"八一南昌第一枪","meaning":"1927年8月1日南昌起义打响武装反抗国民党的第一枪，是党独立领导革命战争、创建人民军队和武装夺取政权的开端。","targetIds":["cs-target-nanchang-uprising"],"coverageType":"uprising-status","conditionRefs":[],"refs":[{"pointId":"land-revolution","tabId":"nanchang-uprising","sourceUnitIds":["cs-1-9-p19-nanchang-uprising-list"],"fingerprint":"4fc8acf2","label":"土地革命 · 南昌起义","auditStatus":"ready-for-user-acceptance"}],"questionIds":["nanchang-uprising-core","land-uprisings-full"],"checks":[{"questionId":"nanchang-uprising-core","checkPurpose":"uprising-status","reviewTarget":"phrase","reviewAnchorId":"cs-target-nanchang-uprising-memory"},{"questionId":"land-uprisings-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-nanchang-uprising-memory"}]},{"id":"cs-target-august-seventh-memory","phrase":"八七汉口定土革武装","meaning":"1927年8月7日汉口八七会议确定土地革命和武装反抗国民党的总方针，毛泽东提出政权由枪杆子中取得。","targetIds":["cs-target-august-seventh"],"coverageType":"meeting-policy","conditionRefs":[],"refs":[{"pointId":"land-revolution","tabId":"august-seventh-meeting","sourceUnitIds":["cs-1-9-p19-august-seventh-meeting-list"],"fingerprint":"79881348","label":"土地革命 · 八七会议","auditStatus":"ready-for-user-acceptance"}],"questionIds":["august-seventh-core","land-uprisings-full"],"checks":[{"questionId":"august-seventh-core","checkPurpose":"meeting-policy","reviewTarget":"phrase","reviewAnchorId":"cs-target-august-seventh-memory"},{"questionId":"land-uprisings-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-august-seventh-memory"}]},{"id":"cs-target-autumn-harvest-memory","phrase":"九月秋收举工农旗","meaning":"1927年9月毛泽东领导湘赣边界秋收起义，党第一次在武装斗争中公开打出工农革命军旗号。","targetIds":["cs-target-autumn-harvest"],"coverageType":"flag-status","conditionRefs":[],"refs":[{"pointId":"land-revolution","tabId":"autumn-harvest-uprising","sourceUnitIds":["cs-1-9-p19-autumn-harvest-uprising-list"],"fingerprint":"1442f282","label":"土地革命 · 秋收起义","auditStatus":"ready-for-user-acceptance"}],"questionIds":["autumn-harvest-core","land-uprisings-full"],"checks":[{"questionId":"autumn-harvest-core","checkPurpose":"flag-status","reviewTarget":"phrase","reviewAnchorId":"cs-target-autumn-harvest-memory"},{"questionId":"land-uprisings-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-autumn-harvest-memory"}]},{"id":"cs-target-jinggangshan-base-memory","phrase":"十月井冈首农村","meaning":"1927年10月毛泽东创建井冈山革命根据地，是第一个农村革命根据地。","targetIds":["cs-target-jinggangshan-base"],"coverageType":"first-rural-base","conditionRefs":[],"refs":[{"pointId":"land-revolution","tabId":"jinggangshan-base","sourceUnitIds":["cs-1-9-p19-jinggangshan-base-list"],"fingerprint":"234effdd","label":"土地革命 · 井冈山革命根据地","auditStatus":"ready-for-user-acceptance"}],"questionIds":["jinggangshan-core","land-uprisings-full"],"checks":[{"questionId":"jinggangshan-core","checkPurpose":"first-rural-base","reviewTarget":"phrase","reviewAnchorId":"cs-target-jinggangshan-base-memory"},{"questionId":"land-uprisings-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-jinggangshan-base-memory"}]}],"questionIds":["nanchang-uprising-core","august-seventh-core","autumn-harvest-core","jinggangshan-core","land-uprisings-full"]},{"id":"land-building-memory","revision":2,"status":"review","scope":"humanities-history","title":"建军与根据地","purpose":"帮助回忆建军与根据地。","text":"三湾支部连上党领军；古田确立建军原则；六大莫斯科群众积力量；赣南闽西中央苏区发展，瑞金成立临时中央政府。","method":"用时间、第一项、建军节点和根据地地位串联","coverage":"三湾改编从政治和组织上保证党对军队绝对领导，主要内容包括支部建在连上、官兵平等。；1929年福建上杭古田会议确立人民军队建设基本原则，提出建设无产阶级领导的新型人民军队。；1928年中共六大在莫斯科举行，讨论社会与革命性质、形势与任务，强调群众工作、积蓄力量。；1931年以赣南、闽西为基础建立全国最大的中央革命根据地；同年瑞金成立中华苏维埃共和国临时中央政府。","conditions":["按正文主线记忆，口诀只作检索线索。"],"excludes":["完整战斗过程和组织数字","正文未展开的党史争议"],"phrases":[{"id":"cs-target-sanwan-memory","phrase":"三湾支部连上党领军","meaning":"三