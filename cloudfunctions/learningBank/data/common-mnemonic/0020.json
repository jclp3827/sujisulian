[{"id":"zunyi-poems-memory","revision":2,"status":"review","scope":"humanities-history","title":"遵义会议与长征诗作","purpose":"帮助回忆遵义会议与长征诗作。","text":"一月遵义转折，三月苟坝新三人团；生死转折；娄山二月，七律六盘十月；作品诗句分别对应。","method":"用年份、路线动词、会议意义和作品线索串联","coverage":"1935年初遵义会议成立毛泽东、周恩来、王稼祥三人军事领导小组。；遵义会议是党史上生死攸关的转折点，标志党从幼年走向成熟。；《忆秦娥·娄山关》作于1935年2月；《七律·长征》《清平乐·六盘山》作于1935年10月。；红军不怕远征难对应《七律·长征》；雄关漫道真如铁对应《忆秦娥·娄山关》；不到长城非好汉对应《清平乐·六盘山》。","conditions":["按正文主线记忆，口诀只作检索线索。"],"excludes":["完整战役过程和诗词全文","正文未展开的党史争议"],"phrases":[{"id":"cs-target-zunyi-time-team-memory","phrase":"一月遵义、三月苟坝毛周王","meaning":"1935年1月遵义会议调整领导与指挥；毛泽东、周恩来、王稼祥新三人军事指挥小组在后来3月苟坝一带形成。","targetIds":["cs-target-zunyi-time-team"],"coverageType":"leadership-team","conditionRefs":[],"refs":[{"pointId":"land-revolution","tabId":"zunyi-meeting","sourceUnitIds":["cs-1-9-p20-zunyi-meeting-list"],"fingerprint":"daa72b32","label":"土地革命 · 遵义会议","auditStatus":"ready-for-user-acceptance"}],"questionIds":["zunyi-team","zunyi-poems-full"],"checks":[{"questionId":"zunyi-team","checkPurpose":"leadership-team","reviewTarget":"phrase","reviewAnchorId":"cs-target-zunyi-time-team-memory"},{"questionId":"zunyi-poems-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-zunyi-time-team-memory"}]},{"id":"cs-target-zunyi-significance-memory","phrase":"生死转折，由幼成熟","meaning":"遵义会议是党史上生死攸关的转折点，标志党从幼年走向成熟。","targetIds":["cs-target-zunyi-significance"],"coverageType":"meeting-significance","conditionRefs":[],"refs":[{"pointId":"land-revolution","tabId":"zunyi-meeting","sourceUnitIds":["cs-1-9-p20-zunyi-meeting-list"],"fingerprint":"daa72b32","label":"土地革命 · 遵义会议","auditStatus":"ready-for-user-acceptance"}],"questionIds":["zunyi-significance","zunyi-poems-full"],"checks":[{"questionId":"zunyi-significance","checkPurpose":"meeting-significance","reviewTarget":"phrase","reviewAnchorId":"cs-target-zunyi-significance-memory"},{"questionId":"zunyi-poems-full","checkPurpose":"full-recheck","reviewTarget":"meaning","reviewAnchorId":"cs-target-zunyi-sig