mirage-full"],"learningForm":"study-outline","formLabel":"速记提纲"},{"id":"rainbow-secondary-memory","revision":2,"status":"review","scope":"science-technology","title":"虹霓内外方位诀","purpose":"从阳光进入雨滴的画面出发，用内外、明暗、色序和相反方位还原主虹与副虹。","text":"日光进雨滴，折射反射成虹；主虹外红内紫。霓在虹外更暗，两次反射、颜色倒；太阳在背，虹在对面。","method":"雨滴画面＋内外明暗对照＋相反方位","coverage":"阳光照射雨点，经折射和反射形成拱形七彩光谱。；主虹由外到内为红、橙、黄、绿、蓝、靛、紫。；副虹又称霓，较暗，位于主虹外侧，由阳光在水滴中两次反射形成，色序与主虹相反。；雨后太阳在东则彩虹在西，太阳在西则彩虹在东。","conditions":["按正文光学过程和相对关系记忆，口诀只作检索线索。"],"excludes":["光路作图、大气分层计算和气象预测"],"phrases":[{"id":"cs-target-rainbow-cause-memory","phrase":"日光进雨滴，折射反射成虹","meaning":"阳光照射雨点，经折射和反射形成拱形七彩光谱。","targetIds":["cs-target-rainbow-cause"],"coverageType":"structural-scene-with-boundary","conditionRefs":[],"refs":[{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-life-optical-phenomena-list"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"}],"questionIds":["rainbow-cause-core","rainbow-secondary-full"],"checks":[{"questionId":"rainbow-cause-core","checkPurpose":"q2-optics-life-phenomena","reviewTarget":"phrase","reviewAnchorId":"cs-target-rainbow-cause-memory"},{"questionId":"rainbow-secondary-full","checkPurpose":"q2-optics-life-phenomena","reviewTarget":"meaning","reviewAnchorId":"cs-target-rainbow-cause-memory"}]},{"id":"cs-target-rainbow-order-memory","phrase":"主虹外红内紫","meaning":"主虹由外到内为红、橙、黄、绿、蓝、靛、紫。","targetIds":["cs-target-rainbow-order"],"coverageType":"structural-scene-with-boundary","conditionRefs":[],"refs":[{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-life-optical-phenomena-list"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"}],"questionIds":["rainbow-order-core","rainbow-secondary-full"],"checks":[{"questionId":"rainbow-order-core","checkPurpose":"q2-optics-life-phenomena","reviewTarget":"phrase","reviewAnchorId":"cs-target-rainbow-order-memory"},{"questionId":"rainbow-secondary-full","checkPurpose":"q2-optics-life