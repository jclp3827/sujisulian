[{"id":"poet-immortal","revision":1,"status":"review","scope":"humanities-history","group":"poet-titles","objective":"区分李白的诗仙称号","prompt":"“诗仙”通常指哪位诗人？","options":["杜甫","李白","白居易"],"answer":1,"explanation":"李白被称为诗仙；杜甫被称为诗圣。","boundary":"此题只辨人物称号，不涉及全部作品和生平。","refs":[{"pointId":"pre-qin-poetry","tabId":"li-bai","sourceUnitIds":["cs-10-15-p2-p3-li-bai-list"],"fingerprint":"989cbd62","label":"诗赋 · 李白","auditStatus":"ready-for-user-acceptance"},{"pointId":"pre-qin-poetry","tabId":"du-fu","sourceUnitIds":["cs-10-15-p3-du-fu-list"],"fingerprint":"d034f3ed","label":"诗赋 · 杜甫","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"poet-immortal","primaryTargetIds":["cs-target-poet-li-bai-title"],"supportingTargetIds":[],"checkPurpose":"direct","distractorReasons":{"0":"诗圣对应杜甫。","2":"本批正文未把诗仙对应白居易。"},"cognitiveLevel":"recall"}},{"id":"poet-sage","revision":1,"status":"review","scope":"humanities-history","group":"poet-titles","objective":"区分杜甫的诗圣称号","prompt":"把人物与称号配对，哪一组正确？","options":["李白—诗圣","杜甫—诗仙","杜甫—诗圣"],"answer":2,"explanation":"“诗圣”对应杜甫，“诗仙”对应李白。","boundary":"人物称号与诗歌评价要分开记。","refs":[{"pointId":"pre-qin-poetry","tabId":"du-fu","sourceUnitIds":["cs-10-15-p3-du-fu-list"],"fingerprint":"d034f3ed","label":"诗赋 · 杜甫","auditStatus":"ready-for-user-acceptance"},{"pointId":"pre-qin-poetry","tabId":"li-bai","sourceUnitIds":["cs-10-15-p2-p3-li-bai-list"],"fingerprint":"989cbd62","label":"诗赋 · 李白","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"poet-sage","primaryTargetIds":["cs-target-poet-du-fu-title"],"supportingTargetIds":["cs-target-poet-li-bai-title"],"checkPurpose":"direct-contrast","distractorReasons":{"0":"李白对应诗仙，不是诗圣。","1":"杜甫对应诗圣，李白对应诗仙。"},"cognitiveLevel":"distinction"}},{"id":"poet-history","revision":1,"status":"review","scope":"humanities-history","group":"poet-titles","objective":"区分诗史评价的对象","prompt":"“诗史”在这里评价的是什么？","options":["杜甫的诗歌","李白的字号","杜甫的官职"],"answer":0,"explanation":"杜甫的诗歌被评价为“诗史”。“诗圣”称人，“诗史”评诗。","boundary":"不能把“诗史”当成官职或字号。","refs":[{"pointId":"pre-qin-poetry","tabId":"du-fu","sourceUnitIds":["cs-10-15-p3-du-fu-list"],"fingerprint":"d034f3ed","label":"诗赋 · 杜甫","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"poet-history","primaryTargetIds":["cs-target-poet-du-fu-poetry-history"],"supportingTargetIds":[],"checkPurpose":"object-distinction","distractorReasons":{"1":"诗史不是李白的字号。","2":"诗史不是杜甫的官职。"},"cognitiveLevel":"distinction"}},{"id":"sound-pitch","revision":2,"status":"review","scope":"science-technology","group":"sound-features","objective":"由振动频率变化判断音调变化","prompt":"同一根琴弦的振动频率由每秒200次提高到每秒400次，其他条件不讨论。可以直接判断声音发生哪项变化？","options":["音调升高","响度增大","音色改变"],"answer":0,"explanation":"发声体振动频率提高，对应音调升高；仅凭频率变化不能推出响度或音色改变。","boundary":"本题只判断频率与音调的基础对应关系，不讨论振幅、传播距离等其他条件。","refs":[{"pointId":"acoustics","tabId":"sound-characteristics","sourceUnitIds":["cs-16-22-p13-sound-characteristics-list"],"fingerprint":"7b830d6c","label":"声学 · 声音的特性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"sound-pitch","primaryTargetIds":["cs-target-sound-pitch-frequency"],"supportingTargetIds":[],"checkPurpose":"direct","distractorReasons":{"1":"响度主要与振幅有关，题干只改变频率。","2":"音色用于辨认声音特点，不能由频率翻倍直接推出音色改变。"},"cognitiveLevel":"application"}},{"id":"sound-loudness","revision":2,"status":"review","scope":"science-technology","group":"sound-features","objective":"在其他条件相同时由振幅变化判断响度","prompt":"同一音箱与听者距离不变，只增大发声体的振幅。根据基础对应关系，声音主要会怎样变化？","options":["音调升高","响度增大","音色改变"],"answer":1,"explanation":"距离等其他条件相同时，发声体振幅增大，对应响度增大。","boundary":"实际听到的响度还会受距离等因素影响，本题已限定这些条件不变。","refs":[{"pointId":"acoustics","tabId":"sound-characteristics","sourceUnitIds":["cs-16-22-p13-sound-characteristics-list"],"fingerprint":"7b830d6c","label":"声学 · 声音的特性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"sound-loudness","primaryTargetIds":["cs-target-sound-loudness-amplitude"],"supportingTargetIds":[],"checkPurpose":"direct-with-condition","distractorReasons":{"0":"音调主要对应频率，题干只改变振幅。","2":"音色反映声音特点，不能由振幅增大直接推出音色改变。"},"cognitiveLevel":"condition"}}]