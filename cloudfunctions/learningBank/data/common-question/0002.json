[{"id":"school-mo","revision":1,"status":"review","scope":"humanities-history","group":"schools-pairing","objective":"兼爱非攻与墨子对应","prompt":"“兼爱、非攻”对应哪一家？","options":["法家","墨家","名家"],"answer":1,"explanation":"墨子提出兼爱、非攻等主张。","boundary":"这两个词只是墨家部分主张，不能当作完整思想体系。","refs":[{"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"fingerprint":"78688f76","label":"中国古代思想 · 百家争鸣","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"school-mo","primaryTargetIds":["q0b-target-school-mo"],"supportingTargetIds":["q0b-target-school-lao","q0b-target-school-fa"],"checkPurpose":"q0b-mapping","cognitiveLevel":"mapping","distractorReasons":{"0":"法家在本组对应法、术、势，不对应兼爱、非攻。","2":"兼爱、非攻是墨家主张，不是本组所列名家主张。"}}},{"id":"school-fa","revision":1,"status":"review","scope":"humanities-history","group":"schools-pairing","objective":"法术势与法家对应","prompt":"“法、术、势相结合”在本节对应哪一家？","options":["道家","墨家","法家"],"answer":2,"explanation":"正文把法术势相结合列在法家部分。","boundary":"这里辨认古代学派，不把古代法家直接等同于现代法治。","refs":[{"pointId":"traditional-thought-ritual","tabId":"hundred-schools","sourceUnitIds":["cs-10-15-p12-p13-hundred-schools-list"],"fingerprint":"78688f76","label":"中国古代思想 · 百家争鸣","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"school-fa","primaryTargetIds":["q0b-target-school-fa"],"supportingTargetIds":["q0b-target-school-lao","q0b-target-school-mo"],"checkPurpose":"q0b-mapping","cognitiveLevel":"mapping","distractorReasons":{"0":"道家在本组对应老子与《道德经》。","1":"墨家在本组对应兼爱、非攻。"}}},{"id":"history-shiji","revision":1,"status":"review","scope":"humanities-history","group":"history-genres","objective":"史记为纪传体通史","prompt":"《史记》的体例与范围应如何配对？","options":["编年体通史","纪传体通史","纪传体断代史"],"answer":1,"explanation":"《史记》是纪传体通史，作者司马迁。","boundary":"纪传或编年是叙述体例；通史或断代史是记述范围。","refs":[{"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-table"],"fingerprint":"a23c158b","label":"史学著作 · 史学著作表","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"history-shiji","primaryTargetIds":["cs-target-history-shiji-genre","cs-target-history-shiji-scope"],"supportingTargetIds":[],"checkPurpose":"combined-direct","distractorReasons":{"0":"编年体通史对应《资治通鉴》，不是《史记》。","2":"纪传体断代史对应《汉书》，《史记》的范围是通史。"},"cognitiveLevel":"synthesis"}},{"id":"history-tongjian","revision":2,"status":"review","scope":"humanities-history","group":"history-genres","objective":"资治通鉴为编年体通史","prompt":"只从叙述体例和记述范围看，《资治通鉴》应如何归类？","options":["纪传体通史","编年体通史","编年体断代史"],"answer":1,"explanation":"《资治通鉴》的叙述体例是编年体，记述范围是通史；两个维度合起来是编年体通史。","boundary":"本题不借作者信息提示答案，也不扩展到具体记载年代和成书经过。","refs":[{"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-table"],"fingerprint":"a23c158b","label":"史学著作 · 史学著作表","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"history-tongjian","primaryTargetIds":["cs-target-history-tongjian-genre","cs-target-history-tongjian-scope"],"supportingTargetIds":[],"checkPurpose":"combined-direct","distractorReasons":{"0":"纪传体通史对应《史记》，《资治通鉴》的体例是编年体。","2":"《资治通鉴》是通史，不是断代史。"},"cognitiveLevel":"synthesis"}},{"id":"history-hanshu","revision":1,"status":"review","scope":"humanities-history","group":"history-genres","objective":"汉书为纪传体断代史","prompt":"《汉书》与《史记》的关键范围区别是什么？","options":["《汉书》是断代史，《史记》是通史","《汉书》不是纪传体","两者都只记一年"],"answer":0,"explanation":"《汉书》为纪传体断代史，《史记》为纪传体通史。","boundary":"这里只比较体例与范围，不代替作者、朝代和篇目学习。","refs":[{"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-table"],"fingerprint":"a23c158b","label":"史学著作 · 史学著作表","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"history-hanshu","primaryTargetIds":["cs-target-history-hanshu-scope"],"supportingTargetIds":[],"checkPurpose":"direct","distractorReasons":{"1":"《汉书》本身属于纪传体；该选项也没有回答通史与断代史的范围区别。","2":"断代史并不等于只记录一年。"},"cognitiveLevel":"recall"}}]