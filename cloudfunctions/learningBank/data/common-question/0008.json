[{"id":"civil-voluntary","revision":2,"status":"review","scope":"law","group":"civil-principles-compare","objective":"在合法边界内识别意思自治所体现的自愿原则","prompt":"在不违反法律和公序良俗的前提下，双方自主决定是否订立合同并协商合同内容，主要体现哪项原则？","options":["自愿原则","平等原则","诚信原则"],"answer":0,"explanation":"民事主体按照自己的意思设立、变更、终止民事法律关系，体现自愿原则。","boundary":"自愿原则受法律和公序良俗约束，不能据此排除强制性规定。","refs":[{"pointId":"civil-basic-principles","tabId":"civil-principle-2","sourceUnitIds":["cs-31-37-p4-civil-principle-kp-2"],"fingerprint":"6b21a09","label":"民法的基本原则 · 自愿原则","auditStatus":"ready-for-user-acceptance"},{"pointId":"civil-basic-principles","tabId":"civil-principle-5","sourceUnitIds":["cs-31-37-p4-civil-principle-kp-5"],"fingerprint":"75ba2bdf","label":"民法的基本原则 · 守法与公序良俗原则","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","verification":{"checkedAt":"2026-10-22","sourceIds":["civil-code-cac-general-provisions"],"locators":["第4条","第5条","第6条","第8条"]},"assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"verificationLabel":"中华人民共和国民法典（总则编） · 第4条、第5条、第6条、第8条 · 核验 2026-10-22","specification":{"questionId":"civil-voluntary","primaryTargetIds":["q0b-target-civil-voluntary"],"supportingTargetIds":["q0b-target-civil-equality","q0b-target-civil-fairness"],"checkPurpose":"q2-application","cognitiveLevel":"application","distractorReasons":{"1":"平等原则解决民事主体法律地位问题，不直接表达是否订约和如何约定。","2":"诚信原则要求秉持诚实、恪守承诺，题干重点是自主决定和协商内容。"}}},{"id":"civil-fairness","revision":2,"status":"review","scope":"law","group":"civil-principles-compare","objective":"根据权利义务和风险的合理安排识别公平原则","prompt":"合同双方确定权利义务时兼顾彼此利益，并合理分配履约风险，主要体现哪项原则？","options":["自愿原则","公平原则","平等原则"],"answer":1,"explanation":"合理确定各方权利和义务、兼顾利益并合理分配风险，主要体现公平原则。","boundary":"复杂案件可能同时涉及多项原则；本题只根据题干给出的直接判断线索作答。","refs":[{"pointId":"civil-basic-principles","tabId":"civil-principle-3","sourceUnitIds":["cs-31-37-p4-civil-principle-kp-3"],"fingerprint":"1a2a8908","label":"民法的基本原则 · 公平原则","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","verification":