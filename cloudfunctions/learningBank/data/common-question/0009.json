[{"id":"sound-pitch-timbre-scenario","revision":2,"status":"review","scope":"science-technology","group":"sound-features","objective":"在同一情境中区分音调、响度与音色","prompt":"两件乐器以相同响度演奏同一音调，人仍能分辨乐器；随后提高甲的振动频率。哪项判断正确？","options":["辨乐器看音色，甲的音调会升高","辨乐器看响度，甲的响度会增大","辨乐器看音调，甲的音色会消失"],"answer":0,"explanation":"辨认不同乐器主要利用音色；提高发声体振动频率，对应音调升高。","boundary":"提高频率不能直接推出响度增大，音色也不会因此消失。","refs":[{"pointId":"acoustics","tabId":"sound-characteristics","sourceUnitIds":["cs-16-22-p13-sound-characteristics-list"],"fingerprint":"7b830d6c","label":"声学 · 声音的特性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"sound-pitch-timbre-scenario","primaryTargetIds":["cs-target-sound-pitch-frequency","cs-target-sound-timbre-identification"],"supportingTargetIds":[],"checkPurpose":"scenario-contrast","distractorReasons":{"1":"辨认乐器主要依据音色，且频率提高不能直接推出响度增大。","2":"辨认乐器主要依据音色；提高频率不会使音色消失。"},"cognitiveLevel":"application"}},{"id":"sound-loudness-condition","revision":2,"status":"review","scope":"science-technology","group":"sound-features","objective":"用控制变量识别振幅与响度关系的比较条件","prompt":"研究振幅变化是否影响响度，哪组实验最能排除其他因素干扰？","options":["固定距离和音调，只改变振幅","固定振幅，同时改变听者距离","固定距离和振幅，只改变频率"],"answer":0,"explanation":"保持距离、音调等其他条件相同，只改变振幅，才能把响度差异与振幅变化对应。","boundary":"同时改变距离或只改变频率，不能单独检验振幅对响度的影响。","refs":[{"pointId":"acoustics","tabId":"sound-characteristics","sourceUnitIds":["cs-16-22-p13-sound-characteristics-list"],"fingerprint":"7b830d6c","label":"声学 · 声音的特性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"sound-loudness-condition","primaryTargetIds":["cs-target-sound-loudness-amplitude"],"supportingTargetIds":[],"checkPurpose":"boundary-condition","distractorReasons":{"1":"振幅和距离同时变化，无法把响度差异单独归因于振幅。","2":"只改变频率检验的是音调关系，不能检验振幅对响度的影响。"},"cognitiveLevel":"condition"}},{"id":"history-hanshu-genre","revision":1,"status":"review","scope":"humanities-history","group":"history-genres","objective":"直接判断汉书的叙述体例","prompt":"只问叙述体例，《汉书》属于哪一类？","options":["纪传体","编年体","国别体"],"answer":0,"explanation":"《汉书》的叙述体例是纪传体；它的记述范围另属于断代史。","boundary":"纪传体回答怎样叙述，断代史回答记述范围，二者不是互斥选项。","refs":[{"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-table"],"fingerprint":"a23c158b","label":"史学著作 · 史学著作表","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"history-hanshu-genre","primaryTargetIds":["cs-target-history-hanshu-genre"],"supportingTargetIds":[],"checkPurpose":"direct","distractorReasons":{"1":"《汉书》不是编年体。","2":"《汉书》不是国别体。"},"cognitiveLevel":"recall"}},{"id":"history-three-books-contrast","revision":1,"status":"review","scope":"humanities-history","group":"history-genres","objective":"对照三部史书的体例与范围","prompt":"哪组把三部史书的叙述体例和记述范围都配对正确？","options":["《史记》—纪传体通史；《资治通鉴》—编年体通史；《汉书》—纪传体断代史","《史记》—编年体通史；《资治通鉴》—纪传体通史；《汉书》—纪传体断代史","《史记》—纪传体断代史；《资治通鉴》—编年体断代史；《汉书》—纪传体通史"],"answer":0,"explanation":"《史记》是纪传体通史，《资治通鉴》是编年体通史，《汉书》是纪传体断代史。先判断体例，再判断范围。","boundary":"本题只对照三部史书的两个分类维度，不检测作者、篇目、记载年代或成书经过。","refs":[{"pointId":"fiction-history-modern-literature","tabId":"historiography-works","sourceUnitIds":["cs-10-15-p9-historiography-table"],"fingerprint":"a23c158b","label":"史学著作 · 史学著作表","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"history-three-books-contrast","primaryTargetIds":["cs-target-history-shiji-genre","cs-target-history-shiji-scope","cs-target-history-tongjian-genre","cs-target-history-tongjian-scope","cs-target-history-hanshu-genre","cs-target-history-hanshu-scope"],"supportingTargetIds":[],"checkPurpose":"cross-book-contrast","distractorReasons":{"1":"该项把《史记》和《资治通鉴》的叙述体例对调。","2":"该项把三部史书的记述范围配错。"},"cognitiveLevel":"distinction"}},{"id":"poet-titles-cross","revision":1,"status":"review","scope":"humanities-history","group":"poet-titles","objective":"在同一组选项中区分李白与杜甫的称号","prompt":"下列人物与称号的对应，哪一项完整正确？","options":["李白—诗圣；杜甫—诗仙","李白—诗仙；杜甫—诗圣","李白—诗史；杜甫—诗仙"],"answer":1,"explanation":"李白被称为诗仙，杜甫被称为诗圣。“诗史”评价杜甫的诗歌，不是李白的人物称号。","boundary":"本题只对照李白与杜甫的本批称号，不扩展到二人的全部文学评价。","refs":[{"pointId":"pre-qin-poetry","tabId":"li-bai","sourceUnitIds":["cs-10-15-p2-p3-li-bai-list"],"fingerprint":"989cbd62","label":"诗赋 · 李白","auditStatus":"ready-for-user-acceptance"},{"pointId":"pre-qin-poetry","tabId":"du-fu","sourceUnitIds":["cs-10-15-p3-du-fu-list"],"fingerprint":"d034f3ed","label":"诗赋 · 杜甫","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"poet-titles-cross","primaryTargetIds":["cs-target-poet-li-bai-title","cs-target-poet-du-fu-title"],"supportingTargetIds":["cs-target-poet-du-fu-poetry-history"],"checkPurpose":"scenario-contrast","distractorReasons":{"0":"该项把李白与杜甫的称号对调。","2":"诗史评价杜甫的诗歌，且杜甫并非诗仙。"},"cognitiveLevel":"application"}}]