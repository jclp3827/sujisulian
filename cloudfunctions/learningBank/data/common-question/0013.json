rceUnitIds":["cs-23-30-p11-market-structure-overview-list"],"fingerprint":"71ba7570","label":"市场结构理论 · 市场结构分类","auditStatus":"ready-for-user-acceptance"},{"pointId":"perfect-competition-market","tabId":"perfect-competition-conditions","sourceUnitIds":["cs-23-30-p11-perfect-competition-conditions-list"],"fingerprint":"d0486534","label":"完全竞争市场 · 存在条件","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-perfect-competition-core","primaryTargetIds":["cs-target-market-perfect-competition"],"supportingTargetIds":["cs-target-market-four-types"],"checkPurpose":"q2-economics-market-structure","distractorReasons":{"0":"垄断竞争中企业众多、产品有差别但可替代，与题干产品同质不符。","2":"寡头垄断由少数厂商控制，厂商决策相互依存且进入较难。"},"cognitiveLevel":"application"}}]