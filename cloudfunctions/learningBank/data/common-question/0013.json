[{"id":"si-derived-power-charge","revision":2,"status":"review","scope":"science-technology","group":"si-named-derived-units","objective":"把功率、电量与瓦特、库仑对应","prompt":"用电器功率标为W，电量标为C。两个具名导出单位依次是？","options":["焦耳和安培","伏特和欧姆","瓦特和库仑"],"answer":2,"explanation":"W表示瓦特，对应功率；C表示库仑，对应电量。","boundary":"安培对应电流，是基本单位；本题不推导电学公式。","refs":[{"pointId":"physics-other","tabId":"international-units","sourceUnitIds":["cs-16-22-p15-si-derived-units-list"],"fingerprint":"120ae3f8","label":"其他 · 国际单位","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"si-derived-power-charge","primaryTargetIds":["cs-target-si-derived-power-charge"],"supportingTargetIds":[],"checkPurpose":"q2-unit-application","distractorReasons":{"0":"焦耳对应能量；安培对应电流而不是电量。","1":"伏特对应电压，欧姆对应电阻。"},"cognitiveLevel":"application"}},{"id":"si-derived-voltage-resistance","revision":2,"status":"review","scope":"science-technology","group":"si-named-derived-units","objective":"把电压、电阻与伏特、欧姆对应","prompt":"电路表给出电压12 V、电阻6 Ω。V和Ω对应的单位名称依次是？","options":["库仑和安培","伏特和欧姆","瓦特和焦耳"],"answer":1,"explanation":"V表示伏特，对应电压；Ω表示欧姆，对应电阻。","boundary":"本题只识别单位对应，不进行欧姆定律计算。","refs":[{"pointId":"physics-other","tabId":"international-units","sourceUnitIds":["cs-16-22-p15-si-derived-units-list"],"fingerprint":"120ae3f8","label":"其他 · 国际单位","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"si-derived-voltage-resistance","primaryTargetIds":["cs-target-si-derived-voltage-resistance"],"supportingTargetIds":[],"checkPurpose":"q2-unit-application","distractorReasons":{"0":"库仑对应电量，安培对应电流。","2":"瓦特对应功率，焦耳对应能量。"},"cognitiveLevel":"application"}},{"id":"si-derived-full-contrast","revision":2,"status":"review","scope":"science-technology","group":"si-named-derived-units","objective":"综合复辨八个具名导出单位"