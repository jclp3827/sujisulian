[{"id":"market-monopolistic-competition-core","revision":2,"status":"review","scope":"economics","group":"market-structure-four-types","objective":"由企业众多、产品有差别且容易进入识别垄断竞争","prompt":"某行业企业众多，产品有差别但可以相互替代，进入退出相对容易。该行业最符合哪类结构？","options":["垄断竞争市场","买卖者众多、产品同质的市场","寡头垄断市场"],"answer":0,"explanation":"企业众多、同类产品存在差别但仍可替代、进入退出较容易，是垄断竞争的核心识别条件。","boundary":"本题按市场存在条件判断，不把广告、包装等具体竞争手段当成唯一依据。","refs":[{"pointId":"market-structure-overview","tabId":"market-structure-classification","sourceUnitIds":["cs-23-30-p11-market-structure-overview-list"],"fingerprint":"71ba7570","label":"市场结构理论 · 市场结构分类","auditStatus":"ready-for-user-acceptance"},{"pointId":"monopolistic-competition-market","tabId":"monopolistic-conditions","sourceUnitIds":["cs-23-30-p11-monopolistic-competition-conditions-list"],"fingerprint":"ae49b454","label":"垄断竞争市场 · 存在条件","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-monopolistic-competition-core","primaryTargetIds":["cs-target-market-monopolistic-competition"],"supportingTargetIds":["cs-target-market-four-types"],"checkPurpose":"q2-economics-market-structure","distractorReasons":{"1":"买卖者众多且产品同质更接近完全竞争，不符合题干产品有差别。","2":"寡头垄断只有少数厂商且决策相互依存，与题干企业众多不符。"},"cognitiveLevel":"application"}},{"id":"market-oligopoly-core","revision":2,"status":"review","scope":"economics","group":"market-structure-four-types","objective":"由少数厂商、进入较难和决策相互依存识别寡头垄断","prompt":"某行业只有少数几家厂商，新企业进入较难，每家调整产量或价格时都要考虑对手反应。该行业最符合哪类结构？","options":["买卖者众多、产品同质的市场","垄断竞争市场","寡头垄断市场"],"answer":2,"explanation":"少数厂商控制市场、进入较难且决策相互依存，共同指向寡头垄断。","boundary":"寡头产品可以同质，也可以有差别，不能仅凭产品差别排除寡头垄断。","refs":[{"pointId":"market-structure-overview","tabId":"market-structure-classification","sourceUnitIds":["cs-23-30-p11-market-structure-overview-list"],"fingerprint":"71ba7570","label":"市场结构理论 · 市场结构分类","auditStatus":"ready-for-user-acceptance"},{"pointId":"oligopoly-market","tabId":"oligopoly-meaning","sourceUnitIds":["cs-23-30-p12-oligopoly-meaning-list"],"fingerprint":"fb3b5807","label":"寡头垄断市场 · 市场含义","auditStatus":"ready-for-user-acceptance"},{"pointId":"oligopoly-market","tabId":"oligopoly-conditions","sourceUnitIds":["cs-23-30-p12-oligopoly-conditions-list"],"fingerprint":"4cf9a0dd","label":"寡头垄断市场 · 存在条件","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-oligopoly-core","primaryTargetIds":["cs-target-market-oligopoly"],"supportingTargetIds":["cs-target-market-four-types"],"checkPurpose":"q2-economics-market-structure","distractorReasons":{"0":"买卖者众多且产品同质的结构，不符合少数厂商相互依存的条件。","1":"垄断竞争中企业众多且进入退出较容易，与少数厂商和高进入障碍不符。"},"cognitiveLevel":"application"}},{"id":"market-monopoly-core","revision":2,"status":"review","scope":"economics","group":"market-structure-four-types","objective":"由唯一卖者、无近似替代品和进入障碍识别完全垄断","prompt":"整个行业只有一个卖者，产品没有十分近似的替代品，并存在明显进入障碍。该行业最符合哪类结构？","options":["完全垄断市场","寡头垄断市场","买卖者众多、产品同质的市场"],"answer":0,"explanation":"唯一卖者、无十分近似替代品并存在进入障碍，共同构成完全垄断的核心识别条件。","boundary":"唯一卖者与少数卖者含义不同；价格歧视是另一主题，不能用来替代市场结构判断。","refs":[{"pointId":"market-structure-overview","tabId":"market-structure-classification","sourceUnitIds":["cs-23-30-p11-market-structure-overview-list"],"fingerprint":"71ba7570","label":"市场结构理论 · 市场结构分类","auditStatus":"ready-for-user-acceptance"},{"pointId":"monopoly-market","tabId":"monopoly-meaning","sourceUnitIds":["cs-23-30-p12-monopoly-meaning-list"],"fingerprint":"20885137","label":"垄断市场 · 市场含义","auditStatus":"ready-for-user-acceptance"},{"pointId":"monopoly-market","tabId":"monopoly-conditions","sourceUnitIds":["cs-23-30-p12-monopoly-conditions-list"],"fingerprint":"1d021876","label":"垄断市场 · 存在条件","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-monopoly-core","primaryTargetIds":["cs-target-market-monopoly"],"supportingTargetIds":["cs-target-market-four-types"],"checkPurpose":"q2-economics-market-structure","distractorReasons":{"1":"寡头垄断由少数厂商控制市场，不是整个行业只有一个卖者。","2":"买卖者众多且产品同质的结构，不符合唯一卖者与进入障碍。"},"cognitiveLevel":"application"}},{"id":"price-discrimination-definition","revision":2,"status":"review","scope":"economics","group":"monopoly-price-discrimination","objective":"保留同等级同质量前提识别价格歧视","prompt":"在其他条件不变时，哪种做法符合价格歧视的定义前提？","options":["同等级同质量服务，向不同接受者采用不同价格","服务内容和质量提高后，统一采用更高收费标准","生产和配送成本上升后，对同一商品统一提高价格"],"answer":0,"explanation":"价格歧视的这一识别口径要求商品或服务等级、质量相同，却对不同接受者采用不同价格。","boundary":"质量、成本或服务内容不同造成的价差不能直接套用该定义；本题也不评价具体行为是否合法。","refs":[{"pointId":"monopoly-market","tabId":"monopoly-price-discrimination","sourceUnitIds":["cs-23-30-p12-monopoly-price-discrimination-list"],"fingerprint":"8a743e42","label":"垄断市场 · 价格歧视","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"price-discrimination-definition","primaryTargetIds":["cs-target-price-discrimination-definition"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-structure","distractorReasons":{"1":"质量不同造成的价格差异不满足同等级、同质量这一识别前提。","2":"成本变化后的统一提价没有体现对不同接受者采用不同价格。"},"cognitiveLevel":"distinction"}},{"id":"price-discrimination-first-degree","revision":2,"status":"review","scope":"economics","group":"monopoly-price-discrimination","objective":"由逐单位按最高支付意愿定价识别一级价格歧视","prompt":"厂商试图对每位消费者购买的每一单位产品，都按其愿意支付的最高价格出售。这属于哪一级价格歧视？","options":["一级价格歧视","二级价格歧视","三级价格歧视"],"answer":0,"explanation":"逐消费者、逐单位按最高支付意愿定价，是一级价格歧视的识别标准。","boundary":"这里只识别分级标准，不讨论实现这种定价所需的信息条件及福利结果。","refs":[{"pointId":"monopoly-market","tabId":"monopoly-price-discrimination","sourceUnitIds":["cs-23-30-p12-monopoly-price-discrimination-list"],"fingerprint":"8a743e42","label":"垄断市场 · 价格歧视","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"price-discrimination-first-degree","primaryTargetIds":["cs-target-price-discrimination-first-degree"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-structure","distractorReasons":{"1":"二级价格歧视按不同消费数量段定价，不逐单位探知个人最高支付意愿。","2":"三级价格歧视按不同市场或消费群定价，不逐单位确定最高支付意愿。"},"cognitiveLevel":"application"}}]