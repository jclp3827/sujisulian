[{"id":"price-discrimination-second-degree","revision":2,"status":"review","scope":"economics","group":"monopoly-price-discrimination","objective":"由消费数量段差别定价识别二级价格歧视","prompt":"同一种商品按购买数量划分区间，不同数量段适用不同单价。这属于哪一级价格歧视？","options":["一级价格歧视","二级价格歧视","三级价格歧视"],"answer":1,"explanation":"按消费数量段规定不同价格，是二级价格歧视的识别标准。","boundary":"判断依据是数量段，不是逐单位探知个人最高支付意愿，也不是按市场或人群划分。","refs":[{"pointId":"monopoly-market","tabId":"monopoly-price-discrimination","sourceUnitIds":["cs-23-30-p12-monopoly-price-discrimination-list"],"fingerprint":"8a743e42","label":"垄断市场 · 价格歧视","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"price-discrimination-second-degree","primaryTargetIds":["cs-target-price-discrimination-second-degree"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-structure","distractorReasons":{"0":"一级价格歧视逐消费者、逐单位按其最高支付意愿定价。","2":"三级价格歧视按不同市场或消费群定价，不以购买数量段为依据。"},"cognitiveLevel":"application"}},{"id":"price-discrimination-third-degree","revision":2,"status":"review","scope":"economics","group":"monopoly-price-discrimination","objective":"由不同市场或消费群差别定价识别三级价格歧视","prompt":"同等级同质量的服务，针对可以区分的不同市场或消费群采用不同价格。这属于哪一级价格歧视？","options":["一级价格歧视","二级价格歧视","三级价格歧视"],"answer":2,"explanation":"按不同市场或不同消费群采用不同价格，是三级价格歧视的识别标准。","boundary":"市场或人群必须能被区分；本题不判断现实分组是否合理、合法或能够持续。","refs":[{"pointId":"monopoly-market","tabId":"monopoly-price-discrimination","sourceUnitIds":["cs-23-30-p12-monopoly-price-discrimination-list"],"fingerprint":"8a743e42","label":"垄断市场 · 价格歧视","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"price-discrimination-third-degree","primaryTargetIds":["cs-target-price-discrimination-third-degree"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-structure","distractorReasons":{"0":"一级价格歧视逐消费者、逐单位按其最高支付意愿定价。","1":"二级价格歧视按不同消费数量段定价，不按市场或消费群划分。"},"cognitiveLevel":"application"}},{"id":"price-discrimination-three-levels","revision":2,"status":"review","scope":"economics","group":"monopoly-price-discrimination","objective":"综合还原一逐二量三人群的三级分法","prompt":"关于一级、二级、三级价格歧视的识别线索，哪组对应正确？","options":["一级看数量段；二级看市场人群；三级逐单位看最高支付意愿","一级逐单位看最高支付意愿；二级看数量段；三级看市场人群","一级看产品质量；二级统一定价；三级看生产成本"],"answer":1,"explanation":"一级逐单位看最高支付意愿，二级看消费数量段，三级看不同市场或消费群。","boundary":"三级划分须先保留同等级同质量而对不同接受者定价的定义前提。","refs":[{"pointId":"monopoly-market","tabId":"monopoly-price-discrimination","sourceUnitIds":["cs-23-30-p12-monopoly-price-discrimination-list"],"fingerprint":"8a743e42","label":"垄断市场 · 价格歧视","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"price-discrimination-three-levels","primaryTargetIds":["cs-target-price-discrimination-first-degree","cs-target-price-discrimination-second-degree","cs-target-price-discrimination-third-degree"],"supportingTargetIds":["cs-target-price-discrimination-definition"],"checkPurpose":"q2-economics-market-structure","distractorReasons":{"0":"该项把逐单位、数量段和市场人群三项识别线索全部错配。","2":"产品质量、统一定价和生产成本不是三级价格歧视的对应分级标准。"},"cognitiveLevel":"mapping"}},{"id":"market-failure-factor-monopoly","revision":2,"status":"review","scope":"economics","group":"market-failure-four-factors","objective":"由一个或少数大企业控制生产销售识别垄断因素","prompt":"某行业由一个大企业或少数几个大企业独占或联合控制产品生产和销售。这首先对应哪类市场失灵因素？","options":["垄断","公共物品","信息不对称"],"answer":0,"explanation":"一个大企业或少数几个大企业独占或联合控制相应产品的生产和销售，首先对应垄断因素。","boundary":"这里先完成四因素分类；垄断的作用链和治理方式在独立主题中继续学习。","refs":[{"pointId":"market-failure-factors","tabId":"market-failure-overview","sourceUnitIds":["cs-23-30-p13-market-failure-factors-overview-list"],"fingerprint":"86f27080","label":"导致市场失灵的因素 · 因素总览","auditStatus":"ready-for-user-acceptance"},{"pointId":"market-failure-factors","tabId":"market-failure-monopoly","sourceUnitIds":["cs-23-30-p13-market-failure-monopoly-list"],"fingerprint":"17030fd5","label":"导致市场失灵的因素 · 垄断","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-failure-factor-monopoly","primaryTargetIds":["cs-target-market-failure-monopoly-factor"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-failure","distractorReasons":{"1":"公共物品强调公共使用以及非竞争性、非排他性，不符合生产销售被控制的线索。","2":"信息不对称强调交易者拥有的信息不同，不符合生产销售被一个或少数企业控制。"},"cognitiveLevel":"application"}},{"id":"market-failure-factor-externality","revision":3,"status":"review","scope":"economics","group":"market-failure-four-factors","objective":"由经济活动影响无关第三方识别外部性因素","prompt":"某项经济活动让未直接参与交易的居民承担未获补偿的污染成本，且没有计入交易价格。这首先对应哪类市场失灵因素？","options":["公共物品","外部性","垄断"],"answer":1,"explanation":"未直接参与交易的第三方承担未计入价格、未获补偿的外部成本，属于外部性；本例是负外部性。","boundary":"第三方是未直接参与该交易，不是与经济活动毫无联系；仅有一般影响或正常价格变化不足以认定外部性。","refs":[{"pointId":"market-failure-factors","tabId":"market-failure-overview","sourceUnitIds":["cs-23-30-p13-market-failure-factors-overview-list"],"fingerprint":"86f27080","label":"导致市场失灵的因素 · 因素总览","auditStatus":"ready-for-user-acceptance"},{"pointId":"market-failure-factors","tabId":"market-failure-externality","sourceUnitIds":["cs-23-30-p13-market-failure-externality-list"],"fingerprint":"34362579","label":"导致市场失灵的因素 · 外部性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-failure-factor-externality","primaryTargetIds":["cs-target-market-failure-externality-factor"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-failure","distractorReasons":{"0":"公共物品的核心线索是非竞争性和非排他性，不是对无关第三方的影响。","2":"垄断强调一个或少数企业控制生产销售，不是经济活动对无关第三方的影响。"},"cognitiveLevel":"application"}}]