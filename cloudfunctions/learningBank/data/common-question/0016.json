[{"id":"market-failure-factor-public-goods","revision":2,"status":"review","scope":"economics","group":"market-failure-four-factors","objective":"由非竞争性和非排他性识别公共物品因素","prompt":"某物品供公众使用，严格意义上同时具有非竞争性和非排他性。这首先对应哪类市场失灵因素？","options":["公共物品","信息不对称","外部性"],"answer":0,"explanation":"严格意义上的公共物品具有非竞争性和非排他性，属于市场失灵四因素之一。","boundary":"本题只定位因素名称，不展开纯公共物品、准公共物品、搭便车和政府供给。","refs":[{"pointId":"market-failure-factors","tabId":"market-failure-overview","sourceUnitIds":["cs-23-30-p13-market-failure-factors-overview-list"],"fingerprint":"86f27080","label":"导致市场失灵的因素 · 因素总览","auditStatus":"ready-for-user-acceptance"},{"pointId":"market-failure-factors","tabId":"market-failure-public-goods","sourceUnitIds":["cs-23-30-p14-market-failure-public-goods-list"],"fingerprint":"3d42dd89","label":"导致市场失灵的因素 · 公共物品","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-failure-factor-public-goods","primaryTargetIds":["cs-target-market-failure-public-goods-factor"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-failure","distractorReasons":{"1":"信息不对称强调交易者掌握的信息不同，不对应非竞争性和非排他性。","2":"外部性强调经济活动对无关第三方的影响，不对应题干两个物品属性。"},"cognitiveLevel":"application"}},{"id":"market-failure-factor-information","revision":2,"status":"review","scope":"economics","group":"market-failure-four-factors","objective":"由交易者掌握信息不同识别信息不对称因素","prompt":"交易中的个人掌握的信息不同，一方难以充分了解另一方。这首先对应哪类市场失灵因素？","options":["生产销售垄断","信息不对称","公共物品供给"],"answer":1,"explanation":"交易中的个人拥有的信息不同，首先对应信息不对称因素。","boundary":"本题只做因素分类，不展开逆向选择、道德风险和信息调控。","refs":[{"pointId":"market-failure-factors","tabId":"market-failure-overview","sourceUnitIds":["cs-23-30-p13-market-failure-factors-overview-list"],"fingerprint":"86f27080","label":"导致市场失灵的因素 · 因素总览","auditStatus":"ready-for-user-acceptance"},{"pointId":"market-failure-factors","tabId":"market-failure-information","sourceUnitIds":["cs-23-30-p14-market-failure-information-asymmetry-list"],"fingerprint":"96df1f75","label":"导致市场失灵的因素 · 信息不对称","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-failure-factor-information","primaryTargetIds":["cs-target-market-failure-information-factor"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-failure","distractorReasons":{"0":"垄断强调生产销售的独占或联合控制，不是交易者之间的信息差异。","2":"公共物品强调非竞争性和非排他性，不是交易者掌握的信息不同。"},"cognitiveLevel":"application"}},{"id":"market-failure-four-factors-full","revision":2,"status":"review","scope":"economics","group":"market-failure-four-factors","objective":"完整复辨市场失灵四类因素","prompt":"下列哪组完整列出四类主要市场失灵因素？","options":["垄断、外部性、公共物品、信息不对称","通货膨胀、失业、财政赤字、贸易逆差","需求、供给、价格、市场竞争"],"answer":0,"explanation":"四类主要因素是垄断、外部性、公共物品和信息不对称。","boundary":"完整名单只建立入口框架，不能替代四类因素各自条件和作用机制的学习。","refs":[{"pointId":"market-failure-factors","tabId":"market-failure-overview","sourceUnitIds":["cs-23-30-p13-market-failure-factors-overview-list"],"fingerprint":"86f27080","label":"导致市场失灵的因素 · 因素总览","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-failure-four-factors-full","primaryTargetIds":["cs-target-market-failure-monopoly-factor","cs-target-market-failure-externality-factor","cs-target-market-failure-public-goods-factor","cs-target-market-failure-information-factor"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-failure","distractorReasons":{"1":"该组属于常见宏观经济现象或指标，没有完整列出四类市场失灵因素。","2":"该组描述市场运行的一般要素，没有完整列出四类市场失灵因素。"},"cognitiveLevel":"recall"}},{"id":"market-failure-monopoly-definition","revision":2,"status":"review","scope":"economics","group":"market-failure-monopoly-mechanism","objective":"识别垄断所要求的独占或联合控制条件","prompt":"下列哪种情形最符合垄断的核心含义？","options":["一个或少数大企业独占或联合控制产品生产和销售","许多企业自由进入市场并以同质产品开展充分竞争","交易双方掌握的信息不同，一方更了解商品质量"],"answer":0,"explanation":"垄断强调一个大企业或少数几个大企业对相应产品生产和销售的独占或联合控制。","boundary":"企业规模较大或商品价格较高，都不能单独替代生产和销售的控制条件。","refs":[{"pointId":"market-failure-factors","tabId":"market-failure-monopoly","sourceUnitIds":["cs-23-30-p13-market-failure-monopoly-list"],"fingerprint":"17030fd5","label":"导致市场失灵的因素 · 垄断","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-failure-monopoly-definition","primaryTargetIds":["cs-target-market-failure-monopoly-definition"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-failure","distractorReasons":{"1":"众多企业自由进入且提供同质产品，属于竞争条件，不符合独占或联合控制。","2":"交易者信息不同对应信息不对称，不等于企业控制生产和销售。"},"cognitiveLevel":"condition"}},{"id":"market-failure-monopoly-chain","revision":3,"status":"review","scope":"economics","group":"market-failure-monopoly-mechanism","objective":"还原垄断控制供给到市场机制失灵的作用链","prompt":"哪条链路正确说明垄断可能导致市场机制失灵？","options":["增加企业数量→充分竞争→信息更完整→机制失灵","限制供给并提高价格→产量可能偏离有效竞争水平→资源配置效率受损","提高劳动效率→降低单位成本→消费者选择增加→机制失灵"],"answer":1,"explanation":"市场势力可能使企业限制产量、提高价格，使产量偏离有效竞争水平并造成效率损失。单纯价格上涨或企业规模较大不能直接证明该机制。","boundary":"链路起点是对供给的控制，不能看到高价就跳过控制供给和调节产量两个环节。","refs":[{"pointId":"market-failure-factors","tabId":"market-failure-monopoly","sourceUnitIds":["cs-23-30-p13-market-failure-monopoly-list"],"fingerprint":"17030fd5","label":"导致市场失灵的因素 · 垄断","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-failure-monopoly-chain","primaryTargetIds":["cs-target-market-failure-monopoly-chain"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-failure","distractorReasons":{"0":"企业增加和充分竞争与垄断控制供给的起点相反，不能形成该作用链。","2":"提高效率、降低成本和增加选择不构成垄断导致市场失灵的作用链。"},"cognitiveLevel":"mapping"}}]