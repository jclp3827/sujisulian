[{"id":"income-distribution-full","revision":3,"status":"review","scope":"economics","group":"income-distribution-core","objective":"综合复辨收入政策和三次分配的主体方式","prompt":"关于收入分配政策和三次分配，下列说法正确的是？","options":["收入政策关注水平与差距；初次分配依据要素贡献，再分配通过税收社保等调节，第三次分配强调自愿公益","初次分配不需要任何公平规则；第三次分配可强制摊派并替代政府法定责任","三次分配只按金额大小区分，与主体、机制及自愿性无关"],"answer":0,"explanation":"三种机制协调配套，不能把初次分配等同企业内部工资分配，也不能将自愿公益变为强制摊派或替代政府法定责任。","boundary":"不扩展具体税制、固定比例或来源可疑的基尼系数阈值。","refs":[{"pointId":"income-distribution-policy","tabId":"income-policy-overview","sourceUnitIds":["cs-23-30-p21-income-distribution-overview-list"],"fingerprint":"3858d041","label":"收入分配政策 · 政策总览","auditStatus":"ready-for-user-acceptance"},{"pointId":"income-distribution-policy","tabId":"income-distribution-stages","sourceUnitIds":["cs-23-30-p21-income-distribution-stages-list"],"fingerprint":"1f56b647","label":"收入分配政策 · 三次分配","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"income-distribution-full","primaryTargetIds":["cs-target-income-policy-overview","cs-target-initial-distribution","cs-target-redistribution","cs-target-third-distribution"],"supportingTargetIds":[],"checkPurpose":"q2-economics-income-distribution","distractorReasons":{"1":"初次分配仍需制度保障，第三次须自愿且不能替代法定责任。","2":"分配机制依主体、过程和自愿性区分，不以金额划分。"},"cognitiveLevel":"synthesis"}},{"id":"trade-composition","revision":2,"status":"review","scope":"economics","group":"international-trade-core","objective":"由跨越国境的商品和服务交换识别进出口贸易构成","prompt":"甲国从乙国购买商品，同时向丙国销售本国服务。按国际贸易的基本构成，这两类活动分别属于什么？","options":["进口贸易和出口贸易","国内零售和政府采购","资本流入和财政支出"],"answer":0,"explanation":"从他国购买属于进口，向他国销售属于出口；进口贸易与出口贸易共同构成国际贸易。","boundary":"本题识别进出口基本构成，不展开服务贸易统计口径。","refs":[{"pointId":"international-trade","tabId":"international-trade-meaning","sourceUnitIds":["cs-23-30-p22-international-trade-meaning-list"],"fingerprint":"dc4c4944","label":"国际贸易 · 贸易构成","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"trade-composition","primaryTargetIds":["cs-target-trade-composition"],"supportingTargetIds":[],"checkPurpose":"q2-economics-international-trade","distractorReasons":{"1":"两项活动跨越国境，不属于国内零售或政府采购。","2":"题干描述商品和服务买卖，不是资本流动或财政支出。"},"cognitiveLevel":"application"}},{"id":"trade-surplus","revision":2,"status":"review","scope":"economics","group":"international-trade-core","objective":"由出口额大于进口额识别顺差和出超","prompt":"某国同期出口额为1200亿元，进口额为1000亿元。该国这一贸易差额应表述为？","options":["贸易逆差，也称入超","贸易顺差，也称出超","财政盈余，也称结余"],"answer":1,"explanation":"出口额大于进口额形成贸易顺差，顺差也称出超。","boundary":"本题只判断差额方向和名称，不评价顺差的利弊。","refs":[{"pointId":"international-trade","tabId":"international-trade-balance","sourceUnitIds":["cs-23-30-p22-international-trade-balance-list"],"fingerprint":"36b42013","label":"国际贸易 · 顺差与逆差","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"trade-surplus","primaryTargetIds":["cs-target-trade-surplus"],"supportingTargetIds":[],"checkPurpose":"q2-economics-international-trade","distractorReasons":{"0":"逆差对应出口额小于进口额，与题干方向相反。","2":"财政盈余描述政府财政收支，不是进出口差额名称。"},"cognitiveLevel":"application"}},{"id":"trade-deficit","revision":2,"status":"review","scope":"economics","group":"international-trade-core","objective":"由出口额小于进口额识别逆差和入超","prompt":"某国同期出口额为800亿元，进口额为950亿元。该国这一贸易差额应表述为？","options":["贸易顺差，也称出超","财政赤字，也称亏空","贸易逆差，也称入超"],"answer":2,"explanation":"出口额小于进口额形成贸易逆差，逆差也称入超。","boundary":"本题只判断差额方向和名称，不评价逆差的利弊。","refs":[{"pointId":"international-trade","tabId":"international-trade-balance","sourceUnitIds":["cs-23-30-p22-international-trade-balance-list"],"fingerprint":"36b42013","label":"国际贸易 · 顺差与逆差","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"trade-deficit","primaryTargetIds":["cs-target-trade-deficit"],"supportingTargetIds":[],"checkPurpose":"q2-economics-international-trade","distractorReasons":{"0":"顺差对应出口额大于进口额，与题干方向相反。","1":"财政赤字描述政府财政收支，不是进出口差额名称。"},"cognitiveLevel":"application"}},{"id":"international-trade-full","revision":2,"status":"review","scope":"economics","group":"international-trade-core","objective":"综合复辨进出口构成和顺逆差方向","prompt":"关于国际贸易及其差额，下列说法正确的是？","options":["国际贸易由进口和出口贸易组成；出口额大于进口额为顺差，反之为逆差","国际贸易只包括商品出口而不包括进口；出口额大于进口额为逆差，反之为顺差","国际贸易由境内零售和政府采购共同组成；出口额与进口额的差额称为财政收支差额"],"answer":0,"explanation":"进口与出口构成国际贸易；比较出口额与进口额可判断顺差或逆差。","boundary":"不依据顺逆差名称直接判断一国经济状况。","refs":[{"pointId":"international-trade","tabId":"international-trade-meaning","sourceUnitIds":["cs-23-30-p22-international-trade-meaning-list"],"fingerprint":"dc4c4944","label":"国际贸易 · 贸易构成","auditStatus":"ready-for-user-acceptance"},{"pointId":"international-trade","tabId":"international-trade-balance","sourceUnitIds":["cs-23-30-p22-international-trade-balance-list"],"fingerprint":"36b42013","label":"国际贸易 · 顺差与逆差","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"international-trade-full","primaryTargetIds":["cs-target-trade-composition","cs-target-trade-surplus","cs-target-trade-deficit"],"supportingTargetIds":[],"checkPurpose":"q2-economics-international-trade","distractorReasons":{"1":"国际贸易也包括进口，且该项颠倒顺差和逆差方向。","2":"国内零售和政府采购不能替代进出口构成，贸易差额也不等同财政差额。"},"cognitiveLevel":"synthesis"}}]