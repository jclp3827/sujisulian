[{"id":"market-feature-property","revision":2,"status":"review","scope":"economics","group":"market-features-foundation","objective":"由权属边界识别产权确定性","prompt":"公司章程和登记资料清楚区分出资者权利与公司法人财产权，使经营责任和收益归属有明确边界。这体现市场经济的？","options":["产权的确定性","体系的开放性","政府干预范围的有限性"],"answer":0,"explanation":"权利归属、财产权边界和责任收益能够明确识别，体现产权确定性。","boundary":"本题识别权属边界，不评价某一具体企业制度安排。","refs":[{"pointId":"market-economy-features","tabId":"market-feature-1","sourceUnitIds":["cs-23-30-p7-market-feature-property-list"],"fingerprint":"f8761fc5","label":"市场经济的特征 · 产权的确定性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-feature-property","primaryTargetIds":["cs-target-market-feature-property"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-features-foundation","distractorReasons":{"1":"开放性关注要素和商品跨区域流动。","2":"题干直接描述权利归属与财产权边界。"},"cognitiveLevel":"application"}},{"id":"market-feature-equality","revision":2,"status":"review","scope":"economics","group":"market-features-foundation","objective":"由自愿协商识别主体平等性","prompt":"两家企业地位对等，自愿决定是否交易，并共同协商价格、交付和违约责任。这体现市场经济的？","options":["活动的竞争性","主体的平等性","行为的法制性"],"answer":1,"explanation":"地位对等、自愿交易和共同议定条件，是主体平等性的直接线索。","boundary":"主体平等指市场地位和交易自主，不表示经营能力或结果相同。","refs":[{"pointId":"market-economy-features","tabId":"market-feature-2","sourceUnitIds":["cs-23-30-p7-market-feature-equality-list"],"fingerprint":"85401428","label":"市场经济的特征 · 市场参与主体的平等性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-feature-equality","primaryTargetIds":["cs-target-market-feature-equality"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-features-foundation","distractorReasons":{"0":"题干没有强调经营者争夺客户或优胜劣汰。","2":"题干核心是对等自愿协商，而非违法制裁与规则执行。"},"cognitiveLevel":"application"}},{"id":"market-feature-competition","revision":2,"status":"review","scope":"economics","group":"market-features-foundation","objective":"由优胜劣汰识别活动竞争性","prompt":"同一行业的经营者通过技术、质量和服务争取客户，经营不善者可能退出市场。这体现市场经济的？","options":["产权的确定性","主体的平等性","活动的竞争性"],"answer":2,"explanation":"经营者争取客户并发生生存、发展或退出，体现市场活动的竞争性。","boundary":"竞争应在法律和市场秩序规则内进行。","refs":[{"pointId":"market-economy-features","tabId":"market-feature-3","sourceUnitIds":["cs-23-30-p7-market-feature-competition-list"],"fingerprint":"3333e473","label":"市场经济的特征 · 经济活动的竞争性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-feature-competition","primaryTargetIds":["cs-target-market-feature-competition"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-features-foundation","distractorReasons":{"0":"题干没有讨论财产权属边界。","1":"题干重点是经营者争取客户和退出压力。"},"cognitiveLevel":"application"}},{"id":"market-features-foundation-full","revision":2,"status":"review","scope":"economics","group":"market-features-foundation","objective":"综合复辨产权主体和活动三个对象","prompt":"下列市场经济特征与判断线索的对应正确的是？","options":["产权确定看权属边界；主体平等看自愿协商；活动竞争看争取客户与优胜劣汰","产权确定看要素跨区流动；主体平等看行政命令；活动竞争看经营者退出市场受到禁止","产权确定看价格涨跌；主体平等看经营结果一致；活动竞争看交易双方地位从属"],"answer":0,"explanation":"正确项把产权、主体、活动三个对象分别对应权属明确、自愿协商和竞争选择。","boundary":"三个对象不能互换；平等不等于结果一致，竞争也须受规则约束。","refs":[{"pointId":"market-economy-features","tabId":"market-feature-1","sourceUnitIds":["cs-23-30-p7-market-feature-property-list"],"fingerprint":"f8761fc5","label":"市场经济的特征 · 产权的确定性","auditStatus":"ready-for-user-acceptance"},{"pointId":"market-economy-features","tabId":"market-feature-2","sourceUnitIds":["cs-23-30-p7-market-feature-equality-list"],"fingerprint":"85401428","label":"市场经济的特征 · 市场参与主体的平等性","auditStatus":"ready-for-user-acceptance"},{"pointId":"market-economy-features","tabId":"market-feature-3","sourceUnitIds":["cs-23-30-p7-market-feature-competition-list"],"fingerprint":"3333e473","label":"市场经济的特征 · 经济活动的竞争性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-features-foundation-full","primaryTargetIds":["cs-target-market-feature-property","cs-target-market-feature-equality","cs-target-market-feature-competition"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-features-foundation","distractorReasons":{"1":"要素流动属于开放性，行政命令和禁止退出也与相应特征不符。","2":"价格涨跌、结果一致和地位从属均不能对应这三项特征。"},"cognitiveLevel":"synthesis"}},{"id":"market-feature-legality","revision":2,"status":"review","scope":"economics","group":"market-features-order","objective":"由规则约束与违法制裁识别行为法制性","prompt":"经营者订立合同、发布广告和参与竞争都须遵守法律；欺诈、垄断等违法行为会受到追究。这体现市场经济的？","options":["行为的法制性","体系的封闭性","产权边界的不确定性"],"answer":0,"explanation":"市场行为有法律规范，违法行为承担相应责任，体现行为法制性。","boundary":"法制性约束交易和竞争行为，不等于政府代替市场作经营决策。","refs":[{"pointId":"market-economy-features","tabId":"market-feature-4","sourceUnitIds":["cs-23-30-p7-market-feature-legality-list"],"fingerprint":"3a0f0bbd","label":"市场经济的特征 · 经济行为的法制性","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"market-feature-legality","primaryTargetIds":["cs-target-market-feature-legality"],"supportingTargetIds":[],"checkPurpose":"q2-economics-market-features-order","distractorReasons":{"1":"题干强调守法与违法责任，并非封闭体系。","2":"权属边界不是本题的行为规则线索。"},"cognitiveLevel":"application"}}]