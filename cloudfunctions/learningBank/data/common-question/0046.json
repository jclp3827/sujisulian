cation":{"questionId":"supply-demand-equilibrium-full","primaryTargetIds":["cs-target-equilibrium-meaning","cs-target-equilibrium-price-quantity","cs-target-equilibrium-price-limits"],"supportingTargetIds":[],"checkPurpose":"q2-economics-equilibrium","distractorReasons":{"1":"均衡同时有价格和数量，该项还反置两类限价位置。","2":"均衡要求供需量相等，价格与数量也不能互换。"},"cognitiveLevel":"synthesis"}}]