[{"id":"demand-supply-basic-full","revision":3,"status":"review","scope":"economics","group":"demand-supply-basic-core","objective":"综合复辨需求供给主体条件弹性和影响因素","prompt":"关于需求和供给，下列说法正确的是？","options":["需求看消费者愿买且能买，供给看生产者愿卖且能供；需求价格弹性比较量变与价变的百分比，成本也会影响供给","需求由生产者出售意愿决定，供给由消费者购买愿望决定；价格弹性只比较企业成本，成本上升推动供给增加","需求有购买愿望即可，供给有生产意愿即可；需求量不受价格变化影响，生产成本也不进入供给判断"],"answer":0,"explanation":"需求和供给均要求意愿与能力同时具备；需求价格弹性比较需求量与价格的百分比变化。在其他条件不变时，成本上升通常抑制供给。","boundary":"本组不纳入待核需求因素分类，也不预测具体商品的供给数量。","refs":[{"pointId":"microeconomics","tabId":"demand-meaning","sourceUnitIds":["cs-23-30-p8-demand-meaning-list"],"fingerprint":"e884ba88","label":"需求 · 需求含义","auditStatus":"ready-for-user-acceptance"},{"pointId":"microeconomics","tabId":"demand-price-elasticity","sourceUnitIds":["cs-23-30-p9-demand-price-elasticity-list"],"fingerprint":"a6d01206","label":"需求 · 价格弹性","auditStatus":"ready-for-user-acceptance"},{"pointId":"supply-theory","tabId":"supply-meaning","sourceUnitIds":["cs-23-30-p10-supply-meaning-list"],"fingerprint":"f47fce5c","label":"供给 · 供给含义","auditStatus":"ready-for-user-acceptance"},{"pointId":"supply-theory","tabId":"supply-factors","sourceUnitIds":["cs-23-30-p10-supply-factors-list"],"fingerprint":"6acff87","label":"供给 · 影响因素","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"demand-supply-basic-full","primaryTargetIds":["cs-target-demand-meaning","cs-target-demand-price-elasticity","cs-target-supply-meaning","cs-target-supply-factors"],"supportingTargetIds":[],"checkPurpose":"q2-economics-demand-supply-basics","distractorReasons":{"1":"该项颠倒需求供给主体，并错写弹性与成本方向。","2":"需求供给都须愿意与能够同时具备，价格和成本也会影响判断。"},"cognitiveLevel":"synthesis"}},{"id":"equilibrium-meaning","revision":2,"status":"review","scope":"economics","group":"supply-demand-equilibrium-core","objective":"由供给量等于需求量识别市场均衡","prompt":"在某一价格水平上，消费者愿意购买的数量恰好等于生产者愿意提供的数量。该市场状态称为？","options":["供求均衡","供不应求","供过于求"],"answer":0,"explanation":"供给量与需求量在特定价格上相等，构成供求均衡。","boundary":"均衡是分析状态，不表示市场价格此后不再变化。","refs":[{"pointId":"supply-demand-equilibrium","tabId":"equilibrium-meaning","sourceUnitIds":["cs-23-30-p10-equilibrium-meaning-list"],"fingerprint":"45786f0d","label":"供求均衡 · 供求均衡","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"equilibrium-meaning","primaryTargetIds":["cs-target-equilibrium-meaning"],"supportingTargetIds":[],"checkPurpose":"q2-economics-equilibrium","distractorReasons":{"1":"供不应求表示需求量大于供给量。","2":"供过于求表示供给量大于需求量。"},"cognitiveLevel":"application"}},{"id":"equilibrium-price-quantity","revision":2,"status":"review","scope":"economics","group":"supply-demand-equilibrium-core","objective":"区分均衡价格与均衡数量","prompt":"某商品在每件 50 元时需求量和供给量都为 100 件。这里的 50 元和 100 件分别是？","options":["均衡数量、均衡价格","均衡价格、均衡数量","最高限价、最低限价"],"answer":1,"explanation":"供需相等时的价格是均衡价格，该价格下相等的数量是均衡数量。","boundary":"价格和数量是两个不同维度，不能互换。","refs":[{"pointId":"supply-demand-equilibrium","tabId":"equilibrium-price-quantity","sourceUnitIds":["cs-23-30-p10-equilibrium-price-quantity-list"],"fingerprint":"88406116","label":"供求均衡 · 价格与数量","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"equilibrium-price-quantity","primaryTargetIds":["cs-target-equilibrium-price-quantity"],"supportingTargetIds":[],"checkPurpose":"q2-economics-equilibrium","distractorReasons":{"0":"50 元是价格维度，100 件是数量维度。","2":"题干没有设置价格管制。"},"cognitiveLevel":"application"}},{"id":"equilibrium-price-limits","revision":2,"status":"review","scope":"economics","group":"supply-demand-equilibrium-core","objective":"识别有约束力的最高最低限价位置","prompt":"为了使价格管制实际约束市场价格，有约束力的最高限价与最低限价通常分别设在均衡价格的哪一侧？","options":["最高限价低于均衡价，最低限价高于均衡价","最高限价高于均衡价，最低限价低于均衡价","最高限价和最低限价都设为均衡数量"],"answer":0,"