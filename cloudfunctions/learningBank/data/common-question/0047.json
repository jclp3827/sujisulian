[{"id":"supply-demand-direction","revision":2,"status":"review","scope":"economics","group":"supply-demand-direction-core","objective":"根据供求相对大小判断价格变化方向","prompt":"其他条件基本不变时，某商品需求增加而短期供给未及时增加，市场出现供不应求。价格通常会怎样变化？","options":["趋于上升","趋于下降","与供求变化没有关系"],"answer":0,"explanation":"需求大于供给时，买方竞争增强，价格通常趋于上升。","boundary":"这是一般方向判断，不预测具体幅度和持续时间。","refs":[{"pointId":"supply-demand-law","tabId":"supply-demand-law","sourceUnitIds":["cs-23-30-p11-supply-demand-law-list"],"fingerprint":"2ec686ac","label":"供求法则 · 供求法则","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"supply-demand-direction","primaryTargetIds":["cs-target-supply-demand-direction"],"supportingTargetIds":[],"checkPurpose":"q2-economics-supply-demand-market","distractorReasons":{"1":"供不应求通常带来价格上行压力。","2":"供求相对变化是价格方向的重要影响因素。"},"cognitiveLevel":"application"}},{"id":"buyer-market","revision":2,"status":"review","scope":"economics","group":"supply-demand-direction-core","objective":"由供给大于需求识别买方市场","prompt":"某类商品供给充足而需求相对不足，销售者主动降价并改善服务以争取顾客。此时更接近？","options":["卖方市场，卖方选择余地更大","买方市场，买方选择余地更大","均衡数量，买卖双方都不作选择"],"answer":1,"explanation":"供给大于需求时，买方可选择的商品和卖方更多，交易中买方相对有利。","boundary":"买方市场描述供求相对关系，不表示每位买方都能决定价格。","refs":[{"pointId":"supply-demand-law","tabId":"buyer-seller-market","sourceUnitIds":["cs-23-30-p11-buyer-seller-market-list"],"fingerprint":"8f272bd7","label":"供求法则 · 买方与卖方市场","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"buyer-market","primaryTargetIds":["cs-target-buyer-market"],"supportingTargetIds":[],"checkPurpose":"q2-economics-supply-demand-market","distractorReasons":{"0":"供给充足、卖方争取顾客时买方相对有利。","2":"题干描述交易地位，不是均衡数量概念。"},"cognitiveLevel":"application"}},{"id":"seller-market","revision":2,"status":"review","scope":"economics","group":"supply-demand-direction-core","objective":"由需求大于供给识别卖方市场","prompt":"某类商品短期供应不足而购买者较多，多个买方竞相购买。此时更接近？","options":["买方市场，买方可以在更多卖方和商品之间选择","卖方市场，卖方相对处于有利地位","供给过剩，卖方需要主动降价并改善服务争抢顾客"],"answer":1,"explanation":"需求大于供给时，商品相对稀缺，卖方在交易中通常更有利。","boundary":"卖方市场不表示卖方可以违反交易规则。","refs":[{"pointId":"supply-demand-law","tabId":"buyer-seller-market","sourceUnitIds":["cs-23-30-p11-buyer-seller-market-list"],"fingerprint":"8f272bd7","label":"供求法则 · 买方与卖方市场","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"seller-market","primaryTargetIds":["cs-target-seller-market"],"supportingTargetIds":[],"checkPurpose":"q2-economics-supply-demand-market","distractorReasons":{"0":"供应不足而买方竞争时卖方相对有利。","2":"题干是供不应求，不是供给过剩。"},"cognitiveLevel":"application"}},{"id":"supply-demand-market-full","revision":2,"status":"review","scope":"economics","group":"supply-demand-direction-core","objective":"综合复辨供求方向与买卖方市场","prompt":"关于供求关系、价格方向和交易地位，下列对应正确的是？","options":["需大于供时价格趋升并偏卖方市场；供大于需时价格趋降并偏买方市场","需大于供时价格趋降并偏买方市场；供大于需时价格趋升并偏卖方市场","买方市场和卖方市场按经营者产权性质区分，与供求数量及交易选择没有关系"],"answer":0,"explanation":"需求相对多时商品更稀缺、卖方相对有利；供给相对多时买方选择更多。","boundary":"对应关系用于一般分析，不直接预测某一商品的实际价格。","refs":[{"pointId":"supply-demand-law","tabId":"supply-demand-law","sourceUnitIds":["cs-23-30-p11-supply-demand-law-list"],"fingerprint":"2ec686ac","label":"供求法则 · 供求法则","auditStatus":"ready-for-user-acceptance"},{"pointId":"supply-demand-law","tabId":"buyer-seller-market","sourceUnitIds":["cs-23-30-p11-buyer-seller-market-list"],"fingerprint":"8f272bd7","label":"供求法则 · 买方与卖方市场","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"supply-demand-market-full","primaryTargetIds":["cs-target-supply-demand-direction","cs-target-buyer-market","cs-target-seller-market"],"supporting