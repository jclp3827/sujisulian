[{"id":"visible-order-core","revision":2,"status":"review","scope":"science-technology","group":"optics-light-basics","objective":"判断可见光由红到紫时波长与频率的变化","prompt":"把可见光按红、橙、黄、绿、青、蓝、紫排列。由红端走向紫端时，波长和频率怎样变化？","options":["波长增大，频率减小","波长减小，频率增大","波长和频率都增大"],"answer":1,"explanation":"由红到紫，波长逐渐减小，频率逐渐增大。","boundary":"本题只判断相对变化方向，不要求计算具体数值。","refs":[{"pointId":"optics","tabId":"light-nature","sourceUnitIds":["cs-16-22-p10-p11-light-nature-list"],"fingerprint":"79c425bb","label":"光学 · 光的本质","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"visible-order-core","primaryTargetIds":["cs-target-visible-order"],"supportingTargetIds":[],"checkPurpose":"q2-optics-application","distractorReasons":{"0":"由红到紫时波长减小、频率增大，该项两个方向都相反。","2":"由红到紫时频率增大，但波长不会同时增大。"},"cognitiveLevel":"application"}},{"id":"light-basics-full","revision":2,"status":"review","scope":"science-technology","group":"optics-light-basics","objective":"综合运用光的属性、光年、可见范围和红紫方向","prompt":"某同学整理光学基础卡片。下列哪张卡片的四项对应都正确？","options":["光—机械波；光年—时间；可见光—人眼不可见；红到紫—波长增大","光—电磁波；光年—速度；可见光—只含紫光；红到紫—频率减小","光—电磁波；光年—长度；可见光—人眼可感知；红到紫—波长减小"],"answer":2,"explanation":"光是电磁波，光年衡量长度，可见光可被人眼感知，红到紫波长减小。","boundary":"综合题不涉及光年换算和完整电磁波谱。","refs":[{"pointId":"optics","tabId":"light-nature","sourceUnitIds":["cs-16-22-p10-p11-light-nature-list"],"fingerprint":"79c425bb","label":"光学 · 光的本质","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"light-basics-full","primaryTargetIds":["cs-target-light-electromagnetic","cs-target-light-year","cs-target-visible-light","cs-target-visible-order"],"supportingTargetIds":[],"checkPurpose":"q2-optics-application","distractorReasons":{"0":"光的属性、光年的物理量、可见性和红紫方向均不正确。","1":"光是电磁波正确，但光年不是速度，可见光不只含紫光，红到紫频率增大。"},"cognitiveLevel":"synthesis"}},{"id":"infrared-wavelength-core","revision":2,"status":"review","scope":"science-technology","group":"optics-infrared-ultraviolet","objective":"利用光谱位置识别红外线的波长与可见性","prompt":"红外线位于可见光红端之外。与可见光相比，红外线通常具有哪组特征？","options":["波更长，人眼不可见","波长更短，人眼可见","波长相同，人眼可见"],"answer":0,"explanation":"红外线位于红端之外，波长比可见光长，人眼不能直接看到。","boundary":"本题只比较波长和可见性，不扩展完整电磁波谱。","refs":[{"pointId":"optics","tabId":"light-nature","sourceUnitIds":["cs-16-22-p10-p11-light-nature-list"],"fingerprint":"79c425bb","label":"光学 · 光的本质","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"infrared-wavelength-core","primaryTargetIds":["cs-target-infrared-wavelength"],"supportingTargetIds":[],"checkPurpose":"q2-optics-application","distractorReasons":{"1":"红外线波长比可见光长，而且人眼不可见。","2":"红外线与可见光波长范围不同，人眼也不能直接看到红外线。"},"cognitiveLevel":"application"}},{"id":"infrared-applications-core","revision":2,"status":"review","scope":"science-technology","group":"optics-infrared-ultraviolet","objective":"从设备用途识别红外线应用","prompt":"夜间救援要根据物体热辐射形成图像。下列设备最符合这一用途的是？","options":["紫外消毒灯","验钞灯","热成像仪"],"answer":2,"explanation":"红外热成像仪利用红外辐射形成热分布图像；消毒和验钞常用紫外线。","boundary":"本题识别典型应用，不讨论设备操作或医学用途。","refs":[{"pointId":"optics","tabId":"light-nature","sourceUnitIds":["cs-16-22-p10-p11-light-nature-list"],"fingerprint":"79c425bb","label":"光学 · 光的本质","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"infrared-applications-core","primaryTargetIds":["cs-target-infrared-applications"],"supportingTargetIds":[],"checkPurpose":"q2-optics-application","distractorReasons":{"0":"紫外消毒灯利用紫外线的杀菌作用。","1":"验钞灯常利用紫外线激发荧光，不是红外热成像用途。"},"cognitiveLevel":"application"}},{"id":"ultraviolet-wavelength-core","revision":2,"status":"review","scope":"science-technology","group":"optics-infrared-ultraviolet","objective":"利用光谱位置识别紫外线的波长、可见性和臭氧吸收","prompt":"太阳辐射中的一种光位于可见光紫端之外，人眼看不见，并会被大气臭氧吸收。它是？","options":["红外线","紫外线","可见红光"],"answer":1,"explanation":"紫外线位于紫端之外，波长比可见光短，人眼不可见，太阳紫外线会被臭氧吸收。","boundary":"本题不讨论紫外暴露剂量和防护建议。","refs":[{"pointId":"optics","tabId":"light-nature","sourceUnitIds":["cs-16-22-p10-p11-light-nature-list"],"fingerprint":"79c425bb","label":"光学 · 光的本质","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"ultraviolet-wavelength-core","primaryTargetIds":["cs-target-ultraviolet-wavelength"],"supportingTargetIds":[],"checkPurpose":"q2-optics-application","distractorReasons":{"0":"红外线位于红端之外，波长比可见光长，不符合臭氧吸收线索。","2":"可见红光能被人眼看到，也不位于紫端之外。"},"cognitiveLevel":"application"}}]