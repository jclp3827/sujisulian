[{"id":"ultraviolet-applications-core","revision":2,"status":"review","scope":"science-technology","group":"optics-infrared-ultraviolet","objective":"从生活用途识别紫外线应用","prompt":"银行验钞灯和部分消毒灯利用的是哪一种电磁波？","options":["紫外线","红外线","无线电波"],"answer":0,"explanation":"紫外线可用于验钞和杀菌；红外线常用于遥控、探测和热成像。","boundary":"本题只识别验钞和杀菌两类典型用途。","refs":[{"pointId":"optics","tabId":"light-nature","sourceUnitIds":["cs-16-22-p10-p11-light-nature-list"],"fingerprint":"79c425bb","label":"光学 · 光的本质","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"ultraviolet-applications-core","primaryTargetIds":["cs-target-ultraviolet-applications"],"supportingTargetIds":[],"checkPurpose":"q2-optics-application","distractorReasons":{"1":"红外线常用于遥控、探测和热成像，不是验钞消毒的对应项。","2":"无线电波不对应正文所列的验钞和杀菌用途。"},"cognitiveLevel":"application"}},{"id":"infrared-ultraviolet-full","revision":2,"status":"review","scope":"science-technology","group":"optics-infrared-ultraviolet","objective":"综合区分红外线与紫外线的波长、可见性和用途","prompt":"下列对红外线和紫外线的比较，哪一项正确？","options":["红外波长较短且用于验钞；紫外波长较长且用于遥控","红外和紫外都能被人眼直接看到；臭氧会增强太阳紫外线","红外较长用于热成像；紫外较短用于杀菌验钞"],"answer":2,"explanation":"红外线波长较长且常用于热成像；紫外线波长较短且常用于杀菌、验钞。两者均不可见。","boundary":"综合题不讨论精确波段、剂量和医学安全。","refs":[{"pointId":"optics","tabId":"light-nature","sourceUnitIds":["cs-16-22-p10-p11-light-nature-list"],"fingerprint":"79c425bb","label":"光学 · 光的本质","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"infrared-ultraviolet-full","primaryTargetIds":["cs-target-infrared-wavelength","cs-target-infrared-applications","cs-target-ultraviolet-wavelength","cs-target-ultraviolet-applications"],"supportingTargetIds":[],"checkPurpose":"q2-optics-application","distractorReasons":{"0":"红外、紫外的波长关系和典型用途都被对调。","1":"红外线与紫外线均不可见，臭氧会吸收而不是增强太阳紫外线。"},"cognitiveLevel":"synthesis"}},{"id":"light-straight-condition-core","revision":2,"status":"review","scope":"science-technology","group":"optics-propagation-reflection","objective":"在给定介质条件下判断光能否按直线传播","prompt":"激光在成分和密度处处相同的透明介质中传播。忽略边界影响时，光路应怎样判断？","options":["在介质中随机改变方向","沿直线传播","会形成闭合曲线"],"answer":1,"explanation":"光在同种均匀介质中沿直线传播；题干同时给出了“同种”和“均匀”两个条件。","boundary":"结论不能扩大为光在任意不均匀介质或跨介质界面时都沿直线传播。","refs":[{"pointId":"optics","tabId":"light-propagation","sourceUnitIds":["cs-16-22-p11-p12-light-propagation-list"],"fingerprint":"55f3286f","label":"光学 · 光的传播","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"light-straight-condition-core","primaryTargetIds":["cs-target-light-straight-condition"],"supportingTargetIds":[],"checkPurpose":"q2-optics-mechanism-application","distractorReasons":{"0":"同种均匀介质不会使光路随机改变，题干没有给出扰动或不均匀条件。","2":"基础直线传播条件不能推出闭合曲线，光路仍按直线判断。"},"cognitiveLevel":"application"}},{"id":"light-straight-examples-core","revision":2,"status":"review","scope":"science-technology","group":"optics-propagation-reflection","objective":"从遮挡和准直情境识别光的直线传播","prompt":"下列哪组现象主要用光在同种均匀介质中沿直线传播解释？","options":["平面镜成像、水中筷子偏折、蓝天","影子、小孔成像、日食","光纤通信、海市蜃楼、潜望镜"],"answer":1,"explanation":"影子、小孔成像和日食都与光沿直线传播及遮挡关系有关。","boundary":"本题只识别主要机制；不展开日月食轨道或小孔成像的定量关系。","refs":[{"pointId":"optics","tabId":"light-propagation","sourceUnitIds":["cs-16-22-p11-p12-light-propagation-list"],"fingerprint":"55f3286f","label":"光学 · 光的传播","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"light-straight-examples-core","primaryTargetIds":["cs-target-light-straight-examples"],"supportingTargetIds":[],"checkPurpose":"q2-optics-mechanism-application","distractorReasons":{"0":"三项主要机制依次涉及反射、折射和散射，不是同一组直线传播现象。","2":"光纤主要利用全反射，海市蜃楼涉及折射，潜望镜利用反射。"},"cognitiveLevel":"application"}},{"id":"light-reflection-definition-core","revision":2,"status":"review","scope":"science-technology","group":"optics-propagation-reflection","objective":"由返回原介质识别光的反射","prompt":"一束光从空气射到镜面后改变方向，仍回到空气中传播。这一过程属于？","options":["折射","散射","反射"],"answer":2,"explanation":"光到达两种物质的分界面后改变方向并返回原来介质，属于反射。","boundary":"若光进入另一透明介质并在交界处改变方向，应按折射判断。","refs":[{"pointId":"optics","tabId":"light-propagation","sourceUnitIds":["cs-16-22-p11-p12-light-propagation-list"],"fingerprint":"55f3286f","label":"光学 · 光的传播","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"light-reflection-definition-core","primaryTargetIds":["cs-target-light-reflection-definition"],"supportingTargetIds":[],"checkPurpose":"q2-optics-mechanism-application","distractorReasons":{"0":"折射要求光进入另一透明介质，题干明确光返回空气。","1":"散射指部分光在不均匀介质中偏离原方向，不符合镜面返回原介质的情境。"},"cognitiveLevel":"application"}}]