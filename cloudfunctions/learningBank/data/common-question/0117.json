[{"id":"rainbow-sun-position-core","revision":2,"status":"review","scope":"science-technology","group":"optics-rainbow-secondary","objective":"利用太阳与虹相反方位判断观察方向","prompt":"雨后清晨太阳位于东方，若条件合适，观察者应主要向哪个方向寻找彩虹？","options":["西方","东方","太阳正上方"],"answer":0,"explanation":"太阳和彩虹通常位于观察者的相反方向；太阳在东时，彩虹在西。","boundary":"这里只判断基本相对方位，不推断彩虹出现的持续时间。","refs":[{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-life-optical-phenomena-list"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"rainbow-sun-position-core","primaryTargetIds":["cs-target-rainbow-sun-position"],"supportingTargetIds":[],"checkPurpose":"q2-optics-life-phenomena","distractorReasons":{"1":"太阳与彩虹位于观察者相反方向，向东迎着太阳不符合该关系。","2":"彩虹的基本方位关系是与太阳相反，不能仅凭题干判断在正上方。"},"cognitiveLevel":"application"}},{"id":"rainbow-secondary-full","revision":2,"status":"review","scope":"science-technology","group":"optics-rainbow-secondary","objective":"综合区分主虹、副虹及太阳方位","prompt":"关于雨后同时出现的主虹和副虹，下列记录完整正确的是？","options":["主虹外紫内红；副虹位于主虹内侧且亮度更高；观察虹时太阳与虹处在同一方向","主虹与副虹色序相同；副虹由空气尘埃散射形成；虹在太阳一侧","主虹外红内紫；副虹位于外侧且较暗、色序相反；观察虹时太阳在身后"],"answer":2,"explanation":"主虹外红内紫，副虹在主虹外侧且较暗、色序相反；太阳和虹位于相反方向。","boundary":"综合辨析不涉及波长、折射角或亮度的定量计算。","refs":[{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-life-optical-phenomena-list"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"rainbow-secondary-full","primaryTargetIds":["cs-target-rainbow-cause","cs-target-rainbow-order","cs-target-secondary-rainbow","cs-target-rainbow-sun-position"],"supportingTargetIds":[],"checkPurpose":"q2-optics-life-phenomena","distractorReasons":{"0":"主虹色序、副虹位置和明暗、太阳方位均被颠倒。","1":"副虹与主虹色序相反，并非由尘埃散射形成。"},"cognitiveLevel":"synthesis"}},{"id":"light-primary-colors-core","revision":3,"status":"review","scope":"science-technology","group":"optics-primary-colors","objective":"从舞台灯光合成情境识别色光三原色","prompt":"舞台需要用三束基础色光合成多种颜色，应选择哪一组作为色光三原色？","options":["红、黄、蓝","红、绿、蓝","青、品红、黄"],"answer":1,"explanation":"色光加色模型的三原色是红、绿、蓝。传统绘画的红黄蓝与现代印刷的青品红黄属于不同模型。","boundary":"这里只按基础色光模型识别，不扩展到专业色彩空间。","refs":[{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-life-optical-phenomena-list"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"},{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-light-primary-colors-image"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"light-primary-colors-core","primaryTargetIds":["cs-target-light-primary-colors"],"supportingTargetIds":[],"checkPurpose":"q2-optics-color-application","distractorReasons":{"0":"红黄蓝属于颜料三原色，不能用于替代色光三原色。","2":"青品红黄不是本题所采用的基础色光三原色组合。"},"cognitiveLevel":"application"}},{"id":"pigment-primary-colors-core","revision":3,"status":"review","scope":"science-technology","group":"optics-primary-colors","objective":"从绘画调色情境识别颜料三原色","prompt":"传统绘画入门课采用红黄蓝教学原色模型，准备三种基础颜料调配颜色。该模型的原色是哪组？","options":["红、绿、蓝","青、品红、黄","红、黄、蓝"],"answer":2,"explanation":"本题明确限定传统绘画红黄蓝模型，不将其当作现代印刷青品红黄减色模型的通用替代。","boundary":"本题依据基础颜料模型，不讨论印刷或工业色彩体系。","refs":[{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-life-optical-phenomena-list"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"},{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-pigment-primary-colors-image"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"pigment-primary-colors-core","primaryTargetIds":["cs-target-pigment-primary-colors"],"supportingTargetIds":[],"checkPurpose":"q2-optics-color-application","distractorReasons":{"0":"红绿蓝属于色光三原色，不能直接套用到基础颜料模型。","1":"青品红黄不是本题正文所列的基础颜料三原色组合。"},"cognitiveLevel":"application"}},{"id":"light-color-mixing-core","revision":3,"status":"review","scope":"science-technology","group":"optics-primary-colors","objective":"依据灯光重叠结果判断色光叠加关系","prompt":"舞台上两束色光重叠，并继续加入第三束基础色光。下列记录符合色光叠加关系的是？","options":["红绿光叠加为黄，红绿蓝三色叠加为白","红黄光叠加为橙，红黄蓝三色叠加为黑","红蓝光叠加为紫，红黄蓝三色叠加为白"],"answer":0,"explanation":"在色光加色模型中，适当比例的红绿光叠加可呈黄，红绿蓝可呈白。颜料混合属于不同模型，不可照搬。","boundary":"这里只判断所列基础色光叠加结果，不推导亮度或光谱。","refs":[{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-light-primary-colors-image"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"light-color-mixing-core","primaryTargetIds":["cs-target-light-color-mixing"],"supportingTargetIds":[],"checkPurpose":"q2-optics-color-application","distractorReasons":{"1":"红黄得橙和三色得黑属于颜料混合关系，不是色光叠加。","2":"该项混入颜料中的紫色结果，并把三色原色集合也写错。"},"cognitiveLevel":"application"}}]