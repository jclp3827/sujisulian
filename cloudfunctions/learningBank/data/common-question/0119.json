[{"id":"red-clothes-core","revision":3,"status":"review","scope":"science-technology","group":"optics-object-colors","objective":"用不透明物体反射规则解释红色衣服","prompt":"白光照在红色衣服上，观察者看到衣服呈红色。对此解释正确的是？","options":["衣服主要反射入射光中的红光","衣服主要吸收红光并反射其他色光","衣服使全部红光透过到背面"],"answer":0,"explanation":"白光含红光，衣服主要将红光反射到人眼。若照明中缺少红光，红衣可能显得暗，不能忽略入射光条件。","boundary":"本题不讨论光源缺少红光时的综合色彩变化。","refs":[{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-object-color-list"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"red-clothes-core","primaryTargetIds":["cs-target-red-clothes"],"supportingTargetIds":[],"checkPurpose":"q2-optics-color-application","distractorReasons":{"1":"该项把红光与其他色光的反射、吸收关系完全对调。","2":"衣服属于不透明物体，不能用透明物体的透过规则解释。"},"cognitiveLevel":"application"}},{"id":"object-colors-full","revision":3,"status":"review","scope":"science-technology","group":"optics-object-colors","objective":"综合运用透过、反射和白黑物体规则","prompt":"关于透明物体和不透明物体的颜色判断，下列归纳完整正确的是？","options":["透明和不透明物体都只看透过光，白色主要吸收各色光","透明和不透明物体都只看反射光，黑色主要反射各色光","透明物体关注透过光，不透明物体关注反射光，外观还受入射光影响"],"answer":2,"explanation":"外观取决于照明与材料对各色光的透过、反射和吸收。白色反射较强、黑色吸收较强，不宜压缩为现实中全反全吸。","boundary":"归纳仅覆盖基础规则和所列不透明物体情境。","refs":[{"pointId":"optics","tabId":"life-optics","sourceUnitIds":["cs-16-22-p12-object-color-list"],"fingerprint":"f7ed8db6","label":"光学 · 生活中的光学现象","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"object-colors-full","primaryTargetIds":["cs-target-transparent-color","cs-target-opaque-color","cs-target-white-black-opaque","cs-target-red-clothes"],"supportingTargetIds":[],"checkPurpose":"q2-optics-color-application","distractorReasons":{"0":"透明与不透明物体分别依据透过光和反射光，白色也不是全吸收。","1":"两类物体不能统一只看反射光，黑色不透明物体也不是全反射。"},"cognitiveLevel":"synthesis"}},{"id":"q1-treaty-quick-recall","revision":1,"status":"review","scope":"humanities-history","group":"q1-modern-treaty-contrast","objective":"用高辨识度条款识别《南京条约》","prompt":"“割香港岛、开放五口、协定关税”对应哪一条约？","options":["《马关条约》","《南京条约》","《辛丑条约》"],"answer":1,"explanation":"割香港岛、开放广州等五口并协定关税，是《南京条约》的高辨识度条款。","boundary":"判断时抓条款组合，不用签约年份单独猜测。","refs":[{"pointId":"late-qing-invasions","tabId":"treaty-of-nanjing","sourceUnitIds":["cs-1-9-p14-treaty-of-nanjing-list"],"fingerprint":"d88bdc41","label":"鸦片战争 · 《南京条约》","auditStatus":"ready-for-user-acceptance"},{"pointId":"first-sino-japanese-war","tabId":"treaty-of-shimonoseki","sourceUnitIds":["cs-1-9-p15-treaty-of-shimonoseki-list"],"fingerprint":"73780823","label":"甲午中日战争 · 《马关条约》","auditStatus":"ready-for-user-acceptance"},{"pointId":"boxer-rebellion-eight-nation-alliance","tabId":"boxer-protocol","sourceUnitIds":["cs-1-9-p16-boxer-protocol-list"],"fingerprint":"d54b3a3c","label":"义和团运动与八国联军侵华 · 《辛丑条约》","auditStatus":"ready-for-user-acceptance"}],"kind":"自编学习题","assessmentType":"learning-card","examBasis":{"originType":"self-authored","displayLabel":"自编学习题"},"specification":{"questionId":"q1-treaty-quick-recall","primaryTargetIds":["q1-target-nanjing-treaty"],"supportingTargetIds":[],"checkPurpose":"q1-quick-recall","cognitiveLevel":"recall","distractorReasons":{"0":"《马关条约》的高辨识度条款是割辽台澎并允许设厂。","2":"《辛丑条约》的高辨识度条款是划使馆界并允许驻兵。"}}},{"id":"q1-treaty-boundary","revision":1,"status":"review","scope":"humanities-history","group":"q1-modern-treaty-contrast","objective":"区分《马关条约》与《辛丑条约》的条款边界","prompt":"下列条约与高辨识度条款的对应，哪一项正确？","options":["《南京条约》—开放沙市重庆苏州杭州并允许设厂","《马关条约》—划东交民巷为使馆界并允许驻兵","《辛丑条约》—划东交民巷为使馆界并允许驻兵"],"answer":2,"explanation":"划东交民巷为使馆界并允许驻兵对应《辛丑条约》；开放沙市、重庆、苏州、杭州并允许设厂对应《马关条约》。","boundary":"本题只比较可直接区分条约的条款，不展开条约影响。","refs":[{"pointId":"late-qing-invasions","tabId":"treaty-of-nanjing","sourceUnitIds":["cs-1-9-p14-treaty-of-nanjing-list"],"fingerprint":"d88bdc41","label":"鸦片战争 · 《南京条约》","auditStatus":"ready-for-