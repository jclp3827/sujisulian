[{"id":"notes-q-app-da01-000035","revision":1,"status":"review","subjectId":"data-analysis","categoryId":"ratio","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000035","exposureGroupId":"notes-exposure-notes-source-example-000035","answerMode":"single-choice","origin":{"subjectId":"data-analysis","pointId":"ratio-difference","tabId":"example","sourceExampleRecordId":"notes-source-example-000035","expectedBlockSha256":"b5c4d2bd16c11c27e5808fe931a22caa5ad0c65e1e444d10c5dc8577cb5902cb"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":true},"primaryTargetIds":["notes-target-app-da01-000035"],"supportingTargetIds":[],"refs":[{"subjectId":"data-analysis","pointId":"ratio-difference","tabId":"knowledge","expectedSha256":"a7423bb1726a081b2992323f22bb5e3e39afe6d53f3774a9e2a42f86c1de7f2d","fingerprint":"35ddf17e"},{"subjectId":"data-analysis","pointId":"ratio-difference","tabId":"example","expectedSha256":"008e11bb6bb97860faf08d4c650be208d46f734891fe68ba8c563149fb776a9d","fingerprint":"99d4791d"}],"distractorReasons":{"A":"部分8.8%大于整体3.83%，比重应增加，不能判减少。","C":"不仅方向错误；还把约1.424个百分点的变化误判为超过3个百分点。","D":"方向虽对，但现期比重约31.18%，代入比重差公式得约1.424个百分点，小于3。"},"originTask":{"verified":true,"statement":"2020 年，C 市天然气用量为 107.47 亿立方米，同比增长 3.83%。其中，中石化供应 33.51 亿立方米，同比增长 8.8%。问 2020 年，中石化供气量占 C 市天然气用量的比重比上年如何变化。","evidence":"题干内数据与任务完整，原选项／答案／解析按原块直接导入；独立数值复核见本批冻结对照包。考试出处未认证，保持legacy-unverified。"},"reviewVerified":false,"resourceType":"question","prompt":"2020 年，C 市天然气用量为 107.47 亿立方米，同比增长 3.83%。其中，中石化供应 33.51 亿立方米，同比增长 8.8%。问 2020 年，中石化供气量占 C 市天然气用量的比重比上年如何变化。","options":[{"key":"A","text":"减少了不到 3 个百分点"},{"key":"B","text":"增加了不到 3 个百分点"},{"key":"C","text":"减少了 3 个百分点以上"},{"key":"D","text":"增加了 3 个百分点以上"}],"answer":"B","explanation":"第一步判断趋势：部分 R1 = 8.8%，整体 R2 = 3.83%，部分增速大于整体增速，比重上升，排除 A、C。第二步比较增速差：8.8% - 3.83% = 4.97%，比重差必小于 4.97 个百分点。第三步估算：中石化供气量现期占比约 33.51/107.47 ≈ 30%，比重差 ≈ 30% × (8.8%-3.83%) / (1+8.8%) ≈ 30%×5% ≈ 1.5 个百分点，增加不到 3 个百分点，选 B。","originalExampleFingerprint":"29b759bc","declaredOriginalSource":"2022 国考","answerSourceKeys":["[\"data-analysis\",\"ratio-difference\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-da01-000035","questionRevision":1,"effectiveContentDigest":"18ff113165082678ef82d09f0113f7aeac7f0bc196500bea27566133e0371d4e"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-da01-000035","revision":1,"sha256":"8c55ed5c8ef9ebb71a21b0c4dc69ae7fd2fb61941d408a4401c3b0ec978d181a"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"data-analysis","pointId":"ratio-difference","tabId":"example","revision":null,"sha256":"008e11bb6bb97860faf08d4c650be208d46f734891fe68ba8c563149fb776a9d"},{"subjectId":"data-analysis","pointId":"ratio-difference","tabId":"knowledge","revision":null,"sha256":"a7423bb1726a081b2992323f22bb5e3e39afe6d53f3774a9e2a42f86c1de7f2d"}],"sourceAnchors":[],"originalExample":{"subjectId":"data-analysis","pointId":"ratio-difference","tabId":"example","expectedBlockSha256":"b5c4d2bd16c11c27e5808fe931a22caa5ad0c65e1e444d10c5dc8577cb5902cb","revision":null},"materialGroup":null,"images":[],"sharedSourceBindings":[]},"dependencyDigest":"33c0c14471ba47ecf296250cc3d40ba290582a2d4f912853936ccbbd12ba7572","ruleVersion":"exam-goal-v4","ruleDigest":"cde4b0cf5c8f1542a5a662cc642037c39b9968aba1618b319d56fd8b62cb8033","receiptId":"app-da01-independent-notes-q-app-da01-000035-r1","signatureVersion":"notes-semantic-v1","signature":"cffc38d4c35f453b42636c9955a3e0329d57400bd609a5e039a8b5f9b965f137"},"knowledgeAtoms":[],"resolvedTargets":[{"id":"notes-target-app-da01-000035","revision":1,"status":"review","subjectId":"data-analysis","categoryId":"ratio","statement":"比重变化方向与百分点范围","conclusion":"33.51/107.47×(0.088-0.0383)/1.088≈0.014243，即增加约1.424个百分点，B。","conditions":["以原题给定的同期、同口径数据为准，涉及分母或基期量须为正。"],"excludes":["仅评价本原题的计算和识别，不推断全章掌握。","笔记所标考试年