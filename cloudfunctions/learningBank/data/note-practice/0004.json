[{"id":"notes-q-app-lo01-000167","revision":2,"status":"review","subjectId":"logic","categoryId":"formal","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000167","exposureGroupId":"notes-exposure-notes-source-example-000167","answerMode":"single-choice","origin":{"subjectId":"logic","pointId":"truth-analysis","tabId":"example","sourceExampleRecordId":"notes-source-example-000167","expectedBlockSha256":"8d75b375606579d0c3cf488404bdb8d3336b7277bb35c0877771a8337e95d9b0"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"请选择关于甲、乙是否进入决赛的正确推论。","reason":"原笔记块遗漏任务问法；公开同题题面与当前题干和选项匹配，独立复核已确认该任务方向。仅补中性作答说明，原块及题源身份不变。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-lo01-000167"],"supportingTargetIds":[],"refs":[{"subjectId":"logic","pointId":"truth-analysis","tabId":"knowledge","expectedSha256":"807f4da1245ab78a22f23470ec85bcfc2bc6971a1abb94e75221587b27628d79","fingerprint":"372c9f37"},{"subjectId":"logic","pointId":"truth-analysis","tabId":"example","expectedSha256":"56f8fafe4b0302fdda4e9bec4f6431a4c4908dd24da75999105b1e9bbc7faff7","fingerprint":"e573f9e1"}],"distractorReasons":{"A":"甲真会使小钱和小李的判断同时为真，超过剩余一真。","B":"甲乙均假时小李的“非甲→乙”为假，整体真假数不满足两真两假。","C":"甲真、乙假会使小孙为真但小赵为假，结合小钱和小李后真假数不符。"},"originTask":{"verified":true,"statement":"欧洲杯比赛期间，小赵、小钱、小孙、小李预测甲、乙两支队伍能否进入决赛。小赵：如果甲进入决赛，则乙也能进入决赛。小钱：我看甲进入决赛没有问题。小孙：在我看来，甲能够进入决赛，但乙进不了。小李：我的看法是，如果甲不能进入决赛，则乙进决赛。结果出来后，四人的预测有两个真、两个假。关于甲和乙是否进入决赛，以下推论正确的是：","evidence":"公开同题题面匹配题干、选项和任务方向；独立复核通过。考试年份与真题身份未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"请选择关于甲、乙是否进入决赛的正确推论。\n欧洲杯比赛期间，小赵、小钱、小孙、小李预测甲、乙两支队伍能否进入决赛。小赵：如果甲进入决赛，则乙也能进入决赛。小钱：我看甲进入决赛没有问题。小孙：在我看来，甲能够进入决赛，但乙进不了。小李：我的看法是，如果甲不能进入决赛，则乙进决赛。结果出来后，四人的预测有两个真、两个假。","options":[{"key":"A","text":"甲和乙都进入决赛"},{"key":"B","text":"甲和乙都没有进入决赛"},{"key":"C","text":"甲进入决赛，乙没有进入决赛"},{"key":"D","text":"甲没有进入决赛，乙进入决赛"}],"answer":"D","explanation":"第一步找矛盾：①（甲→乙）和③（甲且非乙）矛盾，必有一真一假。因此②④为一真一假。假设②为真（甲进入决赛），则④（非甲→乙）前件为假，命题为真，这样②④都为真，与两真两假矛盾。因此②为假，即甲没有进入决赛。由④（非甲→乙）前件为真，且④为真，可得乙进入决赛。选D。","originalExampleFingerprint":"5617418d","declaredOriginalSource":"2022联考","answerSourceKeys":["[\"logic\",\"truth-analysis\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-lo01-000167","questionRevision":2,"effectiveContentDigest":"fd3f0788306d9a54fb140d6220e39d8394a4461c5507cb7825e93c36c2db478d"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-lo01-000167","revision":2,"sha256":"5d1b9bc77f29af99297c87a73a667b29eef1e827646c2e784f2c582fae3a60b8"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"logic","pointId":"truth-analysis","tabId":"example","revision":null,"sha256":"56f8fafe4b0302fdda4e9bec4f6431a4c4908dd24da75999105b1e9bbc7faff7"},{"subjectId":"logic","pointId":"truth-analysis","tabId":"knowledge","revision":null,"sha256":"807f4da1245ab78a22f23470ec85bcfc2bc6971a1abb94e75221587b27628d79"}],"sourceAnchors":[],"originalExample":{"subjectId":"logic","pointId":"truth-analysis","tabId":"example","expectedBlockSha256":"8d75b375606579d0c3cf488404bdb8d3336b7277bb35c0877771a8337e95d9b0","revision":null},"materialGroup":null,"images":[],"sharedSourceBindings":[]},"dependencyDigest":"ca00d4d2e7a26ed0beda2bfeb7b37e8db3c95a0734fead4074d96b3e91184b94","ruleVersion":"exam-goal-v4","ruleDigest":"cde4b0cf5c8f1542a5a662cc642037c39b9968aba1618b319d56fd8b62cb8033","receiptId":"app-lo-correct01-independent-notes-q-app-lo01-000167-r2","signatureVersion":"notes-semantic-v1","signature":"777dc790e84fafb277ca05715b4a743bb8d61fa8937b5701c4bfb009b91824d8"},"knowledgeAtoms":[],"resolvedTargets":[{"id":"notes-target-app-lo01-000167","revision":2,"status":"review","subjectId":"logic","categoryId":"formal","statement":"两真两假的球队结果","conclusion":"①甲→乙与③甲且非乙互为矛盾，②甲与④非甲→乙须一真一假；甲只能为假，从而乙为真，选D。","conditions":["按原题陈述、四个选项及已恢复的任务方向作答。","逻辑关系只在题干给定条件内判断。"],"excludes":["公开题面只用于恢复任务方向，不认证考试年份或真题身份。","不据现有答案倒造题干，不修改原题干、选项、答案或解析。"],"refs":[{"subjectId":"logic","pointId":"truth-analysis","tabId":"knowledge","expectedSha256":"807f4da1245ab78a22f23470ec85bcfc2bc6971a1abb94e75221587b27628d79","fingerprint":"372c9f37"},{"subjectId":"logic","pointId":"truth-analysis","tabId":"example","expectedSha256":"56f8fafe4b0302fdda4e9bec4f6431a4c4908dd24da75999105b1e9bbc7faff7","fingerprint":"e573f9e1"}],"examTaskUse":"判断推理完整作答：两真两假的球队结果","recallTarget":"先找必有一真一假的矛盾组，再用总真假数约束剩余命题。","expectedAnswerCore":"①甲→乙与③甲且非乙互为矛盾，②甲与④非甲→乙须一真一假；甲只能为假，从而乙为真，选D。","likelyConfusionOrForgetting":"甲真会使小钱和小李的判断同时为真，超过剩余一真。；甲乙均假时小李的“非甲→乙”为假，整体真假数不满足两真两假。；甲真、乙假会使小孙为真但小赵为假，结合小钱和小李后真假数不符。","taskActionRationale":"保留原题干、选项、答案和解析，仅在题目前透明补充已由同题公开题面恢复的任务方向。","sourceBindings":[{"subjectId":"logic","pointId":"truth-analysis","tabId":"knowledge","expectedSha256":"807f4da1245ab78a22f23470ec85bcfc2bc6971a1abb94e75221587b27628d79"},{"subjectId":"logic","pointId":"truth-analysis","tabId":"example","expectedSha256":"56f8fafe4b0302fdda4e9bec4f6431a4c4908dd24da75999105b1e9bbc7faff7"}],"knowledgeRelationEvidence":{"kind":"original-task-with-evidenced-neutral-direction-completion","pointIds":["truth-analysis"],"reason":"先找必有一真一假的矛盾组，再用总真假数约束剩余命题。"},"sourceProvenance":{"kind":"curated-note-example-with-external-task-direction-recovery","authorIdentity":"unknown","examProvenance":"unverified-unless-separately-established"},"reviewVerified":false}],"assessmentFingerprint":"bb9663b7","semanticRuntimeSignature":"e3b5458adba28ced55bd88eb4d37d502ea117334f5b897e0e2c36e6757469325"},{"id":"notes-q-app-lo01-000168","revision":2,"status":"review","subjectId":"logic","categoryId":"formal","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000168","exposureGroupId":"notes-exposure-notes-source-example-000168","answerMode":"single-choice","origin":{"subjectId":"logic","pointId":"truth-analysis","tabId":"example","sourceExampleRecordId":"notes-source-example-000168","expectedBlockSha256":"244cef02ab59634d485b028ece99687e06557f4533199fda5d397ffc715e3780"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"请选择由题干必然推出的一项。","reason":"原笔记块遗漏任务问法；公开同题题面与当前题干和选项匹配，独立复核已确认该任务方向。仅补中性作答说明，原块及题源身份不变。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-lo01-000168"],"supportingTargetIds":[],"refs":[{"subjectId":"logic","pointId":"truth-analysis","tabId":"knowledge","expectedSha256":"807f4da1245ab78a22f23470ec85bcfc2bc6971a1abb94e75221587b27628d79","fingerprint":"372c9f37"},{"subjectId":"logic","pointId":"truth-analysis","tabId":"example","expectedSha256":"56f8fafe4b0302fdda4e9bec4f6431a4c4908dd24da75999105b1e9bbc7faff7","fingerprint":"e573f9e1"}],"distractorReasons":{"A":"第五句为假要求小陈获奖，A与之冲突。","B":"第五句为假要求小刘未获奖，B与之冲突。","C":"第三句为假且小陈获奖，可推出小李获奖，C与之冲突。"},"originTask":{"verified":true,"statement":"小陈、小李、小刘3人从学校脱颖而出，到市里参加竞赛。5人预测：小陈、小李都获奖；小陈、小李至多有1人获奖；小陈获奖，小李未获奖；小陈未获奖，小李获奖；若小陈获奖，则小刘也获奖。结果发现，只有1人预测正确。由此可以推出：","evidence":"公开同题题面匹配题干、选项和任务方向；独立复核通过。考试年份与真题身份未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"请选择由题干必然推出的一项。\n小陈、小李、小刘3人从学校脱颖而出，到市里参加竞赛。5人预测：小陈、小李都获奖；小陈、小李至多有1人获奖；小陈获奖，小李未获奖；小陈未获奖，小李获奖；若小陈获奖，则小刘也获奖。结果发现，只有1人预测正确。","options":[{"key":"A","text":"小陈、小李都未获奖"},{"key":"B","text":"小陈、小刘都获奖"},{"key":"C","text":"小李、小刘都未获奖"},{"key":"D","text":"小陈、小李都获奖"}],"answer":"D","explanation":"第一、二句矛盾（都获奖 vs 至多1人获奖），二者必有一真一假。故第三、四、五句全为假。由第五句为假可推出：小陈且非小刘。由第三句为假可推出：小陈且小李。因此小陈、小李都获奖，选D。","originalExampleFingerprint":"5666bc7d","declaredOriginalSource":"2022国考副省","answerSourceKeys":["[\"logic\",\"truth-analysis\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-lo01-000168","questionRevision":2,"effectiveContentDigest":"e5567f3d0055e473ac85fe851ddceea531d5a1ff189c7ef1dfad06fd6d27a123"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-lo01-000168","r