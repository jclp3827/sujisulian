[{"id":"notes-q-app-lo01-000173","revision":1,"status":"review","subjectId":"logic","categoryId":"formal","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000173","exposureGroupId":"notes-exposure-notes-source-example-000173","answerMode":"single-choice","origin":{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","sourceExampleRecordId":"notes-source-example-000173","expectedBlockSha256":"dd22b15796b87dfbed4f46981f263041c2d286882068e69816e69ceca95fcd31"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"请选择由题干必然推出的一项。","reason":"原笔记块遗漏任务问法；公开同题题面已恢复任务方向。解析错误已按独立逻辑证明纠正，题干、选项和答案保持不变。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-lo01-000173"],"supportingTargetIds":[],"refs":[{"subjectId":"logic","pointId":"daily-analysis","tabId":"knowledge","expectedSha256":"89c2971d4545a237ac3bcbd7870712008fa1e40e9dd50242399a032991435e96","fingerprint":"ed9523fb"},{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","expectedSha256":"0c3069b38985d3750d473d2c567ccd17a4e31a87c6b32697ee981a5e75ecdf7e","fingerprint":"a9b84f"}],"distractorReasons":{"A":"取L=15、W=5、Z=10，王刚纳税不比赵贤多。","B":"取L=15、W=12、Z=10，李明与王刚纳税不相等。","C":"取L=15、W=12、Z=10，两次帮助都指向纳税较少者。"},"originTask":{"verified":true,"statement":"在某公司中，李明帮助了王刚，而王刚帮助了赵贤。李明纳税比赵贤多。由此可以推出：","evidence":"公开同题题面匹配任务方向；解析纠错经独立逻辑证明。考试年份与真题身份未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"请选择由题干必然推出的一项。\n在某公司中，李明帮助了王刚，而王刚帮助了赵贤。李明纳税比赵贤多。","options":[{"key":"A","text":"王刚纳税比赵贤多"},{"key":"B","text":"李明纳税和王刚一样多"},{"key":"C","text":"有人帮助了一个纳税比他多的人"},{"key":"D","text":"有人帮助了一个纳税比他少的人"}],"answer":"D","explanation":"设李明、王刚、赵贤的纳税额分别为L、W、Z，已知L>Z。若L>W，则李明帮助了纳税比自己少的王刚；若L≤W，则W≥L>Z，所以王刚帮助了纳税比自己少的赵贤。两种情况至少有一种成立，因此必然有人帮助了一个纳税比自己少的人，选D。A、B、C都不是必然结论。","originalExampleFingerprint":"468bf6","declaredOriginalSource":"2017国考副省","answerSourceKeys":["[\"logic\",\"daily-analysis\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-lo01-000173","questionRevision":1,"effectiveContentDigest":"ed842c92aa2ae6b9aef158b2a479e4e7bbf349048f6e9ccc1f4aec12e3ccbbaf"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-lo01-000173","revision":1,"sha256":"2756d13ff8bead61d49dee9094966e193e6061403a29f355a24fb121892596c3"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","revision":null,"sha256":"0c3069b38985d3750d473d2c567ccd17a4e31a87c6b32697ee981a5e75ecdf7e"},{"subjectId":"logic","pointId":"daily-analysis","tabId":"knowledge","revision":null,"sha256":"89c2971d4545a237ac3bcbd7870712008fa1e40e9dd50242399a032991435e96"}],"sourceAnchors":[],"originalExample":{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","expectedBlockSha256":"dd22b15796b87dfbed4f46981f263041c2d286882068e69816e69ceca95fcd31","revision":null},"materialGroup":null,"images":[],"sharedSourceBindings":[]},"dependencyDigest":"ef7994a8b44b09fedf7977ca0535bbb6c3a4939c89b7e4febe6d281253df15d6","ruleVersion":"exam-goal-v4","ruleDigest":"cde4b0cf5c8f1542a5a662cc642037c39b9968aba1618b319d56fd8b62cb8033","receiptId":"app-lo-correct01-independent-notes-q-app-lo01-000173-r1","signatureVersion":"notes-semantic-v1","signature":"44e6ba64546bf9b54b440ec7382bb3bb815dc7cb9391ac4dff647df8b79185af"},"knowledgeAtoms":[],"resolvedTargets":[{"id":"notes-target-app-lo01-000173","revision":1,"status":"review","subjectId":"logic","categoryId":"formal","statement":"帮助关系中的纳税高低","conclusion":"L>Z；若L>W则李明帮助较低者，若L≤W则W≥L>Z，王刚帮助较低者，因此D必然成立。","conditions":["按纠正后的原例题解析、四个选项及已恢复的任务方向作答。","逻辑判断只使用题干给定关系。"],"excludes":["解析纠错不认证考试年份或真题身份。","不改变题干、选项和答案，不据答案倒造条件。"],"refs":[{"subjectId":"logic","pointId":"daily-analysis","tabId":"knowledge","expectedSha256":"89c2971d4545a237ac3bcbd7870712008fa1e40e9dd50242399a032991435e96","fingerprint":"ed9523fb"},{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","expectedSha256":"0c3069b38985d3750d473d2c567ccd17a4e31a87c6b32697ee981a5e75ecdf7e","fingerprint":"a9b84f"}],"examTaskUse":"判断推理完整作答：帮助关系中的纳税高低","recallTarget":"对中间量与两端量分情况：W低于L或不低于L，两种情况覆盖全部可能。","expectedAnswerCore":"L>Z；若L>W则李明帮助较低者，若L≤W则W≥L>Z，王刚帮助较低者，因此D必然成立。","likelyConfusionOrForgetting":"取L=15、W=5、Z=10，王刚纳税不比赵贤多。；取L=15、W=12、Z=10，李明与王刚纳税不相等。；取L=15、W=12、Z=10，两次帮助都指向纳税较少者。","taskActionRationale":"保留题干、选项和答案；原例题解析经独立逻辑核验后纠错，并透明补全任务方向。","sourceBindings":[{"subjectId":"logic","pointId":"daily-analysis","tabId":"knowledge","expectedSha256":"89c2971d4545a237ac3bcbd7870712008fa1e40e9dd50242399a032991435e96"},{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","expectedSha256":"0c3069b38985d3750d473d2c567ccd17a4e31a87c6b32697ee981a5e75ecdf7e"}],"knowledgeRelationEvidence":{"kind":"corrected-original-analysis-with-evidenced-neutral-direction-completion","pointIds":["daily-analysis"],"reason":"对中间量与两端量分情况：W低于L或不低于L，两种情况覆盖全部可能。"},"sourceProvenance":{"kind":"curated-note-example-with-reviewed-analysis-correction-and-task-recovery","authorIdentity":"unknown","examProvenance":"unverified-unless-separately-established"},"reviewVerified":false}],"assessmentFingerprint":"bb9663b7","semanticRuntimeSignature":"f926e0976bcce4ec8879b734822ecf5d9bbb86e256108431c40488740eff147e"},{"id":"notes-q-app-lo02-000134","revision":1,"status":"review","subjectId":"logic","categoryId":"argument","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000134","exposureGroupId":"notes-exposure-notes-source-example-000134","answerMode":"single-choice","origin":{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"real","sourceExampleRecordId":"notes-source-example-000134","expectedBlockSha256":"9a6046f14bf0a4fe4e8bbec86839b042a6ca9053f186a7c921014ddd6cf7842b"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"请选择最能质疑研究者观点的一项。","reason":"现有笔记块保留题干、四个选项、答案和解析，但遗漏题目问法；公开同题题面核对出原任务方向。仅补中性作答说明，不改变现有题目内容或宣称官方题源。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-lo02-000134"],"supportingTargetIds":[],"refs":[{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"knowledge","expectedSha256":"1ad67f739536f32bcfe0c53cedb6387222cfc51feb4391766f82958548264dde","fingerprint":"2d29f637"},{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"real","expectedSha256":"3858325bb5ac76bcb5c83db962100908d37a62a4650869a9e0aa7612c450e90f","fingerprint":"bd2457cc"}],"distractorReasons":{"A":"题干说适当增加，选项说睡眠过长，范围不同。","B":"解释睡眠变短的原因，不能否定增加睡眠能否预防失智。","C":"存在其他风险因素，不排除睡眠时长也有作用。"},"originTask":{"verified":true,"statement":"某研究调查了数千名被试者的睡眠情况与健康状况，结果发现从中年至老年，睡眠时间过长或过短都跟某些疾病有关。研究者认为，老年人适当增加睡眠时长，可以预防失智。\n以下陈述如果为真，哪项最能质疑研究者的观点？","evidence":"公开同题题面与现有题干、选项和答案相符；仅恢复作答方向，考试年份与官方真题身份未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"请选择最能质疑研究者观点的一项。\n某研究调查了数千名被试者的睡眠情况与健康状况，结果发现从中年至老年，睡眠时间过长或过短都跟某些疾病有关。研究者认为，老年人适当增加睡眠时长，可以预防失智。","options":[{"key":"A","text":"老年人每日睡眠时间过长不仅会有疲劳、还会记忆力降低、精力不集中"},{"key":"B","text":"随着年龄增加，身体的细胞也慢慢衰老，这就导致睡眠时间开始变短"},{"key":"C","text":"心血管代谢问题和精神疾病等都是失智的重要风险因素"},{"key":"D","text":"失智是一种因脑部疾病所导致的渐进性认知功能退化，跟睡眠时长无关"}],"answer":"D","explanation":"题干认为增加睡眠时长能预防失智。D 直接说明失智与睡眠时长无关，否定题干原因，力度强于只补充其他风险因素的选项。","originalExampleFingerprint":"8e289dcf","declaredOriginalSource":"2022北京","answerSourceKeys":["[\"logic\",\"comparative-experiment-attribution\",\"real\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-lo02-000134","questionRevision":1,"effectiveContentDigest":"974d03f6a875151e12d05566dac744205c6d92bec32086a9b808f8dae7363f00"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-lo02-000134","revision":1,"sha256":"fee816beb05da3e5e88ecdc539ad2ec159237a68876705a02cb984a8d028e302"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"knowledge","revision":null,"sha256":"1ad67f739536f32bcfe0c53cedb6387222cfc51feb4391766f82958548264dde"},{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"real","revision":null,"sha256":"3858325bb5ac76bcb5c83db962100908d37a62a4650869a9e0aa7612c450e90f"}],"sourceAnchors":[],"originalExample":{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"real","expectedBlockSha256":"9a6046f14bf0a4fe4e8bbec86839b042a6ca9053f186a7c921014ddd6cf7842b","revision":null},"materialGroup":null,"images":[],"sharedSourceBindings":[]},"dependencyDigest":"d86b1d664ba73973f921999dd8243736b09f8e99cbed2176920d3bd78e1618b7","ruleVersion":"exam-goal-v4","ruleDigest":"cde4b0cf5c8f1542a5a662cc642037c39b9968aba1618b319d56fd8b62cb8033","receiptId":"app-lo02-independent-notes-q-app-lo02-000134-r1","signatureVersion":"notes-semantic-v1","signature":"f888c9d5cbac05143b31f1679b83e0800f279c5abb5de56707e40a8bf157e658"},"knowledgeAtoms":[],"resolvedTargets":[{"id":"notes-target-app-lo02-000134","revision":1,"status":"review","subjectId":"logic","categoryId":"argument","statement":"睡眠时长与失智风险","conclusion":"D直接说明失智与睡眠时长无关，否定“增加睡眠可预防失智”的因果关系，选D。","conditions":["按现有笔记题干、四个选项及已从公开同题题面恢复的任务方向作答。","仅在题干给出的因果论证范围内比较削弱力度。"],"excludes":["公开题面只用于恢复任务方向和核对同题选项，不认证考试年份或官方真题身份。","不补入原笔记未保留的论据，不修改原题干、选项、答案或解析。"],"refs":[{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"knowledge","expectedSha256":"1ad67f739536f32bcfe0c53cedb6387222cfc51feb4391766f82958548264dde","fingerprint":"2d29f637"},{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"real","expectedSha256":"3858325bb5ac76bcb5c83db962100908d37a62a4650869a9e0aa7612c450e90f","fingerprint":"bd2457cc"}],"examTaskUse":"判断推理完整作答：睡眠时长与失智风险","recallTarget":"比较直接否定此因与仅补充其他风险因素的削弱力度。","expectedAnswerCore":"D直接说明失智与睡眠时长无关，否定“增加睡眠可预防失智”的因果关系，选D。","likelyConfusionOrForgetting":"题干说适当增加，选项说睡眠过长，范围不同。；解释睡眠变短的原因，不能否定增加睡眠能否预防失智。；存在其他风险因素，不排除睡眠时长也有作用。","taskActionRationale":"保留现有笔记题干、选项、答案和解析，仅在题目前透明补充由公开同题题面恢复的作答方向。","sourceBindings":[{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"knowledge","expectedSha256":"1ad67f739536f32bcfe0c53cedb6387222cfc51feb4391766f82958548264dde"},{"subjectId":"logic","pointId":"comparative-experiment-attribution","tabId":"real","expectedSha256":"3858325bb5ac76bcb5c83db962100908d37a62a4650869a9e0aa7612c450e90f"}],"knowledgeRelationEvidence":{"kind":"original-task-with-evidenced-neutral-direction-completion","pointIds":["comparative-experiment-attribution"],"reason":"比较直接否定此因与仅补充其他风险因素的削弱力度。"},"sourceProvenance":{"kind":"curated-note-example-with-external-task-direction-recovery","authorIdentity":"unknown","examProvenance":"unverified-unless-separately-established"},"reviewVerified":false}],"assessmentFingerprint":"bb9663b7","semanticRuntimeSignature":"b6d7de953cb2563af35126dfff68ae74d75693021684ff85135669c73d08c2de"},{"id":"notes-q-app-lo04-000143","revision":2,"status":"review","subjectId":"logic","categoryId":"argument","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000143","exposureGroupId":"notes-exposure-notes-source-example-000143","answerMode":"single-choice","origin":{"subjectId":"logic","pointId":"general-weaken","tabId":"real","sourceExampleRecordId":"notes-source-example-000143","expectedBlockSha256":"3ba9eacb8f7124d3c4c8e0aa3d9137f0568f5f675efbf442fd61bd2bcc0be578"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"请选择最能质疑上述设想的一项。","reason":"现有笔记块保留完整题干、四个选项、答案和解析，但题干没有单列作答问法；依据所在知识点、标签与解析透明补充中性任务方向，不改题干内容。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-lo04-000143"],"supportingTargetIds":[],"refs":[{"subjectId":"logic","pointId":"general-weaken","tabId":"knowledge","expectedSha256":"f985f297a6c4926ed021a097e95520b41c2934da6f4f3337190e69d2f1ed54a3","fingerprint":"b750c841"},{"subjectId":"logic","pointId":"general-weaken","tabId":"real","expectedSha256":"4ee6e45ba6fb6cb3733c6d431dd4f45402d3e71dbcbeb3010cf029fb5e511d12","fingerprint":"90e202e8"}],"distractorReasons":{"A":"合乘不易只说明部分车主难以使用HOV，不能证明方案整体无效。","C":"逃避监管属于执行漏洞，且只涉及部分车辆，削弱不如直接加剧拥堵。","D":"另一方法可能更有效，不代表HOV不能提高道路使用效率。"},"originTask":{"verified":true,"statement":"不少车辆在交通高峰期只有一人使用，极大浪费了有限的道路资源。因此，有人提出设置“多乘员车辆专用车道”（HOV），该车道只允许乘坐2人以上车辆进入，只有驾驶员一人的“单身车”不得在工作日的某些时间段内进入该车道，以此提高道路使用效率、缓解交通拥堵。\n请选择最能质疑上述设想的一项。","evidence":"当前原块的知识点、标签、答案和解析共同确定作答方向；仅认证当前内容自洽，来源考试身份保持未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"请选择最能质疑上述设想的一项。\n不少车辆在交通高峰期只有一人使用，极大浪费了有限的道路资源。因此，有人提出设置“多乘员车辆专用车道”（HOV），该车道只允许乘坐2人以上车辆进入，只有驾驶员一人的“单身车”不得在工作日的某些时间段内进入该车道，以此提高道路使用效率、缓解交通拥堵。","options":[{"key":"A","text":"因出发地或目的地不同等原因，单身车主找人合乘不易"},{"key":"B","text":"设置HOV后，增加了车辆的变道难度，容易加剧交通拥堵"},{"key":"C","text":"有些单身车驾驶员可能以遮蔽车窗等手段逃避监管，侵占HOV"},{"key":"D","text":"通过鼓励乘坐公共交通工具出行的方法，更能提高道路使用效率"}],"answer":"B","explanation":"题干是无论据有结论：设置HOV车道可提高效率、缓解拥堵。B 说明设置HOV后反而增加变道难度、加剧拥堵，直接质疑结论，属于有理由地反驳原观点。A 话题不一致（合乘不易不代表不能提高效率）；C 个别不影响整体；D 话题不一致（比较另一种方法）。","originalExampleFingerprint":"fb46919a","declaredOriginalSource":"2021浙江","answerSourceKeys":["[\"logic\",\"general-weaken\",\"real\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-lo04-000143","questionRevision":2,"effectiveContentDigest":"09cb8198f4869028baafb65f3c04fde1ec9b5687d4f582423987ff8ebd0b6e70"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-lo04-000143","revision":2,"sha256":"379cda88612c25ab66641ffeac3f35abb0e4d7d17ac9478af876197e953aced4"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"logic","pointId":"general-weaken","tabId":"real","revision":null,"sha256":"4ee6e45ba6fb6cb3733c6d431dd4f45402d3e71dbcbeb3010cf029fb5e511d12"},{"subjectId":"logic","pointId":"general-weaken"