[{"id":"notes-q-app-qu05-000121","revision":1,"status":"review","subjectId":"quantity","categoryId":"work","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000121","exposureGroupId":"notes-exposure-notes-source-example-000121","answerMode":"single-choice","origin":{"subjectId":"quantity","pointId":"work-efficiency","tabId":"真题示例","sourceExampleRecordId":"notes-source-example-000121","expectedBlockSha256":"f60db4e89c0a26668d8b9f247e1085ee43cb7d390cb7d6a226b6976455ea7eb5"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":true},"primaryTargetIds":["notes-target-app-qu05-000121"],"supportingTargetIds":[],"refs":[{"subjectId":"quantity","pointId":"work-efficiency","tabId":"knowledge","expectedSha256":"241b405146e9a58d8db8cc5ba0b871fa607fae335008b8dd39c9ff21fa9c254d","fingerprint":"15796832"},{"subjectId":"quantity","pointId":"work-efficiency","tabId":"真题示例","expectedSha256":"1784d91670d2b0d770cb765bc0bd55658b352bf62f4d5036c1f5253eb3ed2633","fingerprint":"f2644a76"}],"distractorReasons":{"A":"只相当于甲的任务量，漏了乙。","C":"高估两人任务总量。","D":"不满足时间差2天。"},"originTask":{"verified":true,"statement":"甲、乙两人生零件，甲的任务量是乙的 2 倍，甲每天生产 200 个零件，乙每天生产 150 个零件，甲完成任务的时间比乙多 2 天，则甲、乙任务量总共为多少个零件？","evidence":"题干、选项、答案和解析结构完整；原块按字节绑定，独立数值复核待本批回执。来源年份未认证，保持legacy-unverified。"},"reviewVerified":false,"resourceType":"question","prompt":"甲、乙两人生零件，甲的任务量是乙的 2 倍，甲每天生产 200 个零件，乙每天生产 150 个零件，甲完成任务的时间比乙多 2 天，则甲、乙任务量总共为多少个零件？","options":[{"key":"A","text":"1200"},{"key":"B","text":"1800"},{"key":"C","text":"2400"},{"key":"D","text":"3600"}],"answer":"B","explanation":"设乙完成任务用 t 天，则甲用 t+2 天。甲任务量是乙的 2 倍，列式：200×(t+2)=2×150×t，解得 t=4。乙任务量 = 150×4=600 个，甲任务量 = 600×2=1200 个，总量 = 1200+600=1800 个。","originalExampleFingerprint":"a7e5c046","declaredOriginalSource":"2019 国考","answerSourceKeys":["[\"quantity\",\"work-efficiency\",\"真题示例\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-qu05-000121","quest