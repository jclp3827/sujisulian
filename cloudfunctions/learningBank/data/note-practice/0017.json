[{"id":"notes-q-app-ve01-000193","revision":2,"status":"review","subjectId":"verbal","categoryId":"main-idea","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000193","exposureGroupId":"notes-exposure-notes-source-example-000193","answerMode":"single-choice","origin":{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","sourceExampleRecordId":"notes-source-example-000193","expectedBlockSha256":"84493f193c59645f7e67cc19f687a1cec7aa03e19e572b8d9593f73bbb47d39f"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"选择最能概括这段文字意图的一项。","reason":"现有笔记块保留题干、四个选项、答案和解析，但遗漏题目问法；公开同题题面核对出原任务方向。仅补中性作答说明，不改变现有题目内容或宣称官方题源。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-ve01-000193"],"supportingTargetIds":[],"refs":[{"subjectId":"verbal","pointId":"passage-structure","tabId":"knowledge","expectedSha256":"9efb7d14432341ac833c184e20595124c35c3f8e0173752b15e8fc02e1918659","fingerprint":"2cce03"},{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","expectedSha256":"c71829a5f4efd34b6a2be5482b811feca036ff483fde001dd0fd04b9b8a819cc","fingerprint":"a6b4279f"}],"distractorReasons":{"A":"绘画留存载歌载舞场景只是背景，且不是诗歌舞蹈传承的完整结论。","B":"只概括艺术门类融合的历史，遗漏古典名画活化这一落点。","D":"范围扩大到全部艺术创新，遗漏古典名画这一核心对象。"},"originTask":{"verified":true,"statement":"作为经典的艺术门类，绘画在历史长河中并非独立发展。在原始艺术中，音乐、诗歌、舞蹈三位一体，密不可分，绘画则将载歌载舞的场景留存于世。不同艺术门类成熟之后各自独立，但在发展的过程中又相互吸收、相互依托、相互影响。各艺术门类之间的吸收与借鉴、配合与结合，是艺术发展创新的重要手段。古典名画是人类审美情趣的集中体现，很长一段时间是深在博物馆中的高雅艺术，名画想要真正活化，还需要借助跨界融合。\n这段文字意在强调：","evidence":"公开同题题面与现有题干、选项和答案相符；仅恢复作答方向，考试年份与官方真题身份未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"选择最能概括这段文字意图的一项。\n作为经典的艺术门类，绘画在历史长河中并非独立发展。在原始艺术中，音乐、诗歌、舞蹈三位一体，密不可分，绘画则将载歌载舞的场景留存于世。不同艺术门类成熟之后各自独立，但在发展的过程中又相互吸收、相互依托、相互影响。各艺术门类之间的吸收与借鉴、配合与结合，是艺术发展创新的重要手段。古典名画是人类审美情趣的集中体现，很长一段时间是深在博物馆中的高雅艺术，名画想要真正活化，还需要借助跨界融合。","options":[{"key":"A","text":"绘画是诗歌和舞蹈传承的重要载体"},{"key":"B","text":"不同艺术门类的跨界融合由来已久"},{"key":"C","text":"古典名画可以借助跨界融合重焕生机"},{"key":"D","text":"打破形式壁垒是艺术创新的重要手段"}],"answer":"C","explanation":"A 载歌载舞场景的留存只是背景。B 只概括艺术门类融合由来已久，遗漏古典名画活化这一落点。C 对应尾句“名画想要真正活化，还需要借助跨界融合”，正确。D 泛谈艺术创新，范围大于本段古典名画活化的具体主张。","originalExampleFingerprint":"7706356c","declaredOriginalSource":"2023国考","answerSourceKeys":["[\"verbal\",\"passage-structure\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-ve01-000193","questionRevision":2,"effectiveContentDigest":"47960bbda2eabe45e75218b58c492a9536169770c9aa05aaec1baef03fad38bd"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-ve01-000193","revision":2,"sha256":"ba670a415f7b1bcf4eeb18bfcd2706c3804f88000852ce0d8769f4524d95a399"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"verbal","pointId":"passage-structure","tabId":"knowledge","revision":null,"sha256":"9efb7d14432341ac833c184e20595124c35c3f8e0173752b15e8fc02e1918659"},{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","revision":null,"sha256":"c71829a5f4efd34b6a2be5482b811feca036ff483fde001dd0fd04b9b8a819cc"}],"sourceAnchors":[],"originalExample":{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","expectedBlockSha256":"84493f193c59645f7e67cc19f687a1cec7aa03e19e572b8d9593f73bbb47d39f","revision":null},"materialGroup":null,"images":[],"sharedSourceBindings":[]},"dependencyDigest":"d8933fcf032d6a72f9a112993469be4649edd56730e04d80d84b6312b45af364","ruleVersion":"exam-goal-v4","ruleDigest":"cde4b0cf5c8f1542a5a662cc642037c39b9968aba1618b319d56fd8b62cb8033","receiptId":"app-ve01-independent-notes-q-app-ve01-000193-r2","signatureVersion":"notes-semantic-v1","signature":"c0465d14be5bced1da4f437e64a6833cf1a8d02e8a4a606590ec88944d1597aa"},"knowledgeAtoms":[],"resolvedTargets":[{"id":"notes-target-app-ve01-000193","revision":2,"status":"review","subjectId":"verbal","categoryId":"main-idea","statement":"古典名画跨界活化","conclusion":"尾句把古典名画活化与跨界融合直接联系起来，选C。","conditions":["按现有笔记题干、四个选项及从公开同题题面恢复的任务方向作答。","只依据文段与选项的语义关系判断。"],"excludes":["公开题面只用于恢复任务方向和核对同题内容，不认证考试年份或官方真题身份。","不改写原题干、选项、答案或解析。"],"refs":[{"subjectId":"verbal","pointId":"passage-structure","tabId":"knowledge","expectedSha256":"9efb7d14432341ac833c184e20595124c35c3f8e0173752b15e8fc02e1918659","fingerprint":"2cce03"},{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","expectedSha256":"c71829a5f4efd34b6a2be5482b811feca036ff483fde001dd0fd04b9b8a819cc","fingerprint":"a6b4279f"}],"examTaskUse":"言语理解完整作答：古典名画跨界活化","recallTarget":"前文讲艺术门类关系，尾句把对策收束到“古典名画+跨界融合”。","expectedAnswerCore":"尾句把古典名画活化与跨界融合直接联系起来，选C。","likelyConfusionOrForgetting":"绘画留存载歌载舞场景只是背景，且不是诗歌舞蹈传承的完整结论。；只概括艺术门类融合的历史，遗漏古典名画活化这一落点。；范围扩大到全部艺术创新，遗漏古典名画这一核心对象。","taskActionRationale":"保留现有笔记题干、选项、答案和解析，仅在题目前透明补充由公开同题题面恢复的作答方向。","sourceBindings":[{"subjectId":"verbal","pointId":"passage-structure","tabId":"knowledge","expectedSha256":"9efb7d14432341ac833c184e20595124c35c3f8e0173752b15e8fc02e1918659"},{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","expectedSha256":"c71829a5f4efd34b6a2be5482b811feca036ff483fde001dd0fd04b9b8a819cc"}],"knowledgeRelationEvidence":{"kind":"original-task-with-evidenced-neutral-direction-completion","pointIds":["passage-structure"],"reason":"前文讲艺术门类关系，尾句把对策收束到“古典名画+跨界融合”。"},"sourceProvenance":{"kind":"curated-note-example-with-external-task-direction-recovery","authorIdentity":"unknown","examProvenance":"unverified-unless-separately-established"},"reviewVerified":false}],"assessmentFingerprint":"bb9663b7","semanticRuntimeSignature":"e0e002b8d431a1b6e41d2600e32cd11a150d0ad644d114f1c2d59c35ac18328d"},{"id":"notes-q-app-ve01-000194","revision":2,"status":"review","subjectId":"verbal","categoryId":"main-idea","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000194","exposureGroupId":"notes-exposure-notes-source-example-000194","answerMode":"single-choice","origin":{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","sourceExampleRecordId":"notes-source-example-000194","expectedBlockSha256":"091c67032803d9398248e3d60264b58248c316be1b0cc806ed20bed9d9eccb1e"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"选择最能概括这段文字主要内容的一项。","reason":"现有笔记块保留题干、四个选项、答案和解析，但遗漏题目问法；公开同题题面核对出原任务方向。仅补中性作答说明，不改变现有题目内容或宣称官方题源。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-ve01-000194"],"supportingTargetIds":[],"refs":[{"subjectId":"verbal","pointId":"passage-structure","tabId":"knowledge","expectedSha256":"9efb7d14432341ac833c184e20595124c35c3f8e0173752b15e8fc02e1918659","fingerprint":"2cce03"},{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","expectedSha256":"c71829a5f4efd34b6a2be5482b811feca036ff483fde001dd0fd04b9b8a819cc","fingerprint":"a6b4279f"}],"distractorReasons":{"A":"“拨开战争迷雾”只是背景，并非文段论述的关键。","B":"只覆盖无人化装备部分，遗漏网络空间。","D":"把“虚拟空间因素”改成笼统的信息化进程，主题不准。"},"originTask":{"verified":true,"statement":"当技术的进步逐渐拨开传统\"战争迷雾\"之时，网络和电磁等虚拟空间因素也给侦察情报带来了相应的挑战。一方面，网络空间的开放互联，庞大的用户群体、被动的防御特性,未知的安全漏洞,使得网络攻击的隐蔽性不断增强、难以防范。同时,情报的处理、分发离不开安全稳定的网络支撑。另一方面，战场上的无人化侦察装备种类繁多,特别是重点区域和要害目标附近,用频装备数量庞大,导致局部电磁拥挤,容易出现频率自扰现象。而且交战双方极易互相实施电磁干扰和压制,使得无人化侦察装备的稳定运行遭受严峻考验。\n这段文字主要介绍了：","evidence":"公开同题题面与现有题干、选项和答案相符；仅恢复作答方向，考试年份与官方真题身份未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"选择最能概括这段文字主要内容的一项。\n当技术的进步逐渐拨开传统\"战争迷雾\"之时，网络和电磁等虚拟空间因素也给侦察情报带来了相应的挑战。一方面，网络空间的开放互联，庞大的用户群体、被动的防御特性,未知的安全漏洞,使得网络攻击的隐蔽性不断增强、难以防范。同时,情报的处理、分发离不开安全稳定的网络支撑。另一方面，战场上的无人化侦察装备种类繁多,特别是重点区域和要害目标附近,用频装备数量庞大,导致局部电磁拥挤,容易出现频率自扰现象。而且交战双方极易互相实施电磁干扰和压制,使得无人化侦察装备的稳定运行遭受严峻考验。","options":[{"key":"A","text":"新形势下驱散传统\"战争迷雾\"的关键"},{"key":"B","text":"无人化侦察装备升级引发的连锁反应"},{"key":"C","text":"虚拟空间因素对侦察情报工作的影响"},{"key":"D","text":"侦察情报技术信息化进程中遭遇的困境"}],"answer":"C","explanation":"A “拨开传统战争迷雾”只是背景。B 只覆盖无人化侦察装备，遗漏网络空间的影响。C 同时概括网络和电磁等虚拟空间因素对侦察情报工作的影响，正确。D 把文段明确讨论的虚拟空间因素泛化为信息化进程，主题关系不如C准确。","originalExampleFingerprint":"ab376e21","declaredOriginalSource":"2022国考","answerSourceKeys":["[\"verbal\",\"passage-structure\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-ve01-000194","questionRevision":2,"effectiveContentDigest":"81d5d7943518017227e7fb4f4e6ebf1c68d392eb99ef523d2453c9508317c6c9"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-ve01-000194","revision":2,"sha256":"f0111c8a3ca2104b293a07e99a3830704e387f7739393a507d3a72502e4fdc16"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"verbal","pointId":"passage-structure","tabId":"knowledge","revision":null,"sha256":"9efb7d14432341ac833c184e20595124c35c3f8e0173752b15e8fc02e1918659"},{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","revision":null,"sha256":"c71829a5f4efd34b6a2be5482b811feca036ff483fde001dd0fd04b9b8a819cc"}],"sourceAnchors":[],"originalExample":{"subjectId":"verbal","pointId":"passage-structure","tabId":"example","expectedBlockSha256":"091c67032803d9398248e3d60264b58248c316be1b0cc806ed20bed9d9eccb1e","revision":null},"materialGroup":null,"images":[],"sharedSourceBindings":[]},"dependencyDigest":"e7c5ad07a7a645fc93180e7888ec5dd1e9c808ca74d48b4da0cd1e03793c8b01","ruleVersion":"exam-goal-v4","ruleDigest":"cde4b0cf5c8f1542a5a662cc642037c39b9968aba1618b319d56fd8b62cb8033","receiptId":"app-ve01-independent-notes-q-app-ve01-000194-r2","signatureVersion":"notes-semantic-v1","signature":"5d1e9b26e3370157adb8d9d206fa146f55b2d1e3b9301680c58260109be281f8"},"knowledgeAtoms":[],"resolvedTargets":[{"id":"notes-target-app-ve01-000194","revision":2,"status":"review","subjectId":"verbal","categoryId":"main-idea","statement":"虚拟空间对侦察情报的影响","conclusion":"网络与电磁两方面都在说明虚拟空间因素给侦察情报带来的影响，选C。","conditions":["按现有笔记题干、四个选项及从公开同题题面恢复的任务方向作答。","只依据文段与选项的语义关系判断。"],"excludes":["公开题面只用于恢复任务方向和核对同题内容，不认证考试年份或官方真题身份。","不改写原题干、选项、答案或解析。"],"refs":[{"