[{"id":"notes-q-app-ve01-000198","revision":2,"status":"review","subjectId":"verbal","categoryId":"main-idea","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000198","exposureGroupId":"notes-exposure-notes-source-example-000198","answerMode":"single-choice","origin":{"subjectId":"verbal","pointId":"passage-key-info","tabId":"example","sourceExampleRecordId":"notes-source-example-000198","expectedBlockSha256":"516da3160770631b36a0ffa41326ecef4a60c94aaabad8ea1e69674694815482"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"选择最能概括这段文字主旨的一项。","reason":"现有笔记块保留题干、四个选项、答案和解析，但遗漏题目问法；公开同题题面核对出原任务方向。仅补中性作答说明，不改变现有题目内容或宣称官方题源。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-ve01-000198"],"supportingTargetIds":[],"refs":[{"subjectId":"verbal","pointId":"passage-key-info","tabId":"knowledge","expectedSha256":"fac5f4dc860341b66bb041f94e61f5659d8ff9c01e786a187a85aaee40868c02","fingerprint":"b45ef3cf"},{"subjectId":"verbal","pointId":"passage-key-info","tabId":"example","expectedSha256":"f6215bff2f9b9b42ec73b0e05cc9dea7b6273bacc4d446127255ad323f6951f2","fingerprint":"39d8ccc4"}],"distractorReasons":{"A":"这是首句背景，不是主旨。","B":"只复述问题且把范围缩成文物。","C":"只说文物开放，遗漏遗产、文字及时代连接。"},"originTask":{"verified":true,"statement":"在5000多年文明发展进程中，中华民族创造了博大精深的灿烂文化。在当下，如何\"让收藏在禁宫里的文物、陈列在广阔大地上的遗产、书写在古籍里的文字都活起来\"，已成为我们必须面对的现实问题。试想，如果传统文化失去了与时代的连接、缺少了与现代人的情感沟通和心灵默契，\"仅止于几个人在书房中互相叹赏\"，那和一堆零散的符号、呆板的素材又有什么区别？只有从\"沉睡\"中再出发，从\"馆舍天地\"走向\"大千世界\"，才能涵养出更具时代特色的、富有创新力的文化自信。\n这段文字旨在强调：","evidence":"公开同题题面与现有题干、选项和答案相符；仅恢复作答方向，考试年份与官方真题身份未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"选择最能概括这段文字主旨的一项。\n在5000多年文明发展进程中，中华民族创造了博大精深的灿烂文化。在当下，如何\"让收藏在禁宫里的文物、陈列在广阔大地上的遗产、书写在古籍里的文字都活起来\"，已成为我们必须面对的现实问题。试想，如果传统文化失去了与时代的连接、缺少了与现代人的情感沟通和心灵默契，\"仅止于几个人在书房中互相叹赏\"，那和一堆零散的符号、呆板的素材又有什么区别？只有从\"沉睡\"中再出发，从\"馆舍天地\"走向\"大千世界\"，才能涵养出更具时代特色的、富有创新力的文化自信。","options":[{"key":"A","text":"中华民族拥有博大精深的传统文化"},{"key":"B","text":"如何让文物\"活起来\"是我们必须面对的问题"},{"key":"C","text":"文物应走出封闭状态，向公众开放"},{"key":"D","text":"传统文化应加强与时代的连接"}],"answer":"D","explanation":"A 只是首句背景。B 只复述文物活化这一局部问题，没有概括作者主张。C 只涉及文物开放，遗漏遗产、文字以及与时代连接的核心关系。D 与反面论证及“只有……才……”提出的主张一致，正确。","originalExampleFingerprint":"ba908718","declaredOriginalSource":"2019山东","answerSourceKeys":["[\"verbal\",\"passage-key-info\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-ve01-000198","questionRevision":2,"effectiveContentDigest":"69d451c78b86986d621c3d60edfa8e83f12ad1873c51721a81379047af7ebba0"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-ve01-000198","revision":2,"sha256":"45835752bfee2ecb0429318909efe7055a553924a43827564462c8aac1bc3a13"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"verbal","pointId":"passage-key-info","tabId":"example","revision":null,"sha256":"f6215bff2f9b9b42ec73b0e05cc9dea7b6273bacc4d446127255ad323f6951f2"},{"subjectId":"verbal","pointId":"passage-key-info","tabId":"knowledge","revision":null,"sha256":"fac5f4dc860341b66bb041f94e61f5659d8ff9c01e786a187a85aaee40868c02"}],"sourceAnchors":[],"originalExample":{"subjectId":"verbal","pointId":"passage-key-info","tabId":"example","expectedBlockSha256":"516da3160770631b36a0ffa41326ecef4a60c94aaabad8ea1e69674694815482","revision":null},"materialGroup":null,"images":[],"sharedSourceBindings":[]},"dependencyDigest":"9c666c22fff281eb79d3c5a3341901bf7caa7c931822de700d93df0d125411cb","ruleVersion":"exam-goal-v4","ruleDigest":"cde4b0cf5c8f1542a5a662cc642037c39b9968aba1618b319d56fd8b62cb8033","receiptId":"app-ve01-independent-notes-q-app-ve01-000198-r2","signatureVersion":"notes-semantic-v1","signature":"5e9cf41b1497be0cd01e535e9e6a32fa151a51c233d62eaea00c887458cf7ae4"},"knowledgeAtoms":[],"resolvedTargets":[{"id":"notes-target-app-ve01-000198","revision":2,"status":"review","subjectId":"verbal","categoryId":