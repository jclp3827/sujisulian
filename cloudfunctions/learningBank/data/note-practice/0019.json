","tabId":"example","expectedSha256":"1e74993f33822bdf4e81a3c53b2aff0c584e70b91d6de4b354f1c1a9f7a1540e","fingerprint":"b19fee58"}],"examTaskUse":"言语理解完整作答：人才下沉后续内容","recallTarget":"推断下文紧扣末句新话题，优先展开刚提出但尚未说明的原因。","expectedAnswerCore":"末句提出二三线城市差距缩小和流动多元化，后文最可能展开人才下沉的具体原因，选A。","likelyConfusionOrForgetting":"扩散效应只是开头背景，已转向人才下沉。；文段未转向一线城市应对措施。；聚集效应背景已在前文交代。","taskActionRationale":"保留现有笔记题干、选项、答案和解析，仅在题目前透明补充由公开同题题面恢复的作答方向。","sourceBindings":[{"subjectId":"verbal","pointId":"next-paragraph","tabId":"knowledge","expectedSha256":"d086925abd7dbb15e3db63b502ee408b41db1a4a6695833c414f72fad7516e13"},{"subjectId":"verbal","pointId":"next-paragraph","tabId":"example","expectedSha256":"1e74993f33822bdf4e81a3c53b2aff0c584e70b91d6de4b354f1c1a9f7a1540e"}],"knowledgeRelationEvidence":{"kind":"original-task-with-evidenced-neutral-direction-completion","pointIds":["next-paragraph"],"reason":"推断下文紧扣末句新话题，优先展开刚提出但尚未说明的原因。"},"sourceProvenance":{"kind":"curated-note-example-with-external-task-direction-recovery","authorIdentity":"unknown","examProvenance":"unverified-unless-separately-established"},"reviewVerified":false}],"assessmentFingerprint":"bb9663b7","semanticRuntimeSignature":"0a3952b953d8de6df2e98699815cd92e83b525dd27cc8eec0936c908c2092853"},{"id":"notes-q-app-ve02-000206","revision":2,"status":"review","subjectId":"verbal","categoryId":"main-idea","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000206","exposureGroupId":"notes-exposure-notes-source-example-000206","answerMode":"single-choice","origin":{"subjectId":"verbal","pointId":"next-paragraph","tabId":"example","sourceExampleRecordId":"notes-source-example-000206","expectedBlockSha256":"5426bfc89d5d5bac2cec969afca3bd3c4c944103694a759ed2a8daf0d2b17b27"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"选择这段文字接下来最可能讲述的一项。","reason":"现有笔记块保留题干、四个选项、答案和解析，但遗漏题目问法；公开同题题面核对出原任务方向。仅补中性作答说明，不改变现有题目内容或宣称官方题源。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-ve02-000206"],"supportingTargetIds":[],"refs":[{"subjectId":"verbal","pointId":"next-paragraph","tabId":"knowledge","expectedSha256":"d086925abd7dbb15e3db63b502ee408b41db1a4a6695833c414f72fad7516e13","fingerprint":"7557a66a"},{"subjectId":"verbal","pointId":"next-paragraph","tabId":"example","expectedSha256":"1e74993f33822bdf4e81a3c53b2aff0c584e70b91d6de4b354f1c1a9f7a1540e","fingerprint":"b19fee58"}],"distractorReasons":{"B":"泛化为强制解决欠薪，没有对应取证困难。","C":"只说法规培训，没有直接对应证据留存和取证机制。","D":"只是泛称法规问题，未承接证据不足这一明确问题。"},"originTask":{"verified":true,"statement":"在现实中，农民工维权时往往面临证据不足、难以取证的问题。北京市昌平区法院审理的案件统计数据显示，在农民工讨薪案件中，约有80%的败诉是由于农民工没有相关证据而导致的。虽然劳动合同、工资卡、工资条、银行转账记录、考勤表、工作证等资料证明都可以作为农民工被欠薪的证据，但很多农民工跟着包工头干活仅以现金结账，而没有留存证据，再加上部分农民工缺乏证据意识，也可能导致被欠薪后拿不出足够证据来维权。\n这段文字接下来最可能讲的是：","evidence":"公开同题题面与现有题干、选项和答案相符；仅恢复作答方向，考试年份与官方真题身份未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"选择这段文字接下来最可能讲述的一项。\n在现实中，农民工维权时往往面临证据不足、难以取证的问题。北京市昌平区法院审理的案件统计数据显示，在农民工讨薪案件中，约有80%的败诉是由于农民工没有相关证据而导致的。虽然劳动合同、工资卡、工资条、银行转账记录、考勤表、工作证等资料证明都可以作为农民工被欠薪的证据，但很多农民工跟着包工头干活仅以现金结账，而没有留存证据，再加上部分农民工缺乏证据意识，也可能导致被欠薪后拿不出足够证据来维权。","options":[{"key":"A","text":"用法规来解决农民工被欠薪之后证据不足的问题"},{"key":"B","text":"用法规来强制用工单位解决农民工被欠薪问题"},{"key":"C","text":"培训农民工会用法规维护自己合法权益"},{"key":"D","text":"农民工在讨薪过程中遇到的法规问题"}],"answer":"A","explanation":"A 直接针对农民工被欠薪后证据不足的问题提出法规解决路径，最能承接下文。B 泛化为强制解决欠薪，没有对应取证困难。C 只说法规培训，没有直接对应证据留存和取证机制。D 只是泛称法规问题，没有承接证据不足这一明确问题。","originalExampleFingerprint":"5389dc03","declaredOriginalSource":"2020联考","answerSourceKeys":["[\"verbal\",\"next-paragraph\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-ve02-000206","questionRevision":2,"effectiveContentDigest":"5bf91b16eff6466b907148eb5e825f0b5122ef0845fcfd8d50bf031afdfa7920"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-ve02-000206","revision":2,"sha256":"7917e757ac3146e5f7f5f55fbd1ef591e1c08714df27ab7