[{"id":"notes-q-app-ve02-000203","revision":2,"status":"review","subjectId":"verbal","categoryId":"main-idea","exerciseKinds":["application"],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000203","exposureGroupId":"notes-exposure-notes-source-example-000203","answerMode":"single-choice","origin":{"subjectId":"verbal","pointId":"title-writing","tabId":"example","sourceExampleRecordId":"notes-source-example-000203","expectedBlockSha256":"8356ea72f8606f9029e8079959e7b06a9fcd32ef0f2d6fc8136847b3df3cbc45"},"originAdaptation":{"kind":"neutral-display-completion","instruction":"选择最适合做这段文字标题的一项。","reason":"现有笔记块保留题干、四个选项、答案和解析，但遗漏题目问法；公开同题题面核对出原任务方向。仅补中性作答说明，不改变现有题目内容或宣称官方题源。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"primaryTargetIds":["notes-target-app-ve02-000203"],"supportingTargetIds":[],"refs":[{"subjectId":"verbal","pointId":"title-writing","tabId":"knowledge","expectedSha256":"e8eeca30c8e10da182c3fd3e38ee43bd8846682b5aa259ea41ab60a71099be27","fingerprint":"ceb386d2"},{"subjectId":"verbal","pointId":"title-writing","tabId":"example","expectedSha256":"1dc787a8502cae8748cc9e25cbb54129d3a2dc83edf4defcbda7aac0e733afae","fingerprint":"356e296f"}],"distractorReasons":{"A":"只覆盖软骨比例这一局部。","C":"以柔克刚不能完整概括舍弃鱼鳔等多种调整。","D":"无法承受与文段已经形成适应相反。"},"originTask":{"verified":true,"statement":"对于生活在浅海的硬骨鱼类来说，鱼鳔非常重要，可以帮助其调整浮力，实现上浮或下潜。但是对于深海鱼来说，充满气的鱼鳔像是脆弱的气球，在外部巨大水压的挤压下，会炸成碎片。因此，很多深海鱼在进化过程中\"舍弃\"了鱼鳔这个\"危险\"的部件，转而依靠某些脂类提供浮力。相比于浅海中的鱼，深海鱼的骨骼和肌肉含量都比较少，脂质和胶质相对较多。此外，深海鱼骨骼中软骨的比例也远高于浅海鱼。对于深海鱼来说，这些都是为了适应深海生活所作出的必要的\"妥协\"。毕竟相比于骨骼和肌肉，脂质和胶质能更好地帮助鱼类对抗巨大的压力。\n最适合做这段文字标题的是：","evidence":"公开同题题面与现有题干、选项和答案相符；仅恢复作答方向，考试年份与官方真题身份未认证。"},"reviewVerified":false,"resourceType":"question","prompt":"选择最适合做这段文字标题的一项。\n对于生活在浅海的硬骨鱼类来说，鱼鳔非常重要，可以帮助其调整浮力，实现上浮或下潜。但是对于深海鱼来说，充满气的鱼鳔像是脆弱的气球，在外部巨大水压的挤压下，会炸成碎片。因此，很多深海鱼在进化过程中\"舍弃\"了鱼鳔这个\"危险\"的部件，转而依靠某些脂类提供浮力。相比于浅海中的鱼，深海鱼的骨骼和肌肉含量都比较少，脂质和胶质相对较多。此外，深海鱼骨骼中软骨的比例也远高于浅海鱼。对于深海鱼来说，这些都是为了适应深海生活所作出的必要的\"妥协\"。毕竟相比于骨骼和肌肉，脂质和胶质能更好地帮助鱼类对抗巨大的压力。","options":[{"key":"A","text":"深海鱼竟是\"软骨头\""},{"key":"B","text":"抗压，从鱼鳔的\"断舍离\"开始"},{"key":"C","text":"精通以柔克刚的深海鱼"},{"key":"D","text":"深海压力，无法承受之痛"}],"answer":"B","explanation":"参考选择B。文段以抗压为共同目的，从舍弃鱼鳔写起，再展开骨肌、脂胶与软骨等适应变化；“从……开始”可统摄同一叙述方向的后续展开，不只局限鱼鳔。C的“以柔克刚”有部分文字依据，不能说无中生有，但对所有适应机制作了较强的修辞概括。比较覆盖范围和表述贴切程度，B更合适；判断不依据引号或比喻的有无。科技日报原文（央广网转载）对应小节亦用此叙述起点，链接https://tech.cnr.cn/techgd/20201218/t20201218_525367236.shtml；这只支持文章结构，不等于取得国考原卷与官方标准答案。","originalExampleFingerprint":"2019bb24","declaredOriginalSource":"据原材料整理讲解；文章结构参照科技日报2020-12-18报道（央广网转载），非国考官方答案认证","answerSourceKeys":["[\"verbal\",\"title-writing\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-app-ve02-000203","questionRevision":2,"effectiveContentDigest":"5a9c6d14493fdff26c8058df5fd38e9e32d1ec70ae9731ed867ffeba913b252e"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-app-ve02-000203","revision":2,"sha256":"ee5674fd2fe3caff8f8b6215d0d60dfac6725954537894e313fad65e4017b86c"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"verbal","pointId":"title-writing","tabId":"example","revision":null,"sha256":"1dc787a8502cae8748cc9e25cbb54129d3a2dc83edf4defcbda7aac0e733afae"},{"subjectId":"verbal","pointId":"title-writing","tabId":"knowledge","revision":null,"sha256":"e8eeca30c8e10da182c3fd3e38ee43bd8846682b5aa259ea41ab60a71099be27"}],"sourceAnchors":[],"originalExample":{"subjectId":"verbal","pointId":"title-writing","tabId":"example","expectedBlockSha256":"8356ea72f8606f9029e8079959e7b06a9fcd32ef0f2d6fc8136847b3df3cbc45","revision":null},"materialGroup":null,"images":[],"sharedSourceBindings":[]},"dependencyDigest":"de138cd30fb2899d4f4f5546d27d2c24264c68ee1f63fb610f89040bd2745a4d","ruleVersion":"exam-goal-v4","ruleDigest":"cde4b0cf5c8f1542a5a662cc642037c39b9968aba1618b319d56fd8b62cb8033","receiptId":"app-ve02-independent-notes-q-app-ve02-000203-r2","signatureVersion":"notes-semantic