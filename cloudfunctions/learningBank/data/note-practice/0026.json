,"pointIds":["logic-relations","equivalent-deduction"],"reason":"将逆否和德摩根法则用于甲乙丙的真实条件结构。"},"sourceProvenance":{"kind":"curated-note-source","authorIdentity":"unknown","examProvenance":"unverified-unless-separately-established"},"reviewVerified":false}],"assessmentFingerprint":"bb9663b7","semanticRuntimeSignature":"e82a065a6365d3fb63056a4a51b5e2960593915673a41a39fef9a2f28ec1354b"},{"id":"notes-q-nq4-logic-application-table","revision":3,"status":"review","subjectId":"logic","categoryId":"formal","exerciseKinds":["application"],"primaryTargetIds":["notes-target-v4-logic-complete-matching"],"supportingTargetIds":[],"refs":[{"subjectId":"logic","pointId":"daily-analysis","tabId":"knowledge","expectedSha256":"89c2971d4545a237ac3bcbd7870712008fa1e40e9dd50242399a032991435e96","fingerprint":"ed9523fb"},{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","expectedSha256":"0c3069b38985d3750d473d2c567ccd17a4e31a87c6b32697ee981a5e75ecdf7e","fingerprint":"a9b84f"}],"sourceKind":"legacy-unverified","familyId":"notes-origin-notes-source-example-000174","exposureGroupId":"notes-exposure-notes-source-example-000174","answerMode":"single-choice","origin":{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","sourceExampleRecordId":"notes-source-example-000174","expectedBlockSha256":"391d25e85a013f664fabfb32de9c45e3892f2782037a2a822446f23dcc587e27"},"distractorReasons":{"A":"由条件可得甲为湖南人并考上医科，A为真。","B":"乙为江苏且农业、丙师范、甲医科，剩下丁为财经，B为真。","D":"丙为浙江，确实不是湖南人，D为真。"},"assessment":{"taskType":"complete-application","knowledgeAtomIds":[],"requiresCalculation":false},"originTask":{"verified":true,"statement":"甲、乙、丙、丁4人为室友，来自江苏、浙江、湖南、湖北，毕业时都考上了研究生，录取她们的有师范大学、医科大学、财经大学、农业大学。已知：甲考上的不是农业大学，考上农业大学的是江苏人，丙考上了师范大学，丁是湖北人。如果考上医科大学的是湖南人，那么以下哪项为假？","evidence":"原例题stem包含明确求解任务；选项、答案、解析齐全，保留原块，考试题源标签未验证"},"reviewVerified":false,"resourceType":"question","prompt":"甲、乙、丙、丁4人为室友，来自江苏、浙江、湖南、湖北，毕业时都考上了研究生，录取她们的有师范大学、医科大学、财经大学、农业大学。已知：甲考上的不是农业大学，考上农业大学的是江苏人，丙考上了师范大学，丁是湖北人。如果考上医科大学的是湖南人，那么以下哪项为假？","options":[{"key":"A","text":"甲考上了医科大学"},{"key":"B","text":"丁考上了财经大学"},{"key":"C","text":"丙不是浙江人"},{"key":"D","text":"丙不是湖南人"}],"answer":"C","explanation":"画表法：先填入确定信息。丙=师范；丁=湖北；农业=江苏；甲≠农业。由于农业=江苏，丁=湖北，所以丁≠农业。甲≠农业，所以乙=农业=江苏。医学=湖南，丁=湖北，所以丁≠医学。师范=丙，农业=乙，医学=湖南人（甲或丙），但丙=师范，所以医学=甲=湖南。剩下财经=丁。籍贯：乙=江苏，丁=湖北，甲=湖南，丙=浙江。因此C（丙不是浙江人）为假，选C。","originalExampleFingerprint":"f1757b1b","declaredOriginalSource":"2022江苏A类","answerSourceKeys":["[\"logic\",\"daily-analysis\",\"example\"]"],"semanticAdmission":{"questionBinding":{"questionId":"notes-q-nq4-logic-application-table","questionRevision":3,"effectiveContentDigest":"90b300ebd3fb0acaa3e83a44542f5428ee2de4cdb4ea9de1769dfe65952aa468"},"resolvedDependencyManifest":{"primaryTargets":[{"id":"notes-target-v4-logic-complete-matching","revision":2,"sha256":"ee833a6c8896700ee9f3fba899c74a5136adf3da5c698d217ae8fe6d6408c6e9"}],"supportingTargets":[],"knowledgeAtoms":[],"comparisonGroups":[],"sourceBindings":[{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","revision":null,"sha256":"0c3069b38985d3750d473d2c567ccd17a4e31a87c6b32697ee981a5e75ecdf7e"},{"subjectId":"logic","pointId":"daily-analysis","tabId":"knowledge","revision":null,"sha256":"89c2971d4545a237ac3bcbd7870712008fa1e40e9dd50242399a032991435e96"}],"sourceAnchors":[],"originalExample":{"subjectId":"logic","pointId":"daily-analysis","tabId":"example","expectedBlockSha256":"391d25e85a013f664fabfb32de9c45e3892f2782037a2a822446f23dcc587e27","revision":null},"materialGroup":null,"images":[],"sharedSourceBindings":[]},"dependencyDigest":"35370063ef0d043a48c122fe3def632c1469fa168b729d550d71af6865fb4e1c","ruleVersion":"exam-goal-v4","ruleDigest":"cde4b0cf5c8f1542a5a662cc642037c39b9968aba1618b319d56fd8b62cb8033","receiptId":"app-lo-correct01-independent-notes-q-nq4-logic-application-table-r3","signatureVersion":"notes-semantic-v1","signature":"148d0548bcb02ac5b545174ad3306e2c5b3c37fbc946201ccab165c19b384f43"},"knowledgeAtoms":[],"resolvedTargets":[{"id":"notes-target-v4-logi