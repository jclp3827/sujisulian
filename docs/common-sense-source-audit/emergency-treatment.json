        "rows": [
          [
            "烫伤",
            "先脱离热源，用清洁流动凉水持续冷却，常用建议约20分钟，避免大面积冷却导致低体温。轻取未粘连衣物饰物，不撕扯粘连处、不冰敷或涂酱油油脂；清洁覆盖，严重或特殊部位烧伤及时就医。"
          ],
          [
            "关节扭伤",
            "停止活动、保护受伤部位，可用布包冷敷物短时冷敷缓解疼痛肿胀，适度支撑并注意血液循环。不能仅按48小时一到就自动热敷；畸形、明显肿痛或不能负重应评估骨折等。"
          ],
          [
            "中暑",
            "立即离开高温环境，移至阴凉处、脱去多余衣物并积极物理降温。意识改变、昏迷或疑似热射病立即呼叫120并持续降温；意识不清不喂水，不能靠藿香正气水等替代降温和急救。"
          ],
          [
            "骨折",
            "怀疑骨折时减少移动、保护受伤部位，在保证呼吸和现场安全前提下寻求急救；不强行复位，不随意搬动疑似脊柱损伤者。开放伤口清洁覆盖，严重出血应优先处理。"
          ],
          [
            "溺水",
            "先保证施救者安全，优先呼救、递伸或抛投救援物，不贸然下水。安全上岸后判断反应和正常呼吸，呼叫120、取AED；无正常呼吸尽快按受训溺水复苏流程实施人工呼吸与胸外按压，不控水、不倒挂或盲目抠口。"
          ],
          [
            "猫狗咬伤",
            "尽快用肥皂水和流动清水充分交替冲洗伤口约15分钟，及时到狂犬病暴露处置门诊评估伤口、疫苗及被动免疫制剂。不以挤压出血处理，也不因当天未接种就放弃；严重出血仍需急救止血。"
          ],
          [
            "触电",
            "先确保现场安全、切断电源或由专业人员隔离危险，断电前不直接接触伤者。高压电场景远离并呼叫专业救援，不把普通胶鞋、木棍或家用手套当成可靠高压防护；脱险后评估呼吸并按需呼叫120和复苏。"
          ],
          [
            "急性呼吸道异物堵塞",
            "能有效咳嗽时鼓励咳嗽并观察；成人和儿童严重梗阻、不能有效发声呼吸时，按2025复苏指引交替5次背部拍击与5次腹部冲击，及时呼救。婴儿不用腹部冲击；孕妇等需替代方法。失去反应转入相应复苏流程，不盲目探指。"
          ],
          [
            "心肺复苏",
            "成人无反应且无正常呼吸或仅濒死喘息，应呼叫120、取AED并尽快胸外按压。成人频率100至120次/分钟、深度约5至6厘米，充分回弹、减少中断；受训且能通气者常按30次按压配2次呼吸，未受训者遵从调度指导，AED按语音操作。"
          ]
        ]
      }
