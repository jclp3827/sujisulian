        "rows": [
          [
            "按开发利用传统分类",
            "常规能源",
            "煤、石油、天然气和水电等已有长期、大规模利用的能源。常规与新能源有历史和技术发展背景，不能简单等同于是否成熟。"
          ],
          [
            "",
            "新能源",
            "太阳能、风能、地热能、海洋能、生物质能和核能等常见例子；新能源是开发利用传统的分类，不等于可再生能源，也不等于没有环境影响。"
          ],
          [
            "按产生方式分类",
            "一次能源",
            "直接从自然界取得的能源，如原煤、原油、天然气、水能、风能、太阳能、核能等；一次指来源方式，不指只能使用一次。"
          ],
          [
            "",
            "二次能源",
            "由一次能源加工或转换获得，如焦炭、汽油、液化石油气、电能和热能。二次指加工转换关系，不是再次回收使用。液化石油气不能省略成含义不清的液化气。"
          ],
          [
            "按再生能力分类",
            "可再生能源",
            "太阳能、水能、风能、生物质能和地热能等，能够在自然过程中持续补充。可再生不表示任何地点的供给都没有限制，也不表示开发利用没有环境影响。"
          ],
          [
            "",
            "不可再生能源",
            "煤、石油、天然气等化石能源及以铀等有限核燃料为基础的核裂变能，人类利用时间尺度内资源不能迅速补充。低碳与可再生是不同维度，核能不能仅因低碳而归为可再生。"
          ]
        ]
      }
