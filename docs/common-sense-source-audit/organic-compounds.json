        "rows": [
          [
            "乙醇",
            "乙醇俗称酒精，是易燃、易挥发液体。常用消毒酒精含适当比例的水，常见体积分数约75%；浓度更高不等于所有消毒效果都更好，使用时应远离火源并遵守产品说明。"
          ]
        ]
      }
