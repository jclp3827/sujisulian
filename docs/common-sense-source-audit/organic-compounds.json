        "rows": [
          [
            "甲醛",
            "甲醛又称蚁醛，是有刺激性的气体，可用于树脂和黏合剂等生产。福尔马林是一定浓度的甲醛水溶液，与乙醇不是同一种物质；有工业或防腐用途不表示可用于食品或可随意接触。"
          ]
        ]
      }
