    {"id": "cs-10-15-p13-five-rites-list", "type": "list", "page": 13, "label": "五礼", "items": ["五礼：", "五礼指古代的五种礼制。", "祭祀之事为吉礼。", "冠婚之事为嘉礼。", "宾客之事为宾礼。", "军旅之事为军礼。", "丧葬之事为凶礼。"], "subsections": [{"headingIndex": 0, "childIndexes": [1, 2, 3, 4, 5, 6]}]},
    {"id": "cs-10-15-p13-auspicious-rite-list", "type": "list", "page": 13, "label": "吉礼", "items": ["吉礼：吉礼是五礼之冠，主要是对天神、地祇、人鬼的祭祀典礼。"]},
    {"id": "cs-10-15-p13-festive-rite-list", "type": "list", "page": 13, "label": "嘉礼", "items": ["嘉礼：嘉礼是和合人际关系、沟通、联络感情的礼仪。冠礼、笄礼、婚礼等都属于嘉礼。"]},
    {"id": "cs-10-15-p13-six-marriage-rites-list", "type": "list", "page": 13, "label": "婚礼六礼", "items": ["婚礼六礼：", "纳采（媒人提亲）", "问名（问女方的出生年月和姓名）", "纳吉（占卜）", "纳征（送聘礼）", "请期（男方择定婚期）", "亲迎（迎娶）"], "subsections": [{"headingIndex": 0, "childIndexes": [1, 2, 3, 4, 5, 6]}]},
    {"id": "cs-10-15-p13-grand-lesser-sacrifice-list", "type": "list", "page": 13, "label": "太牢少牢", "items": ["太牢少牢：古代帝王祭祀社稷时，牛、羊、豕（猪）三牲全备为“太牢”。古代诸侯、卿大夫祭祀宗庙时，燕烹用羊、豕，叫作“少牢”。"]},
    {"id": "cs-10-15-p13-funeral-rite-list", "type": "list", "page": 13, "label": "丧礼", "items": ["丧礼：", "属凶礼，丧礼等级分明。", "天子死曰崩。", "诸侯曰薨。", "大夫曰卒。", "士曰不禄。", "庶人曰死。"], "subsections": [{"headingIndex": 0, "childIndexes": [1, 2, 3, 4, 5, 6]}]}
