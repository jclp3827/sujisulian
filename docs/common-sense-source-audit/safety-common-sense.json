          ],
          [
            "",
            "电热毯",
            "电热毯通电使用时不得折叠、卷曲或覆盖散热部位，应按说明书使用，发现破损或异常发热应停用，避免长时间无人看管通电。"
          ],
          [
            "煤气中毒",
            "",
            "疑似一氧化碳中毒时，先确保救援者安全，不能盲目进入危险环境。在安全处拨打120求助；具备安全条件时通风、移至空气新鲜处。无反应且无正常呼吸时按急救调度指导实施心肺复苏；仍有正常呼吸的昏迷者保持气道通畅并等待救治，不能仅凭昏迷就做人工呼吸。疑有燃气泄漏时避免明火及开关电器产生火花。"
          ],
          [
            "火灾",
            "",
            "居民楼起火先判断门的温度、烟气与疏散通道是否安全；具备安全条件时按疏散指引撤离，不乘普通电梯，不贪恋财物。门外高温或浓烟阻断退路时不要盲目冲出，应关门避烟并报警等待救援。具体疏散服从现场指挥，不把固定楼层顺序作为所有建筑的通用规则。"
          ],
          [
            "雷雨",
            "",
            "雷雨时优先进入有防雷设施的建筑物或封闭车辆，远离孤立高物、树木、水边及金属设施。空旷处来不及进入安全场所时可双脚并拢蹲下，减少身体高度和跨步电压风险；不要躺倒，也不要把积水坑或沟渠当作安全避雷地点。"
          ],
          [
            "地震",
            "",
            "地震强烈摇晃时就近躲在结实桌子下或能遮挡坠落物的安全位置，护住头颈，避开玻璃和易倒物，不跳楼、不乘电梯；摇晃停止后按疏散指引撤往开阔地。不要仅按楼层高低决定是否在强震中奔跑，也不要为关闭开关冒险。"
          ],
          [
            "洪水、泥石流",
            "",
            "洪水来袭按预警及时转移，来不及撤离时向稳固高处避险等待救援，不涉险穿越急流。发生泥石流时向与流动方向大致垂直的两侧稳固高坡撤离，不沿沟道上下跑，不躲树上、洞穴或不稳巨石下。"
          ],
          [
            "台风",
            "",
            "台风来临前关注预警，安全加固门窗并收妥易坠物，准备应急物资，按通知及时转移。风雨到来后减少外出，不冒险到室外加固广告牌或门窗，同时防范洪水、滑坡和泥石流等次生灾害。"
          ]
        ]
