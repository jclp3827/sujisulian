          { "type": "bridge", "text": "可以先把《马克思主义基本原理》看作基础理论组成和认识、分析、实践的方法坐标；习近平新时代中国特色社会主义思想坚持“两个结合”，围绕新时代坚持和发展中国特色社会主义形成理论体系，并向中国式现代化和各实践领域展开。两篇不是简单套用或彼此平行，而是在正式内容中通过基本原理、现实条件、理论创新和实践发展连接起来。", "sourceBlockIds": ["block:politics-toc-v2-u020:b003", "block:politics-toc-v2-u020:b006", "block:politics-toc-v2-u020:b008", "block:politics-toc-v2-u020:b009", "block:politics-toc-v2-u002:b002", "block:politics-toc-v2-u002:b003", "block:politics-toc-v2-u002:b012", "block:politics-toc-v2-u001:b002", "block:politics-toc-v2-u003:b002", "block:politics-toc-v2-u003:b003", "block:politics-toc-v2-u003:b004", "block:politics-toc-v2-u003:b015", "block:politics-toc-v2-u003:b018", "block:politics-toc-v2-u003:b020", "block:politics-toc-v2-u004:b002", "block:politics-toc-v2-u024:b019", "block:politics-toc-v2-u024:b020", "block:politics-toc-v2-u024:b025", "block:politics-toc-v2-u027:b011", "block:politics-toc-v2-u027:b012", "block:politics-toc-v2-u027:b013", "block:politics-toc-v2-u027:b014", "block:politics-toc-v2-u027:b015", "block:politics-toc-v2-u027:b016", "block:politics-toc-v2-u027:b023"], "sourceAtomRefIds": [] }
