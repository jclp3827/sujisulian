    "projectedBlocks": [
      {
        "type": "rule",
        "title": "分母对象与口径",
        "items": [
          "人均指标以相应人数为分母，户均指标以相应户数为分母。",
          "每单位指标先找“每”后面的计量对象，再确定该对象的数量或总量。",
          "如每百元产值能耗，以相应产值为分母，再按“每百元”换算；不能用企业家数作分母。",
          "分子与分母的统计对象、地区和时期应相匹配，并核对元与万元、人和万人等单位换算。"
        ]
      }
    ],
