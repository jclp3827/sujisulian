    "projectedBlocks": [
      {
        "type": "formula",
        "label": "顺行扶梯",
        "content": "扶梯长度 = (人速 + 电梯速度) × 顺行时间",
        "description": "人速是相对梯面的行走速度，梯速是扶梯相对地面的速度，二者及时间单位一致；长度指固定两端之间的静态扶梯长度。"
      },
      {
        "type": "formula",
        "label": "逆行扶梯",
        "content": "扶梯长度 = (人速 - 电梯速度) × 逆行时间",
        "description": "逆着运行方向走到另一端时，须人速>梯速，二者均取速率大小；人速等于或小于梯速时不能按此式到达逆向终点。"
      },
      {
        "type": "rule",
        "title": "解题规则",
        "items": [
          "先把人速定义为相对梯面的速度，把梯速定义为扶梯相对地面的速度。",
          "顺行用速度和，逆行到达另一端须人速大于梯速并用速度差。",
          "扶梯静态长度固定；用米或梯级计量时，人与扶梯速度、行走步数及时间要统一单位。",
          "人的行走级数不等于扶梯总级数；顺行相加、逆行相减，两次时间不应擅自视为相同。"
        ]
      }
    ],
