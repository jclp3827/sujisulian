        {
          "type": "mind-map",
          "label": "结构导图",
          "title": "一般归因&直接根本原因",
          "summary": "两个非典型归因题型的思路汇总：一般归因沿用对比实验削弱加强思路；直接根本原因用原观点串起反对者观点。",
          "nodes": [
            {
              "title": "一般归因",
              "summary": "没有完整对比实验过程，但仍按对比实验思路处理。",
              "points": [
                "题干只给既成事实 + 单一原因分析，没有完整对比实验过程。",
                "常见问法仍是削弱或支持某个原因分析。",
                "例题：2022 国考旅客列车订餐需求不高的削弱。"
              ],
              "children": [
                {
                  "title": "处理思路",
                  "points": [
                    "先看否定此因、因果倒置、另有他因。",
                    "再看异因同果、同因异果、异因异果。",
                    "题干虽无完整分组，选项能围绕变量或事实差异展开即可。"
                  ]
                },
                {
                  "title": "易错点",
                  "points": [
                    "不要因为没有完整对比实验过程，就放弃对比实验的削弱加强思路。",
                    "特例、样本瑕疵、话题不一致选项力度仍偏弱。"
                  ]
                }
              ]
            },
            {
              "title": "直接根本原因",
              "summary": "出现原观点 + 反对者观点的对立结构，题目要求质疑反对者观点。",
              "points": [
                "原观点：A 是 C 的原因。",
                "反对者：B 是 C 的原因。",
                "质疑反对者时，重点找 A 能导致 B 的选项。"
              ],
              "children": [
                {
                  "title": "处理思路",
                  "points": [
                    "抓住原观点，反推它能否解释反对者观点。",
                    "能把原观点和反对者观点串起来的选项，可以质疑反对者。",
                    "典型链条：A → B → C，原观点的因能解释反对者的因。"
                  ]
                },
                {
                  "title": "典型例题",
                  "points": [
                    "2019 国考脱发：营养不均衡 vs 毛囊受损。",
                    "选项 C 说明营养不均衡导致毛囊受损，质疑反对者。"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "rule",
          "title": "一般归因辨别",
          "items": [
            "题干仅给既成事实 + 单一原因分析，没有完整对比实验过程。",
            "选项围绕变量或事实差异展开，仍按对比实验思路处理。",
            "不要因缺少完整分组就否定质疑或支持方向。"
          ]
        },
        {
          "type": "rule",
          "title": "直接根本原因辨别",
          "items": [
            "题干同时出现原观点和反对者观点两种原因。",
            "提问方式是质疑反对者观点。",
            "正确选项常把原观点原因和反对者原因串起来。"
          ]
        }
