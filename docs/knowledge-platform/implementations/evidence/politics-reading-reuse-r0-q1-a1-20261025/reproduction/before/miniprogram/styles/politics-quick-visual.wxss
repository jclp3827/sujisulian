@import "./politics-article-visual.wxss";
/* Quick overview steps 2 and 4 only; no new content or learning controls. */
.guided-route.quick-visual-v1 {background:var(--ui-color-page);color:var(--av-ink);letter-spacing:var(--av-body-tracking);}
.guided-route.quick-visual-v1 .guided-shell {padding:var(--space-4) var(--av-gutter) calc(var(--ui-touch-target) + var(--space-8) + env(safe-area-inset-bottom));}
.guided-route.quick-visual-v1 .route-step-progress {padding:var(--space-2) 0 var(--space-3);margin-bottom:var(--space-4);background:var(--ui-color-page);border-color:var(--av-divider);box-shadow:none;}
.guided-route.quick-visual-v1 .quick-progress-context {gap:var(--space-2);}
.guided-route.quick-visual-v1 .quick-progress-count {font-size:var(--av-control);line-height:var(--ui-line-body);color:var(--av-secondary);font-weight:400;}
.guided-route.quick-visual-v1 .quick-section {padding:0;margin:0;}
.guided-route.quick-visual-v1 .quick-section-overview .quick-section-title {margin:0;font-size:var(--av-title);line-height:var(--ui-line-title);font-weight:var(--ui-weight-heading);}
.guided-route.quick-visual-v1 .quick-reading {margin-top:var(--space-5);}
.guided-route.quick-visual-v1 .quick-overview-takeaway {padding:var(--space-4);border:0;border-left:3rpx solid var(--av-lead-border);border-radius:0 var(--radius-sm) var(--radius-sm) 0;background:var(--av-lead-background);font-size:var(--av-body);line-height:var(--ui-line-body);color:var(--av-ink);font-weight:400;}
.guided-route.quick-visual-v1 .quick-overview .quick-reading-beats {margin-top:var(--space-7);}
.guided-route.quick-visual-v1 .quick-overview-beat {margin:var(--space-7) 0 0;padding:0;border:0;}
.guided-route.quick-visual-v1 .quick-reading-beats > .quick-overview-beat:first-child {margin-top:0;}
.guided-route.quick-visual-v1 .quick-overview-label {margin:0 0 var(--av-heading-gap);font-size:var(--av-module);line-height:var(--ui-line-title);font-weight:var(--ui-weight-label);color:var(--av-ink);}
.guided-route.quick-visual-v1 .quick-reading-text {font-size:var(--av-body);line-height:var(--av-body-line);letter-spacing:var(--av-body-tracking);word-spacing:normal;text-align:left;color:var(--av-ink);}
.guided-route.quick-visual-v1 .quick-inline-key {box-shadow:none;background-image:var(--av-key-gradient);background-size:100% .55em;background-position:left bottom;background-repeat:no-repeat;-webkit-box-decoration-break:clone;box-decoration-break:clone;}
.guided-route.quick-visual-v1 .quick-inline-boundary {box-shadow:none;background-image:none;text-decoration-color:var(--av-boundary-ink);}
.guided-route.quick-visual-v1 .quick-overview-note {margin-top:var(--space-7);font-size:var(--av-body);line-height:var(--av-body-line);}
.guided-route.quick-visual-v1 .quick-overview-scope {padding:var(--space-4);border-left:3rpx solid var(--av-lead-border);border-radius:0 var(--radius-sm) var(--radius-sm) 0;background:var(--av-module-background);color:var(--av-ink);}
.guided-route.quick-visual-v1 .quick-overview-next {font-size:var(--av-caption);color:var(--av-secondary);border-color:var(--av-divider);}
.guided-route.quick-visual-v1 .quick-overview-note-label {font-size:var(--av-caption);font-weight:var(--ui-weight-label);}
.guided-route.quick-visual-v1 .quick-optional-index {margin-top:var(--space-5);border-color:var(--av-divider);}
.guided-route.quick-visual-v1 .quick-index-toggle {display:flex;align-items:center;justify-content:flex-start;width:100%;max-width:100%;min-height:var(--ui-touch-target);margin:0;padding:var(--space-2) 0;background:transparent;color:var(--ui-color-accent-text);font-size:var(--av-caption);line-height:var(--ui-line-body);text-align:left;}
.guided-route.quick-visual-v1 .quick-optional-index .quick-overview-beat {margin-top:var(--space-5);}
.guided-route.quick-visual-v1 .quick-optional-index .quick-overview-label {font-size:var(--av-caption);line-height:var(--ui-line-body);}
.guided-route.quick-visual-v1 .guided-system-toolbar {padding:var(--space-3) var(--av-gutter) calc(var(--space-3) + env(safe-area-inset-bottom));background:var(--ui-color-dock);border-top:var(--ui-border-width) solid var(--av-divider);box-shadow:none;backdrop-filter:none;}
.guided-route.quick-visual-v1 .guided-system-toolbar-actions {gap:var(--space-2);}
.guided-route.quick-visual-v1 .guided-system-toolbar .btn-base {min-height:var(--ui-touch-target);max-width:100%;margin:0;padding:var(--space-2);border-radius:var(--ui-radius-control);font-size:var(--av-control);line-height:var(--ui-line-title);font-weight:var(--ui-weight-label);white-space:nowrap;box-shadow:none;}
.guided-route.quick-visual-v1 .quick-next {background:var(--av-accent);color:var(--text-on-primary);}
