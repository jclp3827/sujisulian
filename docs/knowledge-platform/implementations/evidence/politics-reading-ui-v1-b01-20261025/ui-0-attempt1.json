                        "level": null
                      },
                      {
                        "text": "社会变革和社会主义发展",
                        "role": "key",
                        "level": null
                      },
                      {
                        "text": "，关注",
                        "role": "plain",
                        "level": null
                      },
                      {
                        "text": "满足社会需要与人的解放发展",
                        "role": "key",
                        "level": null
                      },
                      {
                        "text": "。哲学中的唯物史观与政治经济学中的剩余价值学说构成其理论基础。",
                        "role": "plain",
                        "level": null
