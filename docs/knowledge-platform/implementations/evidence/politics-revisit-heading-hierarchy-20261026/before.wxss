@import "./politics-status-tag.wxss";
.unit-page.unit-closeout-visual {padding:var(--space-4) var(--space-4) calc(var(--ui-touch-target) + var(--space-8) + env(safe-area-inset-bottom));background:var(--bg-page-accent);}
.unit-page.unit-closeout-visual .unit-progress {padding:var(--space-2) 0;background:var(--bg-page);border-bottom:var(--ui-border-width) solid var(--border-subtle);}
.unit-page.unit-closeout-visual .unit-closeout-card {margin-top:var(--space-4);padding:var(--space-4);border:var(--ui-border-width) solid var(--border-subtle);border-radius:var(--radius-lg);background:var(--bg-card);box-shadow:var(--shadow-card);}
.unit-page.unit-closeout-visual .unit-closeout-title {margin:0;font-size:var(--ui-font-reading-extra-large);line-height:var(--ui-line-title);font-weight:var(--ui-weight-heading);color:var(--text-primary);}
.unit-page.unit-closeout-visual .unit-closeout-remaining {margin-top:var(--space-3);padding:var(--space-3);border-radius:var(--radius-sm);background:var(--color-primary-50);font-size:var(--ui-font-body);line-height:var(--ui-line-body);color:var(--text-secondary);}
.unit-page.unit-closeout-visual .unit-closeout-lessons {margin-top:var(--space-4);}
.unit-page.unit-closeout-visual .unit-lesson-row {display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-4);margin:0;padding:var(--space-4) 0;border:0;border-bottom:var(--ui-border-width) solid var(--border-subtle);}
.unit-page.unit-closeout-visual .unit-lesson-row:first-child {padding-top:0;}
.unit-page.unit-closeout-visual .unit-lesson-row:last-child {border-bottom:0;padding-bottom:0;}
.unit-page.unit-closeout-visual .unit-review-title-row {display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-2);flex:1;min-width:0;}
.unit-page.unit-closeout-visual .unit-review-title {flex:0 1 auto;min-width:0;max-width:100%;font-size:var(--ui-font-reading-heading);line-height:1.5;font-weight:var(--ui-weight-label);color:var(--text-primary);}
.unit-page.unit-closeout-visual .unit-review-action {flex:0 0 88rpx;width:88rpx;min-width:88rpx;max-width:88rpx;box-sizing:border-box;min-height:var(--ui-touch-target);margin:0;padding:var(--space-2);border:var(--ui-border-width) solid var(--color-primary-100);border-radius:var(--ui-radius-control);background:var(--color-primary-50);font-size:var(--ui-font-body);line-height:1.5;color:var(--color-primary-600);}
.unit-page.unit-closeout-visual .unit-review-action::after {border:0;}
.unit-page.unit-closeout-visual .unit-closeout-next {margin-top:var(--space-5);padding:var(--space-4);border:var(--ui-border-width) solid var(--color-primary-100);border-radius:var(--radius-sm);background:var(--color-primary-50);}
.unit-page.unit-closeout-visual .unit-closeout-next-label {font-size:var(--font-caption);line-height:1.5;color:var(--text-secondary);}
.unit-page.unit-closeout-visual .unit-closeout-next-title {margin-top:var(--space-2);font-size:var(--ui-font-reading-heading);line-height:1.45;font-weight:var(--ui-weight-label);}
.unit-page.unit-closeout-visual .unit-closeout-next-copy {margin-top:var(--space-2);font-size:var(--ui-font-body);line-height:var(--ui-line-body);color:var(--text-secondary);}
.unit-page.unit-closeout-visual .unit-dock {padding:var(--space-3) var(--space-4) calc(var(--space-3) + env(safe-area-inset-bottom));border-top:var(--ui-border-width) solid var(--border-subtle);background:var(--bg-card);box-shadow:none;}
.unit-page.unit-closeout-visual .unit-dock > .btn-base {width:100%;max-width:100%;height:auto;min-height:var(--ui-touch-target);margin:0;padding:var(--space-3) var(--space-4);border-radius:var(--ui-radius-control);background:var(--color-primary-500);color:var(--text-on-primary);font-size:var(--font-subtitle);line-height:1.5;box-shadow:none;}
