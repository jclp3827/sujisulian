@import "../../../styles/politics-systematic-visual.wxss";
@import "../../../styles/politics-reading.wxss";
.unit-page { --unit-body-size: var(--ui-font-reading-body); min-height: 100vh; padding: var(--ui-page-gutter) var(--ui-page-gutter) calc(300rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--ui-color-page); color: var(--ui-color-text); }
.unit-font-large { --unit-body-size: var(--ui-font-reading-large); }
.unit-font-extraLarge { --unit-body-size: var(--ui-font-reading-extra-large); }
.unit-card { margin-top: var(--space-4); padding: var(--space-4); border: var(--ui-border-width) solid var(--ui-color-border); border-radius: var(--ui-radius-card); background: var(--ui-color-surface); }
.unit-reading { padding: var(--space-2) 0 var(--space-4); border: 0; border-radius: 0; background: transparent; }
.unit-title { font-size: var(--ui-font-reading-extra-large); line-height: var(--ui-line-title); font-weight: var(--ui-weight-heading); }
.unit-heading { margin-bottom: var(--space-2); font-size: var(--ui-font-reading-heading); line-height: var(--ui-line-title); font-weight: var(--ui-weight-label); }
.unit-label { margin-bottom: var(--space-1); font-size: var(--ui-font-body); color: var(--ui-color-muted); font-weight: var(--ui-weight-label); }
.unit-caption { margin-top: var(--space-2); color: var(--ui-color-muted); font-size: var(--ui-font-description); line-height: var(--ui-line-body); }
.unit-body { margin-top: var(--space-2); font-size: var(--unit-body-size); line-height: var(--ui-line-reading); overflow-wrap: break-word; }
.unit-body-paragraph + .unit-body-paragraph { margin-top: var(--space-2); }
.unit-line-relaxed .unit-body { line-height: 2; }
.unit-goal { margin: var(--space-4) 0; padding: var(--space-3); background: var(--ui-color-soft); border-left: 4rpx solid var(--ui-color-accent); font-size: var(--ui-font-body); line-height: var(--ui-line-body); }
.unit-question { font-size: var(--ui-font-reading-heading); line-height: var(--ui-line-title); font-weight: var(--ui-weight-heading); }
.unit-outcome-line { font-size: var(--ui-font-reading-heading); line-height: var(--ui-line-title); }
.unit-outcome-label, .unit-outcome-summary { color: var(--ui-color-text); font-weight: var(--ui-weight-heading); }
.unit-scope { display: flex; gap: var(--space-2); align-items: flex-start; padding: var(--space-2) var(--space-3); border-radius: var(--ui-radius-control); background: var(--ui-color-soft); color: var(--ui-color-muted); font-size: var(--ui-font-description); line-height: var(--ui-line-body); }
.unit-scope-label { flex-shrink: 0; color: var(--ui-color-text); font-weight: var(--ui-weight-label); }
.unit-part { margin-top: var(--space-5); }
.unit-part-boundary { padding: var(--space-3); border-radius: var(--ui-radius-control); background: var(--ui-color-soft); }
.unit-part-recap { padding-top: var(--space-4); border-top: var(--ui-border-width) solid var(--ui-color-border); }
.unit-part-recap.unit-part-emphasized { padding-top: 0; padding-left: var(--space-3); border-top: 0; border-left: 2rpx solid var(--ui-color-boundary); }
.unit-conclusion-summary { margin-top: var(--space-4); }
.unit-conclusion-boundary { margin-top: var(--space-4); }
.unit-inline-key { font-weight: var(--ui-weight-heading); box-shadow: var(--ui-emphasis-key-shadow); }
.unit-inline-boundary { font-weight: var(--ui-weight-heading); text-decoration: underline; text-decoration-color: var(--ui-color-boundary); text-underline-offset: var(--ui-emphasis-boundary-offset); }
.unit-progress { position: sticky; top: 0; z-index: 5; padding: var(--ui-progress-padding-y) 0; background: var(--ui-color-page); border-bottom: var(--ui-border-width) solid var(--ui-color-border); color: var(--ui-color-muted); font-size: var(--ui-progress-label-font); line-height: var(--ui-line-body); }
.unit-progress-row,.unit-progress-metrics,.unit-progress-metric,.unit-test-head { display: flex; align-items: center; }
.unit-progress-row { justify-content: space-between; gap: var(--space-2); }
.unit-progress-metrics { min-width: 0; gap: var(--space-4); }
.unit-progress-metric { gap: var(--space-1); white-space: nowrap; }
.unit-progress-value { color: var(--ui-color-text); font-size: var(--ui-progress-value-font); font-weight: var(--ui-weight-heading); }
.unit-menu.unit-progress-route {
  flex: none;
  width: auto;
  min-height: var(--ui-action-height);
  padding: 0 var(--ui-action-padding-x);
}
.unit-progress-track { width: 100%; }
.unit-test { margin-top: var(--space-5); padding: var(--space-3); border: var(--ui-border-width) solid var(--ui-color-border); border-radius: var(--ui-radius-control); background: var(--ui-color-soft); }
.unit-test-head { justify-content: space-between; gap: var(--space-2); }
.unit-test-title { color: var(--ui-color-text); font-size: var(--ui-font-reading-heading); font-weight: var(--ui-weight-heading); }
.unit-test-note,.unit-test-instruction { color: var(--ui-color-muted); font-size: var(--ui-font-description); line-height: var(--ui-line-body); }
.unit-test-instruction { margin-top: var(--space-3); }
.unit-test-question { margin-top: var(--space-1); }
.unit-test-action { margin-top: var(--space-3); }
.unit-test-answer { margin-top: var(--space-3); padding-top: var(--space-3); border-top: var(--ui-border-width) solid var(--ui-color-border); }
.unit-test-answer .unit-body { margin-top: var(--space-1); }
.unit-sources { margin-top: var(--space-4); }
.unit-source-primary { width: 100%; }
.unit-related-toggle { margin: var(--space-1) auto 0; padding: 0 var(--space-2); }
.unit-primary,.unit-secondary,.unit-ghost { width: 100%; margin-top: var(--space-3); white-space: normal; }
.unit-menu { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-height: var(--ui-touch-target); margin: 0; padding: 0 var(--space-1); background: transparent; color: var(--ui-color-accent-text); font-size: var(--ui-font-description); line-height: var(--ui-line-body); }
.unit-primary::after,.unit-secondary::after,.unit-ghost::after,.unit-menu::after,.unit-source::after { border: 0; }
.unit-dock > .btn-base { width: auto; margin: 0 auto; }
.unit-dock-actions .unit-primary,.unit-dock-actions .unit-secondary,.unit-dock-actions .unit-ghost { white-space: nowrap; }
.unit-lesson-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-top: var(--space-3); border-top: var(--ui-border-width) solid var(--ui-color-border); font-size: var(--ui-font-body); line-height: var(--ui-line-body); }
.unit-source { margin-top: var(--space-2); padding: var(--space-2); min-height: var(--ui-touch-target); background: var(--ui-color-soft); color: var(--ui-color-text); font-size: var(--ui-font-body); line-height: var(--ui-line-body); }
.unit-error { position: fixed; z-index: 20; bottom: var(--space-4); left: var(--ui-page-gutter); right: var(--ui-page-gutter); padding: var(--space-3); background: var(--ui-color-surface); border: 2rpx solid var(--ui-color-boundary); border-radius: var(--ui-radius-control); font-size: var(--ui-font-body); line-height: var(--ui-line-body); }

.unit-route-tabs { display:flex; gap:var(--space-2); align-items:stretch; }
.unit-route-tab { flex:1; min-width:0; margin-top:0; padding:var(--space-2); flex-direction:column; gap:var(--space-1); }
.unit-route-count { color:var(--ui-color-muted); font-size:var(--ui-font-description); }
.unit-route-selected { box-shadow:inset 0 0 0 2rpx var(--ui-color-accent); font-weight:var(--ui-weight-heading); }
.unit-route-summary { margin-top:var(--space-4); padding:0 var(--space-1); }
.unit-current-card { border-color:var(--ui-color-accent); }
.unit-group-card { transition: background-color 120ms ease, border-color 120ms ease; }
.unit-group-card-pressed { opacity: .82; }
.unit-group-card-complete { border-color: var(--color-success); background: var(--bg-soft-green); }
.unit-group-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); }
.unit-group-head .unit-heading { flex: 1; min-width: 0; margin-bottom: 0; font-size: var(--ui-font-section-title); }
.unit-group-entry { display: flex; align-items: center; justify-content: flex-end; flex: none; width: var(--ui-icon-small); min-height: var(--ui-touch-target); color: var(--ui-color-accent-text); font-size: var(--ui-font-reading-heading); line-height: 1; }
.unit-group-scope { margin-top: var(--space-2); }
.unit-group-progress-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-top: var(--space-3); }
.unit-group-progress-label { color: var(--ui-color-muted); font-size: var(--ui-font-description); line-height: var(--ui-line-body); }
.unit-group-state { display: inline-flex; flex: none; align-items: center; gap: var(--space-1); min-height: var(--space-5); padding: 0 var(--space-2); border-radius: var(--ui-radius-pill); background: var(--ui-color-soft); color: var(--ui-color-muted); font-size: var(--ui-font-meta); font-weight: var(--ui-weight-label); }
.unit-group-state-active { background: var(--ui-color-accent-soft); color: var(--ui-color-accent-text); }
.unit-group-state-complete { background: var(--ui-color-surface); color: var(--color-green-700); }
.unit-group-state-mark { font-weight: var(--ui-weight-heading); }
.unit-group-progress-track { width: 100%; }
.unit-group-progress-fill { background: var(--ui-color-caption); }
.unit-group-progress-fill-active { background: var(--ui-color-accent); }
.unit-group-progress-fill-complete { background: var(--color-success); }
.unit-group-card-complete .unit-group-entry { color: var(--color-green-700); }

/* Reading UI representative lessons only. */
.unit-page.pr-reader {padding-left:40rpx;padding-right:40rpx;--unit-body-size:var(--pr-body-size);}
.pr-reader .unit-reading {padding-top:16rpx;}
.pr-reader .unit-title {font-size:var(--pr-title-size);line-height:1.4;overflow-wrap:break-word;}
.pr-reader .pr-title-ordinal {margin-top:12rpx;color:var(--ui-color-muted);font-size:var(--pr-caption-size);line-height:1.6;font-weight:400;}
.pr-reader .unit-goal {margin:24rpx 0 48rpx;padding:0;background:transparent;border:0;}
.pr-reader .unit-outcome-line {font-size:var(--pr-caption-size);line-height:1.65;}
.pr-reader .unit-outcome-label,.pr-reader .unit-outcome-summary {color:var(--ui-color-muted);font-weight:400;}
.pr-reader .unit-part {margin-top:var(--pr-section-gap);}
.pr-reader .unit-heading {font-size:var(--pr-heading-size);line-height:1.45;margin-bottom:16rpx;}
.pr-reader .unit-body {font-size:var(--pr-body-size);line-height:var(--pr-line);margin-top:0;}
.pr-reader .unit-body-paragraph + .unit-body-paragraph {margin-top:var(--pr-paragraph-gap);}
.pr-reader .unit-part-boundary {padding:0;border:0;background:transparent;}
.pr-reader .unit-part-recap {margin-top:64rpx;}
.pr-reader .unit-part-recap.unit-part-emphasized {padding-left:24rpx;border-left:3rpx solid var(--ui-color-accent);}
.pr-reader .unit-test {margin-top:64rpx;padding:28rpx;border-radius:16rpx;background:var(--ui-color-surface);}
.pr-reader .unit-test-title {font-size:var(--pr-subheading-size);font-weight:600;}
.pr-reader .unit-test-note,.pr-reader .unit-test-instruction {font-size:var(--pr-caption-size);}
.pr-reader .unit-test-question {font-size:var(--pr-heading-size);line-height:1.5;margin-top:16rpx;}
.pr-reader .unit-test-action {width:auto;max-width:100%;margin-left:0;min-height:88rpx;}
.pr-reader .unit-progress-metrics {gap:20rpx;}
.pr-reader .unit-progress-row {flex-wrap:wrap;}
.pr-reader .unit-progress-route {border:0;background:transparent;min-height:88rpx;}
.pr-reader .unit-dock .btn-base {min-height:88rpx;}
.pr-reader .unit-sources {margin-top:40rpx;}
.pr-reader .unit-source-primary {background:transparent;border:0;border-top:1rpx solid #dce3ed;border-radius:0;justify-content:flex-start;color:var(--ui-color-accent-text);font-size:var(--pr-caption-size);min-height:88rpx;}
