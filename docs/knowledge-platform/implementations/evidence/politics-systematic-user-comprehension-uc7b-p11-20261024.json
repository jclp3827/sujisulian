            },
            {
              "part": "text",
              "quote": "分配",
              "occurrence": 1,
              "role": "key"
            },
            {
              "part": "text",
              "quote": "市场经济体制",
              "occurrence": 1,
              "role": "key"
            }
          ]
        },
        {
          "label": "公有制与非公有制",
          "text": "公有制经济包括国有经济、集体经济，以及混合所有制中的国有成分和集体成分；非公有制经济包括个体经济、私营经济等。两者都是社会主义市场经济的重要组成部分，也是经济社会发展的重要基础。必须巩固和发展公有制经济，鼓励、支持、引导非公有制经济发展。",
          "sourceBlockIds": [
