    "LEADERSHIP-02": {
      "title": "人民立场、服务宗旨与群众路线",
      "question": "人民立场、为人民服务和群众路线分别讲什么？",
      "objectives": [
        "把价值立场、根本目的与工作路线连起来"
      ],
      "scopeLimit": "学习重点：人民立场、为人民服务和群众路线分别讲什么。不展开制度细目。",
      "sections": [
        {
          "label": "立场与发展目的",
          "text": "人民性是马克思主义的本质属性和鲜明品格，人民立场是中国共产党的根本政治立场。坚持人民至上是新时代治国理政的根本价值取向，增进民生福祉是发展的根本目的。先明确面向谁，再理解具体工作要求。",
          "sourceBlockIds": [
            "block:politics-toc-v2-u006:b003",
            "block:politics-toc-v2-u006:b004",
            "block:politics-toc-v2-u006:b006",
            "block:politics-toc-v2-u006:b008"
