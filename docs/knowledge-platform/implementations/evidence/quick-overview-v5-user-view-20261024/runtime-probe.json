      "title": "马克思主义基本原理与新时代思想",
      "reading": {
        "takeawayRuns": [
          {
            "text": "马克思主义基本原理提供",
            "role": "plain",
            "level": null
          },
          {
            "text": "认识世界和社会的基础理论",
            "role": "key",
            "level": null
          },
          {
            "text": "；习近平新时代中国特色社会主义思想在新时代中国的实践中",
            "role": "plain",
            "level": null
          },
          {
            "text": "坚持和发展马克思主义",
            "role": "key",
            "level": null
          },
          {
            "text": "。",
            "role": "plain",
            "level": null
          }
        ],
        "beats": [
          {
            "id": "J2V5-SEC-01:beat:1",
            "label": "马克思主义：认识世界与社会",
            "runs": [
              {
                "text": "由",
                "role": "plain",
                "level": null
              },
              {
                "text": "马克思主义哲学、政治经济学和科学社会主义",
                "role": "key",
                "level": null
              },
              {
                "text": "构成，分别关注一般规律、社会经济关系和社会变革与人的发展。",
                "role": "plain",
                "level": null
              }
            ]
          },
          {
            "id": "J2V5-SEC-01:beat:2",
            "label": "新时代思想：回应新时代中国问题",
            "runs": [
              {
                "text": "习近平新时代中国特色社会主义思想围绕",
                "role": "plain",
                "level": null
              },
              {
                "text": "坚持和发展中国特色社会主义",
                "role": "key",
                "level": null
              },
              {
                "text": "，回答现代化建设和党的建设等重大时代问题。",
                "role": "plain",
                "level": null
              }
            ]
          },
          {
            "id": "J2V5-SEC-01:beat:3",
            "label": "两部分的联系",
            "runs": [
              {
                "text": "新时代思想是坚持“两个结合”的重大成果，在中国具体实际和中华优秀传统文化中",
                "role": "plain",
                "level": null
              },
              {
                "text": "坚持、运用和发展马克思主义",
                "role": "key",
                "level": null
              },
              {
                "text": "。",
                "role": "plain",
                "level": null
              }
            ]
          }
        ],
        "notes": [],
        "optionalIndex": []
      },
