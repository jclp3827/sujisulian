      "reading": {
        "takeawayRuns": [
          {
            "text": "各领域建设",
            "role": "plain",
            "level": null
          },
          {
            "text": "围绕现代化目标协同推进",
            "role": "key",
            "level": null
          },
          {
            "text": "；改革和法治提供动力与保障，党的领导与人民立场贯穿其中。",
            "role": "plain",
            "level": null
          }
        ],
        "beats": [
          {
            "id": "J2V5-SEC-04:beat:1",
            "label": "主要建设方面：五位一体总体布局",
            "runs": [
              {
                "text": "经济、政治、文化、社会、生态文明建设相互联系",
                "role": "key",
                "level": null
              },
              {
                "text": "。发展经济、保障人民当家作主、丰富精神文化生活、改善民生与保护生态，共同服务现代化和人民生活。",
                "role": "plain",
                "level": null
              }
