          },
          {
            "id": "J2V5-SEC-04:beat:2",
            "label": "战略部署：四个全面战略布局",
            "runs": [
              {
                "text": "统筹全面建设社会主义现代化国家、全面深化改革、全面依法治国、全面从严治党。",
                "role": "plain",
                "level": null
              },
              {
                "text": "改革激发动力",
                "role": "key",
                "level": null
              },
              {
                "text": "，",
                "role": "plain",
                "level": null
              },
              {
                "text": "法治保障治理",
                "role": "key",
                "level": null
              },
              {
                "text": "，全面从严治党通过自我革命",
                "role": "plain",
                "level": null
              },
              {
                "text": "提高长期执政能力",
                "role": "key",
                "level": null
              },
              {
                "text": "，",
                "role": "plain",
                "level": null
              },
              {
                "text": "为现代化建设提供政治保证",
                "role": "key",
                "level": null
              },
              {
                "text": "。",
                "role": "plain",
                "level": null
              }
            ]
          },
          {
            "id": "J2V5-SEC-04:beat:3",
            "label": "发展支撑、安全与对外条件",
            "runs": [
              {
                "text": "教育科技人才",
                "role": "key",
                "level": null
              },
              {
                "text": "提供基础性、战略性支撑；",
                "role": "plain",
                "level": null
              },
              {
                "text": "统筹发展和安全",
                "role": "key",
                "level": null
              },
              {
                "text": "，加强国防和军队建设，",
                "role": "plain",
                "level": null
              },
              {
                "text": "维护国家主权、统一和安全",
                "role": "key",
                "level": null
              },
              {
                "text": "；对外坚持和平发展，",
                "role": "plain",
                "level": null
              },
              {
                "text": "推动构建人类命运共同体",
                "role": "key",
                "level": null
              },
              {
                "text": "。",
                "role": "plain",
                "level": null
