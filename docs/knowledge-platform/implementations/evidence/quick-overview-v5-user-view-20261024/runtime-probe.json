    {
      "step": 3,
      "sectionId": "J2V5-SEC-03",
      "title": "新时代思想的核心主题与目标",
      "reading": {
        "takeawayRuns": [
          {
            "text": "新时代思想围绕坚持和发展中国特色社会主义，把中国实际中的",
            "role": "plain",
            "level": null
          },
          {
            "text": "时代问题、现代化目标与人民需要",
            "role": "key",
            "level": null
          },
          {
            "text": "联系起来。",
            "role": "plain",
            "level": null
          }
        ],
        "beats": [
          {
            "id": "J2V5-SEC-03:beat:1",
            "label": "面对的现实问题",
            "runs": [
              {
                "text": "人民日益增长的",
                "role": "plain",
                "level": null
              },
              {
                "text": "美好生活需要同不平衡不充分的发展之间的矛盾",
                "role": "key",
                "level": null
              },
              {
                "text": "，是新时代我国社会主要矛盾；我国仍长期处于社会主义初级阶段。",
                "role": "plain",
                "level": null
              }
            ]
          },
          {
            "id": "J2V5-SEC-03:beat:2",
            "label": "回答的重大时代课题",
            "runs": [
              {
                "text": "新时代坚持和发展什么样的",
                "role": "plain",
                "level": null
              },
              {
                "text": "中国特色社会主义",
                "role": "key",
                "level": null
              },
              {
                "text": "、怎样坚持和发展，建设什么样的",
                "role": "plain",
                "level": null
              },
              {
                "text": "社会主义现代化强国和长期执政的马克思主义政党",
                "role": "key",
                "level": null
              },
              {
                "text": "、怎样建设，是其回答的重大问题。",
                "role": "plain",
                "level": null
              }
            ]
          },
          {
            "id": "J2V5-SEC-03:beat:3",
            "label": "目标与贯穿原则",
            "runs": [
              {
                "text": "以中国式现代化推进中华民族伟大复兴",
                "role": "key",
                "level": null
              },
              {
                "text": "，朝着国家富强、民族振兴、人民幸福迈进；",
                "role": "plain",
                "level": null
              },
              {
                "text": "党的领导和以人民为中心",
                "role": "key",
                "level": null
              },
              {
                "text": "贯穿其中。",
                "role": "plain",
                "level": null
              }
            ]
          }
        ],
        "notes": [],
        "optionalIndex": []
      },
      "position": 3,
