<view class="contrast-surface" wx:if="{{contrastPair}}">
  <view wx:if="{{stage === 'preview'}}" class="contrast-preview-head"><view class="contrast-preview-label">本组知识</view><view class="contrast-preview-change" bindtap="handleChange" role="button" aria-label="换一组易混知识">换一组 <view class="contrast-chevron" aria-hidden="true"></view></view></view>
  <block wx:if="{{stage === 'evidence'}}">
    <view class="contrast-dimension">对照重点 · {{contrastPair.dimensions[0]}}</view>
    <view class="contrast-evidence-grid">
      <view wx:for="{{evidenceSides}}" wx:key="side" class="contrast-evidence-side">
        <view class="contrast-evidence-title">{{item.title}}</view>
        <view class="contrast-evidence-quotes"><view wx:for="{{item.blocks}}" wx:for-item="sourceBlock" wx:key="id" class="contrast-evidence-quote">{{sourceBlock.text}}</view></view>
        <view class="contrast-evidence-link {{evidenceViewed[item.side] ? 'contrast-evidence-viewed' : ''}}" data-side="{{item.side}}" bindtap="handleEvidence" role="button" aria-label="{{(evidenceViewed[item.side] ? '已查看，重新查看' : '查看') + item.title + '原文'}}"><text class="contrast-evidence-status">{{evidenceViewed[item.side] ? '已查看 · 再看' : '查看原文'}}</text><view class="contrast-chevron" aria-hidden="true"></view></view>
      </view>
    </view>
    <view class="contrast-key-boundary"><view class="contrast-key-label">关键区别</view><view wx:for="{{contrastPair.boundaries}}" wx:key="*this" class="contrast-boundary">{{item}}</view></view>
  </block>
  <block wx:else>
    <view class="contrast-pair"><view>{{contrastPair.leftLabel || sourceTitle}}</view><text>与</text><view>{{contrastPair.rightLabel || targetTitle}}</view></view>
    <view wx:if="{{stage === 'preview'}}" class="contrast-preview-method">先判断，再核对区别与原文。</view>
    <view wx:elif="{{stage === 'boundary'}}" class="contrast-stage-body"><view wx:if="{{contrastPair.initialCheck && judgment}}" class="contrast-answer-result contrast-answer-{{judgment.correct ? 'correct' : 'wrong'}}"><view class="contrast-key-label">{{judgment.correct ? '判断正确' : '这次未答对'}}</view><view>{{judgment.correct ? contrastPair.initialCheck.explanation : (contrastPair.initialCheck.wrongAnswerExplanation || contrastPair.initialCheck.explanation)}}</view></view><view class="contrast-dimension">对照重点 · {{contrastPair.dimensions[0]}}</view><view class="contrast-key-boundary"><view class="contrast-key-label">关键区别</view><view wx:for="{{contrastPair.boundaries}}" wx:key="*this" class="contrast-boundary">{{item}}</view></view></view>
    <view wx:elif="{{stage === 'judgment'}}" class="contrast-stage-body"><view class="contrast-question">{{contrastPair.initialCheck ? contrastPair.initialCheck.prompt : comparisonPrompt}}</view><view wx:if="{{contrastPair.initialCheck}}" class="contrast-option-list"><view wx:for="{{contrastPair.initialCheck.options}}" wx:key="unitId" data-unit-id="{{item.unitId}}" bindtap="handleJudgment" role="button">{{item.label}}</view></view><view wx:else class="contrast-actions"><view data-result="answered" bindtap="handleJudgment" role="button">已想好</view><view data-result="unsure" bindtap="handleJudgment" role="button">不确定</view><view data-result="skipped" bindtap="handleJudgment" role="button">先跳过</view></view></view>
    <view wx:else class="contrast-stage-body"><view class="contrast-question">{{contrastPair.variantCheck ? contrastPair.variantCheck.prompt : comparisonPrompt}}</view><view wx:if="{{contrastPair.variantCheck}}" class="contrast-option-list"><view wx:for="{{contrastPair.variantCheck.options}}" wx:key="unitId" data-unit-id="{{item.unitId}}" bindtap="handleRetest" role="button">{{item.label}}</view></view><view wx:else class="contrast-actions"><view data-result="clear" bindtap="handleRetest" role="button">能分清</view><view data-result="fuzzy" bindtap="handleRetest" role="button">有点模糊</view><view data-result="missed" bindtap="handleRetest" role="button">仍分不清</view></view></view>
  </block>
</view>
