.contrast-surface { padding: 24rpx; border-radius: 20rpx; background: #fff; color: var(--text-primary); }
.contrast-stage { color: var(--knowledge-boundary-text); font-size: 23rpx; font-weight: 800; }
.contrast-dimension { margin-top: 12rpx; padding: 14rpx; border-radius: 12rpx; background: var(--bg-soft-orange); font-size: 19rpx; line-height: 1.5; }
.contrast-side { margin-top: 12rpx; padding: 16rpx; border: 1rpx solid var(--border-light); border-radius: 14rpx; }
.contrast-side text { color: var(--text-tertiary); font-size: 17rpx; }
.contrast-side view { margin-top: 5rpx; font-size: 23rpx; font-weight: 800; line-height: 1.4; }
.contrast-stage-body { margin-top: 20rpx; font-size: 20rpx; line-height: 1.6; }
.contrast-boundary { padding: 14rpx 0; border-bottom: 1rpx solid var(--border-light); }
.contrast-note { margin-top: 14rpx; color: var(--text-secondary); font-size: 18rpx; line-height: 1.5; }
.contrast-question { font-size: 22rpx; font-weight: 750; }
.contrast-actions { display: flex; flex-direction: column; gap: 10rpx; margin-top: 18rpx; }
.contrast-actions view,.contrast-primary { min-height: 78rpx; display: flex; align-items: center; justify-content: center; padding: 10rpx 16rpx; border-radius: 13rpx; box-sizing: border-box; text-align: center; font-size: 20rpx; font-weight: 800; }
.contrast-actions view:first-child,.contrast-primary { background: var(--knowledge-reading-text); color: #fff; }
.contrast-actions view:not(:first-child) { background: var(--bg-soft-gray); color: var(--text-secondary); }
.contrast-evidence-link { min-height: 75rpx; display: flex; align-items: center; padding: 10rpx 14rpx; margin-top: 10rpx; border-radius: 12rpx; background: var(--bg-soft-gray); color: var(--knowledge-reading-text); font-weight: 800; }
.contrast-primary { margin-top: 16rpx; }
