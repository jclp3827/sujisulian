<view wx:if="{{card}}" class="knowledge-card reading-font-{{displayPreferences.fontScale}} reading-line-{{displayPreferences.lineSpacing}}">
  <view class="knowledge-card-context">
    <view class="knowledge-card-path">{{card.identity.pathText}}</view>
    <view class="knowledge-card-context-actions">
      <view class="knowledge-card-state">{{card.identity.statusLabel}}</view>
      <view wx:if="{{!compact}}" class="knowledge-card-display" bindtap="handleDisplay" role="button" aria-label="调整显示字号">显示</view>
    </view>
  </view>
  <view class="knowledge-card-title">{{card.identity.title}}</view>
  <view wx:if="{{card.identity.summary && (card.activity !== 'recall' || recallView.answerVisible)}}" class="knowledge-card-summary">{{card.identity.summary}}</view>
  <view wx:if="{{!compact && card.activity !== 'recall' && card.sectionOutline.length && (card.outlinePreview.length || outlineExpanded)}}" class="knowledge-card-outline">
    <view class="knowledge-card-outline-heading">本篇脉络</view>
    <view wx:if="{{outlineExpanded || card.outlinePreview.length}}" class="knowledge-card-outline-list"><view wx:for="{{outlineExpanded ? card.sectionOutline : card.outlinePreview}}" wx:key="id" class="knowledge-card-outline-item" data-block-id="{{item.id}}" bindtap="handleOutlineTap" role="button" aria-label="跳到{{item.kind === 'article' ? '文章小节' : '知识节点'}}{{item.label}}"><text class="knowledge-card-outline-kind">{{item.kind === 'article' ? '小节' : item.semanticLabel || '知识'}}</text><text class="knowledge-card-outline-text">{{item.label}}</text></view></view>
    <view wx:if="{{card.sectionOutline.length > 3}}" class="knowledge-card-outline-toggle" bindtap="handleOutlineToggle" role="button" aria-label="{{outlineExpanded ? '收起' : '展开全部'}}本篇导航">{{outlineExpanded ? '收起导航' : '展开全部 ' + card.sectionOutline.length + ' 处'}}</view>
  </view>
  <view wx:if="{{!compact && card.activity !== 'recall' && card.sectionOutline.length && !card.outlinePreview.length && !outlineExpanded}}" class="knowledge-card-outline-compact" bindtap="handleOutlineToggle" role="button" aria-label="展开本篇{{card.sectionOutline.length}}处正文定位">本篇脉络 · 展开全部 {{card.sectionOutline.length}} 处 ›</view>

  <view wx:if="{{card.activity !== 'recall'}}" class="knowledge-card-body">
    <block wx:for="{{card.semanticBlocks}}" wx:key="id" wx:for-item="block">
    <view id="{{block.domId}}" class="knowledge-block knowledge-block-{{block.kind}} knowledge-semantic-{{block.semantic}} {{block.keyPoint ? 'knowledge-block-key' : ''}} {{activeBlockId === block.id ? 'knowledge-block-active' : ''}}" data-block-id="{{block.id}}" bindtap="handleBlockTap">
      <view wx:if="{{block.semanticLabel}}" class="knowledge-semantic-label">{{block.semanticLabel}}</view>
      <view wx:if="{{block.kind === 'heading'}}" class="knowledge-block-heading-text">{{block.title || block.text}}</view>
      <view wx:elif="{{block.kind === 'list'}}" class="knowledge-block-list"><view wx:for="{{block.items}}" wx:key="index" wx:for-item="listItem" class="knowledge-block-list-item"><text class="knowledge-block-list-mark">{{block.ordered ? index + 1 : '•'}}</text><view>{{listItem}}</view></view></view>
      <view wx:elif="{{block.kind === 'table'}}" class="knowledge-block-table"><view wx:for="{{block.tableRows}}" wx:key="index" wx:for-item="row" class="knowledge-block-table-row"><view wx:for="{{row}}" wx:key="index" wx:for-item="cell" class="knowledge-block-table-cell"><text class="knowledge-block-table-label">{{cell.label}}</text><view>{{cell.value}}</view></view></view></view>
      <view wx:elif="{{block.kind === 'quote'}}" class="knowledge-block-quote">{{block.text}}</view>
      <view wx:elif="{{block.kind === 'callout'}}" class="knowledge-block-callout">{{block.text}}</view>
      <view wx:else class="knowledge-block-text">{{block.text || block.fallbackText}}</view>
    </view>
    <view wx:for="{{block.inlineContrasts}}" wx:for-item="contrast" wx:key="relationId" class="knowledge-inline-contrast">
      <view class="knowledge-inline-contrast-label">易混边界 · {{contrast.dimensionText}}</view>
      <view class="knowledge-inline-contrast-boundary">{{contrast.boundaryText}}</view>
      <view class="knowledge-inline-contrast-toggle" data-relation-id="{{contrast.relationId}}" bindtap="handleContrastToggle" role="button" aria-label="{{expandedContrastRelationId === contrast.relationId ? '收起' : '查看'}}关联理由">{{expandedContrastRelationId === contrast.relationId ? '收起关联理由' : '查看关联理由'}}</view>
      <view wx:if="{{expandedContrastRelationId === contrast.relationId}}" class="knowledge-inline-contrast-reason">关联理由：{{contrast.reason}}</view>
      <view class="knowledge-inline-contrast-link" data-relation-id="{{contrast.relationId}}" bindtap="handleRelationTap" role="button" aria-label="查看{{contrast.targetTitle}}原文">查看{{contrast.targetTitle}}原文 ›</view>
    </view>
    <view wx:if="{{block.inlineRelations.length}}" class="knowledge-inline-relations">
      <view class="knowledge-inline-relations-toggle" data-block-id="{{block.id}}" bindtap="handleInlineRelationsToggle" role="button" aria-label="{{expandedRelationAnchor === block.id ? '收起' : '展开'}}{{block.inlineRelations.length}}条关联线索">{{expandedRelationAnchor === block.id ? '收起' : '查看'}}关联线索（{{block.inlineRelations.length}}）{{expandedRelationAnchor === block.id ? '⌃' : '⌄'}}</view>
      <view wx:if="{{expandedRelationAnchor === block.id}}" class="knowledge-inline-relations-list">
        <view wx:for="{{block.inlineRelations}}" wx:for-item="relation" wx:key="relationId" class="knowledge-inline-relation" data-relation-id="{{relation.relationId}}" bindtap="handleRelationTap" role="button" aria-label="查看{{relation.relationLabel}}知识，{{relation.targetTitle}}"><view class="knowledge-inline-relation-title">{{relation.relationLabel}} · {{relation.targetTitle}} ›</view><view class="knowledge-inline-relation-reason">{{relation.reason}}</view></view>
      </view>
    </view>
    </block>
  </view>

  <view wx:if="{{!compact && card.activity !== 'recall' && card.recallFace}}" class="knowledge-card-recall-entry">
    <view class="knowledge-card-section-label">读完这一篇</view>
    <view class="knowledge-card-recall-entry-copy">用现有回忆题试着复述，再按需回到原文核对。</view>
    <button class="knowledge-card-recall-entry-action" bindtap="handleStartRecall" aria-label="回忆一下">回忆一下</button>
    <view wx:if="{{taskReturnLabel}}" class="knowledge-card-task-return" bindtap="handleTaskReturn" role="button" aria-label="{{taskReturnLabel}}">{{taskReturnLabel}}</view>
  </view>
  <view wx:if="{{card.activity !== 'recall' && card.relationFooter}}" class="knowledge-card-relations">
    <view class="knowledge-card-section-label">相关知识 · 可选探索</view>
    <view wx:for="{{card.relationFooter.items}}" wx:key="relationId" class="knowledge-card-relation">
      <view class="knowledge-card-relation-head" data-relation-id="{{item.relationId}}" bindtap="handleFooterRelationToggle" role="button" aria-label="{{expandedFooterRelationId === item.relationId ? '收起' : '展开'}}{{item.relationLabel}}知识{{item.targetTitle}}"><view><text class="knowledge-card-relation-label">{{item.relationLabel}}</text><view class="knowledge-card-relation-title">{{item.targetTitle}}</view></view><text>{{expandedFooterRelationId === item.relationId ? '⌃' : '⌄'}}</text></view>
      <view wx:if="{{expandedFooterRelationId === item.relationId}}" class="knowledge-card-relation-detail"><text class="knowledge-card-relation-reason">{{item.reason}}</text><view wx:if="{{item.formalContrast}}" class="knowledge-card-relation-boundary"><text>易混边界 · {{item.formalContrast.dimensionText}}</text><view>{{item.formalContrast.boundaryText}}</view></view><view class="knowledge-card-relation-open" data-relation-id="{{item.relationId}}" bindtap="handleRelationTap" role="button" aria-label="查看{{item.targetTitle}}原文">查看对应原文 ›</view></view>
    </view>
  </view>

  <view wx:if="{{card.activity === 'recall' && recallView}}" class="knowledge-card-recall">
    <view class="knowledge-card-section-label">主动回忆</view>
    <view class="knowledge-card-recall-prompt">{{recallView.prompt}}</view>
    <button wx:if="{{!recallView.answerVisible}}" class="knowledge-card-reveal" bindtap="handleReveal" aria-label="揭晓答案">先想一想，再揭晓</button>
    <view wx:else class="knowledge-card-recall-answer"><text class="knowledge-card-recall-label">答案</text><view>{{recallView.answer}}</view><block wx:if="{{recallView.pitfall}}"><text class="knowledge-card-recall-label">易错边界</text><view>{{recallView.pitfall}}</view></block></view>
    <view wx:if="{{recallView.answerVisible && !recallView.response}}" class="knowledge-card-assess {{allowSkip ? 'knowledge-card-assess-four' : ''}}"><view class="knowledge-card-assess-item" data-result="remembered" bindtap="handleRecallResult" role="button" aria-label="自评：记住了">记住了</view><view class="knowledge-card-assess-item" data-result="fuzzy" bindtap="handleRecallResult" role="button" aria-label="自评：有点模糊">有点模糊</view><view class="knowledge-card-assess-item" data-result="missed" bindtap="handleRecallResult" role="button" aria-label="自评：没想起">没想起</view><view wx:if="{{allowSkip}}" class="knowledge-card-assess-item" data-result="skipped" bindtap="handleRecallResult" role="button" aria-label="自评：跳过">跳过</view></view>
    <view wx:if="{{showReadingReturn && recallView.answerVisible}}" class="knowledge-card-recall-next">
      <view wx:if="{{recallView.response === 'fuzzy' || recallView.response === 'missed'}}" class="knowledge-card-recall-hint">有不确定的地方，可以核对这道题对应的原文。</view>
      <view class="knowledge-card-link" bindtap="handleBackToReading" role="button" aria-label="核对答案原文">核对答案原文 ›</view>
      <view wx:if="{{taskReturnLabel}}" class="knowledge-card-task-return" bindtap="handleTaskReturn" role="button" aria-label="{{taskReturnLabel}}">{{taskReturnLabel}}</view>
    </view>
  </view>

</view>
