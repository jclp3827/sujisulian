/* Reading v2: one continuous article, with stable hierarchy and authored scan cues. */
.knowledge-card { --reader-body-size: 34rpx; --reader-heading-size: 40rpx; --reader-subheading-size: 36rpx; --reader-minorheading-size: 34rpx; }
