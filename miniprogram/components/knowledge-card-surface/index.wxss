.knowledge-card .knowledge-card-outline { margin-top: var(--space-5); padding: var(--space-3) 0; border: 0; border-top: var(--ui-border-width) solid var(--ui-color-border); border-bottom: var(--ui-border-width) solid var(--ui-color-border); border-radius: 0; }
