.knowledge-card { color: #17202a; }
.knowledge-card-context { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.knowledge-card-path { min-width: 0; color: #748091; font-size: 18rpx; line-height: 1.5; }
.knowledge-card-state { flex: none; color: #8a704c; font-size: 18rpx; font-weight: 700; }
.knowledge-card-title { margin-top: 14rpx; font-size: 38rpx; line-height: 1.35; font-weight: 850; }
.knowledge-card-summary { margin-top: 16rpx; padding: 20rpx; border-radius: 16rpx; background: #f2f5f8; color: #445166; font-size: 22rpx; line-height: 1.7; }
.knowledge-card-body { margin-top: 26rpx; }
.knowledge-block { padding: 18rpx 0; font-size: 24rpx; line-height: 1.85; }
.knowledge-block + .knowledge-block { border-top: 1rpx solid #edf0f3; }
.knowledge-block-heading { margin-top: 10rpx; font-size: 29rpx; line-height: 1.5; font-weight: 850; }
.knowledge-block-key { margin: 10rpx 0; padding: 20rpx; border-left: 6rpx solid #526a8b; border-radius: 0 14rpx 14rpx 0; background: #f5f7fa; }
.knowledge-semantic-label { display: inline-flex; margin-bottom: 8rpx; padding: 4rpx 10rpx; border-radius: 999rpx; background: #e9eef5; color: #50617a; font-size: 17rpx; line-height: 1.4; font-weight: 800; }
.knowledge-block-list-item { display: flex; gap: 12rpx; }
.knowledge-block-list-mark { flex: none; color: #607089; }
.knowledge-block-table-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1rpx solid #dfe5ec; }
.knowledge-block-table-cell { min-width: 0; padding: 12rpx; }
.knowledge-block-table-label { color: #748091; font-size: 17rpx; }
.knowledge-block-quote, .knowledge-block-callout { padding: 18rpx; border-radius: 14rpx; background: #f2f5f8; }
.knowledge-inline-contrast { margin: 0 0 14rpx; padding: 16rpx 18rpx; border-left: 4rpx solid #9b7354; border-radius: 0 12rpx 12rpx 0; background: #faf6f0; }
.knowledge-inline-contrast-label { color: #865c3f; font-size: 18rpx; font-weight: 800; line-height: 1.5; }
.knowledge-inline-contrast-boundary { margin-top: 7rpx; color: #4d4038; font-size: 21rpx; line-height: 1.6; white-space: pre-line; }
.knowledge-inline-contrast-reason { margin-top: 7rpx; color: #6d5b4f; font-size: 18rpx; line-height: 1.55; }
.knowledge-inline-contrast-link { margin-top: 8rpx; color: #70533e; font-size: 18rpx; font-weight: 750; }
.knowledge-inline-relations { margin: 0 0 14rpx; }
.knowledge-inline-relations-toggle { display: inline-flex; min-height: 44rpx; align-items: center; padding: 3rpx 10rpx; border-radius: 10rpx; background: #eef2f7; color: #52647c; font-size: 18rpx; font-weight: 750; }
.knowledge-inline-relations-list { margin-top: 7rpx; padding: 4rpx 14rpx; border-left: 3rpx solid #d8e0ea; }
.knowledge-inline-relation { padding: 12rpx 0; }
.knowledge-inline-relation + .knowledge-inline-relation { border-top: 1rpx solid #e7ebf0; }
.knowledge-inline-relation-title { color: #425572; font-size: 20rpx; font-weight: 800; line-height: 1.5; }
.knowledge-inline-relation-reason { margin-top: 5rpx; color: #5d6b7c; font-size: 18rpx; line-height: 1.55; }
.knowledge-card-relations, .knowledge-card-recall { margin-top: 30rpx; padding: 22rpx; border-radius: 18rpx; background: #f5f7fa; }
.knowledge-card-section-label { color: #50617a; font-size: 19rpx; font-weight: 850; }
.knowledge-card-relation { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 18rpx 0; border-top: 1rpx solid #dfe5ec; }
.knowledge-card-relation-label { color: #64748b; font-size: 17rpx; font-weight: 800; }
.knowledge-card-relation-title { margin-top: 3rpx; font-size: 22rpx; font-weight: 800; }
.knowledge-card-relation .knowledge-card-relation-reason { display: block; margin-top: 5rpx; color: #718096; font-size: 18rpx; line-height: 1.45; font-weight: 500; }
.knowledge-card-relation-boundary { margin-top: 10rpx; color: #6d5545; font-size: 18rpx; line-height: 1.55; white-space: pre-line; }
.knowledge-card-relation-boundary text { display: block; font-weight: 800; }
.knowledge-card-recall-prompt { margin-top: 16rpx; font-size: 28rpx; line-height: 1.55; font-weight: 800; }
.knowledge-card-reveal { margin-top: 20rpx; background: #253858; color: #fff; }
.knowledge-card-recall-answer { margin-top: 20rpx; font-size: 23rpx; line-height: 1.7; }
.knowledge-card-recall-label { display: block; margin-top: 14rpx; color: #728096; font-size: 18rpx; font-weight: 800; }
.knowledge-card-assess { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 18rpx; }
.knowledge-card-assess-four { grid-template-columns: repeat(2,minmax(0,1fr)); }
.knowledge-card-assess-item { min-width: 0; min-height: 104rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 15rpx 8rpx; border-radius: 12rpx; background: #fff; text-align: center; font-size: 24rpx; line-height: 1.4; font-weight: 700; word-break: break-word; }
.knowledge-card-link { margin-top: 18rpx; color: #50617a; font-size: 20rpx; font-weight: 800; }
.knowledge-card-tools { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 26rpx; padding-top: 18rpx; border-top: 1rpx solid #e4e9ef; }
.knowledge-card-tool { padding: 13rpx 17rpx; border-radius: 999rpx; background: #eef2f7; color: #50617a; font-size: 19rpx; font-weight: 750; }

.reading-font-large .knowledge-card-title { font-size: 42rpx; }
.reading-font-large .knowledge-card-summary,
.reading-font-large .knowledge-block,
.reading-font-large .knowledge-card-recall-answer { font-size: 30rpx; }
.reading-font-large .knowledge-card-recall-prompt { font-size: 33rpx; }
.reading-font-large .knowledge-card-assess-item { font-size: 29rpx; }
.reading-font-large .knowledge-inline-contrast-boundary { font-size: 27rpx; }
.reading-font-extraLarge .knowledge-card-title { font-size: 46rpx; }
.reading-font-extraLarge .knowledge-card-summary,
.reading-font-extraLarge .knowledge-block,
.reading-font-extraLarge .knowledge-card-recall-answer { font-size: 34rpx; }
.reading-font-extraLarge .knowledge-card-recall-prompt { font-size: 38rpx; }
.reading-font-extraLarge .knowledge-card-assess-item { font-size: 34rpx; }
.reading-font-extraLarge .knowledge-inline-contrast-boundary { font-size: 31rpx; }
.reading-line-relaxed .knowledge-block,
.reading-line-relaxed .knowledge-card-recall-prompt,
.reading-line-relaxed .knowledge-card-recall-answer { line-height: 2; }
