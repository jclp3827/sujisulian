.knowledge-reading-heading { display: block; margin: var(--space-6) 0 var(--space-3); color: var(--ui-color-text); line-height: 1.45; font-weight: var(--ui-weight-heading); }
.knowledge-reading-heading-1 { padding: var(--space-3) 0 var(--space-2) var(--space-3); border-left: 5rpx solid var(--ui-color-accent); font-size: var(--reader-heading-size); }
