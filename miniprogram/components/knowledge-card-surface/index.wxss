.knowledge-card .knowledge-block-heading { margin-top: var(--space-7); }
.knowledge-inline-key { color: var(--ui-color-text); font-weight: var(--ui-weight-heading); }
.knowledge-inline-boundary { color: var(--ui-color-text); font-weight: var(--ui-weight-heading); text-decoration: underline; text-decoration-color: var(--ui-color-boundary); text-underline-offset: 5rpx; }
.knowledge-reading-row-item { position: relative; padding: var(--space-2) 0 var(--space-2) var(--space-3); margin-left: var(--space-1); border-left: 2rpx solid var(--ui-color-border); }
