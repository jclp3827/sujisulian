.knowledge-space { color: #18212b; }
.knowledge-space-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 24rpx; }
.knowledge-space-kicker { color: #6b7280; font-size: 20rpx; font-weight: 700; }
.knowledge-space-title { margin-top: 6rpx; font-size: 34rpx; line-height: 1.35; font-weight: 800; }
.knowledge-space-toggle { flex: none; padding: 14rpx 18rpx; border-radius: 999rpx; background: #eef2f7; color: #405064; font-size: 20rpx; font-weight: 700; }
.knowledge-space-root { display: flex; align-items: center; gap: 18rpx; padding: 22rpx; border: 2rpx solid #253858; border-radius: 20rpx; background: #fff; }
.knowledge-space-root-mark { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #253858; color: #fff; font-size: 24rpx; font-weight: 800; }
.knowledge-space-root-title { font-size: 25rpx; line-height: 1.4; font-weight: 800; }
.knowledge-space-root-meta { color: #708090; font-size: 19rpx; }
.knowledge-space-trunk { width: 2rpx; height: 24rpx; margin: 0 auto; background: #aab6c4; }
.knowledge-space-regions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.knowledge-space-region { min-width: 0; padding: 20rpx; border: 1rpx solid #dbe3ec; border-radius: 18rpx; background: #fff; box-sizing: border-box; transition: opacity .18s ease; }
.knowledge-space-region-active { border-color: #253858; background: #f3f6fa; }
.knowledge-space-region-compressed { opacity: .58; }
.knowledge-space-region-index { color: #708090; font-size: 18rpx; font-weight: 800; }
.knowledge-space-region-title { margin-top: 8rpx; font-size: 22rpx; line-height: 1.45; font-weight: 800; word-break: break-all; }
.knowledge-space-region-meta { margin-top: 8rpx; color: #708090; font-size: 18rpx; }
.knowledge-branch { margin-top: 20rpx; padding: 22rpx; border-radius: 20rpx; background: #f7f9fc; }
.knowledge-branch-back { color: #50617a; font-size: 20rpx; font-weight: 700; }
.knowledge-branch-title { margin-top: 12rpx; font-size: 28rpx; line-height: 1.45; font-weight: 800; }
.knowledge-branch-group { margin-top: 20rpx; }
.knowledge-branch-group-title { margin-bottom: 10rpx; color: #50617a; font-size: 21rpx; font-weight: 800; }
.knowledge-branch-point { display: flex; gap: 14rpx; padding: 18rpx 0; border-top: 1rpx solid #e2e8f0; }
.knowledge-branch-point-mark { flex: none; width: 9rpx; height: 9rpx; margin-top: 12rpx; border-radius: 50%; background: #50617a; }
.knowledge-branch-point-copy { min-width: 0; flex: 1; font-size: 22rpx; line-height: 1.5; font-weight: 700; }
.knowledge-branch-point-action { display: block; margin-top: 4rpx; color: #7b8796; font-size: 18rpx; font-weight: 600; }
.knowledge-directory-note { margin-bottom: 16rpx; color: #6b7280; font-size: 20rpx; line-height: 1.5; }
.knowledge-directory-row { position: relative; display: flex; gap: 12rpx; min-width: 0; box-sizing: border-box; }
.knowledge-directory-line { width: 2rpx; margin: 0 8rpx; background: #d5dde7; }
.knowledge-directory-copy { min-width: 0; flex: 1; padding: 15rpx 12rpx; border-bottom: 1rpx solid #e7ebf0; }
.knowledge-directory-title { font-size: 21rpx; line-height: 1.45; font-weight: 700; word-break: break-all; }
.knowledge-directory-meta { margin-top: 3rpx; color: #7b8796; font-size: 17rpx; }
.knowledge-directory-part .knowledge-directory-title, .knowledge-directory-article .knowledge-directory-title { font-weight: 850; }
.knowledge-space-compact .knowledge-space-toggle, .knowledge-space-compact .knowledge-branch-point-action { display: none; }
