<view class="home-head">
  <view class="home-title" role="heading" aria-level="1">{{title}}</view>
  <view class="home-description">{{description}}</view>
  <view class="search-entry" bindtap="handleSearch" hover-class="search-pressed" role="button" aria-label="{{searchHint}}，进入搜索页">
    <view class="search-symbol" aria-hidden="true"></view><text class="search-copy">{{searchHint}}</text><text class="search-label">搜索</text><view class="search-arrow" aria-hidden="true"></view>
  </view>
</view>
