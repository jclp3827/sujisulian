:host { display:block; width:100%; min-width:0; }
.home-head { display:block; width:100%; min-width:0; }
.home-title { color:var(--text-primary); font-size:var(--ui-font-page-title); font-weight:var(--ui-weight-heading); line-height:var(--ui-line-title); overflow-wrap:anywhere; }
.home-description { margin-top:var(--space-2); color:var(--text-secondary); font-size:var(--ui-font-body); line-height:var(--ui-line-body); }
.search-entry { display:flex; align-items:center; gap:var(--space-3); width:100%; min-width:0; min-height:44px; margin-top:var(--space-4); padding:var(--space-3) var(--ui-card-padding); box-sizing:border-box; border:var(--ui-border-width) solid var(--border-subtle); border-radius:var(--ui-radius-control); background:var(--bg-card); color:var(--text-secondary); font-size:var(--ui-font-body); line-height:var(--ui-line-body); }
.search-copy { flex:1; min-width:0; overflow-wrap:anywhere; }
.search-label { flex:none; color:var(--color-primary-600); font-weight:var(--ui-weight-label); }
.search-symbol { position:relative; flex:none; width:24rpx; height:24rpx; border:2rpx solid currentColor; border-radius:50%; margin-right:var(--space-1); }
.search-symbol::after { content:''; position:absolute; right:-8rpx; bottom:-5rpx; width:12rpx; height:2rpx; background:currentColor; transform:rotate(45deg); }
.search-arrow { flex:none; width:12rpx; height:12rpx; border-right:2rpx solid currentColor; border-bottom:2rpx solid currentColor; transform:rotate(-45deg); }
.search-pressed { background:var(--bg-soft-blue); }
