.tab-bar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 8rpx 28rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(156, 163, 175, 0.16);
  box-shadow: 0 -8rpx 28rpx rgba(47, 107, 255, 0.08);
}

.tab-bar {
  min-height: 92rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
}

.tab-bar-item {
  min-width: 0;
  min-height: 48px;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  color: var(--text-tertiary);
}

.tab-bar-item-active {
  background: var(--bg-soft-blue);
  color: var(--color-primary-500);
}
.tab-bar-item-home.tab-bar-item-active { background: #e8f0ff; color: #2456d6; }
.tab-bar-item-note.tab-bar-item-active { background: #fff1d8; color: #a76420; }
.tab-bar-item-train.tab-bar-item-active { background: #e7f7ee; color: #238a50; }
.tab-bar-item-common-sense.tab-bar-item-active { background: #f1e8fa; color: #6934aa; }
.tab-bar-item-politics.tab-bar-item-active { background: #e8f0ff; color: #2456d6; }

.tab-bar-icon-wrap {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-bar-icon {
  width: 46rpx;
  height: 46rpx;
}

.tab-bar-text {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #9ca3af;
}

.tab-bar-item-active .tab-bar-text { color: currentColor; }

.tab-bar-item-pressed { background: var(--bg-soft-blue); }
.tab-bar-item-home.tab-bar-item-pressed { background: #e8f0ff; }
.tab-bar-item-train.tab-bar-item-pressed { background: #e7f7ee; }
