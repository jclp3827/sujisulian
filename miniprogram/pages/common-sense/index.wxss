.common-sense-page { min-height: 100vh; background: var(--bg-page-accent); }
.common-sense-shell { min-height: 100vh; padding: 20rpx 24rpx calc(120rpx + env(safe-area-inset-bottom)); }
.common-sense-hero { padding: 10rpx 2rpx 34rpx; }
.common-sense-title-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.common-sense-search { flex: none; }
.common-sense-kicker { font-size: 24rpx; color: var(--color-primary-500); font-weight: 700; letter-spacing: 2rpx; }
.common-sense-title-group { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.common-sense-title { min-width: 0; font-size: 48rpx; line-height: 1.2; font-weight: 700; color: var(--text-primary); }
.common-sense-title-count { flex: none; padding: 7rpx 12rpx; border-radius: 999rpx; background: var(--bg-soft-blue); color: var(--color-primary-500); font-size: 21rpx; line-height: 1.2; font-weight: 700; }
.common-sense-desc { margin-top: 8rpx; max-width: 650rpx; font-size: 24rpx; line-height: 1.5; color: var(--text-secondary); }
.common-sense-chip { display: inline-block; margin-top: 18rpx; padding: 8rpx 16rpx; border-radius: 999rpx; background: var(--bg-soft-green); color: var(--color-green-500); font-size: 22rpx; font-weight: 700; }
.drill-meta { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.drill-list { display: flex; flex-direction: column; gap: 18rpx; }
.drill-card { min-height: 142rpx; padding: 22rpx 18rpx; display: flex; align-items: center; gap: 16rpx; border-color: rgba(51, 196, 122, .16); }
.drill-card.is-pending { opacity: .66; border-color: var(--border-soft); }
.drill-index { flex: none; min-width: 88rpx; height: 52rpx; padding: 0 12rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; border: 2rpx solid var(--border-subtle); background: var(--bg-soft-blue); color: var(--text-tertiary); font-size: 20rpx; line-height: 1; font-weight: 800; }
.drill-index.is-ready { border-color: rgba(51, 196, 122, .18); background: var(--bg-soft-green); color: var(--color-green-500); }
.drill-card-main { flex: 1; min-width: 0; }
.drill-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.drill-card-title-wrap { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.drill-card-learning { flex: none; display: flex; align-items: center; gap: 7rpx; }
.drill-card-title { min-width: 0; flex: 0 1 auto; font-size: 30rpx; line-height: 1.35; font-weight: 700; color: var(--text-primary); }
.drill-card-count { flex: none; padding: 5rpx 9rpx; border-radius: 999rpx; background: rgba(47, 107, 255, .08); color: rgba(47, 107, 255, .8); font-size: 18rpx; line-height: 1.25; font-weight: 700; }
.drill-point-count { flex: none; padding: 5rpx 9rpx; border-radius: 999rpx; background: var(--bg-soft-blue); color: var(--color-primary-500); font-size: 18rpx; line-height: 1.2; font-weight: 700; white-space: nowrap; }
.drill-card-subtitle { margin-top: 7rpx; font-size: 22rpx; line-height: 1.5; color: var(--text-secondary); }
.drill-status { flex: none; padding: 5rpx 9rpx; border-radius: 999rpx; background: var(--bg-soft-blue); color: var(--text-tertiary); font-size: 18rpx; line-height: 1.2; white-space: nowrap; }
.drill-status.is-ready { background: var(--bg-soft-green); color: var(--color-green-500); }
.home-search { margin: 0; border-radius: 40rpx; background: #fff; color: #2f6bff; font-size: 26rpx; padding: 10rpx 28rpx; line-height: 1.7; }
.home-search::after, .part-shortcuts button::after { border: 0; }
.home-browse-actions { display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; }
.home-browse-actions .home-search { padding: 10rpx 18rpx; flex-shrink: 0; }
.common-sense-title-row { flex-wrap: wrap; }
.daily-entry { margin-top: 18rpx; padding: 22rpx 24rpx; border-radius: 28rpx; background: linear-gradient(130deg, #e0eaff, #edf3ff); color: #173b7e; }
.daily-kicker { font-size: 23rpx; line-height: 1.4; color: #5d76a4; }
.daily-title { font-size: 40rpx; line-height: 1.3; font-weight: 700; margin-top: 6rpx; }
.daily-description { font-size: 26rpx; line-height: 1.5; margin-top: 6rpx; }
.daily-action { display: inline-block; background: #2f6bff; color: #fff; border-radius: 32rpx; padding: 10rpx 24rpx; font-size: 26rpx; line-height: 1.5; margin-top: 14rpx; }
.feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.feature-card { min-width: 0; min-height: 132rpx; display: flex; align-items: center; gap: 12rpx; background: #fff; border-radius: 24rpx; padding: 20rpx; }
.feature-main { flex: 1; min-width: 0; }
.feature-arrow { flex-shrink: 0; font-size: 38rpx; color: #738098; }
.home-topic-entry { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 24rpx; margin-top: 16rpx; background: #fff; border-radius: 24rpx; }
.feature-title { color: #23324b; font-weight: 600; font-size: 30rpx; line-height: 1.4; }
.feature-description { color: #738098; font-size: 24rpx; line-height: 1.5; margin-top: 6rpx; }
.browse-title { display: flex; justify-content: space-between; color: #47556d; font-size: 26rpx; line-height: 1.4; margin: 18rpx 0 12rpx; }
.browse-title text { color: #8995a7; font-size: 24rpx; }
.part-shortcuts { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.part-shortcuts button { flex: 1; min-width: 120rpx; margin: 0; padding: 12rpx 8rpx; line-height: 1.5; border-radius: 16rpx; background: #fff; color: #3464bb; font-size: 24rpx; }
.shortcut-title { margin-bottom: 8rpx; }
.part-shortcuts { margin-top: 0; }
@media (max-height: 650px) {
  .common-sense-shell { padding-top: 12rpx; }
  .common-sense-title { font-size: 44rpx; }
  .common-sense-desc { margin-top: 6rpx; font-size: 22rpx; line-height: 1.4; }
  .daily-entry { margin-top: 14rpx; padding: 12rpx 22rpx; }
  .daily-kicker { font-size: 22rpx; }
  .daily-title { margin-top: 4rpx; font-size: 36rpx; }
  .daily-description { margin-top: 4rpx; font-size: 24rpx; line-height: 1.4; }
  .daily-action { margin-top: 10rpx; padding: 8rpx 22rpx; font-size: 24rpx; }
  .home-topic-entry { margin-top: 12rpx; padding: 16rpx 22rpx; }
  .feature-grid { gap: 12rpx; }
  .feature-card { min-height: 116rpx; padding: 16rpx; }
  .feature-title { font-size: 28rpx; }
  .feature-description { margin-top: 4rpx; font-size: 22rpx; line-height: 1.4; }
  .browse-title { margin: 14rpx 0 8rpx; font-size: 24rpx; }
  .part-shortcuts { margin-top: 0; }
  .part-shortcuts button { padding: 8rpx; font-size: 22rpx; line-height: 1.4; }
}
