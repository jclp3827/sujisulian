<view class="note-page">
  <view class="note-shell module-home-shell">
    <view class="note-page-head">
      <view class="note-page-title" role="heading" aria-level="1">花生笔记</view>
      <view class="note-page-description">梳理知识，快速回忆</view>
      <view class="note-search-entry" bindtap="handleSearchTap" hover-class="note-search-pressed" role="button" aria-label="搜索知识点、公式或解题方法，进入搜索页">
        <view class="note-search-symbol" aria-hidden="true"></view><text class="note-search-copy">搜索知识点、公式或解题方法</text><view class="note-search-arrow" aria-hidden="true"></view>
      </view>
    </view>
    <view class="note-daily module-home-primary surface-card" wx:if="{{primaryMode}}">
      <image class="note-daily-art" src="/images/notes-home/themed-v1/daily-quick-review.svg" mode="aspectFit" aria-hidden="true" />
      <view class="note-daily-copy">
        <view class="module-home-primary-heading"><view class="module-home-primary-title">每日快记</view></view>
        <view class="module-home-primary-description">回顾公式与方法，巩固关键知识</view>
      </view>
      <view class="note-daily-footer">
        <view class="btn-base btn-compact btn-primary module-home-primary-action" data-kind="basic" bindtap="handlePracticeTap" hover-class="btn-pressed" role="button" aria-label="开始快记"><text>开始快记</text><view class="note-daily-action-arrow" aria-hidden="true"></view></view>
      </view>
    </view>
    <view class="note-all surface-card module-home-entry" bindtap="handleDirectoryTap" hover-class="module-home-pressed" role="button" aria-label="全部知识，按科目和专题查阅">
      <view class="note-directory-art-slot" aria-hidden="true"><image class="note-directory-art" src="/images/notes-home/themed-v1/all-knowledge.svg" mode="aspectFit" aria-hidden="true" /></view><view class="module-home-entry-copy"><view class="module-home-entry-title">全部知识</view><view class="module-home-entry-description">{{subjectCount}} 个科目 · {{totalPointCount}} 个知识点</view></view><view class="note-library-enter" aria-hidden="true"><text>进入</text><view class="module-home-arrow"></view></view>
    </view>
    <view class="module-home-section-title">选择学习方式</view>
    <view class="note-mode-list module-home-path-list">
      <view wx:for="{{otherModes}}" wx:key="id" id="note-mode-{{item.id}}" class="note-mode note-mode-{{item.id}} surface-card module-home-path" data-kind="{{item.id}}" bindtap="handlePracticeTap" hover-class="module-home-pressed" role="button" aria-label="{{item.title}}，{{item.description}}{{!item.enabled ? '，建设中' : ''}}">
        <view class="note-glyph-well" aria-hidden="true"><image class="note-mode-art" src="/images/notes-home/delivered-v1/{{item.id === 'method' ? 'method-selection' : item.id === 'exam' ? 'exam-recall' : 'full-problem-application'}}.svg" mode="aspectFit" aria-hidden="true" /></view><view class="module-home-path-copy"><view class="module-home-path-title">{{item.title}}</view><view class="module-home-path-description">{{item.description}}</view></view>
        <view wx:if="{{!item.enabled}}" class="module-home-path-status">建设中</view><view wx:else class="module-home-arrow" aria-hidden="true"></view>
      </view>
    </view>
  </view>
</view>
