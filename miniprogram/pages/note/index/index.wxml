<view class="note-page">
  <view class="note-shell">
    <view class="note-heading">花生笔记</view>
    <view class="note-subtitle">梳理知识，快速回忆</view>
    <view class="note-search surface-card">
      <input class="note-search-input" value="{{keyword}}" placeholder="搜索知识点、公式或解题方法" bindinput="handleInput" bindconfirm="handleSearchTap" confirm-type="search" />
      <button class="note-search-button" bindtap="handleSearchTap">搜索</button>
    </view>
    <view class="note-all surface-card" bindtap="handleDirectoryTap">
      <view><view class="note-card-title">全部笔记</view><view class="note-card-desc">{{subjectCount}} 个科目 · {{totalPointCount}} 个知识点，按专题查阅</view></view>
      <view class="note-arrow">›</view>
    </view>
    <view class="note-section-title">选择学习方式</view>
    <view wx:for="{{modes}}" wx:key="id" class="note-mode surface-card" data-kind="{{item.id}}" bindtap="handlePracticeTap">
      <view class="note-mode-main"><view class="note-card-title">{{item.title}}</view><view class="note-card-desc">{{item.description}}</view></view>
      <view wx:if="{{!item.enabled}}" class="note-mode-pending">建设中</view><view wx:else class="note-arrow">›</view>
    </view>
  </view>
</view>
