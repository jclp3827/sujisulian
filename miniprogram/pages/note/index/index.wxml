<view class="note-page">
  <view class="note-shell module-home-shell">
    <learning-home-head title="花生笔记" description="梳理知识，快速回忆" search-hint="搜索知识点、公式或解题方法" bind:search="handleSearchTap" />
    <view class="module-home-primary surface-card" wx:if="{{primaryMode}}">
      <view class="module-home-primary-heading"><image class="home-glyph" src="/images/module-home/memory.svg" mode="aspectFit" aria-hidden="true" /><view class="module-home-primary-title">每日快记</view></view>
      <view class="module-home-primary-description">回顾公式与方法，巩固关键知识</view>
      <view class="btn-base btn-compact btn-primary module-home-primary-action" data-kind="basic" bindtap="handlePracticeTap" hover-class="btn-pressed" role="button" aria-label="开始快记">开始快记</view>
    </view>
    <view class="note-all surface-card module-home-entry" bindtap="handleDirectoryTap" hover-class="module-home-pressed" role="button" aria-label="全部知识，按科目和专题查阅">
      <view class="module-home-entry-copy"><view class="module-home-entry-title">全部知识</view><view class="module-home-entry-description">{{subjectCount}} 个科目 · {{totalPointCount}} 个知识点，按专题查阅</view></view><image class="home-glyph home-directory-art" src="/images/module-home/directory.svg" mode="aspectFit" aria-hidden="true" /><view class="module-home-arrow" aria-hidden="true"></view>
    </view>
    <view class="module-home-section-title">换一种学习方式</view>
    <view class="module-home-path-list">
      <view wx:for="{{otherModes}}" wx:key="id" class="note-mode surface-card module-home-path" data-kind="{{item.id}}" bindtap="handlePracticeTap" hover-class="module-home-pressed" role="button" aria-label="{{item.title}}，{{item.description}}">
        <image class="home-glyph" src="/images/module-home/{{item.id === 'method' ? 'compare' : item.id === 'exam' ? 'memory' : 'route'}}.svg" mode="aspectFit" aria-hidden="true" /><view class="module-home-path-copy"><view class="module-home-path-title">{{item.title}}</view><view class="module-home-path-description">{{item.description}}</view></view>
        <view wx:if="{{!item.enabled}}" class="module-home-path-status">建设中</view><view wx:else class="module-home-arrow" aria-hidden="true"></view>
      </view>
    </view>
  </view>
</view>
