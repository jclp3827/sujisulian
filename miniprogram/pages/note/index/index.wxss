@import "../../../styles/module-home.wxss";
.note-page {
  --note-card-inset:28rpx;
  --note-glyph-size:84rpx;
  min-height:100vh; background:var(--bg-page); color:var(--text-primary);
}
.note-page .module-home-primary,.note-page .module-home-path { box-shadow:none; }
.note-page .module-home-primary-title,.note-page .module-home-entry-title { font-size:var(--ui-font-section-title); font-weight:var(--ui-weight-heading); line-height:var(--ui-line-title); color:var(--text-primary); }
.note-page .module-home-path-title { font-size:var(--ui-font-card-title); font-weight:var(--ui-weight-label); line-height:var(--ui-line-title); }
.note-page .module-home-primary-description,.note-page .module-home-entry-description,.note-page .module-home-path-description { font-size:var(--ui-font-description); line-height:var(--ui-line-body); }
.note-page .module-home-path-status { font-size:var(--ui-font-meta); line-height:var(--ui-line-body); color:var(--text-secondary); }
.note-page .module-home-section-title { margin-top:var(--space-5); font-size:var(--ui-font-description); font-weight:var(--ui-weight-label); }

.note-page .note-daily {
  position:relative; overflow:hidden; flex-direction:column; align-items:stretch;
  padding:var(--space-3) var(--note-card-inset); border-color:rgba(47,107,255,.13);
  background-color:var(--color-primary-100);
  background-image:radial-gradient(ellipse at 100% 100%,rgba(89,213,183,.17) 0%,rgba(89,213,183,0) 65%),radial-gradient(ellipse at 100% 0%,rgba(116,213,244,.16) 0%,rgba(116,213,244,0) 62%),linear-gradient(115deg,#dce9ff 0%,#e7e3fb 58%,#e2edfc 100%);
}
.note-daily-copy,.note-daily-footer { position:relative; z-index:1; min-width:0; }
.note-page .note-daily .module-home-primary-title { min-width:0; }
.note-daily-art { position:absolute; z-index:0; pointer-events:none; right:-4%; top:50%; transform:translateY(-50%); width:46vw; height:46vw; min-width:170px; min-height:170px; max-width:200px; max-height:200px; opacity:.16; }
.note-daily-footer { display:flex; align-items:center; flex-wrap:wrap; gap:var(--space-3); margin-top:var(--space-2); }
.note-page .note-daily-footer .module-home-primary-action { flex:none; align-self:auto; max-width:100%; margin:0 0 0 auto; box-shadow:none; }
.note-daily-action-arrow { position:relative; flex:none; width:24rpx; height:var(--ui-chevron-stroke); margin-left:var(--space-2); background:currentColor; }
.note-daily-action-arrow::after { content:''; position:absolute; right:0; top:50%; width:10rpx; height:10rpx; border-top:var(--ui-chevron-stroke) solid currentColor; border-right:var(--ui-chevron-stroke) solid currentColor; transform:translateY(-50%) rotate(45deg); }
.note-page .note-all {
  position:relative; overflow:hidden; display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; margin-top:var(--space-3); gap:var(--space-3);
  padding:20rpx var(--note-card-inset); border-color:rgba(51,196,122,.14);
  background-color:var(--bg-soft-green);
  background-image:radial-gradient(ellipse at 100% 100%,rgba(98,162,245,.18) 0%,rgba(98,162,245,0) 72%),radial-gradient(ellipse at 65% 0%,rgba(67,203,175,.11) 0%,rgba(67,203,175,0) 65%),linear-gradient(115deg,#e7f8ee 0%,#e0f5eb 55%,#e9f5f4 100%);
}
.note-directory-art-slot { position:relative; z-index:1; width:var(--note-glyph-size); min-width:44px; max-width:48px; height:72rpx; }
.note-directory-art { position:absolute; pointer-events:none; left:50%; top:50%; transform:translate(-50%,-50%); margin-left:-2.2px; width:52px; height:52px; }
.note-all .module-home-entry-copy { min-width:0; padding-left:var(--space-1); box-sizing:border-box; }
.note-library-enter { display:flex; align-items:center; gap:var(--space-3); color:var(--text-secondary); font-size:var(--ui-font-meta); line-height:var(--ui-line-body); }
.note-page .note-mode-list { gap:var(--space-3); }
.note-page .note-mode { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; column-gap:var(--space-3); padding:var(--space-3) var(--note-card-inset); background:var(--bg-card); box-shadow:none; }
.note-glyph-well { display:flex; align-items:center; justify-content:center; width:var(--note-glyph-size); height:var(--note-glyph-size); min-width:44px; min-height:44px; max-width:48px; max-height:48px; border-radius:50%; background:var(--color-primary-100); }
/* Preserve the politics template's 80% scale; fit the supplied SVG bounds proportionally. */
.note-mode-art { display:block; flex:none; }
.note-mode-method .note-mode-art { width:59.77358rpx; height:59.77358rpx; min-width:33.62264px; min-height:33.62264px; transform:translateY(-.315px) scale(.8); }
.note-mode-exam .note-glyph-well { background:var(--bg-soft-orange); }
.note-mode-exam .note-mode-art { width:66rpx; height:66rpx; min-width:37px; min-height:37px; transform:translateY(-.344px) scale(.8); }
.note-mode-application .note-glyph-well { background:var(--bg-soft-green); }
.note-mode-application .note-mode-art { width:60.80769rpx; height:60.80769rpx; min-width:34.32692px; min-height:34.32692px; transform:translate(-.322px,-.429px) scale(.8); }
.note-mode .module-home-path-copy { min-width:0; padding-left:var(--space-1); box-sizing:border-box; }
.note-page .module-home-arrow { margin:0; }
.note-mode .module-home-arrow,.note-mode .module-home-path-status { justify-self:end; }

.note-page-head { display:block; width:100%; min-width:0; }
.note-page-title { color:var(--text-primary); font-size:var(--ui-font-page-title); font-weight:var(--ui-weight-heading); line-height:var(--ui-line-title); overflow-wrap:anywhere; }
.note-page-description { margin-top:var(--space-2); color:var(--text-secondary); font-size:var(--ui-font-body); line-height:var(--ui-line-body); }
.note-search-entry { display:flex; align-items:center; gap:var(--space-3); width:100%; min-width:0; min-height:44px; margin-top:var(--space-4); padding:var(--space-3) var(--note-card-inset); box-sizing:border-box; border:var(--ui-border-width) solid var(--border-subtle); border-radius:var(--ui-radius-control); background:var(--bg-card); color:var(--text-secondary); font-size:var(--ui-font-body); line-height:var(--ui-line-body); }
.note-search-copy { flex:1; min-width:0; overflow-wrap:anywhere; }
.note-search-symbol { position:relative; flex:none; width:24rpx; height:24rpx; border:2rpx solid currentColor; border-radius:50%; margin-right:var(--space-1); }
.note-search-symbol::after { content:''; position:absolute; right:-8rpx; bottom:-5rpx; width:12rpx; height:2rpx; background:currentColor; transform:rotate(45deg); }
.note-search-arrow { flex:none; width:var(--ui-chevron-size); height:var(--ui-chevron-size); color:var(--text-tertiary); border-right:var(--ui-chevron-stroke) solid currentColor; border-bottom:var(--ui-chevron-stroke) solid currentColor; transform:rotate(-45deg); }
.note-search-pressed { background:var(--bg-soft-blue); }
