.note-page { min-height:100vh; background:var(--bg-page-accent); }
.note-shell { padding:32rpx 24rpx calc(160rpx + env(safe-area-inset-bottom)); }
.note-heading { font-size:48rpx; font-weight:700; color:var(--text-primary); }
.note-subtitle { margin:14rpx 0 28rpx; color:var(--text-secondary); font-size:28rpx; line-height:1.6; }
.note-search { display:flex; align-items:center; padding:8rpx 12rpx 8rpx 22rpx; gap:12rpx; margin-bottom:24rpx; }
.note-search-input { min-width:0; flex:1; height:52px; font-size:28rpx; }
.note-search-button { flex:none; min-width:60px; min-height:44px; margin:0; padding:0 16rpx; color:var(--color-primary-500); background:var(--bg-soft-blue); font-size:28rpx; line-height:44px; }
.note-all,.note-mode { display:flex; align-items:center; justify-content:space-between; gap:18rpx; padding:28rpx 24rpx; min-height:92px; }
.note-all { border-color:var(--color-primary-500); }
.note-card-title { font-size:32rpx; color:var(--text-primary); font-weight:700; line-height:1.5; }
.note-card-desc { margin-top:10rpx; font-size:26rpx; color:var(--text-secondary); line-height:1.6; }
.note-section-title { margin:36rpx 0 18rpx; font-size:30rpx; font-weight:700; }
.note-mode { margin-bottom:18rpx; }
.note-mode-main { min-width:0; flex:1; }
.note-mode-pending { flex:none; font-size:23rpx; color:var(--text-tertiary); }
.note-arrow { flex:none; font-size:42rpx; color:var(--color-primary-500); }
