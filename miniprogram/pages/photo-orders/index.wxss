.orders-page { min-height: 100vh; box-sizing: border-box; padding: 34rpx 32rpx 60rpx; background: #f7f8fa; color: #26344b; }
.orders-heading { font-size: 34rpx; font-weight: 700; }
.orders-note { margin-top: 10rpx; color: #748094; font-size: 23rpx; }
.orders-empty { margin-top: 34rpx; padding: 42rpx 28rpx; border-radius: 20rpx; background: #fff; color: #68768b; font-size: 25rpx; line-height: 1.55; }
.order-card { margin-top: 24rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(31, 47, 73, .04); }
.order-top, .order-line { display: flex; justify-content: space-between; gap: 22rpx; }
.order-top { align-items: flex-start; margin-bottom: 22rpx; }
.order-product { flex: 1; font-size: 29rpx; font-weight: 650; }
.order-status { color: #3265d8; font-size: 24rpx; white-space: nowrap; }
.order-line { margin-top: 13rpx; color: #6d798c; font-size: 23rpx; }
.order-line text:last-child { color: #364459; text-align: right; }
