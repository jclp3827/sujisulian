<view class="politics-home politics-theme">
  <view class="politics-content module-home-shell">
    <view class="politics-page-head">
      <view class="politics-page-title" role="heading" aria-level="1">政治理论</view>
      <view class="politics-page-description">阅读、理解与回忆，把知识读成体系</view>
      <view class="politics-search-entry" bindtap="handleSearchTap" hover-class="politics-search-pressed" role="button" aria-label="搜索考点、概念或问题，进入搜索页">
        <view class="politics-search-symbol" aria-hidden="true"></view><text class="politics-search-copy">搜索考点、概念或问题</text><view class="politics-search-arrow" aria-hidden="true"></view>
      </view>
    </view>
    <view wx:if="{{decision.storageStatus.ok === false}}" class="politics-storage-notice">暂时无法读取上次进度，可以先浏览知识或从导读开始。</view>
    <view wx:if="{{dailyCard}}" class="politics-resume module-home-primary surface-card">
      <image class="politics-daily-art" src="/images/politics-home/delivered-v1/daily-theory.svg" mode="aspectFit" aria-hidden="true" />
      <view class="politics-daily-copy">
        <view class="module-home-primary-heading"><view class="module-home-primary-title">每日理论</view></view>
        <view class="module-home-primary-description">{{dailyCard.state === 'ready' || dailyCard.state === 'active' ? '接着学习，巩固理论要点' : dailyCard.state === 'updated' ? '练习内容已更新，可以重新开始' : dailyCard.description}}</view>
        <text wx:if="{{dailyCard.state === 'active' && dailyCard.meta}}" class="module-home-primary-meta" aria-label="{{'当前练习位置，' + dailyCard.meta}}">{{dailyCard.meta}}</text>
      </view>
      <view wx:if="{{dailyCard.action}}" class="politics-daily-footer">
        <view class="btn-base btn-compact btn-primary module-home-primary-action" bindtap="handleDailyTap" hover-class="btn-pressed" role="button" aria-label="{{dailyCard.action}}"><text>{{dailyCard.action}}</text><view class="politics-daily-action-arrow" aria-hidden="true"></view></view>
      </view>
    </view>
    <view class="politics-library module-home-entry surface-card" bindtap="handleTerrainTap" hover-class="module-home-pressed" role="button" aria-label="全部知识，按篇章查找">
      <view class="module-home-entry-copy"><view class="module-home-entry-title">全部知识</view><view class="module-home-entry-description">完整目录 · 按章节查找</view></view><view class="politics-directory-art-slot" aria-hidden="true"><image class="home-glyph home-directory-art" src="/images/politics-home/delivered-v1/all-knowledge.svg" mode="aspectFit" aria-hidden="true" /></view><view class="politics-library-enter" aria-hidden="true"><text>进入</text><view class="module-home-arrow"></view></view>
    </view>
    <view class="module-home-section-title">选择学习方式</view>
    <view class="politics-route-list module-home-path-list">
      <view wx:for="{{routeCards}}" wx:key="id" class="politics-route-card politics-route-{{item.id}} module-home-path surface-card" data-type="{{item.id}}" bindtap="handleGoalTap" hover-class="module-home-pressed" role="button" aria-label="{{item.label}}，{{item.displayLine1}}，{{item.displayLine2}}{{item.progressLabel ? '，' + item.progressLabel : ''}}">
        <image class="home-glyph" src="/images/politics-home/delivered-v1/{{item.id === 'quick' ? 'quick-overview' : item.id === 'systematic' ? 'systematic-learning' : item.id === 'confusion' ? 'concept-comparison' : 'exam-recall'}}.svg" mode="aspectFit" aria-hidden="true" /><view class="module-home-path-copy"><view class="module-home-path-heading"><text class="module-home-path-title">{{item.label}}</text></view><view class="module-home-path-description">{{item.displayLine1}}，{{item.displayLine2}}</view></view><text class="module-home-path-status politics-route-status">{{item.progressText}}</text><view class="module-home-arrow" aria-hidden="true"></view>
      </view>
    </view>
    <view class="politics-upcoming"><text class="politics-upcoming-label">筹备中</text><view class="politics-upcoming-link" data-feature="favorites" bindtap="handlePlaceholderTap" role="button" aria-label="我的收藏，功能筹备中">我的收藏</view></view>
  </view>
</view>
