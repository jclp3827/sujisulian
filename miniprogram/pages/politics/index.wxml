<view class="politics-page">
  <view class="politics-shell">
    <view class="politics-hero">
      <view class="politics-kicker">知识体系 · 审核样本</view>
      <view class="politics-title-row">
        <view class="politics-title">{{module.title}}</view>
        <view class="politics-count">{{module.pointCount}} 个知识点</view>
      </view>
      <view class="politics-desc">{{module.description}}</view>
      <view class="politics-notice">当前仅纳入已完成证据审核和协议校验的正式知识。</view>
    </view>

    <view class="politics-section-head">
      <view>
        <view class="politics-section-title">知识入口</view>
        <view class="politics-section-desc">从体系定位知识，再进入阅读、关系和速记</view>
      </view>
    </view>
    <view class="politics-mode-grid">
      <view class="politics-mode-card politics-mode-card-active surface-card">
        <view class="politics-mode-mark">目</view>
        <view class="politics-mode-title">目录浏览</view>
        <view class="politics-mode-desc">按正式知识体系连续查看</view>
      </view>
      <view class="politics-mode-card surface-card" bindtap="handleMapTap">
        <view class="politics-mode-mark politics-mode-mark-map">图</view>
        <view class="politics-mode-title">知识地图</view>
        <view class="politics-mode-desc">看体系并探索知识关系</view>
      </view>
      <view class="politics-mode-card surface-card" bindtap="handleRecallTap">
        <view class="politics-mode-mark politics-mode-mark-card">记</view>
        <view class="politics-mode-title">速记卡</view>
        <view class="politics-mode-desc">从提示开始主动回忆</view>
      </view>
    </view>

    <block wx:for="{{categories}}" wx:key="title" wx:for-item="category">
      <view class="politics-category">
        <view class="politics-category-head">
          <view class="politics-category-title">{{category.title}}</view>
          <view class="politics-category-count">{{category.points.length}} 篇</view>
        </view>
        <view class="politics-point-list">
          <view
            wx:for="{{category.points}}"
            wx:key="id"
            wx:for-item="point"
            class="politics-point-card surface-card"
            data-point-id="{{point.id}}"
            bindtap="handlePointTap"
          >
            <view class="politics-point-index">{{index + 1}}</view>
            <view class="politics-point-main">
              <view class="politics-point-title">{{point.title}}</view>
              <view class="politics-point-summary">{{point.summary}}</view>
            </view>
            <view class="tap-arrow">›</view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
