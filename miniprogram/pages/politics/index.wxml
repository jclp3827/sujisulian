<view class="politics-home">
  <view class="politics-hero" style="padding-top: {{heroSafeTop}}px">
    <image class="politics-hero-art" src="/images/politics/home-hero.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="politics-hero-shade"></view>
    <view class="politics-hero-copy">
      <view class="politics-brand">政治<text>理论</text></view>
      <view class="politics-brand-desc">系统学，真理解，会应用。</view>
      <view class="politics-brand-line"></view>
    </view>
  </view>

  <view class="politics-content">
    <view class="politics-search" bindtap="handleSearchTap" role="button" aria-label="搜索考点、概念或问题">
      <view class="politics-search-icon" aria-hidden="true"></view>
      <view class="politics-search-placeholder">搜索考点、概念或问题</view>
      <view class="politics-search-chevron" aria-hidden="true"></view>
    </view>

    <view wx:if="{{resumePrompt}}" class="politics-resume" bindtap="handlePrimaryTap" role="button" aria-label="{{resumePrompt.recommendedAction.label}}">
      <view class="politics-resume-copy">
        <view class="politics-resume-label">{{resumePrompt.statusLabel}}</view>
        <view class="politics-resume-title">{{resumePrompt.title}}</view>
      </view>
      <view class="politics-resume-action">{{resumePrompt.recommendedAction.label}} ›</view>
    </view>

    <view class="politics-section-head politics-routes-head">
      <view class="politics-section-title">学习路线</view>
      <view class="politics-section-hint">按目标选择</view>
    </view>

    <view wx:if="{{quickGoal}}" class="politics-quick-card" data-type="quick" bindtap="handleGoalTap" role="button" aria-label="{{quickGoal.label}}，{{quickGoal.outcome}}">
      <view class="politics-quick-deco"></view>
      <view class="politics-quick-top">
        <image class="politics-quick-icon" src="/images/politics/route-target.png" mode="aspectFit" aria-hidden="true" />
        <view class="politics-recommend-pill">建议起点</view>
      </view>
      <view class="politics-quick-title">快速了解</view>
      <view class="politics-quick-desc">8–12 分钟，先建立两条主线的框架</view>
      <view class="politics-quick-action">{{quickGoal.progressLabel ? '继续快速导读' : '开始快速导读'}} <text>→</text></view>
      <view class="politics-quick-progress" style="background: conic-gradient(#f53140 {{quickGoal.progressPercent}}%, #f9d9dc 0)" aria-label="快速了解进度 {{quickProgressLabel}}">
        <view class="politics-quick-progress-inner">{{quickProgressLabel}}</view>
      </view>
    </view>

    <view class="politics-route-grid">
      <view wx:for="{{routeCards}}" wx:key="id" class="politics-route-card politics-route-{{item.id}}" data-type="{{item.id}}" bindtap="handleGoalTap" role="button" aria-label="{{item.label}}，{{item.outcome}}">
        <image class="politics-route-icon" src="{{item.iconPath}}" mode="aspectFit" aria-hidden="true" />
        <view class="politics-route-title">{{item.label}}</view>
        <view class="politics-route-desc"><view>{{item.displayLine1}}</view><view>{{item.displayLine2}}</view></view>
        <view class="politics-route-arrow">→</view>
      </view>
    </view>

    <view class="politics-section-head politics-tools-head">
      <view class="politics-section-title">学习工具</view>
    </view>
    <view class="politics-tool-grid">
      <view class="politics-tool-card" bindtap="handleTerrainTap" role="button" aria-label="知识图谱，浏览全部知识">
        <view class="politics-tool-icon politics-tool-icon-map"><image src="/images/politics/tool-map.png" mode="aspectFit" aria-hidden="true" /></view>
        <view class="politics-tool-copy"><view class="politics-tool-title">知识图谱</view><view class="politics-tool-desc">浏览全部知识</view></view>
        <view class="politics-tool-arrow">›</view>
      </view>
      <view class="politics-tool-card" data-feature="favorites" bindtap="handlePlaceholderTap" role="button" aria-label="我的收藏，功能筹备中">
        <view class="politics-tool-icon politics-tool-icon-favorite"><image src="/images/politics/tool-star.png" mode="aspectFit" aria-hidden="true" /></view>
        <view class="politics-tool-copy"><view class="politics-tool-title">我的收藏</view><view class="politics-tool-desc">功能筹备中</view></view>
        <view class="politics-tool-arrow">›</view>
      </view>
    </view>

    <view class="politics-section-head politics-daily-head">
      <view class="politics-section-title">今日一练</view>
    </view>
    <view class="politics-daily-card" data-feature="daily" bindtap="handlePlaceholderTap" role="button" aria-label="今日一练，功能筹备中">
      <view class="politics-daily-icon"><image src="/images/politics/tool-quiz.png" mode="aspectFit" aria-hidden="true" /></view>
      <view class="politics-daily-copy"><view class="politics-daily-title">每日练习入口</view><view class="politics-daily-desc">练习内容正在筹备</view></view>
      <view class="politics-daily-button">查看</view>
    </view>

    <view class="politics-content-notice">{{module.copy.contentNotice}}</view>
  </view>
</view>
