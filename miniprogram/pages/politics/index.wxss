@import "../../styles/module-home.wxss";
/* Political-home-only grid and type roles. SVG files and shared tokens stay intact. */
.politics-home {
  --politics-card-inset:28rpx;
  --politics-core-title:var(--ui-font-section-title);
  --politics-path-title:var(--ui-font-card-title);
  --politics-copy-font:var(--ui-font-description);
  --politics-state-font:var(--ui-font-meta);
  --politics-glyph-size:84rpx;
  --politics-state-width:128rpx;
  min-height:100vh; background:var(--bg-page); color:var(--text-primary);
}
.politics-storage-notice { margin-top:var(--space-3); color:var(--text-secondary); font-size:var(--politics-copy-font); line-height:var(--ui-line-body); }
.politics-upcoming { display:flex; align-items:center; flex-wrap:wrap; justify-content:center; gap:var(--space-2); margin-top:var(--space-4); color:var(--text-tertiary); font-size:var(--politics-state-font); }
.politics-upcoming-link { display:flex; align-items:center; min-height:44px; padding:0 var(--space-1); text-decoration:underline; }
.politics-home .module-home-primary,.politics-home .module-home-path { box-shadow:none; }
.politics-home .module-home-primary-title,.politics-home .module-home-entry-title { font-size:var(--politics-core-title); font-weight:var(--ui-weight-heading); line-height:var(--ui-line-title); color:var(--text-primary); }
.politics-home .module-home-path-title { font-size:var(--politics-path-title); font-weight:var(--ui-weight-label); line-height:var(--ui-line-title); }
.politics-home .module-home-primary-description,.politics-home .module-home-entry-description,.politics-home .module-home-path-description { font-size:var(--politics-copy-font); line-height:var(--ui-line-body); }
.politics-home .module-home-primary-meta,.politics-home .module-home-path-status { font-size:var(--politics-state-font); line-height:var(--ui-line-body); color:var(--text-secondary); }
.politics-home .module-home-section-title { margin-top:var(--space-5); font-size:var(--politics-copy-font); font-weight:var(--ui-weight-label); }
.politics-home .politics-resume {
  position:relative; overflow:hidden; flex-direction:column; align-items:stretch;
  padding:var(--space-3) var(--politics-card-inset); border-color:rgba(47,107,255,.13);
  background-color:var(--color-primary-100);
  background-image:radial-gradient(ellipse at 100% 100%,rgba(89,213,183,.17) 0%,rgba(89,213,183,0) 65%),radial-gradient(ellipse at 100% 0%,rgba(116,213,244,.16) 0%,rgba(116,213,244,0) 62%),linear-gradient(115deg,#dce9ff 0%,#e7e3fb 58%,#e2edfc 100%);
}
.politics-daily-copy,.politics-daily-footer { position:relative; z-index:1; min-width:0; }
.politics-home .politics-resume .module-home-primary-title { min-width:0; }
.politics-daily-art { position:absolute; z-index:0; pointer-events:none; right:-4%; top:50%; transform:translateY(-50%); width:46vw; height:46vw; min-width:170px; min-height:170px; max-width:200px; max-height:200px; opacity:.16; }
.politics-daily-footer { display:flex; align-items:center; flex-wrap:wrap; gap:var(--space-3); margin-top:var(--space-2); }
.politics-home .politics-daily-footer .module-home-primary-action { flex:none; align-self:auto; max-width:100%; margin:0 0 0 auto; box-shadow:none; }
.politics-daily-action-arrow { position:relative; flex:none; width:24rpx; height:var(--ui-chevron-stroke); margin-left:var(--space-2); background:currentColor; }
.politics-daily-action-arrow::after { content:''; position:absolute; right:0; top:50%; width:10rpx; height:10rpx; border-top:var(--ui-chevron-stroke) solid currentColor; border-right:var(--ui-chevron-stroke) solid currentColor; transform:translateY(-50%) rotate(45deg); }
.politics-home .politics-library {
  position:relative; overflow:hidden; display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; margin-top:var(--space-3); gap:var(--space-3);
  padding:20rpx var(--politics-card-inset); border-color:rgba(51,196,122,.14);
  background-color:var(--bg-soft-green);
  background-image:radial-gradient(ellipse at 100% 100%,rgba(98,162,245,.18) 0%,rgba(98,162,245,0) 72%),radial-gradient(ellipse at 65% 0%,rgba(67,203,175,.11) 0%,rgba(67,203,175,0) 65%),linear-gradient(115deg,#e7f8ee 0%,#e0f5eb 55%,#e9f5f4 100%);
}
.politics-directory-art-slot { position:relative; z-index:1; width:var(--politics-glyph-size); min-width:44px; max-width:48px; height:72rpx; }
.politics-home .politics-library .home-directory-art { position:absolute; pointer-events:none; left:50%; top:50%; transform:translate(-50%,-50%); width:52px; height:52px; margin-left:-2.2px; }
.politics-library .module-home-entry-copy,.politics-library-enter { position:relative; z-index:1; }
.politics-library .module-home-entry-copy { min-width:0; padding-left:var(--space-1); box-sizing:border-box; }
.politics-library-enter { display:flex; flex:none; align-items:center; gap:var(--space-3); color:var(--text-secondary); font-size:var(--politics-state-font); line-height:var(--ui-line-body); }
/* Shared four-column grid: carrier | copy | status | direction. */
.politics-home .politics-route-list { gap:var(--space-3); }
.politics-home .politics-route-card {
  display:grid; grid-template-columns:auto minmax(0,1fr) var(--politics-state-width) var(--ui-chevron-size);
  align-items:center; column-gap:var(--space-3);
  padding:var(--space-3) var(--politics-card-inset); background:var(--bg-card); box-shadow:none;
}
.politics-glyph-well { display:flex; align-items:center; justify-content:center; width:var(--politics-glyph-size); height:var(--politics-glyph-size); min-width:44px; min-height:44px; max-width:48px; max-height:48px; border-radius:50%; background:var(--color-primary-100); }
.politics-route-systematic .politics-glyph-well { background:#e5edff; }
.politics-route-qa .politics-glyph-well { background:#e6f4ff; }
.politics-route-confusion .politics-glyph-well { background:#f0eaff; }
.politics-route-exam .politics-glyph-well { background:var(--bg-soft-orange); }
.politics-glyph-well .home-glyph { display:block; flex:none; width:64rpx; height:64rpx; min-width:36px; min-height:36px; transform:translate(-.112px,.112px) scale(.8); }
.politics-route-systematic .home-glyph,.politics-route-confusion .home-glyph { width:62rpx; height:62rpx; min-width:35px; min-height:35px; transform:translateY(-.112px) scale(.8); }
.politics-route-exam .home-glyph { width:66rpx; height:66rpx; min-width:37px; min-height:37px; transform:translateY(-.344px) scale(.8); }
.politics-route-card .module-home-path-copy { min-width:0; padding-left:var(--space-1); box-sizing:border-box; }
.politics-route-card .module-home-path-heading { justify-content:flex-start; }
.politics-route-card .politics-route-status { width:var(--politics-state-width); text-align:right; justify-self:end; }
.politics-home .module-home-arrow { margin:0; }
.politics-route-card .module-home-arrow { justify-self:end; }

/* Match the existing home head tokens, without changing the shared component. */
.politics-page-head { display:block; width:100%; min-width:0; }
.politics-page-title { color:var(--text-primary); font-size:var(--ui-font-page-title); font-weight:var(--ui-weight-heading); line-height:var(--ui-line-title); overflow-wrap:anywhere; }
.politics-page-description { margin-top:var(--space-2); color:var(--text-secondary); font-size:var(--ui-font-body); line-height:var(--ui-line-body); }
.politics-search-entry { display:flex; align-items:center; gap:var(--space-3); width:100%; min-width:0; min-height:44px; margin-top:var(--space-4); padding:var(--space-3) var(--politics-card-inset); box-sizing:border-box; border:var(--ui-border-width) solid var(--border-subtle); border-radius:var(--ui-radius-control); background:var(--bg-card); color:var(--text-secondary); font-size:var(--ui-font-body); line-height:var(--ui-line-body); }
.politics-search-copy { flex:1; min-width:0; overflow-wrap:anywhere; }
.politics-search-symbol { position:relative; flex:none; width:24rpx; height:24rpx; border:2rpx solid currentColor; border-radius:50%; margin-right:var(--space-1); }
.politics-search-symbol::after { content:''; position:absolute; right:-8rpx; bottom:-5rpx; width:12rpx; height:2rpx; background:currentColor; transform:rotate(45deg); }
.politics-search-arrow { flex:none; width:var(--ui-chevron-size); height:var(--ui-chevron-size); color:var(--text-tertiary); border-right:var(--ui-chevron-stroke) solid currentColor; border-bottom:var(--ui-chevron-stroke) solid currentColor; transform:rotate(-45deg); }
.politics-search-pressed { background:var(--bg-soft-blue); }
