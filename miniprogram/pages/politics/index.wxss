.politics-home {
  min-height: 100vh;
  background: var(--ui-color-page);
  color: var(--ui-color-text);
}
.politics-content {
  max-width: 960rpx;
  margin: 0 auto;
  padding: var(--space-5) var(--ui-page-gutter) calc(var(--ui-button-height) + var(--space-8) + env(safe-area-inset-bottom));
}
.politics-hero { padding: 0 0 var(--ui-section-gap); }
.politics-eyebrow { display: flex; align-items: center; gap: var(--space-2); color: var(--ui-color-muted); font-size: var(--ui-font-description); letter-spacing: 2rpx; }
.politics-bookmark { width: 12rpx; height: 20rpx; background: var(--ui-color-accent); border-radius: 2rpx 2rpx 6rpx 0; }
.politics-brand { margin-top: var(--space-2); font-size: var(--ui-font-page-title); line-height: 1.35; font-weight: 700; letter-spacing: 1rpx; }
.politics-search { min-height: var(--ui-button-height); display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border: var(--ui-border-width) solid var(--ui-color-border); border-radius: var(--ui-radius-control); background: var(--ui-color-surface); color: var(--ui-color-caption); }
.politics-search-icon { position: relative; flex: none; width: 24rpx; height: 24rpx; border: 2rpx solid currentColor; border-radius: 50%; margin-right: var(--space-0); }
.politics-search-icon::after { content: ""; position: absolute; right: -8rpx; bottom: -5rpx; width: 11rpx; height: 2rpx; background: currentColor; transform: rotate(45deg); }
.politics-search-placeholder { flex: 1; min-width: 0; font-size: var(--ui-font-body); line-height: 1.5; }
.politics-storage-notice { padding: var(--space-3) var(--space-2) 0; color: var(--ui-color-muted); font-size: var(--ui-font-description); line-height: 1.6; }
.politics-resume { margin-top: var(--space-4); padding: var(--ui-card-padding); background: var(--ui-color-accent-soft); }
.politics-resume-top { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2); }
.politics-resume-label { color: var(--ui-color-accent-text); font-size: var(--ui-font-description); font-weight: 600; line-height: 1.5; }
.politics-resume-meta { color: var(--ui-color-muted); font-size: var(--ui-font-meta); line-height: 1.5; }
.politics-resume-title { margin-top: var(--space-2); font-size: var(--ui-font-section-title); font-weight: var(--ui-weight-heading); line-height: var(--ui-line-title); overflow-wrap: anywhere; }
.politics-resume-desc { margin-top: var(--space-2); font-size: var(--ui-font-description); line-height: var(--ui-line-body); color: var(--ui-color-muted); overflow-wrap: anywhere; }
.politics-resume-bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--ui-control-gap); margin-top: var(--space-4); }
.politics-resume-note { flex: 1 1 180rpx; min-width: 0; color: var(--ui-color-muted); font-size: var(--ui-font-meta); line-height: var(--ui-line-body); }
.politics-primary-action { flex: 0 0 auto; width: auto; max-width: 100%; gap: var(--ui-control-gap); margin: 0; }
.politics-primary-action text { min-width: 0; }
.politics-library { display: flex; align-items: center; gap: var(--space-3); min-height: var(--ui-touch-target); margin-top: var(--space-4); padding: var(--ui-card-padding); }
.politics-library-symbol { display: flex; align-items: flex-end; gap: 5rpx; width: 44rpx; flex: none; color: var(--ui-color-accent-text); }
.politics-library-symbol view { width: 10rpx; height: 32rpx; border: 2rpx solid currentColor; border-radius: 2rpx; }
.politics-library-symbol view:last-child { height: 38rpx; transform: rotate(-12deg); margin-left: 2rpx; }
.politics-library-copy { flex: 1; min-width: 0; }
.politics-library-title { font-size: var(--ui-font-card-title); font-weight: 600; line-height: 1.5; }
.politics-library-desc { margin-top: var(--space-0); font-size: var(--ui-font-meta); color: var(--ui-color-muted); line-height: 1.5; }
.politics-library-action { display: flex; align-items: center; gap: var(--space-2); color: var(--ui-color-accent-text); font-size: var(--ui-font-description); line-height: 1.5; }
.politics-routes-head { margin: var(--ui-section-gap) 0 var(--space-2); }
.politics-route-list { overflow: hidden; }
.politics-section-title { font-size: var(--ui-font-description); font-weight: 500; color: var(--ui-color-muted); line-height: 1.5; }
.politics-route-card { display: flex; align-items: center; gap: var(--space-3); min-height: var(--ui-touch-target); padding: var(--ui-card-padding); border-bottom: var(--ui-border-width) solid var(--ui-color-border); }
.politics-route-card:last-child { border-bottom: 0; }
.politics-route-mark { flex: none; display: flex; align-items: center; justify-content: center; width: var(--ui-icon-size); height: var(--ui-icon-size); background: var(--ui-color-soft); border: var(--ui-border-width) solid var(--ui-color-border); border-radius: var(--radius-sm); color: var(--ui-color-accent-text); font-size: var(--ui-font-card-title); font-weight: 500; }
.politics-route-copy { flex: 1; min-width: 0; }
.politics-route-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--space-1) var(--space-2); }
.politics-route-title { font-size: var(--ui-font-card-title); font-weight: 600; line-height: 1.5; }
.politics-route-status { font-size: var(--ui-font-meta); color: var(--ui-color-muted); line-height: var(--ui-line-body); }
.politics-route-desc { margin-top: var(--space-0); font-size: var(--ui-font-description); color: var(--ui-color-muted); line-height: 1.6; }
.politics-route-arrow { color: var(--ui-color-caption); }
.politics-upcoming { display: flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: var(--space-2); margin-top: var(--space-4); color: var(--ui-color-caption); font-size: var(--ui-font-meta); }
.politics-upcoming-label { margin-right: var(--space-2); }
.politics-upcoming-link { display: flex; align-items: center; min-height: var(--ui-touch-target); padding: 0 var(--space-1); text-decoration: underline; text-underline-offset: 5rpx; }
.politics-pressed { background: var(--ui-color-soft); }

@media (max-width: 340px) {
  .politics-primary-action { align-self: flex-end; }
  .politics-resume-note { flex: none; width: 100%; }
  .politics-resume-bottom { align-items: stretch; flex-direction: column; }
  .politics-library { flex-wrap: wrap; }
  .politics-library-action { margin-left: calc(44rpx + var(--space-3)); min-height: var(--ui-touch-target); }
  .politics-library-copy { flex-basis: calc(100% - 72rpx); }
  .politics-route-card { gap: var(--space-3); }
}
