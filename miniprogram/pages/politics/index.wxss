@import "../../styles/module-home.wxss";
.politics-home { min-height:100vh; background:var(--bg-page-accent); color:var(--text-primary); }
.politics-storage-notice { margin-top:var(--space-3); color:var(--text-secondary); font-size:var(--ui-font-description); line-height:var(--ui-line-body); }
.politics-upcoming { display:flex; align-items:center; flex-wrap:wrap; justify-content:center; gap:var(--space-2); margin-top:var(--space-4); color:var(--text-tertiary); font-size:var(--ui-font-meta); }
.politics-upcoming-link { display:flex; align-items:center; min-height:44px; padding:0 var(--space-1); text-decoration:underline; }
