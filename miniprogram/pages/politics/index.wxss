.politics-page { min-height: 100vh; background: var(--bg-page-accent); }
.politics-shell { min-height: 100vh; padding: 28rpx 24rpx calc(148rpx + env(safe-area-inset-bottom)); }
.politics-hero { padding: 8rpx 2rpx 30rpx; }
.politics-kicker { margin-bottom: 10rpx; color: var(--color-green-500); font-size: 24rpx; line-height: 1.4; font-weight: 700; letter-spacing: 2rpx; }
.politics-title-row { display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.politics-title { font-size: 52rpx; line-height: 1.18; font-weight: 700; color: var(--text-primary); }
.politics-count,
.politics-category-count { padding: 7rpx 12rpx; border-radius: 999rpx; background: var(--bg-soft-blue); color: var(--color-primary-500); font-size: 21rpx; line-height: 1.3; font-weight: 700; }
.politics-desc { margin-top: 14rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.6; }
.politics-notice { display: inline-block; margin-top: 18rpx; padding: 9rpx 15rpx; border-radius: 12rpx; background: var(--bg-soft-orange); color: var(--color-orange-700); font-size: 21rpx; line-height: 1.45; }
.politics-section-head { margin-bottom: 16rpx; }
.politics-section-title { color: var(--text-primary); font-size: 29rpx; line-height: 1.4; font-weight: 700; }
.politics-section-desc { margin-top: 4rpx; color: var(--text-tertiary); font-size: 21rpx; line-height: 1.45; }
.politics-mode-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 30rpx; }
.politics-mode-card { min-width: 0; padding: 20rpx 18rpx; }
.politics-mode-card-active { border-color: rgba(51, 196, 122, .2); background: var(--bg-soft-green); }
.politics-mode-mark { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: rgba(51, 196, 122, .12); color: var(--color-green-700); font-size: 20rpx; line-height: 1; font-weight: 800; }
.politics-mode-mark-map { background: var(--bg-soft-blue); color: var(--color-primary-500); }
.politics-mode-mark-card { background: var(--bg-soft-purple); color: var(--color-purple-500); }
.politics-mode-title { margin-top: 12rpx; color: var(--text-primary); font-size: 27rpx; line-height: 1.35; font-weight: 700; }
.politics-mode-desc { margin-top: 6rpx; color: var(--text-tertiary); font-size: 20rpx; line-height: 1.45; }
.politics-category { margin-bottom: 30rpx; }
.politics-category-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.politics-category-title { color: var(--text-primary); font-size: 29rpx; line-height: 1.4; font-weight: 700; }
.politics-category-count { flex: none; font-size: 19rpx; }
.politics-point-list { display: flex; flex-direction: column; gap: 16rpx; }
.politics-point-card { display: flex; align-items: center; gap: 16rpx; min-height: 144rpx; padding: 22rpx 18rpx; border-color: rgba(51, 196, 122, .16); }
.politics-point-index { flex: none; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--bg-soft-green); color: var(--color-green-500); font-size: 22rpx; font-weight: 800; }
.politics-point-main { flex: 1; min-width: 0; }
.politics-point-title { color: var(--text-primary); font-size: 30rpx; line-height: 1.35; font-weight: 700; }
.politics-point-summary { margin-top: 8rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.55; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
