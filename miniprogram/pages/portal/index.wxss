.portal-page { min-height: 100vh; background: var(--bg-page-accent); }
.portal-shell { padding: 20rpx 28rpx calc(148rpx + env(safe-area-inset-bottom)); }
.portal-hero { padding: 18rpx 4rpx 34rpx; }
.portal-eyebrow { display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; color: var(--color-primary-500); font-size: 23rpx; font-weight: 600; }
.portal-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--color-primary-500); box-shadow: 0 0 0 7rpx var(--color-primary-100); }
.portal-title { margin-bottom: 14rpx; color: var(--text-primary); font-size: 46rpx; line-height: 1.25; font-weight: 700; letter-spacing: 1rpx; }
.portal-intro { color: var(--text-secondary); font-size: 25rpx; line-height: 1.65; }
.portal-section-head { margin-bottom: 18rpx; }
.portal-section-title { color: var(--text-primary); font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.portal-section-hint { margin-top: 6rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.5; }
.portal-module-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.portal-page .portal-module { box-sizing: border-box; display: flex; flex-direction: column; align-items: stretch; width: 100%; min-width: 0; min-height: 330rpx; margin: 0; padding: 20rpx; text-align: left; white-space: normal; line-height: 1.4; border: 1rpx solid #e5ebf3; border-radius: var(--radius-lg); background: var(--bg-card); box-shadow: 0 8rpx 24rpx rgba(48, 75, 118, .035); }
.portal-module-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 18rpx; }
.portal-module-icon { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #fff2df; }
.portal-module-icon image { width: 52rpx; height: 52rpx; }
.portal-module-train .portal-module-icon { background: #e7f7ee; }
.portal-module-common .portal-module-icon { background: #f1e8fa; }
.portal-module-politics .portal-module-icon { background: #e8f0ff; }
.portal-arrow { color: #b47a2b; font-size: 30rpx; font-weight: 400; line-height: 1; }
.portal-module-train .portal-arrow { color: #238a50; }
.portal-module-common .portal-arrow { color: #6934aa; }
.portal-module-politics .portal-arrow { color: #2456d6; }
.portal-module-title { margin-bottom: 8rpx; color: var(--text-primary); font-size: 16px; font-weight: 700; line-height: 1.3; }
.portal-module-subtitle { color: var(--text-secondary); font-size: 12px; font-weight: 400; line-height: 1.45; }
.portal-module-detail { margin-top: auto; padding-top: 12rpx; border-top: 1rpx solid var(--border-subtle); color: var(--text-secondary); font-size: 11px; font-weight: 400; line-height: 1.4; }
.portal-tools-label { margin: 28rpx 2rpx 14rpx; color: var(--text-secondary); font-size: 23rpx; font-weight: 600; }
.portal-page .portal-photo { position: relative; width: 100%; min-height: 152rpx; margin: 0; padding: 18rpx 20rpx; display: flex; align-items: center; gap: 14rpx; overflow: hidden; text-align: left; line-height: 1.4; white-space: normal; border: 2rpx solid #d6e5ff; border-radius: 26rpx; background: linear-gradient(115deg, #f4f8ff 0%, #edf4ff 62%, #e8f1ff 100%); }
.portal-photo-icon { flex: none; width: 62rpx; height: 68rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; border-radius: 17rpx; background: linear-gradient(145deg, #ffffff 0%, #f2f7ff 100%); box-shadow: 0 5rpx 14rpx rgba(72,130,239,.12); }
.portal-photo-head { width: 20rpx; height: 20rpx; margin-top: 5rpx; border-radius: 50%; background: linear-gradient(135deg, #7bb4ff, #4a8dff); }
.portal-photo-body { width: 34rpx; height: 22rpx; margin-top: 4rpx; border-radius: 20rpx 20rpx 4rpx 4rpx; background: linear-gradient(135deg, #7bb4ff, #4a8dff); }
.portal-photo-copy { flex: 1; min-width: 0; }
.portal-photo-title { color: var(--text-primary); font-size: 30rpx; font-weight: 700; }
.portal-photo-desc { margin-top: 8rpx; color: var(--text-secondary); font-size: 21rpx; font-weight: 400; }
.portal-photo-art { flex: none; width: 112rpx; height: 112rpx; transform: translateX(-14rpx); }
.portal-photo-arrow { flex: none; color: var(--color-primary-500); font-size: 38rpx; line-height: 1; font-weight: 400; }
.portal-footer { padding: 30rpx 0 8rpx; color: var(--text-tertiary); font-size: 22rpx; line-height: 1.5; text-align: center; }
.portal-pressed { opacity: .75; }
