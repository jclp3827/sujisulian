.portal-page { min-height: 100vh; background: var(--bg-page-accent); }
.portal-shell { padding: 24rpx 28rpx calc(148rpx + env(safe-area-inset-bottom)); }
.portal-hero { padding: 20rpx 4rpx 46rpx; }
.portal-eyebrow { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; color: var(--color-primary-500); font-size: 23rpx; font-weight: 600; }
.portal-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--color-primary-500); box-shadow: 0 0 0 7rpx var(--color-primary-100); }
.portal-title { margin-bottom: 18rpx; color: var(--text-primary); font-size: 48rpx; line-height: 1.25; font-weight: 700; letter-spacing: 1rpx; }
.portal-intro { color: var(--text-secondary); font-size: 25rpx; line-height: 1.8; }
.portal-section-head { margin-bottom: 20rpx; }
.portal-section-title { color: var(--text-primary); font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.portal-section-hint { margin-top: 6rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.5; }
.portal-module-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.portal-module { width: 100%; min-width: 0; margin: 0; padding: 24rpx; text-align: left; white-space: normal; line-height: 1.4; border-radius: var(--radius-lg); }
.portal-module-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.portal-module-icon { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: var(--bg-soft-blue); color: var(--color-primary-500); font-size: 32rpx; font-weight: 700; }
.portal-module-icon image { width: 46rpx; height: 46rpx; }
.portal-module-common .portal-module-icon { background: var(--bg-soft-green); color: var(--color-green-700); }
.portal-module-politics .portal-module-icon { background: var(--bg-soft-purple); color: var(--color-purple-500); }
.portal-arrow { color: var(--text-tertiary); font-size: 30rpx; font-weight: 400; }
.portal-module-title { margin-bottom: 10rpx; color: var(--text-primary); font-size: 34rpx; font-weight: 700; }
.portal-module-subtitle { color: var(--text-secondary); font-size: 23rpx; font-weight: 400; line-height: 1.6; }
.portal-module-detail { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border-subtle); color: var(--text-secondary); font-size: 20rpx; font-weight: 400; line-height: 1.5; }
.portal-tools-label { margin: 34rpx 2rpx 14rpx; color: var(--text-secondary); font-size: 23rpx; font-weight: 600; }
.portal-page .portal-photo { position: relative; width: 100%; min-height: 152rpx; margin: 0; padding: 18rpx 20rpx; display: flex; align-items: center; gap: 14rpx; overflow: hidden; text-align: left; line-height: 1.4; white-space: normal; border: 2rpx solid #d6e5ff; border-radius: 26rpx; background: linear-gradient(115deg, #f4f8ff 0%, #edf4ff 62%, #e8f1ff 100%); }
.portal-photo-icon { flex: none; width: 62rpx; height: 68rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; border-radius: 17rpx; background: linear-gradient(145deg, #ffffff 0%, #f2f7ff 100%); box-shadow: 0 5rpx 14rpx rgba(72,130,239,.12); }
.portal-photo-head { width: 20rpx; height: 20rpx; margin-top: 5rpx; border-radius: 50%; background: linear-gradient(135deg, #7bb4ff, #4a8dff); }
.portal-photo-body { width: 34rpx; height: 22rpx; margin-top: 4rpx; border-radius: 20rpx 20rpx 4rpx 4rpx; background: linear-gradient(135deg, #7bb4ff, #4a8dff); }
.portal-photo-copy { flex: 1; min-width: 0; }
.portal-photo-title { color: var(--text-primary); font-size: 30rpx; font-weight: 700; }
.portal-photo-desc { margin-top: 8rpx; color: var(--text-secondary); font-size: 21rpx; font-weight: 400; }
.portal-photo-art { flex: none; width: 112rpx; height: 112rpx; transform: translateX(-14rpx); }
.portal-photo-arrow { flex: none; color: var(--color-primary-500); font-size: 38rpx; line-height: 1; font-weight: 400; }
.portal-footer { padding: 30rpx 0 8rpx; color: var(--text-tertiary); font-size: 22rpx; line-height: 1.5; text-align: center; }
.portal-pressed { opacity: .75; }
