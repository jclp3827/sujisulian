.wrong-book-page {
  min-height: 100vh;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  background: var(--bg-page-accent);
}

.wrong-book-page-pad {
  padding: var(--space-3) var(--space-4) 0;
}

.wrong-book-empty {
  margin-top: var(--space-2);
  padding: var(--space-5) var(--space-4);
  border-radius: var(--radius-lg);
  font-size: var(--font-caption);
  line-height: 1.5;
  color: var(--text-secondary);
  text-align: center;
}

/* 与训练页的题数切换控件保持相同的容器与激活态。 */
.wrong-book-tabs {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: var(--space-4);
  padding: var(--space-1);
  border: 1rpx solid var(--border-soft);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-card);
}

.wrong-book-tab {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  padding: 0 var(--space-2);
  border-radius: 999rpx;
  color: var(--text-secondary);
  font-size: var(--font-caption);
  line-height: 1.2;
  font-weight: 700;
  white-space: nowrap;
}

.wrong-book-tab-active {
  color: var(--text-on-primary);
  background: var(--gradient-primary);
  box-shadow: var(--shadow-active);
}

.wrong-book-tab-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  color: inherit;
}

.wrong-book-tab-count {
  flex: none;
  font-size: 20rpx;
  line-height: 1;
  color: var(--text-tertiary);
}

.wrong-book-tab-active .wrong-book-tab-count {
  color: rgba(255, 255, 255, 0.9);
}

.wrong-book-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

/* 沿用笔记路径卡片的留白、圆角和信息层级。 */
.wrong-book-item {
  position: relative;
  padding: 22rpx 20rpx;
}

.wrong-book-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.wrong-book-item-title {
  min-width: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--bg-soft-blue);
  color: var(--color-primary-500);
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wrong-book-arrow {
  background: var(--bg-soft-blue);
  align-self: center;
}

.wrong-book-question-board {
  margin-bottom: var(--space-3);
  padding: 12rpx 28rpx;
  overflow-x: auto;
  color: var(--text-primary);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.32;
  text-align: center;
}

.wrong-book-question-formula {
  display: block;
  margin: 8rpx 0;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  font-weight: inherit;
}

.wrong-book-question-formula .formula {
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  row-gap: var(--space-1);
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

.wrong-book-answer {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: var(--space-2);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--border-subtle);
  font-size: var(--font-caption);
  line-height: 1.35;
}

.wrong-book-answer-label {
  flex: none;
  color: var(--text-tertiary);
}

.wrong-book-answer-value {
  min-width: 0;
  color: var(--text-primary);
  font-weight: 700;
  word-break: break-all;
}

/* 与训练页的开始练习按钮采用同一悬浮栏尺寸，保留错题本的危险色。 */
.wrong-book-clear-wrap {
  z-index: 20;
  background: transparent;
  box-shadow: none;
}

.wrong-book-clear-btn {
  width: 100%;
  border-radius: var(--radius-md);
  background: var(--color-danger);
  color: var(--text-on-primary);
  box-shadow: var(--shadow-cta);
}
