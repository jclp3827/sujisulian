/* Draft: learning page auxiliary action, 44 CSS px touch and visual box. */
.learning-aux-action { box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; flex: none; width: 78px; min-width: 44px; max-width: 78px; height: 44px; min-height: 44px; margin: 0; padding: 0 12px; border: 1px solid #dce5f4; border-radius: 999px; background: #fff; color: #2f6bff; font-size: 13px; font-weight: 600; line-height: 1; white-space: nowrap; box-shadow: none; }
.learning-aux-action::after { border: 0; }
.learning-aux-pressed { background: #eaf1ff; }
.learning-aux-action[disabled] { opacity: .5; }

.learning-aux-action-info { width: 88px; max-width: 88px; }
