/* Draft family recipes. Business values and action availability belong to callers. */
.family-action-pair { display:flex; flex-direction:row-reverse; align-items:stretch; gap:12rpx; }
.family-action-pair > button { flex:1; width:0; min-width:0; min-height:44px; height:auto; margin:0; padding:10rpx 12rpx; border-radius:14rpx; font-size:26rpx; line-height:1.4; display:flex; align-items:center; justify-content:center; white-space:normal; }
.family-progress-card { box-sizing:border-box; padding:18rpx 20rpx 16rpx; border:1rpx solid #e8edf5; border-radius:22rpx; background:#fff; box-shadow:0 10rpx 24rpx rgba(39,66,95,.04); }
.note-progress-card.family-progress-card { padding:18rpx 20rpx 16rpx; }
.family-progress-card .note-progress-row { align-items:baseline; }
.family-progress-card .note-progress-label { font-size:21rpx; }
.family-progress-card .note-progress-stats { white-space:normal; }
.family-progress-card .note-progress-track { height:8rpx; margin-top:14rpx; }
.family-progress-card .session-meta-row { display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12rpx; }
.family-progress-card .session-meta-card { padding:0; margin:0; border:0; background:transparent; border-radius:0; min-height:0; }
.family-progress-card .session-meta-label { font-size:21rpx; }
.family-progress-card .session-meta-value { font-size:28rpx; }
.family-progress-card > .session-progress-track { height:8rpx; margin:14rpx 0 0; }
.family-progress-card > .progress { font-size:21rpx; margin-top:8rpx; line-height:1.4; }
.practice-progress-line.family-progress-card { padding:18rpx 20rpx 16rpx; border:1rpx solid #e8edf5; background:#fff; }
.guide-title-layout { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:12rpx; }
.guide-title-copy { flex:1; min-width:0; }
.guide-title-copy .guide-group-title { overflow-wrap:anywhere; }
.guide-title-actions { flex:none; display:flex; align-items:center; gap:6px; }
