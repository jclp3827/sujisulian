/* Politics consumes the same palette as common sense and training. */
.politics-theme {
  --ui-color-page: var(--bg-page);
  --ui-color-surface: var(--bg-card);
  --ui-color-soft: var(--bg-soft-blue);
  --ui-color-accent: var(--color-primary-500);
  --ui-color-accent-text: var(--color-primary-600);
  --ui-color-accent-soft: var(--color-primary-100);
  --ui-color-text: var(--text-primary);
  --ui-color-muted: var(--text-secondary);
  --ui-color-caption: var(--text-tertiary);
  --ui-color-border: var(--border-subtle);
  --ui-shadow-card: var(--shadow-card);
  --ui-shadow-floating: var(--shadow-floating);
  --ui-emphasis-key-shadow: inset 0 -.4em 0 var(--color-primary-100);

  /* Preserve the accepted action hierarchy with the shared palette. */
  --ui-button-secondary-background: var(--color-primary-100);
  --ui-button-secondary-text: var(--color-primary-600);
  --ui-button-secondary-border: 0;
  --ui-button-ghost-background: transparent;
  --ui-button-ghost-text: var(--color-primary-600);
  --ui-button-ghost-border: 2rpx solid var(--color-primary-500);
}

.politics-theme .surface-card { border-width: var(--ui-border-width); }
