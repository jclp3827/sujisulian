/* Shared political auxiliary tag: wording/checkmark determines completion, not colour alone. */
.politics-status-tag {display:inline-flex;flex:none;max-width:100%;align-items:center;gap:var(--space-1);padding:var(--space-0) var(--space-2);border-radius:var(--ui-radius-pill);background:var(--bg-soft-green);font-size:var(--rl-meta,var(--font-caption));line-height:1.5;font-weight:var(--ui-weight-label);color:var(--color-green-700);}
.politics-status-tag-muted {background:var(--bg-page);color:var(--text-secondary);}
