@import "./politics-article-visual.wxss";
/* Only live systematic lesson reading and revisits use this surface. */
.unit-page.systematic-visual-v1 {--unit-body-size:var(--av-body);padding:var(--space-4) var(--av-gutter) calc(var(--ui-touch-target) + var(--space-8) + env(safe-area-inset-bottom));background:var(--ui-color-page);color:var(--av-ink);letter-spacing:var(--av-body-tracking);}
.unit-page.systematic-visual-v1 .unit-reading {margin-top:var(--space-4);padding:0;border:0;background:transparent;}
.unit-page.systematic-visual-v1 .unit-title {font-size:var(--av-title);line-height:var(--ui-line-title);font-weight:var(--ui-weight-heading);}
.unit-page.systematic-visual-v1 .pr-title-ordinal {margin-top:var(--space-2);color:var(--av-secondary);font-size:var(--av-caption);line-height:var(--ui-line-body);font-weight:400;}
.unit-page.systematic-visual-v1 .unit-goal {margin:var(--space-5) 0 var(--space-7);padding:var(--space-4);border:0;border-left:3rpx solid var(--av-lead-border);border-radius:0 var(--radius-sm) var(--radius-sm) 0;background:var(--av-lead-background);}
.unit-page.systematic-visual-v1 .unit-outcome-line {font-size:var(--av-caption);line-height:var(--ui-line-body);}
.unit-page.systematic-visual-v1 .unit-outcome-label,
.unit-page.systematic-visual-v1 .unit-outcome-summary {font-weight:400;color:var(--av-ink);}
.unit-page.systematic-visual-v1 .unit-part {margin-top:var(--space-7);padding:0;}
.unit-page.systematic-visual-v1 .unit-heading {margin:0 0 var(--av-heading-gap);font-size:var(--av-module);line-height:var(--ui-line-title);font-weight:var(--ui-weight-label);color:var(--av-ink);}
.unit-page.systematic-visual-v1 .unit-body {margin-top:0;font-size:var(--av-body);line-height:var(--av-body-line);letter-spacing:var(--av-body-tracking);word-spacing:normal;text-align:left;}
.unit-page.systematic-visual-v1 .unit-body-paragraph + .unit-body-paragraph {margin-top:var(--av-paragraph-gap);}
.unit-page.systematic-visual-v1 .unit-part-boundary {padding:var(--space-4);border:var(--ui-border-width) solid var(--av-module-border);border-radius:var(--radius-sm);background:var(--av-module-background);}
.unit-page.systematic-visual-v1 .unit-part-recap,
.unit-page.systematic-visual-v1 .unit-part-recap.unit-part-emphasized {padding:var(--space-4);border:0;border-left:3rpx solid var(--av-lead-border);border-radius:0 var(--radius-sm) var(--radius-sm) 0;background:var(--av-module-background);}
.unit-page.systematic-visual-v1 .unit-inline-key {box-shadow:none;background-image:var(--av-key-gradient);background-size:100% .55em;background-position:left bottom;background-repeat:no-repeat;-webkit-box-decoration-break:clone;box-decoration-break:clone;}
.unit-page.systematic-visual-v1 .unit-inline-boundary {text-decoration-color:var(--av-boundary-ink);background-image:none;box-shadow:none;}
.unit-page.systematic-visual-v1 .unit-progress {padding:var(--space-2) 0 var(--space-3);border-color:var(--av-divider);background:var(--ui-color-page);font-size:var(--av-meta);}
.unit-page.systematic-visual-v1 .unit-progress-row {gap:var(--space-2);}
.unit-page.systematic-visual-v1 .unit-progress-metrics {gap:var(--space-4);}
.unit-page.systematic-visual-v1 .unit-progress-value {font-size:var(--av-control);font-weight:var(--ui-weight-label);}
.unit-page.systematic-visual-v1 .unit-progress-route {min-height:var(--ui-touch-target);padding:0 var(--space-2);font-size:var(--av-control);font-weight:var(--ui-weight-label);}
.unit-page.systematic-visual-v1 .unit-test {margin-top:var(--space-7);padding:var(--space-4);border:var(--ui-border-width) solid var(--av-divider);border-radius:var(--radius-sm);background:var(--bg-soft-gray);}
.unit-page.systematic-visual-v1 .unit-test-title {font-size:var(--av-meta);font-weight:400;line-height:var(--ui-line-body);color:var(--av-secondary);}
.unit-page.systematic-visual-v1 .unit-test-note,
.unit-page.systematic-visual-v1 .unit-test-instruction {font-size:var(--av-caption);line-height:var(--ui-line-body);color:var(--av-secondary);}
.unit-page.systematic-visual-v1 .unit-test-instruction {margin-top:var(--space-3);}
.unit-page.systematic-visual-v1 .unit-test-question {margin-top:var(--space-2);font-size:var(--av-subheading);line-height:var(--ui-line-body);font-weight:var(--ui-weight-label);}
.unit-page.systematic-visual-v1 .unit-test-action {width:fit-content;max-width:100%;min-height:var(--ui-touch-target);margin:var(--space-4) 0 0;padding:var(--space-2) var(--space-4);font-size:var(--av-control);line-height:var(--ui-line-body);border:var(--ui-border-width) solid var(--av-module-border);border-radius:var(--ui-radius-control);background:var(--bg-card);color:var(--ui-color-accent-text);}
.unit-page.systematic-visual-v1 .unit-test-answer {margin-top:var(--space-4);padding-top:var(--space-4);border-color:var(--av-divider);}
.unit-page.systematic-visual-v1 .unit-test-answer .unit-label {font-size:var(--av-caption);color:var(--av-secondary);}
.unit-page.systematic-visual-v1 .unit-sources {margin-top:var(--space-5);padding-top:var(--space-2);border-top:var(--ui-border-width) solid var(--av-divider);}
.unit-page.systematic-visual-v1 .unit-source-primary,
.unit-page.systematic-visual-v1 .unit-source,
.unit-page.systematic-visual-v1 .unit-related-toggle {width:100%;max-width:100%;min-height:var(--ui-touch-target);margin:0;padding:var(--space-3) 0;border:0;border-radius:0;background:transparent;color:var(--ui-color-accent-text);font-size:var(--av-caption);line-height:var(--ui-line-body);text-align:left;justify-content:flex-start;}
.unit-page.systematic-visual-v1 .unit-dock {padding:var(--space-3) var(--av-gutter) calc(var(--space-3) + env(safe-area-inset-bottom));background:var(--ui-color-dock);border-top:var(--ui-border-width) solid var(--av-divider);box-shadow:none;}
.unit-page.systematic-visual-v1 .unit-dock-actions {gap:var(--space-2);}
.unit-page.systematic-visual-v1 .unit-dock .btn-base {min-height:var(--ui-touch-target);margin:0;padding:var(--space-2);font-size:var(--av-control);line-height:var(--ui-line-title);font-weight:var(--ui-weight-label);border-radius:var(--ui-radius-control);box-shadow:none;}
.unit-page.systematic-visual-v1 .unit-dock .unit-primary {background:var(--av-accent);color:var(--text-on-primary);}
.unit-page.systematic-visual-v1 .unit-dock > .btn-base {width:100%;}
