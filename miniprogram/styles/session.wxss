/* Shared session UI. Training and knowledge modules consume the same geometry. */
.session-head {
  margin-bottom: 14rpx;
}

.session-title {
  margin-bottom: 12rpx;
  color: var(--text-primary);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  word-break: break-word;
}

.session-meta-row {
  display: grid;
  gap: 10rpx;
}

.session-meta-row-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.session-meta-row-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

.session-meta-card {
  min-height: 76rpx;
  padding: 10rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: none;
}

.session-meta-label {
  margin-bottom: 0;
  color: var(--text-tertiary);
  font-size: 20rpx;
  white-space: nowrap;
}

.session-meta-value {
  max-width: 100%;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-progress-track {
  display: flex;
  height: 8rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--border-subtle);
}

.session-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--gradient-primary);
  transition: width 180ms ease;
}

.session-progress-segments {
  gap: 8rpx;
  overflow: visible;
  background: transparent;
}

.session-progress-segment {
  flex: 1;
  height: 100%;
  border-radius: inherit;
  background: var(--border-subtle);
}

.session-progress-completed {
  background: var(--color-primary-100);
  box-shadow: inset 0 0 0 1rpx var(--color-primary-500);
}

.session-progress-current { background: var(--gradient-primary); }
.session-progress-skipped { background: var(--border-subtle); box-shadow: inset 0 0 0 1rpx var(--text-tertiary); }

.session-action-dock {
  position: fixed;
  z-index: 18;
  right: 0;
  bottom: 0;
  left: 0;
  padding: var(--ui-toolbar-padding) var(--ui-page-gutter) calc(var(--ui-toolbar-padding) + env(safe-area-inset-bottom));
  border-top: var(--ui-border-width) solid var(--ui-color-border);
  background: var(--ui-color-dock);
  box-shadow: var(--ui-shadow-dock);
  box-sizing: border-box;
}

.session-action-row {
  display: flex;
  align-items: stretch;
  gap: var(--ui-action-gap);
}

.session-action-slot {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: stretch;
}

.session-action-left { justify-content: flex-start; }
.session-action-center { justify-content: center; }
.session-action-right { justify-content: flex-end; }

.session-action-row .btn-base {
  flex: 0 1 auto;
  width: auto;
  min-width: 0;
  margin: 0;
}
