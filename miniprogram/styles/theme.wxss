page {
  --bg-page: #f0f5fc;
  --bg-page-accent: linear-gradient(180deg, #f0f5fc 0%, #f0f5fc 100%);
  --bg-card: #ffffff;
  --bg-soft-blue: #f3f7ff;
  --bg-soft-green: #f1fbf6;
  --bg-soft-orange: #fff4e6;
  --bg-soft-purple: #f5f2ff;
  --color-primary-500: #2f6bff;
  --color-primary-400: #4a86ff;
  --color-primary-100: #e8f0ff;
  --color-primary-50: #f3f7ff;
  --color-primary-600: #2456d6;
  --gradient-primary: linear-gradient(180deg, #4a86ff 0%, #2f6bff 100%);
  --color-green-500: #33c47a;
  --color-green-700: #226235;
  --color-orange-700: #a94f1e;
  --color-purple-500: #7c5cff;
  --text-primary: #111827;
  --text-secondary: #4b5563;
  --text-tertiary: #9ca3af;
  --text-disabled: #d1d5db;
  --text-on-primary: #ffffff;
  --text-muted: var(--text-secondary);
  --text-inverse: #ffffff;
  --border-subtle: #eef2f7;
  --border-soft: rgba(47, 107, 255, 0.08);
  --border-orange: rgba(219, 132, 23, 0.18);
  --overlay-soft: rgba(17, 24, 39, 0.08);
  --shadow-card: 0 8rpx 24rpx rgba(47, 107, 255, 0.06);
  --shadow-floating: 0 16rpx 40rpx rgba(47, 107, 255, 0.12);
  --shadow-cta: 0 10rpx 30rpx rgba(47, 107, 255, 0.18);
  --shadow-active: 0 10rpx 24rpx rgba(47, 107, 255, 0.1);
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --space-0: 4rpx;
  --space-1: 8rpx;
  --space-2: 12rpx;
  --space-3: 16rpx;
  --space-4: 24rpx;
  --space-5: 32rpx;
  --space-6: 40rpx;
  --space-7: 48rpx;
  --space-8: 64rpx;
  --font-caption: 24rpx;
  --font-body: 28rpx;
  --font-subtitle: 32rpx;
  --font-title: 44rpx;
  --font-display: 72rpx;
  --font-heading: 34rpx;

  /* Shared UI roles: geometry and typography are independent of module skin. */
  --ui-page-gutter: var(--space-4);
  --ui-card-padding: var(--space-4);
  --ui-section-gap: var(--space-5);
  --ui-control-gap: var(--space-2);
  --ui-radius-card: var(--radius-lg);
  --ui-radius-control: var(--radius-md);
  --ui-radius-sheet: var(--radius-xl);
  --ui-radius-pill: 999rpx;
  --ui-border-width: 1rpx;
  --ui-font-hero: 52rpx;
  --ui-font-page-title: 48rpx;
  --ui-font-title-large: 52rpx;
  --ui-font-title-extra-large: 56rpx;
  --ui-font-section-title: var(--font-subtitle);
  --ui-font-card-title: 30rpx;
  --ui-font-body: var(--font-body);
  --ui-font-description: var(--font-caption);
  --ui-font-meta: 22rpx;
  --ui-font-reading-title: var(--ui-font-page-title);
  --ui-font-reading-heading: 36rpx;
  --ui-font-reading-body: 32rpx;
  --ui-font-reading-large: 36rpx;
  --ui-font-reading-extra-large: 40rpx;
  --ui-weight-heading: 700;
  --ui-weight-label: 600;
  --ui-line-title: 1.35;
  --ui-line-body: 1.6;
  --ui-line-reading: 1.75;
  --ui-button-height: 96rpx;
  --ui-button-font: var(--font-subtitle);
  --ui-button-compact-height: 80rpx;
  --ui-button-compact-font: var(--font-caption);
  --ui-button-toolbar-font: var(--font-body);
  --ui-action-height: var(--ui-button-compact-height);
  --ui-action-font: var(--ui-button-compact-font);
  --ui-action-padding-x: var(--space-3);
  --ui-action-gap: var(--ui-toolbar-gap);
  --ui-progress-padding-y: var(--space-2);
  --ui-progress-label-font: var(--ui-font-description);
  --ui-progress-value-font: var(--ui-font-body);
  --ui-button-primary-background: var(--gradient-primary);
  --ui-button-primary-text: var(--text-on-primary);
  --ui-button-primary-shadow: var(--shadow-cta);
  --ui-button-secondary-background: var(--bg-card);
  --ui-button-secondary-text: var(--text-primary);
  --ui-button-secondary-border: 1rpx solid var(--border-subtle);
  --ui-button-ghost-background: var(--bg-soft-blue);
  --ui-button-ghost-text: var(--text-primary);
  --ui-button-ghost-border: 0;
  --ui-emphasis-key-shadow: inset 0 -.4em 0 var(--ui-color-accent-soft);
  --ui-emphasis-boundary-offset: 5rpx;
  --ui-icon-size: 48rpx;
  --ui-icon-small: 32rpx;
  --ui-chevron-size: 16rpx;
  --ui-chevron-stroke: 2.4rpx;
  --ui-touch-target: 88rpx;
  --ui-toolbar-gap: var(--space-2);
  --ui-toolbar-padding: var(--space-3);
  --ui-color-page: var(--bg-page);
  --ui-color-surface: var(--bg-card);
  --ui-color-soft: var(--bg-soft-blue);
  --ui-color-accent: var(--color-primary-500);
  --ui-color-accent-text: var(--color-primary-600);
  --ui-color-accent-soft: var(--color-primary-100);
  --ui-color-text: var(--text-primary);
  --ui-color-muted: var(--text-secondary);
  --ui-color-caption: #6b7280;
  --ui-color-border: var(--border-subtle);
  --ui-color-boundary: var(--color-orange-700);
  --ui-color-boundary-soft: var(--bg-soft-orange);
  --ui-color-overlay: rgba(17, 24, 39, .38);
  --ui-color-dock: rgba(255, 255, 255, .97);
  --ui-shadow-card: var(--shadow-card);
  --ui-shadow-floating: var(--shadow-floating);
  --ui-shadow-dock: 0 -8rpx 28rpx rgba(17, 24, 39, .07);
  /* Compatibility for existing learning surfaces. */
  --bg-soft-gray: #f3f4f6;
  --border-light: var(--border-subtle);
  --shadow-sm: var(--shadow-card);
  --shadow-lg: var(--shadow-floating);

  /* Cross-module knowledge semantics */
  --knowledge-system-text: #226235;
  --knowledge-system-soft: #f1fbf6;
  --knowledge-reading-text: #2456d6;
  --knowledge-reading-soft: #f3f7ff;
  --knowledge-boundary-text: #934019;
  --knowledge-boundary-soft: #fff4e6;
  --knowledge-recall-text: #5b3fd6;
  --knowledge-recall-soft: #f5f2ff;
  --knowledge-evidence-text: #4b5563;
  --knowledge-evidence-soft: #f3f4f6;
  --knowledge-motion-fast: 160ms;
  --knowledge-motion-space: 220ms;

  /* Backward-compatible aliases */
  --color-bg-start: #f0f5fc;
  --color-bg-end: #f0f5fc;
  --color-surface: rgba(255, 255, 255, 0.82);
  --color-surface-strong: rgba(255, 255, 255, 0.96);
  --color-surface-muted: rgba(47, 107, 255, 0.06);
  --color-card-start: #ffffff;
  --color-card-end: #fdfefe;
  --color-primary: var(--color-primary-500);
  --color-primary-soft: var(--color-primary-400);
  --color-primary-pale: var(--color-primary-50);
  --color-text: var(--text-primary);
  --color-text-strong: var(--text-primary);
  --color-text-muted: var(--text-secondary);
  --color-text-subtle: var(--text-tertiary);
  --color-line: rgba(156, 163, 175, 0.2);
  --color-line-soft: rgba(156, 163, 175, 0.12);
  --color-success: var(--color-green-500);
  --color-warning: #f59a23;
  --color-danger: #ff4d4f;
  --space-xs: var(--space-2);
  --space-sm: var(--space-3);
  --space-md: var(--space-4);
  --space-lg: var(--space-5);
  --space-xl: var(--space-7);
}
