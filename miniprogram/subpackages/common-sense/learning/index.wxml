<view class="learning-page" style="{{footerHeight ? 'padding-bottom: ' + footerHeight + 'px;' : ''}}">
  <view wx:if="{{development}}" class="preview-note">内容试读 · 本批学习材料待审核</view>
  <view class="learning-header"><view class="page-title">{{title}}</view><button class="text-action" bindtap="handleMenu">{{settingsOpen ? '收起设置' : '学习设置'}}</button></view>
  <view wx:if="{{error}}" class="error-note">{{error}}<button size="mini" bindtap="handleRetrySave">重试保存</button></view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{settingsOpen}}" class="card settings-panel">
    <view class="card-title">学习设置</view>
    <view class="setting-label">学习范围</view>
    <view class="scope-row">
      <button wx:for="{{scopes}}" wx:key="id" id="scope-{{item.id}}" class="scope {{draft.scope === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="handleScope">{{item.title}}</button>
    </view>
    <block wx:if="{{mode === 'qa' || mode === 'exam'}}">
      <view class="setting-label">每组题数</view>
      <view class="count-tabs">
        <button wx:for="{{countOptions}}" wx:key="value" id="count-{{item.count}}" class="count-tab {{draft.count === item.count ? 'selected' : ''}}" data-count="{{item.count}}" bindtap="handleCount">{{item.label}}</button>
      </view>
    </block>
    <block wx:elif="{{mode === 'mnemonic'}}">
      <view class="setting-label">每组条数</view>
      <view class="count-tabs"><button wx:for="{{readingCountOptions}}" wx:key="*this" id="reading-count-{{item}}" class="count-tab {{draft.readingCount === item ? 'selected' : ''}}" data-count="{{item}}" bindtap="handleReadingCount">{{item}} 条</button></view>
    </block>
    <view wx:else class="fixed-quantity"><view class="setting-label">每组数量</view>{{mode === 'daily' ? '每日最多 5 道' : '每组 3 道 · 含初判和复辨'}}</view>
    <view class="settings-hint">保存后立即刷新；内容不足时按实际数量。</view>
  </view>
  <block wx:if="{{!settingsOpen}}">
  <view wx:if="{{mode === 'exam'}}" class="exam-tabs count-tabs"><button class="count-tab {{variant === 'selected' ? 'selected' : ''}}" data-id="selected" bindtap="handleExamVariant">精选回看</button><button class="count-tab {{variant === 'review' ? 'selected' : ''}}" data-id="review" bindtap="handleExamVariant">个人待回顾</button></view>
  <view wx:if="{{mode === 'exam' && variant === 'selected' && examTopics.length}}" class="card exam-topic-card">
    <view class="card-title">本组急救范围</view>
    <view wx:for="{{examTopics}}" wx:key="id" class="exam-topic-item">
      <view class="theme-title">{{item.title}}</view>
      <view class="muted">{{item.task}}</view>
      <view class="muted">覆盖：{{item.coverage}}</view>
      <view class="exam-reasons">纳入理由：<text wx:for="{{item.inclusionReasons}}" wx:key="*this" wx:for-item="reason">{{index ? '；' : ''}}{{reason}}</text></view>
      <view class="boundary">完成边界：{{item.completionScope}}</view>
    </view>
  </view>
  <view wx:if="{{active}}" class="session-head">
    <view class="session-meta-row">
      <view class="session-meta-card"><view class="session-meta-label">{{flowStep ? '学习环节' : (reading ? '当前口诀' : '当前题号')}}</view><view class="session-meta-value">{{flowStep ? phaseLabel : (index + ' / ' + total + ' ' + unit)}}</view></view>
      <view class="session-meta-card"><view class="session-meta-label">{{reading ? '已读条数' : '已处理题数'}}</view><view class="session-meta-value">{{completed ? total : index - 1}}</view></view>
      <view class="session-meta-card"><view class="session-meta-label">{{reading ? '标记再看' : '本组答对'}}</view><view class="session-meta-value">{{reading ? result.again : result.correct}}</view></view>
    </view>
    <view class="session-progress-track"><view class="session-progress-fill" style="width: {{progressPercent}}%;"></view></view>
    <view class="progress">{{progressPercent}}% 已处理<text wx:if="{{mode === 'daily'}}"> · {{day}}</text><text wx:if="{{reason}}"> · {{reason}}</text></view>
    <view wx:if="{{flowStep}}" class="confusion-steps">
      <view class="confusion-step {{flowStep === 1 ? 'current' : ''}}">1 先判断</view>
      <view class="confusion-step {{flowStep === 2 ? 'current' : ''}}">2 差异对照</view>
      <view class="confusion-step {{flowStep === 3 ? 'current' : ''}}">3 再辨一次</view>
    </view>
  </view>
  <view wx:if="{{!active}}" class="card empty-state">
    <view class="card-title">这个范围暂时没有可学内容</view>
    <view class="empty">{{notice || '可调整下一组设置，或查阅完整正文。'}}</view>
  </view>
  <block wx:elif="{{!completed && reading && mnemonic}}">
    <view class="card mnemonic-card">
      <view class="muted">{{mnemonic.formLabel}}</view>
      <view class="card-title">{{mnemonic.title}}</view>
      <view class="mnemonic-text">{{mnemonic.text}}</view>
      <view wx:if="{{mnemonic.purpose}}" class="muted">记忆目的：{{mnemonic.purpose}}</view>
      <view wx:if="{{mnemonic.method}}" class="muted">记法：{{mnemonic.method}}</view>
      <view class="muted">覆盖：{{mnemonic.coverage}}</view>
      <view wx:if="{{reviewNotice}}" class="review-notice">{{reviewNotice}}</view>
      <button class="text-action" bindtap="handleExpand">{{expandedId ? '收起逐句释义' : '展开逐句释义'}}</button>
      <block wx:if="{{expandedId}}">
        <view wx:for="{{mnemonic.phrases}}" wx:key="phrase" class="phrase {{item.review ? 'phrase-review' : ''}}">
          <view class="phrase-title">{{item.phrase}}<text wx:if="{{item.review}}" class="review-tag">{{item.reviewLabel}}</text></view><view>{{item.meaning}}</view>
          <view wx:for="{{item.conditionRefs}}" wx:key="id" wx:for-item="condition" class="phrase-condition {{condition.review ? 'condition-review' : ''}}">适用条件：{{condition.text}}</view>
          <button wx:for="{{item.refs}}" wx:key="tabId" wx:for-item="ref" class="source-link" data-point="{{ref.pointId}}" data-tab="{{ref.tabId}}" bindtap="handleSource">原文：{{ref.label}} ›</button>
        </view>
      </block>
      <view class="boundary">不覆盖：<view wx:for="{{mnemonic.excludes}}" wx:key="*this">{{item}}</view></view>
      <view wx:if="{{mnemonic.verificationLabel}}" class="verification">依据：{{mnemonic.verificationLabel}}</view>
    </view>
    <view class="muted reading-note">阅读记录只表示读过或需要再看，不代表已经掌握。</view>
  </block>
  <block wx:elif="{{!completed && isComparison && comparison}}">
    <view class="card comparison-card">
      <view class="card-title">{{comparison.title}}</view>
      <view class="intro">覆盖：{{comparison.coverage}}</view>
      <view wx:for="{{comparison.rows}}" wx:key="label" class="comparison-row">
        <view class="comparison-label">{{item.label}}</view>
        <view class="comparison-condition">{{item.condition}}</view>
        <view class="comparison-distinction">区分点：{{item.distinction}}</view>
        <button wx:for="{{item.refs}}" wx:key="tabId" wx:for-item="ref" class="source-link" data-point="{{ref.pointId}}" data-tab="{{ref.tabId}}" bindtap="handleSource">查原文：{{ref.label}} ›</button>
      </view>
      <view class="notice">{{comparison.caution}}</view>
      <view class="boundary">不覆盖：<view wx:for="{{comparison.excludes}}" wx:key="*this">{{item}}</view></view>
      <view wx:if="{{comparison.verificationLabel}}" class="verification">依据：{{comparison.verificationLabel}}</view>
    </view>
    <view class="muted reading-note">看过对照不等于已经掌握，再用不同问题检验一下。</view>
  </block>
  <block wx:elif="{{!completed && card}}">
    <view class="card">
      <view class="muted">{{selfTest ? '口诀自测 · ' : ''}}{{card.kind}}</view>
      <view wx:if="{{flowStep}}" class="muted">{{phaseLabel}} · 第 {{index}} / {{total}} 道</view>
      <view class="question">{{card.prompt}}</view>
      <button wx:for="{{card.options}}" wx:key="index" class="option {{item.state}}" disabled="{{revealed}}" data-index="{{item.index}}" bindtap="handleChoice">{{item.text}}</button>
      <block wx:if="{{revealed}}">
        <view class="feedback">{{feedback}}</view>
        <view wx:if="{{answerSummary}}" class="answer-summary">{{answerSummary}}</view>
        <view wx:if="{{distractorReason}}" class="distractor-feedback">
          <view class="distractor-title">你选的“{{selectedOptionText}}”不成立</view>
          <view class="distractor-reason">{{distractorReason}}</view>
        </view>
        <view class="explanation"><view class="feedback-label">判断依据</view>{{card.explanation}}</view>
        <view class="boundary"><view class="feedback-label">适用边界</view>{{card.boundary}}</view>
        <view wx:if="{{card.verificationLabel}}" class="verification">依据：{{card.verificationLabel}}</view>
        <button wx:for="{{card.refs}}" wx:key="tabId" class="source-link" data-point="{{item.pointId}}" data-tab="{{item.tabId}}" bindtap="handleSource">看原文：{{item.label}} ›</button>
      </block>
    </view>
  </block>
  <view wx:else class="card completion">
    <view class="card-title">{{reading ? '这一组记忆材料读完了' : '这一组到这里就结束了'}}</view>
    <view wx:if="{{reading}}" class="intro">读过 {{result.read}} 条 · 标记再看 {{result.again}} 条</view>
    <view wx:else class="intro">答对 {{result.correct}} · 答错 {{result.wrong}} · 揭晓 {{result.revealed}} · 跳过 {{result.skipped}}</view>
    <view class="muted">{{reading ? '读过不等于掌握，可以回看或自测。' : '答错、揭晓和标记再看的内容会进入回顾安排。本次记录不等于已经掌握。'}}</view>
    <view wx:if="{{mode === 'daily' && !canStartToday}}" class="notice">今天这一组已完成，下次可以回来回顾。</view>
  </view>
  </block>
  <view class="learning-actions">
    <button wx:if="{{settingsOpen}}" class="primary save-settings" bindtap="handleSaveSettings">保存设置</button>
    <block wx:elif="{{!active}}">
      <view class="actions"><button class="secondary" bindtap="handleMenu">调整设置</button><button class="primary" bindtap="handleNextGroup">开始学习</button></view>
      <button class="text-action" bindtap="handleTopics">查看全部常识</button>
    </block>
    <block wx:elif="{{completed}}">
      <view class="actions"><button class="secondary" bindtap="handleMenu">学习设置</button><button wx:if="{{selfTest}}" class="primary return-reading" bindtap="handleReturnReading">返回记忆卡</button><button wx:elif="{{mode !== 'daily' || canStartToday}}" class="primary next-group" bindtap="handleNextGroup">{{mode === 'daily' ? '开始今天的一组' : '开始下一组'}}</button><button wx:else class="primary" bindtap="handleTopics">查看全部常识</button></view>
    </block>
    <block wx:elif="{{reading && mnemonic}}">
      <button class="text-action mnemonic-test" data-id="{{mnemonic.id}}" bindtap="handleMnemonicTest">遮住内容，自测一下</button>
      <view class="actions"><button class="secondary" data-again="yes" bindtap="handleNext">标记再看</button><button class="primary" bindtap="handleNext">{{index === total ? '完成本组阅读' : '读过了，下一条'}}</button></view>
    </block>
    <button wx:elif="{{isComparison}}" class="primary comparison-next" bindtap="handleComparisonNext">看清区别，再辨一次 · {{remaining}} 道</button>
    <block wx:else>
      <view class="actions"><button wx:if="{{revealed}}" class="secondary" data-again="yes" bindtap="handleNext">标记再看</button><button wx:else class="secondary reveal-answer" bindtap="handleReveal">查看答案</button><button class="primary" bindtap="handleNext">{{phase === 'judge' ? (revealed ? '看差异对照' : '跳过初判，看对照') : (revealed ? (index === total ? '完成这一组' : '继续') : '跳过这一道')}}</button></view>
      <button wx:if="{{selfTest}}" class="text-action return-reading" bindtap="handleReturnReading">返回记忆卡</button>
    </block>
  </view>
</view>
