.learning-page { padding: 32rpx 28rpx calc(280rpx + env(safe-area-inset-bottom)); color: #17233a; background: #f3f6fc; min-height: 100vh; box-sizing: border-box; }
.page-title { font-size: 44rpx; font-weight: 700; margin: 12rpx 0 28rpx; }
.preview-note { color: #77602d; font-size: 24rpx; margin-bottom: 16rpx; }
.scope-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0; }
button { font-size: 28rpx; line-height: 1.5; padding: 22rpx 24rpx; margin: 0; white-space: normal; border-radius: 20rpx; }
button::after { border: 0; }
.scope { flex: 1; min-width: 80rpx; padding: 14rpx 10rpx; background: #fff; color: #52617b; font-size: 26rpx; }
.scope.selected { background: #e0eaff; color: #2459ce; font-weight: 700; }
