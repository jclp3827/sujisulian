.topics-page { background:#f8f7fb; min-height:100vh; padding:32rpx 28rpx calc(70rpx + env(safe-area-inset-bottom)); box-sizing:border-box; color:#25283b; }
.heading { display:flex; justify-content:space-between; align-items:center; gap:16rpx; margin-bottom:20rpx; }
.eyebrow { color:#7144a8; font-size:23rpx; font-weight:700; letter-spacing:1rpx; }
.catalog-search { display:flex; flex:none; align-items:center; justify-content:center; gap:12rpx; min-height:72rpx; padding:0 8rpx; color:#4e596b; font-size:26rpx; font-weight:600; }
.catalog-search-icon { width:24rpx; height:24rpx; border:3rpx solid currentColor; border-radius:50%; position:relative; box-sizing:border-box; }
.catalog-search-icon::after { content:''; position:absolute; width:12rpx; height:3rpx; right:-10rpx; bottom:-5rpx; border-radius:2rpx; background:currentColor; transform:rotate(45deg); }
.catalog-search-pressed,.nav-tab-pressed { opacity:.65; }
.title { margin-top:8rpx; font-size:44rpx; line-height:1.25; font-weight:700; }
.subtitle { font-size:25rpx; color:#687083; margin-top:10rpx; }
.navigation { position:sticky; top:0; z-index:3; margin:0 -28rpx; padding:0 28rpx; background:#f8f7fb; border-bottom:1rpx solid #eee9f1; }
.part-row { display:flex; align-items:stretch; justify-content:space-between; width:100%; white-space:nowrap; border-bottom:1rpx solid #e8e3ee; }
.part-chip,.chapter-chip { display:flex; flex:none; align-items:center; justify-content:center; box-sizing:border-box; white-space:nowrap; }
.part-chip { min-height:74rpx; padding:0 8rpx; border-bottom:5rpx solid transparent; color:#667083; font-size:27rpx; font-weight:600; }
.part-chip.active { border-bottom-color:#8051b6; color:#623393; font-weight:700; }
.chapter-scroll { width:100%; }
.chapter-row { display:inline-flex; gap:28rpx; align-items:stretch; white-space:nowrap; }
.chapter-chip { min-height:66rpx; padding:0 2rpx; border-bottom:4rpx solid transparent; color:#7c8492; font-size:25rpx; }
.chapter-chip.active { border-bottom-color:#8051b6; color:#623393; font-weight:700; }
.section { margin:24rpx 0; padding:22rpx 24rpx 8rpx; border:1rpx solid #ebe7f0; border-radius:24rpx; background:#fff; box-shadow:0 8rpx 24rpx rgba(51,35,80,.035); }
.section-title { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:64rpx; color:#292c40; font-size:29rpx; line-height:1.45; font-weight:700; }
.section-title-copy { display:flex; align-items:center; gap:12rpx; min-width:0; }
.section-mark { flex:none; width:7rpx; height:28rpx; border-radius:8rpx; background:#9669c6; }
.section-title text { flex:none; color:#856ca0; font-size:23rpx; font-weight:500; }
.point { padding:20rpx 0 22rpx; margin-top:14rpx; border-top:1rpx solid #eeeaf2; }
.point-pressed { background:#faf6ff; }
.point-title { display:flex; align-items:center; justify-content:space-between; gap:14rpx; color:#303348; font-size:28rpx; font-weight:700; line-height:1.5; }
.point-title text { flex:none; color:#9166be; font-size:38rpx; font-weight:400; line-height:1; }
.point-summary { margin-top:8rpx; font-size:25rpx; line-height:1.6; color:#697286; }
.tab-picker { display:inline-block; margin-top:14rpx; padding:10rpx 16rpx; border-radius:12rpx; background:#f5edfa; color:#7043a5; font-size:24rpx; line-height:1.5; }
@media (max-width:340px) { .topics-page { padding-left:22rpx; padding-right:22rpx; } .navigation { margin-left:-22rpx; margin-right:-22rpx; padding-left:22rpx; padding-right:22rpx; } .section-title text { font-size:21rpx; } }
