.topics-page { background: #f3f6fc; min-height: 100vh; padding: 30rpx 26rpx 80rpx; box-sizing: border-box; color: #17233a; }
.heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.heading button { margin: 0; color: #3264d1; background: #fff; border-radius: 40rpx; }
button::after { border: 0; }
.title { font-size: 42rpx; font-weight: 700; }
.subtitle { font-size: 25rpx; color: #68758b; margin-top: 10rpx; }
.navigation { position: sticky; top: 0; z-index: 3; background: #f3f6fc; padding: 10rpx 0 20rpx; }
.part-row { display: flex; gap: 12rpx; }
.part-row button { flex: 1; font-size: 30rpx; padding: 16rpx 4rpx; line-height: 1.6; background: transparent; color: #61708b; margin: 0; border-radius: 16rpx; }
.part-row button.active { background: #e0eaff; color: #255cd3; font-weight: 700; }
.chapter-scroll { width: 100%; margin-top: 14rpx; }
.chapter-row { display: flex; gap: 14rpx; white-space: nowrap; }
.chapter-row button { flex-shrink: 0; font-size: 26rpx; padding: 12rpx 20rpx; line-height: 1.6; background: #fff; color: #65738a; margin: 0; border-radius: 30rpx; }
.chapter-row button.active { background: #2f6bff; color: #fff; }
.section { margin: 20rpx 0; background: #fff; border-radius: 24rpx; padding: 26rpx; }
.section-title { display: flex; justify-content: space-between; gap: 18rpx; font-weight: 600; font-size: 29rpx; line-height: 1.6; }
.section-title text { flex-shrink: 0; color: #8090a5; font-size: 23rpx; font-weight: 400; }
.point { padding: 24rpx 0; margin-top: 14rpx; border-top: 1rpx solid #edf1f7; }
.point-title { font-size: 30rpx; font-weight: 600; display: flex; justify-content: space-between; line-height: 1.6; }
.point-title text { color: #a6b3c7; }
.point-summary { font-size: 25rpx; line-height: 1.7; color: #738098; margin-top: 10rpx; }
.tab-picker { font-size: 25rpx; color: #3267cd; padding: 18rpx 0 0; }
