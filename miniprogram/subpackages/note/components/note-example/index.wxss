.note-example {
  width: 100%;
}

.note-section-label {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: 2rpx 0 14rpx;
  font-size: var(--font-caption);
  line-height: 1.35;
  font-weight: 700;
  color: var(--text-primary);
}

.note-section-label::before {
  content: "";
  width: 8rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: var(--color-primary-500);
}

.note-example-source {
  display: inline-block;
  padding: 6rpx 16rpx;
  margin-bottom: var(--space-2);
  border-radius: 999rpx;
  background: var(--bg-card);
  color: var(--color-green-500);
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 700;
  box-shadow: var(--shadow-active);
}

.note-example-stem {
  padding: var(--space-4);
  margin-bottom: 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-soft-blue);
  border: 1rpx solid var(--border-soft);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  word-break: break-word;
}

.note-example-image-note {
  overflow: hidden;
  margin: -4rpx 0 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-soft-blue);
}

.note-image {
  display: block;
  width: 100%;
}

.note-image-placeholder {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border: 2rpx dashed rgba(47, 107, 255, 0.22);
  border-radius: var(--radius-sm);
  background: var(--bg-soft-blue);
}

.note-image-title {
  max-width: 100%;
  margin-bottom: var(--space-2);
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  word-break: break-word;
}

.note-image-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--bg-card);
  color: var(--color-primary-500);
  font-size: 22rpx;
  font-weight: 700;
}

.note-image-desc {
  padding: 18rpx 20rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--text-secondary);
  word-break: break-word;
}

.note-example-options {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: 20rpx;
}

.note-example-option {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: var(--radius-sm);
  background: #f8fbff;
  border: 2rpx solid var(--border-soft);
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-primary);
  transition: background 160ms ease, border-color 160ms ease;
}

.note-example-option-key {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: var(--shadow-active);
}

.note-example-option-text {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.note-example-option-selected {
  background: var(--color-primary-50);
  border-color: var(--color-primary-500);
}

.note-example-option-selected .note-example-option-key {
  background: var(--color-primary-500);
  color: var(--text-inverse);
}

.note-example-option-correct {
  background: var(--bg-soft-green);
  border-color: var(--color-green-500);
}

.note-example-option-correct .note-example-option-key {
  background: var(--color-green-500);
  color: var(--text-inverse);
}

.note-example-option-wrong {
  background: #fff1f0;
  border-color: var(--color-danger);
}

.note-example-option-wrong .note-example-option-key {
  background: var(--color-danger);
  color: var(--text-inverse);
}

.note-example-action {
  width: 100%;
  min-height: 76rpx;
  margin: 0;
  padding: 0 var(--space-4);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 700;
  box-shadow: var(--shadow-cta);
}

.note-example-action::after {
  border: 0;
}

.note-example-action[disabled] {
  background: var(--border-subtle);
  color: var(--text-tertiary);
  box-shadow: none;
}

.note-example-result {
  margin-top: var(--space-4);
}

.note-example-answer-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  background: var(--bg-soft-green);
  border: 1rpx solid rgba(51, 196, 122, 0.14);
}

.note-example-answer-label {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-green-500);
}

.note-example-answer-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.note-example-analysis {
  padding: var(--space-4);
  border-radius: var(--radius-sm);
  background: var(--bg-soft-green);
  border: 1rpx solid rgba(51, 196, 122, 0.12);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  word-break: break-word;
}
