<view wx:if="{{sourceError}}" class="note-detail-shell"><view class="surface-card" style="padding:32rpx"><view>{{sourceError}}</view><button bindtap="handleDirectory">全部笔记</button></view></view>
<view wx:if="{{module && point}}" class="note-detail-page {{isReadingPrototype ? 'note-reading-prototype' : ''}}">
  <view class="note-detail-shell">
    <view class="note-detail-hero">
      <view class="note-detail-kicker">{{module.title}} · {{category.title}}</view>
      <view class="note-detail-title-row">
        <view class="note-detail-title">{{point.title}}</view>
        <button wx:if="{{point.relatedTraining}}" class="btn-base btn-primary note-detail-training-action" bindtap="handleTrainingTap">技能训练</button>
      </view>
      <view class="note-detail-desc">{{point.summary}}</view>
    </view>


    <view wx:if="{{readingMeta}}" class="note-reading-brief">
      <view class="note-reading-brief-head">
        <view class="note-reading-brief-label">{{readingMeta.label || '本页速记'}}</view>
      </view>
      <view class="note-reading-takeaway">{{readingMeta.takeaway}}</view>
      <view class="note-reading-focus-grid">
        <block wx:for="{{readingMeta.focus}}" wx:key="label">
          <view class="note-reading-focus-item">
            <view class="note-reading-focus-label">{{item.label}}</view>
            <view class="note-reading-focus-note">{{item.note}}</view>
          </view>
        </block>
      </view>
      <view wx:if="{{readingMeta.route && readingMeta.route.length}}" class="note-reading-route">
        <view class="note-reading-route-label">阅读路线</view>
        <block wx:for="{{readingMeta.route}}" wx:key="index">
          <view class="note-reading-route-item">{{item}}</view>
        </block>
      </view>
    </view>

    <scroll-view class="note-detail-tabs-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="note-detail-tabs segmented-control">
        <block wx:for="{{tabs}}" wx:key="id">
          <view class="note-detail-tab {{activeTab === item.id ? 'note-detail-tab-active' : ''}}" data-tab="{{item.id}}" bindtap="handleTabTap">{{item.title}}</view>
        </block>
      </view>
    </scroll-view>

    <view wx:if="{{isReadingPrototype && sectionAnchors.length > 1}}" class="note-section-nav">
      <view class="note-section-nav-label">本页导航</view>
      <scroll-view class="note-section-nav-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="note-section-nav-items">
          <block wx:for="{{sectionAnchors}}" wx:key="id">
            <view class="note-section-nav-item" data-anchor="{{item.id}}" bindtap="handleSectionAnchorTap">{{item.title}}</view>
          </block>
        </view>
      </scroll-view>
    </view>

    <view class="note-detail-section surface-card">
      <include src="../shared/blocks.wxml" />
      <view wx:if="{{hasMore}}" class="note-load-more" bindtap="loadMoreBlocks">
        <view class="note-load-more-text">加载更多</view>
      </view>
    </view>

    <view wx:if="{{activeReview && activeReview.length}}" class="note-reading-review">
      <view class="note-reading-review-head">30秒回顾</view>
      <block wx:for="{{activeReview}}" wx:key="index">
        <view class="note-reading-review-item"><view class="note-reading-review-dot"></view>{{item}}</view>
      </block>
    </view>
  </view>
</view>
