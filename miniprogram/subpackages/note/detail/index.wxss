@import "../shared/blocks.wxss";
.note-detail-page {
  min-height: 100vh;
  background: var(--bg-page-accent);
}

.note-detail-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
}

.note-detail-hero {
  padding: 4rpx 2rpx 26rpx;
}

.note-detail-kicker {
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-green-500);
  margin-bottom: 8rpx;
}

.note-detail-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.note-detail-title {
  flex: 1;
  min-width: 0;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 700;
  color: var(--text-primary);
}

.note-detail-training-action {
  flex: none;
  max-width: 260rpx;
  min-width: 0;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  line-height: 1.2;
  background: transparent;
  color: var(--color-primary-500);
  border: 2rpx solid var(--color-primary-500);
  box-shadow: none;
}

.note-detail-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.note-reading-brief {
  margin: 0 0 22rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eef8f3 0%, #f5f9ff 56%, #ffffff 100%);
  border: 1rpx solid rgba(51, 196, 122, 0.18);
  box-shadow: 0 12rpx 28rpx rgba(29, 78, 60, 0.06);
}

.note-reading-brief-head,
.note-reading-route,
.note-section-nav {
  display: flex;
  align-items: center;
}

.note-reading-brief-head {
  justify-content: space-between;
  gap: 16rpx;
}

.note-reading-brief-label,
.note-reading-route-label,
.note-section-nav-label {
  flex: none;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 800;
  color: var(--color-primary-600);
}

.note-reading-takeaway {
  margin-top: 14rpx;
  font-size: 29rpx;
  line-height: 1.5;
  font-weight: 800;
  color: var(--text-primary);
}

.note-reading-focus-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.note-reading-focus-item {
  min-width: 0;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(47, 107, 255, 0.1);
}

.note-reading-focus-label {
  overflow: hidden;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 800;
  color: var(--text-primary);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-reading-focus-note {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.note-reading-route {
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 18rpx;
}

.note-reading-route-label { margin-right: 4rpx; }

.note-reading-route-item {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(47, 107, 255, 0.08);
  font-size: 21rpx;
  line-height: 1.35;
  color: var(--color-primary-600);
}

.note-detail-tabs-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.note-section-nav {
  gap: 14rpx;
  margin: -2rpx 0 20rpx;
}

.note-section-nav-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.note-section-nav-items {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 4rpx;
}

.note-section-nav-item {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(76, 112, 146, 0.08);
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--text-secondary);
  white-space: nowrap;
}

.note-detail-tabs {
  display: inline-flex;
  width: auto;
  max-width: none;
  box-sizing: border-box;
  vertical-align: top;
  overflow-x: visible;
  white-space: nowrap;
  background: rgba(47, 107, 255, 0.1);
  border: 1rpx solid rgba(47, 107, 255, 0.1);
}

.note-detail-tab {
  flex: 0 0 auto;
  min-width: 104rpx;
  min-height: 54rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
  white-space: nowrap;
}

.note-detail-tab-active {
  background: #ffffff;
  color: var(--color-primary-500);
  box-shadow: 0 8rpx 20rpx rgba(47, 107, 255, 0.14);
}

.note-detail-section {
  padding: 28rpx 24rpx;
}

