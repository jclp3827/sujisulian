.directory-page { min-height:100vh; padding:28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); background:var(--bg-page-accent); }
.directory-header { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.directory-title { font-size:42rpx; font-weight:700; }
.directory-header button { margin:0; min-height:44px; line-height:44px; padding:0 22rpx; font-size:28rpx; color:var(--color-primary-500); background:var(--bg-soft-blue); }
.directory-desc,.directory-count { color:var(--text-secondary); font-size:26rpx; line-height:1.7; margin:16rpx 0; }
.directory-chips { display:inline-flex; gap:12rpx; padding:10rpx 0; white-space:nowrap; }
.directory-chip { flex:none; min-height:44px; line-height:44px; margin:0; padding:0 22rpx; font-size:28rpx; background:var(--bg-soft-blue); color:var(--text-secondary); border-radius:18rpx; }
.directory-chip.is-active { background:var(--color-primary-500); color:white; }
.directory-topics .directory-chip { font-size:26rpx; }
.directory-section-title { margin:30rpx 0 16rpx; font-size:32rpx; font-weight:700; }
.directory-point { padding:24rpx; margin-bottom:18rpx; }
.directory-point-title { font-size:32rpx; line-height:1.5; font-weight:700; }
.directory-arrow { float:right; color:var(--color-primary-500); }
.directory-summary { margin-top:10rpx; font-size:27rpx; line-height:1.65; color:var(--text-secondary); }
.directory-preview { margin-top:12rpx; padding:14rpx; background:var(--bg-soft-blue); color:var(--color-primary-500); font-size:26rpx; line-height:1.6; overflow-wrap:anywhere; }
.directory-empty { padding:32rpx; margin-top:24rpx; font-size:30rpx; }
