<view class="memory-page">
  <view wx:if="{{settingsOpen}}" class="note-settings-header"><view><view class="note-settings-context">{{title}}</view><view class="note-settings-title">学习设置</view></view><button class="note-settings-close" bindtap="handleCloseSettings">返回学习</button></view>
  <view wx:if="{{!settingsOpen}}" class="memory-learning-header"><view class="memory-learning-title">{{title}}</view><view class="memory-learning-actions"><view wx:if="{{!listOpen}}" class="memory-header-link" role="button" bindtap="handleList">{{kind === 'method' ? '全部方法' : '全部卡片'}}</view><button class="memory-settings-action" bindtap="handleSettings">学习设置</button></view></view>
  <view wx:if="{{kind === 'exam' && !settingsOpen}}" class="memory-exam-tabs"><view class="memory-exam-tab {{examVariant === 'selected' ? 'is-active' : ''}}" data-variant="selected" bindtap="handleExamVariant" role="button">精选速记</view><view class="memory-exam-tab {{examVariant === 'review' ? 'is-active' : ''}}" data-variant="review" bindtap="handleExamVariant" role="button">个人待回顾</view></view>
  <view wx:if="{{kind === 'exam' && !settingsOpen && !listOpen}}" class="memory-exam-summary">{{examVariant === 'selected' ? '可学卡片 ' + examBankCounts.selected + ' 张 · 从每日快记开始轮换' : '当前待回顾 ' + examBankCounts.review + ' 张 · 来自模糊和没想起的自评'}}</view>
  <view wx:if="{{!settingsOpen && !listOpen}}" class="memory-progress memory-progress-modern">
    <view wx:if="{{state === 'card' || state === 'complete' || state === 'expired'}}" class="note-progress-card"><view class="note-progress-row"><view class="note-progress-current"><text class="note-progress-label">当前卡片</text><text class="note-progress-value">{{index}} / {{total}}</text></view><view wx:if="{{report.counts}}" class="note-progress-stats">已回顾 {{report.counts.remembered + report.counts.fuzzy + report.counts.missed + report.counts.skipped}} · 记住 {{report.counts.remembered}}</view></view><view class="note-progress-track"><view class="note-progress-fill" style="width:{{progress}}%"></view></view></view>
    <view wx:if="{{scopeLabel !== '全部科目 · 全部专题' || (kind === 'basic' && ((state === 'card' && index > 1) || (state === 'complete' && total > 0)))}}" class="memory-modern-range"><view wx:if="{{scopeLabel !== '全部科目 · 全部专题'}}" class="memory-scope-label">{{scopeLabel}}</view><view class="memory-range-actions"><view wx:if="{{kind === 'basic' && ((state === 'card' && index > 1) || (state === 'complete' && total > 0))}}" role="button" bindtap="handlePrev">上一张</view></view></view>
  </view>
  <scroll-view wx:if="{{settingsOpen}}" class="memory-settings" scroll-y><view class="note-settings-card"><view class="note-settings-section-title">学习范围</view><view class="note-settings-field"><view class="note-settings-field-label">科目</view><view class="note-settings-options"><view role="button" wx:for="{{subjects}}" wx:key="id" wx:for-index="optionIndex" class="note-settings-option {{draftSubjectIndex === optionIndex ? 'selected' : ''}}" data-index="{{optionIndex}}" bindtap="handleDraftSubject">{{item.title}}</view></view></view><view class="note-settings-field"><view class="note-settings-field-label">专题</view><view class="note-settings-options"><view role="button" wx:for="{{draftTopics}}" wx:key="id" wx:for-index="optionIndex" class="note-settings-option {{draftTopicIndex === optionIndex ? 'selected' : ''}}" data-index="{{optionIndex}}" bindtap="handleDraftTopic">{{item.title}}</view></view></view><view wx:if="{{kind === 'exam'}}" class="note-settings-section-title note-settings-divider">每轮卡片</view><view wx:if="{{kind === 'exam'}}" class="note-settings-counts"><button wx:for="{{[5,10,15]}}" wx:key="*this" class="note-settings-count {{draftExamCount === item ? 'selected' : ''}}" data-count="{{item}}" bindtap="handleDraftExamCount">{{item}} 张</button></view></view><view class="note-settings-hint">保存后立即刷新本轮卡片；当前范围内的卡片按实际数量展示。</view></scroll-view>
  <view wx:if="{{notice && !(state === 'empty' && kind !== 'basic')}}" class="memory-notice">{{notice}}<button wx:if="{{card && imageError}}" bindtap="handleImageRetry">重试配图</button></view>
  <scroll-view wx:if="{{!settingsOpen}}" class="memory-body" scroll-y scroll-top="{{scrollTop}}" bindscroll="handleScroll">
    <view wx:if="{{listOpen}}" class="memory-list">
      <view class="memory-list-head"><view class="memory-list-title">{{kind === 'method' ? '全部方法' : '全部卡片'}} · {{listing.length}} {{kind === 'method' ? '个' : '张'}}</view><view class="memory-muted">选择一项继续学习</view></view>
      <view wx:for="{{listing}}" wx:key="id" class="memory-list-row" data-id="{{item.id}}" bindtap="handlePick"><view class="memory-list-row-title">{{item.title}}</view><view class="memory-list-row-end"><text class="memory-list-state {{item.stateLabel === '记住了' ? 'is-remembered' : ''}}">{{item.stateLabel}}</text><text class="memory-list-chevron">›</text></view></view>
    </view>
    <block wx:elif="{{state === 'card'}}">
      <view class="memory-card">
        <view class="memory-card-title">{{card.title}}</view>
        <view class="memory-question"><view class="memory-kicker">{{mode === 'browse' ? '浏览记忆' : '主动回忆'}}</view><view class="memory-prompt">{{card.prompt}}</view>
          <view wx:if="{{answerVisible}}" class="memory-answer"><view class="memory-kicker">知识要点</view><include src="../shared/blocks.wxml" /></view>
        </view>
        <view wx:if="{{answerVisible}}" class="memory-sources"><button data-index="0" bindtap="handleSource">查看原文 ›</button></view>
      </view>

    </block>
    <view wx:elif="{{state === 'complete'}}" class="memory-card"><view class="memory-card-title">本轮完成</view><view class="memory-result">记住了 {{report.counts.remembered}} · 有点模糊 {{report.counts.fuzzy}}</view><view class="memory-result">没想起 {{report.counts.missed}} · 跳过 {{report.counts.skipped}}</view><view class="memory-muted">当前范围剩余弱项 {{report.remainingWeak}} 张。自评仅代表本次回忆感受。</view></view>
    <view wx:elif="{{state === 'expired'}}" class="memory-card"><view class="memory-card-title">这张内容已更新或暂不可用</view><view class="memory-muted">原评价和历史仍保留，可以继续下一张。</view></view>
    <view wx:elif="{{state === 'error'}}" class="memory-card"><view class="memory-card-title">暂时无法载入记忆记录</view><view class="memory-muted">已有记录仍保留，可重试载入。</view></view>
    <view wx:else class="memory-card"><view class="memory-card-title">{{kind === 'exam' ? (examVariant === 'review' ? '暂无个人待回顾卡片' : '当前范围暂无速记卡片') : '当前范围暂无卡片'}}</view><view class="memory-muted">{{kind === 'exam' && examVariant === 'review' ? '先从精选速记开始；自评为模糊或没想起的卡片会出现在这里。' : '可调整科目和专题，或从全部笔记开始阅读。'}}</view></view>
    <view wx:if="{{updatedCards.length}}" class="memory-card"><view class="memory-card-title">内容已更新，待重新评估</view><view wx:for="{{updatedCards}}" wx:key="id" data-id="{{item.id}}" class="memory-list-item" bindtap="handlePick">{{item.title}} ›</view></view>
    <view class="memory-bottom-space"></view>
  </scroll-view>
  <view class="memory-toolbar">
    <view wx:if="{{settingsOpen}}" class="memory-actions"><button class="memory-primary memory-save" bindtap="handleSaveSettings">保存设置</button></view>
    <view wx:elif="{{state === 'card' && answerVisible && !listOpen}}" class="memory-assess"><view class="memory-assess-row"><button disabled="{{!imagesReady}}" data-result="remembered" bindtap="handleAssess">记住了</button><button disabled="{{!imagesReady}}" data-result="fuzzy" bindtap="handleAssess">有点模糊</button></view><view class="memory-assess-row"><button disabled="{{!imagesReady}}" data-result="missed" bindtap="handleAssess">没想起</button><button data-result="skipped" bindtap="handleAssess">跳过</button></view></view>
    <view wx:elif="{{state === 'card' && !listOpen}}" class="memory-actions"><button bindtap="handleHome">退出</button><button class="memory-primary" bindtap="handleReveal">揭晓知识</button><button class="memory-outline" bindtap="handleSkip">跳过这张</button></view>
    <view wx:elif="{{listOpen}}" class="memory-actions"><button bindtap="handleHome">退出</button><button class="memory-primary" bindtap="handleList">返回当前卡片</button></view>
    <view wx:else class="memory-actions"><button bindtap="handleHome">退出</button><button wx:if="{{state === 'complete'}}" class="memory-primary" bindtap="handleFresh">再记一轮</button><button wx:elif="{{state === 'error'}}" class="memory-primary" bindtap="handleRetry">重试载入</button><button wx:elif="{{state === 'expired'}}" class="memory-primary" bindtap="handleNext">继续下一张</button><button wx:else class="memory-primary" bindtap="handleDirectory">全部笔记</button><button bindtap="handleList">全部卡片</button></view>
  </view>
</view>
