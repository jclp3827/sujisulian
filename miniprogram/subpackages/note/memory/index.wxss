@import "../shared/blocks.wxss";
@import "../shared/learning-ui.wxss";
page {height:100%;background:#f0f5fc;}
.memory-page{height:100vh;display:flex;flex-direction:column;background:#f0f5fc;color:#111827;overflow:hidden;}
.memory-learning-header{flex:none;display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:20rpx 24rpx 14rpx;}
.memory-learning-title{min-width:0;font-size:38rpx;font-weight:700;line-height:1.35;}
.memory-learning-actions{flex:none;display:flex;align-items:center;gap:24rpx;margin-left:auto;}
.memory-header-link{color:#2f6bff;font-size:25rpx;line-height:1.5;white-space:nowrap;}
.memory-settings-action{flex:none;width:auto;min-width:0;max-width:160rpx;margin:0;padding:10rpx 0 10rpx 12rpx;background:transparent;color:#2f6bff;font-size:25rpx;line-height:1.5;}
.memory-exam-tabs{flex:none;display:flex;gap:28rpx;margin:0 24rpx 8rpx;border-bottom:1rpx solid #dfe7f3;}
.memory-exam-tab{min-height:62rpx;display:flex;align-items:center;position:relative;color:#667085;font-size:26rpx;font-weight:600;}
.memory-exam-tab.is-active{color:#275ce8;font-weight:700;}
.memory-exam-tab.is-active::after{content:"";position:absolute;left:0;right:0;bottom:-1rpx;height:4rpx;border-radius:4rpx;background:#2f6bff;}
.memory-exam-summary{flex:none;margin:2rpx 24rpx 16rpx;color:#667085;font-size:22rpx;line-height:1.45;}
.memory-progress{flex:none;margin:0 24rpx;}
.memory-muted{font-size:24rpx;line-height:1.6;color:#667085;}
.memory-notice{padding:14rpx 28rpx;color:#b45309;font-size:24rpx;}
.memory-body{flex:1;min-height:0;height:0;}
.memory-card,.memory-list{margin:12rpx 24rpx 24rpx;padding:24rpx;border-radius:24rpx;background:#fff;box-sizing:border-box;overflow:hidden;}
.memory-list{padding:12rpx 24rpx 4rpx;}
.memory-list-head{padding:10rpx 0 18rpx;border-bottom:1rpx solid #e9eef6;}
.memory-list-head .memory-list-title{margin-bottom:2rpx;color:#111827;font-size:30rpx;}
.memory-list-row{display:flex;align-items:center;gap:16rpx;min-height:86rpx;padding:16rpx 0;border-bottom:1rpx solid #e9eef6;}
.memory-list-row:last-child{border-bottom:0;}
.memory-list-row-title{flex:1;min-width:0;color:#172033;font-size:27rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere;}
.memory-list-row-end{flex:none;display:flex;align-items:center;gap:12rpx;}
.memory-list-state{padding:6rpx 12rpx;border-radius:999rpx;background:#f0f4fa;color:#667085;font-size:21rpx;line-height:1.4;white-space:nowrap;}
.memory-list-state.is-remembered{background:#e9f8f0;color:#17804e;}
.memory-list-chevron{color:#98a2b3;font-size:34rpx;line-height:1;}
.memory-card-title,.memory-list-title{color:#4b5563;font-size:26rpx;font-weight:700;line-height:1.6;margin-bottom:16rpx;}
.memory-question{padding:24rpx;border-radius:18rpx;background:#f3f7ff;min-width:0;}
.memory-kicker{font-size:23rpx;font-weight:700;color:#275af5;line-height:1.6;margin-bottom:12rpx;}
.memory-prompt{font-size:32rpx;line-height:1.7;font-weight:700;word-break:break-word;}
.memory-answer{margin-top:24rpx;min-width:0;}
.memory-answer .note-block{padding:0 0 22rpx;margin:0 0 22rpx;}
.memory-answer .note-formula-box{overflow-x:auto;max-width:100%;}
.memory-answer .note-block-emphasis,.memory-answer .note-block-grouped,.memory-answer .note-block-wide{background:#fff;border-radius:14rpx;padding:20rpx;}
.memory-sources{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx;}
.memory-sources button{font-size:22rpx;line-height:1.6;padding:8rpx 14rpx;background:#f1f5ff;color:#386bff;}
.memory-hint{text-align:center;font-size:22rpx;color:#748197;padding:4rpx 24rpx 20rpx;}
.memory-toolbar{flex:none;margin-top:auto;background:#fff;padding:18rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));box-shadow:0 -8rpx 28rpx rgba(48,77,112,.04);}
.memory-actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx;}
.memory-toolbar button{margin:0;min-height:78rpx;font-size:25rpx;font-weight:650;line-height:1.5;padding:18rpx 20rpx;border-radius:14rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;}
.memory-actions button{background:#edf3ff;color:#386bff;}
.memory-actions .memory-primary{background:#3d73ff;color:#fff;}
.memory-actions .memory-outline{background:#fff;border:1rpx solid #477aff;}
.memory-assess{display:flex;flex-direction:column;gap:12rpx;width:100%;min-width:0;}
.memory-assess-row{display:flex;gap:12rpx;width:100%;min-width:0;}
.memory-assess-row button{flex:1;width:0;min-width:0;max-width:100%;background:#fff;border:1rpx solid #e8edf5;color:#111827;}
.memory-list-item{padding:20rpx 0;border-bottom:1rpx solid #edf0f6;font-size:28rpx;line-height:1.7;}
.memory-result{font-size:28rpx;line-height:1.9;}
.memory-bottom-space{height:24rpx;}
button::after{border:none;}

.memory-scope-label{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.memory-page>.note-settings-header{margin:24rpx 28rpx 0;}
.memory-settings{flex:1;min-height:0;height:0;margin:0 24rpx;padding:0 0 20rpx;box-sizing:border-box;}
.memory-modern-range{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:10rpx 2rpx 4rpx;min-height:48rpx;}
.memory-modern-range .memory-scope-label{flex:1;min-width:0;font-size:23rpx;color:#536173;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.memory-range-actions{flex:none;display:flex;align-items:center;gap:24rpx;margin-left:auto;color:#2f6bff;font-size:23rpx;white-space:nowrap;}
.memory-actions .memory-save{flex:1;width:100%;}

.memory-loading{min-height:220rpx;}
.memory-loading-line{height:20rpx;margin-top:24rpx;border-radius:10rpx;background:#edf2f9;width:85%;}
.memory-loading-line.short{width:55%;}
