@import "../shared/learning-ui.wxss";
.practice-page { min-height:100vh; padding:24rpx 24rpx calc(170px + env(safe-area-inset-bottom)); background:var(--bg-page-accent); }
.practice-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.practice-title { font-size:40rpx; font-weight:700; }
.practice-heading button { min-height:44px; line-height:44px; padding:0 24rpx; margin:0; font-size:26rpx; background:var(--bg-soft-blue); color:var(--color-primary-500); }
.practice-scope,.practice-context { font-size:28rpx; color:var(--text-secondary); line-height:1.6; margin:14rpx 0; }
.practice-candidate,.practice-input-tip { font-size:24rpx; line-height:1.65; color:var(--text-tertiary); margin:14rpx 0; }
.practice-notice { margin:16rpx 0; padding:18rpx; border-radius:16rpx; background:#fff1d6; color:#845000; font-size:27rpx; line-height:1.6; }
.practice-progress-card{margin-top:22rpx;}
.practice-source-context{font-size:23rpx;color:var(--text-tertiary);margin:14rpx 2rpx 0;}
.practice-card,.practice-feedback { margin-top:24rpx; padding:28rpx 24rpx; }
.practice-prompt { font-size:32rpx; line-height:1.8; white-space:pre-wrap; word-break:break-all; margin-bottom:24rpx; }
.practice-material { background:var(--bg-soft-blue); padding:22rpx; margin-bottom:24rpx; font-size:29rpx; line-height:1.8; white-space:pre-wrap; }
.practice-option { min-height:48px; display:flex; align-items:flex-start; gap:16rpx; padding:22rpx 18rpx; margin-top:16rpx; border:2rpx solid var(--border-subtle); border-radius:16rpx; font-size:29rpx; line-height:1.65; }
.practice-option-key { flex:none; font-weight:700; }
.practice-option > view { min-width:0; overflow-wrap:anywhere; word-break:break-word; }
.practice-option.is-selected { background:var(--bg-soft-blue); border-color:var(--color-primary-500); color:var(--color-primary-500); }
.practice-option.is-correct { border-color:#33a76b; background:#edfaf2; }
.practice-input { border:2rpx solid var(--border-subtle); border-radius:16rpx; min-height:52px; padding:14rpx 18rpx; margin-top:24rpx; font-size:32rpx; }
.practice-feedback-title { font-size:32rpx; font-weight:700; line-height:1.6; }
.practice-answer { margin-top:16rpx; font-size:30rpx; font-weight:700; }
.practice-explanation,.practice-result-line { font-size:29rpx; line-height:1.8; margin-top:18rpx; white-space:pre-wrap; word-break:break-all; }
.practice-source-title { font-size:28rpx; font-weight:700; margin:28rpx 0 12rpx; }
.practice-source { width:100%; min-height:44px; margin:12rpx 0; padding:18rpx; font-size:27rpx; line-height:1.6; text-align:left; white-space:normal; background:white; color:var(--color-primary-500); }
.practice-actions { position:fixed; z-index:50; left:0; right:0; bottom:0; padding:14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom)); background:white; border-top:1rpx solid var(--border-subtle); }
.practice-primary,.practice-secondary { min-height:44px; line-height:44px; margin:0; padding:0 16rpx; font-size:29rpx; }
.practice-primary { width:100%; background:var(--color-primary-500); color:white; margin-bottom:12rpx; }
.practice-secondary { width:100%; color:var(--color-primary-500); background:var(--bg-soft-blue); }
.practice-action-row { display:flex; gap:12rpx; }
.practice-action-row button { flex:1; min-width:0; }
.practice-settings { position:fixed; z-index:40; inset:0; background:var(--bg-page-accent); padding:32rpx 24rpx calc(160px + env(safe-area-inset-bottom)); overflow-y:auto; }

.practice-image { width:100%; height:auto; display:block; margin:20rpx 0; }
.practice-images { min-width:0; }
