.note-settings-header{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:8rpx 0 24rpx;}
.note-settings-context{font-size:24rpx;line-height:1.5;color:#667085;}
.note-settings-title{margin-top:4rpx;font-size:36rpx;line-height:1.35;font-weight:700;color:#111827;}
.note-settings-close{flex:none;width:auto;min-width:0;max-width:160rpx;min-height:56rpx;margin:0 0 0 auto;padding:8rpx 12rpx;border:1rpx solid #dce5f4;border-radius:14rpx;background:#fff;color:#2f6bff;font-size:23rpx;line-height:1.5;}
.note-settings-header .note-settings-close{margin-left:auto;margin-right:0;}
.note-settings-card{padding:28rpx 24rpx;border:1rpx solid #e5ebf5;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 24rpx rgba(39,66,95,.04);}
.note-settings-section-title{font-size:28rpx;font-weight:700;color:#111827;line-height:1.5;}
.note-settings-divider{margin-top:30rpx;padding-top:24rpx;border-top:1rpx solid #e5ebf5;}
.note-settings-field{margin-top:22rpx;}
.note-settings-field-label{margin-bottom:12rpx;font-size:25rpx;font-weight:650;color:#344054;line-height:1.5;}
.note-settings-options{display:flex;flex-wrap:wrap;gap:12rpx;}
.note-settings-option{flex:none;display:inline-flex;align-items:center;justify-content:center;width:auto;min-width:0;min-height:64rpx;box-sizing:border-box;margin:0;padding:10rpx 20rpx;border:2rpx solid #e1e8f4;border-radius:999rpx;background:#f5f8ff;color:#536173;font-size:25rpx;font-weight:600;line-height:1.4;white-space:nowrap;}
.note-settings-option.selected{border-color:#2f6bff;background:#eaf1ff;color:#275ce8;font-weight:700;}
.note-settings-counts{display:flex;gap:12rpx;margin-top:16rpx;}
.note-settings-count{flex:1;width:0;min-width:0;min-height:88rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;margin:0;padding:14rpx 8rpx;border:2rpx solid #e1e8f4;border-radius:14rpx;background:#f5f8ff;color:#667085;font-size:27rpx;font-weight:600;line-height:1.4;}
.note-settings-count.selected{border-color:#2f6bff;background:#eaf1ff;color:#275ce8;font-weight:700;}
.note-settings-hint{margin:20rpx 4rpx 0;color:#667085;font-size:24rpx;line-height:1.6;}
.note-progress-card{box-sizing:border-box;padding:20rpx 22rpx 18rpx;border:1rpx solid #e8edf5;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 24rpx rgba(39,66,95,.04);}
.note-progress-row{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;}
.note-progress-current{display:flex;align-items:baseline;gap:10rpx;min-width:0;}
.note-progress-label{color:#8994a7;font-size:22rpx;line-height:1.4;white-space:nowrap;}
.note-progress-value{color:#111827;font-size:30rpx;line-height:1.2;font-weight:800;white-space:nowrap;}
.note-progress-stats{color:#536173;font-size:21rpx;line-height:1.4;text-align:right;white-space:nowrap;}
.note-progress-track{height:8rpx;margin-top:16rpx;overflow:hidden;border-radius:999rpx;background:#e4ebf5;}
.note-progress-fill{height:100%;border-radius:inherit;background:#2f6bff;}
