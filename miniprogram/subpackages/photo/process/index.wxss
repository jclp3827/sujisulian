/* A bounded workspace keeps the photo and actions separate from the shared Tab bar. */
.process-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #f7f8fa; color: #202630; --photo-accent: #3265f5; }
.task-header { flex: none; display: flex; align-items: center; padding: 28rpx 32rpx 26rpx; background: #f7f8fa; }
.task-step { flex: none; display: flex; align-items: center; gap: 9rpx; color: #a0a7b2; }
.step-number { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: #e6e9ee; color: #7e8793; font-size: 23rpx; line-height: 1; font-weight: 700; }
.step-label { font-size: 24rpx; line-height: 1; font-weight: 650; white-space: nowrap; }
.task-step.current { color: #2f67ed; }
.task-step.current .step-number { color: #fff; background: #3265f5; box-shadow: 0 4rpx 10rpx rgba(50,101,245,.2); }
.task-step.complete { color: #2f8b69; }
.task-step.complete .step-number { color: #fff; background: #38a67d; }
.step-connector { flex: 1; min-width: 14rpx; height: 3rpx; margin: 0 10rpx; background: #dfe3e9; }
.step-connector.complete { background: #7ec7aa; }
.workspace { flex: 1; min-height: 0; height: 0; }
.workspace-content { padding: 0 36rpx 24rpx; }
.scroll-anchor { height: 1px; }
button { margin: 0; box-sizing: border-box; border: 0; border-radius: 22rpx; font-size: 27rpx; font-weight: 600; line-height: 1.5; padding: 23rpx 24rpx; }
button::after { border: 0; }
.process-page button { width: 100%; }
.primary { color: #fff; background: var(--photo-accent); }
.process-page .primary[disabled] { background: #e4e7ec; color: #89929f; }
.secondary { color: #3b4658; background: #edf0f4; }
.secondary[disabled], .reset[disabled], .inline-action[disabled] { color: #a1a7b1; }
.product-value { margin: 4rpx 0 22rpx; padding: 24rpx 26rpx; border-radius: 22rpx; background: linear-gradient(135deg, #eef4ff 0%, #f7f9ff 100%); border: 1rpx solid #dfe9ff; }
.product-kicker { display: inline-flex; padding: 5rpx 12rpx; border-radius: 999rpx; background: #dfe9ff; color: #315dbd; font-size: 20rpx; line-height: 1.4; font-weight: 600; }
.product-title { margin-top: 11rpx; color: #26344b; font-size: 29rpx; line-height: 1.45; font-weight: 700; }
.product-flow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 8rpx; margin-top: 18rpx; }
.product-flow-step { display: flex; flex-direction: column; align-items: center; gap: 7rpx; color: #53627a; font-size: 20rpx; line-height: 1.3; font-weight: 600; }
.product-flow-icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 14rpx; background: #e0e9ff; color: #315fc4; font-size: 20rpx; line-height: 1; font-weight: 700; }
.product-flow-icon.complete { background: #daf1e7; color: #258362; }
.product-flow-arrow { color: #9aabc9; font-size: 34rpx; line-height: 1; }
.product-subtitle { display: block; margin-top: 16rpx; color: #52627a; font-size: 22rpx; line-height: 1.55; text-align: center; font-weight: 500; }
.requirements-preview { overflow: hidden; background: #fff; border-radius: 24rpx; padding: 22rpx 20rpx 20rpx; }
.requirements-heading { display: flex; align-items: center; justify-content: space-between; font-size: 26rpx; font-weight: 600; }
.requirements-link { color: #3265d8; font-size: 22rpx; font-weight: 500; line-height: 1.6; }
.composition-guide { display: block; width: 100%; margin-top: 10rpx; }
.example-labels { display: flex; margin: -4rpx 0 18rpx; font-size: 21rpx; line-height: 1.5; text-align: center; color: #7a818d; }
.example-labels text { width: 50%; }
.requirement-points { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.requirement-point { display: flex; align-items: center; gap: 10rpx; min-width: 0; padding: 13rpx 14rpx; border-radius: 14rpx; background: #f6f7f9; color: #4d5869; font-size: 22rpx; line-height: 1.35; }
.point-icon { flex: none; display: flex; align-items: center; justify-content: center; min-width: 34rpx; height: 34rpx; padding: 0 5rpx; border-radius: 10rpx; background: #e7edfb; color: #315fca; font-size: 17rpx; line-height: 1; font-weight: 700; }
.global-background-switch { flex: none; margin: 0 36rpx 18rpx; }
.background-paths { display: flex; gap: 4rpx; padding: 5rpx; border-radius: 20rpx; background: #e8ecf1; }
.background-paths .background-path { flex: 1; width: auto; min-width: 0; padding: 19rpx 8rpx; border-radius: 16rpx; font-size: 25rpx; color: #747d8b; background: transparent; font-weight: 600; }
.background-paths .selected { background: #fff; color: #264eac; box-shadow: 0 2rpx 8rpx rgba(27,41,67,0.06); }
.background-paths .background-path[disabled] { color: #a1a8b3; }
.background-paths .selected[disabled] { color: #727c8c; }
.ai-diamond { margin-right: 7rpx; color: #d9a01e; font-size: 20rpx; }
.photo-stage { padding: 18rpx 12rpx 18rpx; background: #e9edf2; border-radius: 22rpx; }
.photo-stage-main { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: start; gap: 8rpx; }
.process-page .photo-tool { width: auto; min-width: 0; min-height: 0; margin: 0; padding: 9rpx 8rpx; border-radius: 13rpx; background: rgba(255,255,255,.78); color: #52627a; font-size: 19rpx; line-height: 1.35; font-weight: 500; white-space: nowrap; box-shadow: 0 2rpx 8rpx rgba(34,50,74,.06); }
.process-page .photo-tool-left { justify-self: start; }
.process-page .photo-tool-right { justify-self: end; }
.process-page .photo-tool[disabled] { color: #a1a7b1; }
.canvas-frame { position: relative; overflow: hidden; background: #d8dfe7; box-shadow: 0 4rpx 18rpx rgba(28,40,59,0.08); }
.photo-canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.crop-guides { position: absolute; top: 20%; right: 22%; bottom: 15%; left: 22%; border: 1rpx dashed rgba(255,255,255,0.6); border-radius: 45% 45% 25% 25%; pointer-events: none; }
.gesture-hint { display: flex; flex-direction: column; align-items: center; gap: 5rpx; margin: 16rpx auto 0; color: #56657a; font-size: 22rpx; line-height: 1.45; font-weight: 500; text-align: center; }
.gesture-hint text { white-space: nowrap; }
.gesture-hint text + text { color: #8b95a3; font-size: 20rpx; font-weight: 400; }
.fine-controls { padding: 12rpx 20rpx; margin-top: 12rpx; border-radius: 18rpx; background: #fff; }
.slider-label { font-size: 23rpx; color: #647289; }
.background-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 14rpx; }
.background-choices button { display: flex; justify-content: center; align-items: center; gap: 12rpx; width: 100%; min-height: 84rpx; margin: 0; padding: 0 18rpx; border-radius: 18rpx; background: #f2f4f7; font-size: 24rpx; font-weight: 600; color: #647289; }
.background-choices .chosen { background: #e7edff; color: #2f5fc8; box-shadow: inset 0 0 0 2rpx rgba(50,101,245,.2); }
.swatch { width: 25rpx; height: 25rpx; border-radius: 50%; box-shadow: inset 0 0 0 1rpx rgba(22,43,73,0.12); }
.swatch.white { background: #fff; }
.swatch.blue { background: #438edb; }
.ai-panel { margin-top: 14rpx; padding: 18rpx; border-radius: 20rpx; background: #fff; }
.ai-facts { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: 10rpx; }
.ai-fact { display: flex; align-items: center; justify-content: center; gap: 7rpx; min-height: 58rpx; padding: 8rpx 10rpx; border-radius: 14rpx; background: #f5f7fa; color: #657184; font-size: 21rpx; line-height: 1.35; }
.ai-fact-value, .ai-fact-icon { color: #3265d8; font-size: 26rpx; font-weight: 700; }
.ai-fact-icon { font-size: 23rpx; }
.process-page .ai-start { display: flex; align-items: center; justify-content: center; min-height: 84rpx; margin-top: 14rpx; border-radius: 18rpx; background: linear-gradient(135deg, #2f6bff 0%, #7357e9 100%); color: #fff; font-size: 27rpx; box-shadow: 0 10rpx 24rpx rgba(75,84,220,.22); }
.magic-wand { position: relative; width: 35rpx; height: 35rpx; margin-right: 10rpx; transform: rotate(-12deg); }
.wand-star { position: absolute; top: -5rpx; left: 0; color: #fff0a8; font-size: 23rpx; line-height: 1; }
.wand-stick { position: absolute; left: 14rpx; top: 20rpx; width: 22rpx; height: 5rpx; border-radius: 999rpx; background: #fff; transform: rotate(45deg); transform-origin: left center; }
.ai-entitlement { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 7rpx; margin-top: 13rpx; color: #7b8593; font-size: 21rpx; line-height: 1.6; }
.ai-entitlement .requirements-link { margin-left: 5rpx; }
.ai-separator { color: #bcc2ca; }
.compact-note { margin-top: 10rpx; font-size: 21rpx; color: #8a929f; line-height: 1.6; text-align: center; }
.compact-note .requirements-link { margin-left: 8rpx; font-size: 21rpx; }
.ai-status { padding-top: 10rpx; border-top: 1rpx solid #edf0f4; }
.action-dock { flex: none; position: relative; z-index: 10; padding: 16rpx 36rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 18rpx rgba(31,47,73,0.025); }
.embedded .action-dock { padding-bottom: 18rpx; }
.action-disclaimer { flex: none; padding: 12rpx 36rpx 10rpx; background: #f7f8fa; color: #858e9b; text-align: center; font-size: 20rpx; line-height: 1.45; }
.action-dock .primary { margin: 0; padding: 23rpx 10rpx; font-size: 28rpx; }
.action-dock .btn-primary { background: var(--gradient-primary); color: var(--text-on-primary); box-shadow: var(--shadow-cta); }
.process-page .btn-primary[disabled] { background: #e4e7ec; color: #89929f; box-shadow: none; }
.select-action-dock { padding-top: 14rpx; }
.process-page .select-secondary { min-height: 82rpx; border-radius: 18rpx; background: #f2f3f5; border: 0; color: #3f4857; font-size: 26rpx; box-shadow: none; }
.process-page .select-primary { min-height: 88rpx; margin-top: 12rpx; border-radius: 18rpx; font-size: 29rpx; }
.process-page .photo-orders-float { position: fixed; z-index: 12; right: 30rpx; bottom: calc(390rpx + env(safe-area-inset-bottom)); width: 78rpx; height: 78rpx; min-height: 0; margin: 0; padding: 0; border: 1rpx solid #dfe7f8; border-radius: 50%; background: #fff; color: #3265d8; font-size: 21rpx; line-height: 78rpx; box-shadow: 0 6rpx 20rpx rgba(40, 77, 150, .15); }
.adjust-action-dock { padding-top: 14rpx; }
.process-page .adjust-secondary { min-height: 78rpx; border-radius: 18rpx; background: #f2f3f5; border: 0; color: #3f4857; font-size: 25rpx; box-shadow: none; }
.adjust-action-dock .generate-photo { margin-top: 12rpx; }
.result-photo-stage { display: flex; align-items: center; justify-content: center; padding: 22rpx; border-radius: 22rpx; background: #e9edf2; }
.result-image { display: block; width: 100%; }
.result-feedback { margin: 0 0 14rpx; padding: 18rpx 22rpx; border-radius: 17rpx; background: #edf7f2; color: #28775c; text-align: center; font-size: 23rpx; line-height: 1.55; font-weight: 500; }
.result-feedback.error { background: #fff0ed; color: #a65143; }
.result-feedback.warning-tone { background: #fff3e8; color: #98692f; }
.result-feedback.neutral { background: #eef1f5; color: #637083; }
.result-spec-card { margin-top: 14rpx; padding: 14rpx 16rpx; border-radius: 18rpx; background: #fff; }
.result-spec-metrics { display: grid; grid-template-columns: 1fr 1rpx 1fr; align-items: center; }
.result-spec-divider { width: 1rpx; height: 34rpx; background: #e6eaf0; }
.result-spec-item { display: flex; align-items: baseline; justify-content: center; gap: 7rpx; min-width: 0; color: #7b8796; line-height: 1.25; white-space: nowrap; }
.result-spec-label { font-size: 19rpx; }
.result-spec-value { color: #263754; font-size: 25rpx; font-weight: 700; }
.result-spec-unit { color: #8793a2; font-size: 17rpx; }
.result-compliance { display: flex; align-items: center; justify-content: center; gap: 9rpx; margin-top: 12rpx; padding: 11rpx 14rpx; border-radius: 14rpx; background: #e9f6f0; color: #27775b; }
.result-check { display: flex; align-items: center; justify-content: center; flex: none; width: 30rpx; height: 30rpx; border-radius: 50%; background: #31a078; color: #fff; font-size: 18rpx; line-height: 1; font-weight: 700; }
.result-compliance-title { font-size: 20rpx; line-height: 1.4; font-weight: 650; }
.delivery-guide { box-sizing: border-box; width: 100%; margin: 16rpx 0 0; padding: 18rpx; border: 1rpx solid #f2d5b6; border-radius: 18rpx; background: #fff7ed; color: #514234; text-align: left; }
.delivery-heading { display: flex; align-items: center; gap: 13rpx; }
.delivery-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 50rpx; height: 50rpx; border-radius: 14rpx; background: #ffe3c3; color: #a85b15; font-size: 15rpx; line-height: 1; font-weight: 700; }
.delivery-heading view { min-width: 0; }
.delivery-title { display: block; color: #49382a; font-size: 23rpx; line-height: 1.35; font-weight: 700; }
.delivery-subtitle { display: block; margin-top: 2rpx; color: #8b735e; font-size: 18rpx; line-height: 1.4; }
.delivery-steps { display: grid; gap: 8rpx; margin-top: 14rpx; }
.delivery-step { display: flex; align-items: center; gap: 10rpx; color: #5d4d3e; font-size: 20rpx; line-height: 1.4; }
.delivery-step-number { display: flex; align-items: center; justify-content: center; flex: none; width: 30rpx; height: 30rpx; border-radius: 50%; background: #e89a48; color: #fff; font-size: 17rpx; line-height: 1; font-weight: 700; }
.delivery-warning { margin-top: 13rpx; padding: 10rpx 12rpx; border-radius: 11rpx; background: rgba(220, 63, 48, 0.10); color: #b3473c; font-size: 19rpx; line-height: 1.4; text-align: center; font-weight: 600; }
.result-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 18rpx; }
.result-actions button { width: 100%; min-height: 68rpx; margin: 0; padding: 13rpx 16rpx; border: 1rpx solid #e2e6ed; border-radius: 16rpx; background: #edf0f4; color: #4c5f7f; font-size: 23rpx; font-weight: 550; }
.result-actions button::after { border: 0; }
.reset { color: #7b8492; background: transparent; }
.ai-terms { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #edf1fa; color: #63799e; font-size: 23rpx; line-height: 1.6; text-align: center; }
.notice, .warning { display: block; padding: 18rpx 22rpx; margin: 12rpx 0; border-radius: 16rpx; background: #fff3e8; color: #98692f; font-size: 24rpx; line-height: 1.7; word-break: break-all; }
.loading-status { display: flex; align-items: center; gap: 14rpx; padding: 18rpx; margin: 10rpx 0 18rpx; border-radius: 16rpx; color: #4f6fac; background: #eaf0ff; font-size: 24rpx; }
.loading-spinner { width: 24rpx; height: 24rpx; border: 3rpx solid #cadbff; border-top-color: #3265f5; border-radius: 50%; animation: photo-loading .8s linear infinite; }
@keyframes photo-loading { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.card:not(.adjustment):not(.result-card) { margin-top: 18rpx; padding: 20rpx; border-radius: 18rpx; background: #fff; }
.description { margin-top: 14rpx; color: #6e7a89; font-size: 25rpx; line-height: 1.8; }
.offstage, .input-canvas { position: fixed; left: -10000px; top: -10000px; width: 320px; pointer-events: none; }
.input-canvas { width: 1px; height: 1px; }
.requirements-overlay { position: fixed; z-index: 1001; left: 0; top: 0; right: 0; bottom: 0; background: rgba(25,34,48,.34); display: flex; align-items: flex-end; }
.requirements-sheet { width: 100%; padding: 28rpx 36rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fff; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; color: #253247; font-size: 29rpx; font-weight: 600; }
.process-page .sheet-close { width: auto; margin: 0; padding: 10rpx 20rpx; border-radius: 24rpx; background: #eef1f6; color: #5c7196; font-size: 23rpx; font-weight: 500; }
.sheet-content { height: 60vh; margin-top: 16rpx; }
.sheet-section-title { margin-top: 24rpx; font-size: 27rpx; font-weight: 600; color: #344259; }
.sheet-requirement-grid { display: grid; gap: 12rpx; }
.sheet-requirement { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 18rpx; border-radius: 16rpx; background: #f6f8fb; }
.sheet-requirement-icon { flex: none; display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 13rpx; background: #e4ecff; color: #315fc4; font-size: 20rpx; font-weight: 700; }
.sheet-requirement-icon.wide { font-size: 14rpx; letter-spacing: -1rpx; }
.sheet-requirement view { min-width: 0; }
.sheet-requirement view text { display: block; color: #354259; font-size: 24rpx; line-height: 1.45; font-weight: 600; }
.sheet-requirement view text + text { margin-top: 2rpx; color: #7b8695; font-size: 21rpx; font-weight: 400; }
.sheet-guide-grid { display: grid; gap: 12rpx; margin-top: 18rpx; }
.sheet-guide { display: flex; align-items: flex-start; gap: 16rpx; padding: 18rpx; border-radius: 18rpx; background: #f7f8fa; }
.sheet-guide-icon { flex: none; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 15rpx; background: #e6edff; color: #315fc4; font-size: 22rpx; font-weight: 700; }
.sheet-guide-icon.ai { background: #fff2cf; color: #bd8111; font-size: 19rpx; }
.sheet-guide-icon.check { background: #e4f4ed; color: #258362; font-size: 27rpx; }
.sheet-guide view { min-width: 0; }
.sheet-guide view text { display: block; color: #354259; font-size: 24rpx; line-height: 1.45; font-weight: 600; }
.sheet-guide view text + text { margin-top: 4rpx; color: #748091; font-size: 21rpx; line-height: 1.6; font-weight: 400; }
.sheet-product-value { margin-top: 22rpx; padding: 20rpx; border-radius: 18rpx; background: linear-gradient(135deg, #eef4ff 0%, #f7f8ff 100%); border: 1rpx solid #dfe8ff; text-align: center; }
.sheet-product-title { color: #2d4166; font-size: 24rpx; line-height: 1.45; font-weight: 700; }
.sheet-product-flow { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 13rpx; color: #3265c9; font-size: 21rpx; line-height: 1.4; font-weight: 600; }
.sheet-product-flow text:nth-child(2n) { color: #9aabc9; font-size: 27rpx; }
.sheet-product-note { display: block; margin-top: 11rpx; color: #74829a; font-size: 20rpx; line-height: 1.5; }
.diagnostics { margin-top: 24rpx; border-top: 1rpx solid #dce2ea; font-size: 23rpx; color: #64738a; }
.details, .input-facts { margin-top: 12rpx; font-size: 23rpx; line-height: 1.7; color: #64738a; }
.fingerprint { display: block; margin-top: 12rpx; word-break: break-all; font-size: 23rpx; font-family: monospace; }
@media (max-height: 650px) {
  .task-header { padding-top: 12rpx; padding-bottom: 12rpx; }
  .photo-stage { padding-top: 14rpx; padding-bottom: 12rpx; }
  .action-dock { padding-top: 12rpx; }
  .process-page .select-secondary { min-height: 72rpx; }
  .process-page .select-primary { min-height: 78rpx; margin-top: 9rpx; }
  .task-header { padding-left: 28rpx; padding-right: 28rpx; }
  .step-number { width: 38rpx; height: 38rpx; }
  .step-label { font-size: 22rpx; }
  .global-background-switch { margin-bottom: 12rpx; }
  .adjust-action-dock .generate-photo { margin-top: 9rpx; }
}
