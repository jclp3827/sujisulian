.transfer-page { min-height: 100vh; padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); }
.kicker { color: #2f6bff; font-size: 24rpx; font-weight: 700; }
.heading { margin-top: 12rpx; font-size: 48rpx; font-weight: 800; color: #182640; }
.description { margin-top: 16rpx; color: #64738a; font-size: 26rpx; line-height: 1.8; }
.card { margin-top: 28rpx; padding: 30rpx; background: #fff; border: 1rpx solid #e1e8f2; border-radius: 24rpx; }
.card-title { color: #182640; font-size: 31rpx; font-weight: 700; line-height: 1.5; }
button { margin-top: 24rpx; border-radius: 16rpx; font-size: 27rpx; font-weight: 700; }
.primary { color: #fff; background: #2f6bff; }
.secondary { color: #2f6bff; background: #eef4ff; }
.primary[disabled], .secondary[disabled] { background: #eef1f5; color: #a0a9b8; }
.preview { width: 100%; height: 300rpx; margin: 24rpx 0 12rpx; border-radius: 12rpx; background: #f5f7fb; }
.meta { color: #64738a; font-size: 25rpx; text-align: center; }
.status { margin-top: 22rpx; padding: 18rpx; border-radius: 12rpx; color: #54647a; background: #f5f7fb; font-size: 25rpx; line-height: 1.7; }
.success { color: #167648; background: #eaf8ef; }
.export-error { display: block; margin-top: 14rpx; padding: 18rpx; border-radius: 12rpx; color: #a53d2d; background: #fff0ed; font-size: 25rpx; line-height: 1.8; word-break: break-all; }
.notice, .warning { margin-top: 22rpx; color: #87581a; font-size: 25rpx; line-height: 1.8; }
.notice { padding: 24rpx; background: #fff6e8; border-radius: 16rpx; }
.detail-toggle { color: #2f6bff; font-size: 26rpx; }
.fingerprint { display: block; margin-top: 12rpx; overflow-wrap: break-word; word-break: break-all; color: #536378; font-size: 23rpx; line-height: 1.8; font-family: monospace; }
.reset { color: #63728b; background: #f5f7fb; font-weight: 400; }
.footnote { margin: 28rpx 8rpx; color: #8590a2; font-size: 23rpx; line-height: 1.8; }
