.politics-placeholder {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: #fff9f7;
}
.politics-placeholder-card {
  width: 100%;
  padding: 50rpx 36rpx;
  box-sizing: border-box;
  border: 2rpx solid #fff;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #fff, #fff1f1);
  box-shadow: 0 20rpx 50rpx rgba(187, 42, 53, .09);
  text-align: center;
}
.politics-placeholder-mark {
  display: inline-block;
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  background: #ffe0e2;
  color: #c12933;
  font-size: 22rpx;
  font-weight: 750;
}
.politics-placeholder-title {
  margin-top: 25rpx;
  color: #101c35;
  font-size: 38rpx;
  font-weight: 850;
}
.politics-placeholder-desc {
  margin-top: 17rpx;
  color: #68758b;
  font-size: 24rpx;
  line-height: 1.65;
}
.politics-placeholder-back {
  margin-top: 42rpx;
  border-radius: 17rpx;
  background: #f53140;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
}
