.politics-placeholder {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--ui-page-gutter);
  box-sizing: border-box;
  background: var(--ui-color-page);
}
.politics-placeholder-card {
  width: 100%;
  padding: var(--ui-card-padding);
  box-sizing: border-box;
  border: var(--ui-border-width) solid var(--ui-color-border);
  border-radius: var(--ui-radius-card);
  background: var(--ui-color-surface);
  box-shadow: var(--ui-shadow-card);
  text-align: center;
}
.politics-placeholder-title {
  color: var(--ui-color-text);
  font-size: var(--ui-font-page-title);
  font-weight: var(--ui-weight-heading);
}
.politics-placeholder-desc {
  margin-top: var(--space-3);
  color: var(--ui-color-muted);
  font-size: var(--ui-font-description);
  line-height: 1.65;
}
.politics-placeholder-back {
  margin-top: var(--space-6);
  border-radius: var(--ui-radius-control);
  background: var(--ui-color-accent);
  color: var(--text-inverse);
  font-size: var(--ui-button-font);
