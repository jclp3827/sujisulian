<view wx:if="{{point}}" class="politics-detail-page">
  <view class="politics-detail-shell">
    <view class="politics-detail-context">
      <view class="politics-detail-path">{{module.title}} / {{point.category}}</view>
      <view class="politics-detail-position">{{positionText}}</view>
    </view>

    <view class="politics-mode-switch">
      <view class="politics-mode-option {{mode === 'reading' ? 'politics-mode-option-active' : ''}}" data-mode="reading" bindtap="handleModeTap">完整阅读</view>
      <view class="politics-mode-option {{mode === 'recall' ? 'politics-mode-option-active politics-mode-option-recall' : ''}}" data-mode="recall" bindtap="handleModeTap">主动回忆</view>
    </view>

    <view class="politics-detail-hero">
      <view class="politics-detail-kicker">{{mode === 'reading' ? '知识点' : '速记卡 · 先回忆再揭晓'}}</view>
      <view class="politics-detail-title">{{point.title}}</view>
      <view wx:if="{{mode === 'reading'}}" class="politics-detail-summary">{{point.summary}}</view>
    </view>

    <block wx:if="{{mode === 'reading'}}">
      <view class="politics-section politics-relations surface-card" bindtap="handleRelationExplore">
        <view class="politics-relation-head">
          <view>
            <view class="politics-section-title politics-section-title-compact">局部关系</view>
            <view class="politics-relation-hint">围绕当前知识，只展示一层正式关系</view>
          </view>
          <view class="tap-arrow">›</view>
        </view>
        <view class="politics-relation-counts">
          <view wx:for="{{relationCounts}}" wx:key="type" wx:for-item="relation" class="politics-relation-count politics-relation-count-{{relation.type}}">
            <view class="politics-relation-number">{{relation.count}}</view>
            <view>{{relation.label}}</view>
          </view>
        </view>
      </view>

      <view class="politics-section surface-card">
        <view class="politics-section-title">完整内容</view>
        <block wx:for="{{point.contentBlocks}}" wx:key="index" wx:for-item="block">
          <view wx:if="{{block.type === 'heading'}}" class="politics-content-heading">{{block.text}}</view>
          <view wx:elif="{{block.type === 'paragraph'}}" class="politics-paragraph">{{block.text}}</view>
          <view wx:elif="{{block.type === 'list'}}" class="politics-list">
            <view wx:for="{{block.items}}" wx:key="index" wx:for-item="item" class="politics-list-item">
              <view class="politics-list-mark">{{block.ordered ? index + 1 : '•'}}</view>
              <view class="politics-list-text">{{item}}</view>
            </view>
          </view>
        </block>
      </view>

      <view class="politics-section politics-confusion surface-card">
        <view class="politics-section-title">易混与边界</view>
        <block wx:for="{{point.confusionBlocks}}" wx:key="index" wx:for-item="block">
          <view wx:if="{{block.type === 'paragraph'}}" class="politics-paragraph">{{block.text}}</view>
          <view wx:elif="{{block.type === 'list'}}" class="politics-list">
            <view wx:for="{{block.items}}" wx:key="index" wx:for-item="item" class="politics-list-item">
              <view class="politics-list-mark">•</view>
              <view class="politics-list-text">{{item}}</view>
            </view>
          </view>
        </block>
      </view>

      <view class="politics-recall-entry surface-card" data-mode="recall" bindtap="handleModeTap">
        <view>
          <view class="politics-card-kicker">主动回忆</view>
          <view class="politics-recall-entry-title">用速记卡检验这个知识点</view>
        </view>
        <view class="tap-arrow">›</view>
      </view>
    </block>

    <view wx:else class="politics-section politics-card surface-card">
      <view class="politics-card-head">
        <view>
          <view class="politics-card-kicker">提示</view>
          <view class="politics-card-title">{{point.card.prompt}}</view>
        </view>
        <view class="politics-card-count">1 张</view>
      </view>
      <button class="politics-card-toggle" bindtap="handleCardToggle" aria-label="{{cardAnswerVisible ? '收起速记卡答案' : '揭晓速记卡答案'}}">{{cardAnswerVisible ? '收起答案' : '查看答案'}}</button>
      <view wx:if="{{cardAnswerVisible}}" class="politics-card-back">
        <view class="politics-card-label">答案</view>
        <view class="politics-card-answer">{{point.card.answer}}</view>
        <view class="politics-card-pitfall">
          <view class="politics-card-label">易错边界</view>
          <view>{{point.card.pitfall}}</view>
        </view>
      </view>
      <view class="politics-reading-return" data-mode="reading" bindtap="handleModeTap">返回完整知识内容</view>
    </view>

    <view class="politics-source">
      <view>内容版本 v{{point.version}} · 审核日期 {{point.reviewedAt}}</view>
      <view>来源单元：{{point.sourceUnitsText}}</view>
    </view>
  </view>

  <view class="politics-detail-nav">
    <view class="politics-detail-nav-item {{previousPointId ? '' : 'politics-detail-nav-disabled'}}" data-point-id="{{previousPointId}}" bindtap="handleAdjacentTap">‹ 上一篇</view>
    <view class="politics-detail-nav-item politics-detail-nav-map" bindtap="handleMapLocation">地图定位</view>
    <view class="politics-detail-nav-item {{nextPointId ? '' : 'politics-detail-nav-disabled'}}" data-point-id="{{nextPointId}}" bindtap="handleAdjacentTap">下一篇 ›</view>
  </view>
</view>
