<view class="politics-detail-page">
  <view class="politics-detail-shell">
    <knowledge-card-surface
      id="knowledge-card"
      card="{{cardSurface}}"
      recall-view="{{recallView}}"
      display-preferences="{{displayPreferences}}"
      bind:blocktap="handleBlockTap"
      bind:relationtap="handleRelationTap"
      bind:startrecall="handleStartRecall"
      bind:reveal="handleReveal"
      bind:recallresult="handleRecallResult"
      bind:backtoreading="handleBackToReading"
      bind:display="handleDisplay"
      bind:sourcefeedback="handleSourceFeedback"
    />
  </view>

  <view wx:if="{{correctionVisible}}" class="politics-correction-mask" bindtap="handleCorrectionClose">
    <view class="politics-correction-sheet" catchtap="handleSheetTap">
      <view class="politics-correction-sheet-head"><view><view class="politics-correction-sheet-title">提交内容反馈</view><view class="politics-correction-sheet-meta">{{cardSurface.identity.title}}</view></view><view class="politics-correction-close" bindtap="handleCorrectionClose">×</view></view>
      <view class="politics-correction-type-list"><view wx:for="{{correctionTypes}}" wx:key="*this" class="politics-correction-type {{correctionType === item ? 'politics-correction-type-active' : ''}}" data-type="{{item}}" bindtap="handleCorrectionTypeTap">{{item}}</view></view>
      <textarea class="politics-correction-input" value="{{correctionDescription}}" maxlength="300" auto-height placeholder="简要说明哪里不准确，以及建议如何修改" bindinput="handleCorrectionInput" />
      <view class="politics-correction-local-note">反馈仅保存在当前设备。</view>
      <button class="politics-correction-save" bindtap="handleCorrectionSave">保存反馈</button>
    </view>
  </view>
</view>
