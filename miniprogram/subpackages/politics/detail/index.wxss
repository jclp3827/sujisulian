.politics-detail-page { min-height: 100vh; background: var(--bg-page-accent); }
.politics-detail-shell { min-height: 100vh; padding: 24rpx 24rpx calc(170rpx + env(safe-area-inset-bottom)); }
.politics-detail-context { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: var(--text-tertiary); font-size: 20rpx; line-height: 1.4; }
.politics-detail-path { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.politics-detail-position { flex: none; font-weight: 700; }
.politics-focus-switch { position: sticky; top: 0; z-index: 8; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6rpx; margin: 18rpx -4rpx 0; padding: 7rpx; border: 1rpx solid rgba(148, 163, 184, .12); border-radius: 20rpx; background: rgba(245, 247, 250, .94); backdrop-filter: blur(16rpx); }
.politics-focus-option { min-width: 0; padding: 15rpx 4rpx; border-radius: 14rpx; color: var(--text-tertiary); font-size: 22rpx; line-height: 1.25; font-weight: 700; text-align: center; }
.politics-focus-option-active { background: var(--bg-card); color: var(--color-primary-500); box-shadow: 0 5rpx 16rpx rgba(15, 23, 42, .07); }
.politics-focus-option-system.politics-focus-option-active { color: var(--color-green-700); }
.politics-focus-option-relations.politics-focus-option-active { color: var(--color-orange-700); }
.politics-focus-option-recall.politics-focus-option-active { color: var(--color-purple-500); }
.politics-detail-hero { padding: 28rpx 2rpx 26rpx; }
.politics-detail-kicker { color: var(--color-primary-500); font-size: 21rpx; line-height: 1.45; font-weight: 700; }
.politics-detail-kicker-system { color: var(--color-green-700); }
.politics-detail-kicker-relations { color: var(--color-orange-700); }
.politics-detail-kicker-recall { color: var(--color-purple-500); }
.politics-detail-title { margin-top: 9rpx; color: var(--text-primary); font-size: 46rpx; line-height: 1.23; font-weight: 750; }
.politics-detail-meta { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 16rpx; }
.politics-detail-meta view { padding: 6rpx 11rpx; border-radius: 999rpx; background: rgba(148, 163, 184, .11); color: var(--text-tertiary); font-size: 18rpx; line-height: 1.3; }
.politics-detail-meta .politics-review-state { background: var(--bg-soft-orange); color: var(--color-orange-700); font-weight: 700; }
.politics-detail-meta .politics-review-state-approved { background: var(--bg-soft-green); color: var(--color-green-700); }
.politics-detail-meta .politics-risk-state { background: var(--bg-soft-purple); color: var(--color-purple-500); font-weight: 700; }
.politics-section,
.politics-system-summary,
.politics-reading-summary,
.politics-evidence,
.politics-relation-focus,
.politics-focus-next { margin-bottom: 20rpx; padding: 26rpx 22rpx; }
.politics-section-eyebrow { margin-bottom: 8rpx; font-size: 19rpx; line-height: 1.35; font-weight: 800; letter-spacing: 1rpx; }
.politics-color-system { color: var(--color-green-700); }
.politics-color-reading { color: var(--color-primary-500); }
.politics-color-relation,
.politics-color-boundary { color: var(--color-orange-700); }
.politics-color-evidence { color: var(--text-tertiary); }
.politics-section-title { margin-bottom: 20rpx; color: var(--text-primary); font-size: 31rpx; line-height: 1.35; font-weight: 750; }
.politics-section-title-compact { margin-bottom: 4rpx; }
.politics-section-hint { color: var(--text-tertiary); font-size: 20rpx; line-height: 1.45; }
.politics-section-head-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.politics-system-summary { border-color: rgba(51, 196, 122, .2); }
.politics-system-path { color: var(--text-primary); font-size: 26rpx; line-height: 1.6; font-weight: 700; }
.politics-system-path text { color: var(--color-green-500); }
.politics-system-summary-text { margin-top: 14rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.7; }
.politics-map-link { flex: none; padding: 8rpx 12rpx; border-radius: 999rpx; background: var(--bg-soft-green); color: var(--color-green-700); font-size: 19rpx; font-weight: 700; }
.politics-system-layers { margin-top: 24rpx; }
.politics-system-layer + .politics-system-layer { margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid var(--border-subtle); }
.politics-system-layer-label { display: inline-block; margin-bottom: 11rpx; padding: 5rpx 10rpx; border-radius: 999rpx; background: var(--bg-soft-green); color: var(--color-green-700); font-size: 18rpx; line-height: 1.3; font-weight: 700; }
.politics-system-nodes { display: flex; flex-direction: column; gap: 10rpx; }
.politics-system-node { display: flex; align-items: center; gap: 12rpx; padding: 15rpx; border: 1rpx solid var(--border-subtle); border-radius: 14rpx; background: var(--bg-page-accent); }
.politics-system-node-current { border-color: rgba(51, 196, 122, .35); background: var(--bg-soft-green); }
.politics-system-node-mark { flex: none; padding: 5rpx 8rpx; border-radius: 8rpx; background: rgba(148, 163, 184, .12); color: var(--text-tertiary); font-size: 17rpx; font-weight: 700; }
.politics-system-node-current .politics-system-node-mark { background: rgba(51, 196, 122, .14); color: var(--color-green-700); }
.politics-system-node-title { flex: 1; min-width: 0; color: var(--text-secondary); font-size: 23rpx; line-height: 1.45; font-weight: 650; }
.politics-focus-next { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-color: rgba(47, 107, 255, .14); }
.politics-focus-next-title { color: var(--text-primary); font-size: 25rpx; line-height: 1.45; font-weight: 700; }
.politics-reading-summary { border-color: rgba(47, 107, 255, .16); background: linear-gradient(135deg, var(--bg-card), var(--bg-soft-blue)); }
.politics-detail-summary { color: var(--text-secondary); font-size: 26rpx; line-height: 1.75; }
.politics-outline { margin: 0 -24rpx 20rpx; }
.politics-outline-label { padding: 0 24rpx 9rpx; color: var(--text-tertiary); font-size: 19rpx; font-weight: 700; }
.politics-outline-scroll { width: 100%; white-space: nowrap; }
.politics-outline-track { display: inline-flex; gap: 10rpx; padding: 0 24rpx; }
.politics-outline-item { display: inline-block; padding: 11rpx 15rpx; border: 1rpx solid rgba(47, 107, 255, .14); border-radius: 999rpx; background: var(--bg-card); color: var(--color-primary-500); font-size: 20rpx; line-height: 1.3; font-weight: 700; }
.politics-reading-body { border-color: rgba(47, 107, 255, .1); }
.politics-content-heading { scroll-margin-top: 120rpx; margin: 34rpx -2rpx 15rpx; padding-left: 16rpx; border-left: 6rpx solid var(--color-primary-500); color: var(--text-primary); font-size: 28rpx; line-height: 1.45; font-weight: 750; }
.politics-section-title + .politics-content-heading { margin-top: 0; }
.politics-paragraph { scroll-margin-top: 120rpx; margin-bottom: 17rpx; color: var(--text-secondary); font-size: 26rpx; line-height: 1.78; white-space: pre-line; }
.politics-list { scroll-margin-top: 120rpx; display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 20rpx; padding: 17rpx; border-radius: 14rpx; background: rgba(47, 107, 255, .045); }
.politics-list-sequence { background: rgba(51, 196, 122, .07); }
.politics-list-item { display: flex; align-items: flex-start; gap: 12rpx; }
.politics-list-mark { flex: none; min-width: 30rpx; color: var(--color-primary-500); font-size: 23rpx; line-height: 1.75; font-weight: 800; text-align: center; }
.politics-list-sequence .politics-list-mark { color: var(--color-green-700); }
.politics-list-text { flex: 1; min-width: 0; color: var(--text-secondary); font-size: 25rpx; line-height: 1.75; }
.politics-confusion { border-color: var(--border-orange); background: linear-gradient(135deg, var(--bg-card), var(--bg-soft-orange)); }
.politics-confusion .politics-list { background: rgba(255, 166, 43, .07); }
.politics-confusion .politics-list-mark { color: var(--color-orange-700); }
.politics-evidence { border-color: var(--border-subtle); }
.politics-evidence-title { color: var(--text-primary); font-size: 25rpx; line-height: 1.4; font-weight: 700; }
.politics-evidence-action { flex: none; color: var(--text-tertiary); font-size: 20rpx; font-weight: 700; }
.politics-source-detail { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--border-subtle); color: var(--text-tertiary); font-size: 20rpx; line-height: 1.75; word-break: break-all; }
.politics-source-risk { color: var(--color-purple-500); font-weight: 700; }
.politics-correction { margin-bottom: 20rpx; padding: 24rpx 22rpx; border-color: rgba(255, 166, 43, .16); }
.politics-color-correction { color: var(--color-orange-700); }
.politics-correction-title { color: var(--text-primary); font-size: 25rpx; line-height: 1.45; font-weight: 750; }
.politics-correction-hint { margin-top: 7rpx; color: var(--text-tertiary); font-size: 20rpx; line-height: 1.6; }
.politics-correction-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.politics-correction-button { flex: 1; min-width: 0; min-height: 68rpx; padding: 0 12rpx; border-radius: 14rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 20rpx; line-height: 68rpx; font-weight: 700; }
.politics-correction-button::after { border: 0; }
.politics-correction-button-primary { background: var(--bg-soft-orange); color: var(--color-orange-700); }
.politics-correction-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(15, 23, 42, .42); }
.politics-correction-sheet { width: 100%; padding: 28rpx 26rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: var(--bg-card); box-shadow: 0 -14rpx 44rpx rgba(15, 23, 42, .16); }
.politics-correction-sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.politics-correction-sheet-title { color: var(--text-primary); font-size: 30rpx; line-height: 1.4; font-weight: 750; }
.politics-correction-sheet-meta { margin-top: 5rpx; color: var(--text-tertiary); font-size: 18rpx; line-height: 1.45; }
.politics-correction-close { flex: none; width: 54rpx; height: 54rpx; border-radius: 50%; background: var(--bg-page-accent); color: var(--text-tertiary); font-size: 36rpx; line-height: 50rpx; text-align: center; }
.politics-correction-type-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 24rpx; }
.politics-correction-type { padding: 10rpx 14rpx; border: 1rpx solid var(--border-subtle); border-radius: 999rpx; color: var(--text-secondary); font-size: 20rpx; line-height: 1.3; font-weight: 700; }
.politics-correction-type-active { border-color: rgba(255, 166, 43, .35); background: var(--bg-soft-orange); color: var(--color-orange-700); }
.politics-correction-input { box-sizing: border-box; width: 100%; min-height: 170rpx; margin-top: 20rpx; padding: 18rpx; border: 1rpx solid var(--border-subtle); border-radius: 16rpx; background: var(--bg-page-accent); color: var(--text-primary); font-size: 23rpx; line-height: 1.65; }
.politics-correction-local-note { margin-top: 13rpx; color: var(--text-tertiary); font-size: 18rpx; line-height: 1.5; }
.politics-correction-save { width: 100%; min-height: 76rpx; margin-top: 19rpx; border-radius: 16rpx; background: var(--color-orange-700); color: #fff; font-size: 23rpx; line-height: 76rpx; font-weight: 750; }
.politics-correction-save::after { border: 0; }
.politics-relation-focus { border-color: rgba(255, 166, 43, .2); background: linear-gradient(135deg, var(--bg-card), var(--bg-soft-orange)); }
.politics-relation-focus-title { color: var(--text-primary); font-size: 30rpx; line-height: 1.4; font-weight: 750; }
.politics-relation-focus-summary { margin-top: 10rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.65; }
.politics-trail { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; padding: 14rpx 16rpx; border-radius: 14rpx; background: var(--bg-soft-blue); }
.politics-trail-label { flex: none; color: var(--text-tertiary); font-size: 18rpx; font-weight: 700; }
.politics-trail-copy { min-width: 0; overflow: hidden; color: var(--color-primary-500); font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.politics-relation-group + .politics-relation-group { margin-top: 22rpx; }
.politics-relation-label { display: inline-block; margin-bottom: 10rpx; padding: 6rpx 12rpx; border-radius: 999rpx; background: var(--bg-soft-blue); color: var(--color-primary-500); font-size: 19rpx; line-height: 1.3; font-weight: 700; }
.politics-relation-label-prerequisites { background: var(--bg-soft-green); color: var(--color-green-700); }
.politics-relation-label-contrasts { background: var(--bg-soft-orange); color: var(--color-orange-700); }
.politics-relation-label-subsequent { background: var(--bg-soft-purple); color: var(--color-purple-500); }
.politics-relation-list { overflow: hidden; border: 1rpx solid var(--border-subtle); border-radius: var(--radius-md); }
.politics-relation-item { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 17rpx; background: var(--bg-card); }
.politics-relation-item + .politics-relation-item { border-top: 1rpx solid var(--border-subtle); }
.politics-relation-copy { flex: 1; min-width: 0; }
.politics-relation-title { color: var(--text-primary); font-size: 26rpx; line-height: 1.4; font-weight: 750; }
.politics-relation-why { margin-top: 7rpx; color: var(--color-orange-700); font-size: 21rpx; line-height: 1.55; }
.politics-relation-summary { margin-top: 6rpx; color: var(--text-tertiary); font-size: 20rpx; line-height: 1.5; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.politics-relation-empty { padding: 40rpx 26rpx; color: var(--text-tertiary); font-size: 23rpx; line-height: 1.65; text-align: center; }
.politics-card { border-color: rgba(124, 92, 255, .16); background: linear-gradient(145deg, var(--bg-card), rgba(124, 92, 255, .04)); }
.politics-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; }
.politics-card-kicker { color: var(--color-purple-500); font-size: 20rpx; line-height: 1.35; font-weight: 800; }
.politics-card-title { margin-top: 7rpx; color: var(--text-primary); font-size: 29rpx; line-height: 1.5; font-weight: 750; }
.politics-card-count { flex: none; padding: 6rpx 11rpx; border-radius: 999rpx; background: var(--bg-soft-purple); color: var(--color-purple-500); font-size: 18rpx; font-weight: 700; }
.politics-card-label { margin-bottom: 8rpx; color: var(--color-purple-500); font-size: 20rpx; line-height: 1.35; font-weight: 700; }
.politics-card-toggle { width: 100%; min-height: 76rpx; border-radius: var(--radius-md); background: var(--bg-soft-purple); color: var(--color-purple-500); font-size: 24rpx; line-height: 76rpx; font-weight: 750; }
.politics-card-toggle::after { border: 0; }
.politics-card-back { margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid var(--border-subtle); }
.politics-card-answer { color: var(--text-secondary); font-size: 26rpx; line-height: 1.75; }
.politics-card-pitfall { margin-top: 18rpx; padding: 17rpx; border-radius: var(--radius-sm); background: var(--bg-soft-orange); color: var(--color-orange-700); font-size: 23rpx; line-height: 1.65; }
.politics-card-pitfall .politics-card-label { color: var(--color-orange-700); }
.politics-reading-return { margin-top: 24rpx; color: var(--color-primary-500); font-size: 23rpx; line-height: 1.4; font-weight: 700; text-align: center; }
.politics-detail-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border-subtle); background: rgba(255, 255, 255, .96); backdrop-filter: blur(16rpx); }
.politics-detail-nav-item { min-width: 0; padding: 20rpx 8rpx; border-radius: 16rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 22rpx; line-height: 1.3; font-weight: 700; text-align: center; }
.politics-detail-nav-map { background: var(--bg-soft-green); color: var(--color-green-700); }
.politics-detail-nav-disabled { opacity: .32; }

@media (max-width: 340px) {
  .politics-detail-shell { padding-left: 18rpx; padding-right: 18rpx; }
  .politics-focus-option { font-size: 20rpx; }
  .politics-detail-title { font-size: 41rpx; }
}
