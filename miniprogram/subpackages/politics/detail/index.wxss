.workbench-list-toggle { min-height: 88rpx; display: flex; align-items: center; justify-content: center; padding: 18rpx; border-radius: 15rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 21rpx; line-height: 1.4; font-weight: 750; text-align: center; box-sizing: border-box; }
.workbench-preview-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(15, 23, 42, .43); }
.workbench-preview-sheet { width: 100%; max-height: 80vh; overflow-y: auto; padding: 28rpx 26rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: var(--bg-card); box-shadow: 0 -14rpx 44rpx rgba(15, 23, 42, .16); box-sizing: border-box; }
.workbench-preview-head { display: flex; align-items: flex-start; justify-content: space-between; }
.workbench-preview-title { margin-top: 10rpx; color: var(--text-primary); font-size: 34rpx; line-height: 1.35; font-weight: 760; }
.workbench-preview-path { margin-top: 8rpx; color: var(--text-tertiary); font-size: 18rpx; line-height: 1.5; }
.workbench-preview-reason { margin-top: 20rpx; padding: 15rpx; border-radius: 14rpx; background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: 21rpx; line-height: 1.55; }
.workbench-preview-summary { margin-top: 17rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.65; }
.workbench-preview-primary { width: 100%; min-height: 88rpx; margin-top: 24rpx; border-radius: 16rpx; background: var(--knowledge-reading-text); color: #fff; font-size: 21rpx; line-height: 88rpx; font-weight: 800; }
.workbench-preview-primary::after { border: 0; }
.workbench-preview-more { min-height: 72rpx; display: flex; align-items: center; justify-content: center; color: var(--text-secondary); font-size: 19rpx; font-weight: 750; }
.workbench-preview-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; }
.workbench-preview-actions button { min-width: 0; min-height: 88rpx; padding: 0 6rpx; border-radius: 14rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 19rpx; line-height: 1.35; font-weight: 750; }
.workbench-preview-actions button::after { border: 0; }
.workbench-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 7rpx; padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border-subtle); background: rgba(255, 255, 255, .96); backdrop-filter: blur(16rpx); }
.workbench-dock-item { display: flex; align-items: center; justify-content: center; gap: 7rpx; min-width: 0; min-height: 88rpx; padding: 14rpx 4rpx; border-radius: 15rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.3; font-weight: 750; box-sizing: border-box; }
.workbench-dock-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: currentColor; opacity: .45; }
.workbench-dock-active { background: var(--bg-soft-blue); color: var(--knowledge-reading-text); }
.workbench-dock-system.workbench-dock-active { background: var(--bg-soft-green); color: var(--knowledge-system-text); }
.workbench-dock-relations.workbench-dock-active { background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); }
.workbench-dock-recall.workbench-dock-active { background: var(--bg-soft-purple); color: var(--knowledge-recall-text); }

/* S3B semantic reading */
.reading-toolbar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7rpx; margin-bottom: 10rpx; padding: 9rpx; }
.reading-toolbar-action { min-width: 0; min-height: 88rpx; display: flex; align-items: center; justify-content: center; padding: 12rpx 4rpx; border-radius: 13rpx; color: var(--text-secondary); font-size: 18rpx; line-height: 1.35; font-weight: 700; text-align: center; box-sizing: border-box; }
.reading-toolbar-active { background: var(--bg-soft-blue); color: var(--knowledge-reading-text); }
.reading-settings { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; margin-bottom: 20rpx; padding: 10rpx; }
.reading-settings-action { min-height: 80rpx; display: flex; align-items: center; justify-content: center; padding: 12rpx; border-radius: 13rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 19rpx; line-height: 1.35; font-weight: 700; text-align: center; box-sizing: border-box; }
.reading-source-return { display: inline-block; max-width: 100%; margin-bottom: 16rpx; padding: 11rpx 15rpx; border-radius: 999rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 20rpx; line-height: 1.35; font-weight: 750; }
.reading-article { margin: 0 -2rpx 20rpx; padding: 30rpx 24rpx; border: 1rpx solid rgba(47, 107, 255, .08); border-radius: 24rpx; background: var(--bg-card); }
.reading-semantic-block { position: relative; scroll-margin-top: 150rpx; border-radius: 14rpx; transition: background-color 160ms ease, border-color 160ms ease; }
.reading-semantic-block + .reading-semantic-block { margin-top: 8rpx; }
.reading-block-active { background: rgba(47, 107, 255, .055); }
.reading-semantic-label { display: inline-block; margin: 5rpx 0 8rpx; padding: 5rpx 10rpx; border-radius: 999rpx; font-size: 17rpx; line-height: 1.25; font-weight: 800; }
.reading-semantic-label-reading { background: var(--bg-soft-blue); color: var(--knowledge-reading-text); }
.reading-semantic-label-system { background: var(--bg-soft-green); color: var(--knowledge-system-text); }
.reading-semantic-label-boundary { background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); }
.reading-semantic-label-evidence { background: var(--bg-page-accent); color: var(--text-secondary); }
.reading-semantic-definition,
.reading-semantic-conclusion { margin: 20rpx 0; padding: 18rpx 18rpx 3rpx; border-left: 5rpx solid var(--knowledge-reading-text); background: var(--bg-soft-blue); }
.reading-semantic-hierarchy,
.reading-semantic-sequence { margin: 18rpx 0; padding: 18rpx 18rpx 3rpx; border-left: 5rpx solid var(--knowledge-system-text); background: var(--bg-soft-green); }
.reading-semantic-condition,
.reading-semantic-exception,
.reading-semantic-contrast { margin: 20rpx 0; padding: 18rpx 18rpx 3rpx; border: 1rpx solid var(--border-orange); background: var(--bg-soft-orange); }
.reading-semantic-evidence { margin: 18rpx 0; padding: 18rpx 18rpx 3rpx; border: 1rpx solid var(--border-subtle); background: var(--bg-page-accent); }
.reading-emphasis-keyPoints .reading-key-point { border-width: 3rpx; box-shadow: inset 7rpx 0 0 rgba(47, 107, 255, .18); }
.reading-emphasis-keyPoints .reading-semantic-condition,
.reading-emphasis-keyPoints .reading-semantic-exception,
.reading-emphasis-keyPoints .reading-semantic-contrast { box-shadow: inset 7rpx 0 0 rgba(180, 83, 9, .2); }
.reading-font-large .politics-paragraph,
.reading-font-large .politics-list-text,
.reading-font-large .reading-quote,
.reading-font-large .reading-callout,
.reading-font-large .reading-table-value,
.reading-font-large .reading-media-fallback,
.reading-font-large .reading-fallback { font-size: 30rpx; }
.reading-font-extraLarge .politics-paragraph,
.reading-font-extraLarge .politics-list-text,
.reading-font-extraLarge .reading-quote,
.reading-font-extraLarge .reading-callout,
.reading-font-extraLarge .reading-table-value,
.reading-font-extraLarge .reading-media-fallback,
.reading-font-extraLarge .reading-fallback { font-size: 34rpx; }
.reading-density-compact .politics-system-summary,
.reading-density-compact .politics-reading-summary,
.reading-density-compact .politics-evidence,
.reading-density-compact .politics-relation-focus,
.reading-density-compact .politics-focus-next,
.reading-density-compact .politics-section { margin-bottom: 12rpx; padding: 20rpx 18rpx; }
.reading-motion-reduced .reading-semantic-block { transition-duration: 0ms; }
.reading-line-relaxed .politics-paragraph,
.reading-line-relaxed .politics-list-text,
.reading-line-relaxed .reading-quote,
.reading-line-relaxed .reading-callout { line-height: 2; }
.reading-quote { margin: 15rpx 0; padding: 18rpx 20rpx; border-left: 6rpx solid var(--text-tertiary); background: var(--bg-page-accent); color: var(--text-secondary); font-size: 26rpx; line-height: 1.78; }
.reading-callout { margin: 15rpx 0; padding: 18rpx 20rpx; border: 1rpx solid var(--border-subtle); border-radius: 14rpx; color: var(--text-secondary); font-size: 26rpx; line-height: 1.78; }
.reading-media-fallback,
.reading-fallback { margin: 15rpx 0; color: var(--text-secondary); font-size: 26rpx; line-height: 1.78; white-space: pre-line; }
.reading-table { display: flex; flex-direction: column; gap: 13rpx; margin: 16rpx 0 22rpx; }
.reading-table-row { overflow: hidden; border: 1rpx solid var(--border-subtle); border-radius: 14rpx; }
.reading-table-cell { display: grid; grid-template-columns: minmax(130rpx, .7fr) minmax(0, 1.3fr); }
.reading-table-cell + .reading-table-cell { border-top: 1rpx solid var(--border-subtle); }
.reading-table-label { padding: 13rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 20rpx; line-height: 1.5; font-weight: 750; }
.reading-table-value { min-width: 0; padding: 13rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.6; word-break: break-word; }
.reading-load-more { width: 100%; min-height: 74rpx; margin-top: 24rpx; border-radius: 16rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 21rpx; line-height: 74rpx; font-weight: 750; }
.reading-load-more::after { border: 0; }
.reading-focus-mode .politics-detail-shell { padding-top: 102rpx; padding-bottom: calc(34rpx + env(safe-area-inset-bottom)); }
.reading-focus-bar { position: fixed; top: 0; left: 0; right: 0; z-index: 18; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx 24rpx; border-bottom: 1rpx solid var(--border-subtle); background: rgba(255, 255, 255, .97); backdrop-filter: blur(16rpx); }
.reading-focus-identity { min-width: 0; overflow: hidden; color: var(--text-primary); font-size: 21rpx; line-height: 1.4; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.reading-focus-exit { flex: none; min-height: 72rpx; display: flex; align-items: center; padding: 11rpx 15rpx; border-radius: 999rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 19rpx; line-height: 1.3; font-weight: 750; }
.reading-focus-shortcut { position: fixed; right: 24rpx; bottom: calc(126rpx + env(safe-area-inset-bottom)); z-index: 9; min-height: 88rpx; display: flex; align-items: center; padding: 15rpx 20rpx; border: 1rpx solid rgba(47, 107, 255, .18); border-radius: 999rpx; background: rgba(255, 255, 255, .96); color: var(--knowledge-reading-text); font-size: 20rpx; line-height: 1.3; font-weight: 750; box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, .12); box-sizing: border-box; }
.workbench-preview-evidence-note { margin-top: 15rpx; color: var(--text-tertiary); font-size: 19rpx; line-height: 1.55; }
.workbench-preview-evidence { width: 100%; min-height: 70rpx; margin-top: 12rpx; border-radius: 14rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 20rpx; line-height: 70rpx; font-weight: 750; }
.workbench-preview-evidence::after { border: 0; }

@media (max-width: 340px) {
  .politics-detail-shell { padding-left: 18rpx; padding-right: 18rpx; }
  .politics-focus-option { font-size: 20rpx; }
  .politics-detail-title { font-size: 41rpx; }
}
.politics-detail-error { padding: 32rpx 24rpx; }
.politics-detail-error-title { color: var(--text-primary); font-size: 30rpx; font-weight: 800; }
.politics-detail-error-copy { margin-top: 12rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.6; }
.politics-detail-error-action { margin-top: 24rpx; border: 0; border-radius: 16rpx; background: var(--knowledge-reading-text); color: #fff; font-size: 22rpx; font-weight: 800; }
