<view class="politics-map-page">
  <view class="politics-map-shell">
    <view class="politics-map-hero">
      <view class="politics-map-kicker">体系地图 · {{mapLevel === 'overview' ? '总览层' : '分支层'}}</view>
      <view class="politics-map-title">{{module.title}}</view>
      <view class="politics-map-desc">先看完整结构，再逐层展开。点击节点进入焦点预览，无需缩放也能到达全部知识。</view>
      <view class="politics-map-legend">
        <view class="politics-map-legend-item"><view class="politics-map-dot"></view>绿色表示体系与前置</view>
        <view class="politics-map-legend-item"><view class="politics-map-badge">点</view>点击节点预览</view>
      </view>
    </view>

    <view class="politics-map-controls">
      <view class="politics-map-control {{mapLevel === 'overview' ? 'politics-map-control-active' : ''}}" bindtap="handleMapOverviewTap">总览</view>
      <view class="politics-map-control {{selectedPointId ? '' : 'politics-map-control-disabled'}}" bindtap="handleCurrentTap">回到当前</view>
      <view class="politics-map-control politics-map-control-recall {{recallMasked ? 'politics-map-control-recall-active' : ''}}" bindtap="handleMapRecallToggle">{{recallMasked ? '显示节点' : '地图回忆'}}</view>
      <view class="politics-map-control-label">{{mapLevel === 'overview' ? module.pointCount + ' 个知识点' : activeCategory.title}}</view>
    </view>

    <view wx:if="{{mapLevel === 'overview'}}" class="politics-map-overview">
      <view class="politics-map-module surface-card">
        <view class="politics-map-module-mark">总</view>
        <view class="politics-map-module-copy">
          <view class="politics-map-module-title">{{module.title}}</view>
          <view class="politics-map-module-desc">{{categoryCards.length}} 个目录分支 · {{module.pointCount}} 个全量联调知识点</view>
        </view>
      </view>
      <view class="politics-map-trunk"></view>
      <view class="politics-map-category-list">
        <view wx:for="{{categoryCards}}" wx:key="id" class="politics-map-category-card surface-card" data-category-id="{{item.id}}" bindtap="handleCategoryTap">
          <view class="politics-map-category-index">{{index + 1}}</view>
          <view class="politics-map-category-copy">
            <view class="politics-map-category-title">{{item.title}}</view>
              <view class="politics-map-category-meta">{{item.pathLabel}}</view>
              <view class="politics-map-category-meta">{{item.pointCount}} 个知识单元 · {{item.layerCount}} 层学习结构</view>
          </view>
          <view class="tap-arrow">›</view>
        </view>
      </view>
    </view>

    <view wx:else class="politics-map-branch">
      <view class="politics-map-branch-head">
        <view class="politics-map-branch-eyebrow">当前目录分支</view>
        <view class="politics-map-branch-title">{{activeCategory.title}}</view>
        <view class="politics-map-branch-hint">当前分支来自 PDF 正式目录；同层节点按原目录顺序连续阅读。</view>
      </view>
      <view class="politics-map-rail"></view>
      <view wx:for="{{activeCategory.layers}}" wx:key="depth" wx:for-item="layer" class="politics-map-layer">
        <view class="politics-map-layer-label">{{layer.label}}</view>
        <view class="politics-map-node-grid">
          <view
            wx:for="{{layer.points}}"
            wx:key="id"
            wx:for-item="point"
            id="map-node-{{point.id}}"
            class="politics-map-node surface-card {{selectedPointId === point.id ? 'politics-map-node-active' : ''}} {{recallMasked ? 'politics-map-node-masked' : ''}}"
            data-point-id="{{point.id}}"
            bindtap="handlePointTap"
          >
            <view class="politics-map-node-topline">
              <view class="politics-map-node-depth">D{{point.mapDepth || 0}}</view>
              <view class="politics-map-node-state {{point.publishable ? 'politics-map-node-state-approved' : ''}}">{{point.statusLabel}}</view>
            </view>
            <view wx:if="{{point.riskLabel && !recallMasked}}" class="politics-map-node-risk">{{point.riskLabel}}</view>
            <view class="politics-map-node-title">{{recallMasked ? point.recallLabel : point.title}}</view>
            <view class="politics-map-node-summary">{{recallMasked ? '根据所在层级，先回忆这里对应的知识点。' : point.summary}}</view>
          </view>
        </view>
        <view wx:if="{{index < activeCategory.layers.length - 1}}" class="politics-map-rail politics-map-rail-short"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{previewVisible}}" class="politics-preview-mask" bindtap="handlePreviewClose"></view>
  <view wx:if="{{previewVisible}}" class="politics-preview-sheet">
    <view class="politics-preview-handle"></view>
    <view class="politics-preview-topline">
      <view class="politics-preview-kicker">{{relationMode ? '局部关系 · 一层探索' : '焦点层 · 节点预览'}}</view>
      <view class="politics-preview-close" bindtap="handlePreviewClose">关闭</view>
    </view>

    <block wx:if="{{!relationMode && recallMasked && !nodeAnswerVisible}}">
      <view class="politics-recall-preview">
        <view class="politics-recall-preview-mark">忆</view>
        <view class="politics-recall-preview-title">这个位置对应什么知识点？</view>
        <view class="politics-recall-preview-hint">线索：{{selectedPoint.category}} · 前置深度 {{selectedPoint.mapDepth || 0}} · {{selectedPoint.relationCount}} 条关系</view>
        <button class="politics-recall-preview-reveal" bindtap="handleNodeAnswerReveal">揭晓节点</button>
      </view>
    </block>

    <block wx:elif="{{!relationMode}}">
      <view class="politics-preview-path">{{selectedPoint.hierarchyText}}</view>
      <view class="politics-preview-title">{{selectedPoint.title}}</view>
      <view class="politics-preview-summary">{{selectedPoint.summary}}</view>
      <view class="politics-preview-facts">
        <view class="politics-preview-review-state">{{selectedPoint.statusLabel}}</view>
        <view wx:if="{{selectedPoint.riskLabel}}" class="politics-preview-risk-state">{{selectedPoint.riskLabel}}</view>
        <view>{{selectedPoint.relationCount}} 条一层关系</view>
        <view>版本 v{{selectedPoint.version}}</view>
      </view>
      <view class="politics-preview-actions">
        <button class="politics-preview-action politics-preview-action-system" data-mode="system" bindtap="handleOpenFocusMode">体系定位</button>
        <button class="politics-preview-action politics-preview-action-primary" data-mode="reading" bindtap="handleOpenFocusMode">完整阅读</button>
        <button class="politics-preview-action politics-preview-action-relation" bindtap="handleRelationsTap">查看关系</button>
        <button class="politics-preview-action politics-preview-action-recall" data-mode="recall" bindtap="handleOpenFocusMode">主动回忆</button>
      </view>
    </block>

    <block wx:else>
      <view class="politics-relation-focus">{{selectedPoint.title}}</view>
      <view wx:if="{{relationGroups.length}}" class="politics-relation-groups">
        <view wx:for="{{relationGroups}}" wx:key="type" wx:for-item="group" class="politics-relation-group">
          <view class="politics-relation-label politics-relation-label-{{group.type}}">{{group.label}}</view>
          <view class="politics-relation-nodes">
            <view wx:for="{{group.items}}" wx:key="id" wx:for-item="relationPoint" class="politics-relation-node" data-point-id="{{relationPoint.id}}" bindtap="handleRelationPointTap">
              <view class="politics-relation-node-title">{{relationPoint.title}}</view>
              <view class="politics-relation-node-why">{{relationPoint.why}}</view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="politics-relation-empty">当前正式知识中暂无已确认关系。</view>
      <view class="politics-preview-actions politics-preview-actions-two">
        <button class="politics-preview-action" bindtap="handlePreviewSummaryTap">返回摘要</button>
        <button class="politics-preview-action politics-preview-action-relation" data-mode="relations" bindtap="handleOpenFocusMode">进入关系工作台</button>
      </view>
    </block>
  </view>
</view>
