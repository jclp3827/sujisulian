.knowledge-directory-copy { flex: 1; min-width: 0; }
.knowledge-directory-item-title { color: var(--text-primary); font-size: 22rpx; line-height: 1.45; font-weight: 750; }
.knowledge-directory-arrow { flex: none; color: var(--knowledge-reading-text); font-size: 31rpx; }
.knowledge-relation-mask { position: fixed; inset: 0; z-index: 20; background: rgba(15, 23, 42, .43); }
.knowledge-relation-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; max-height: 78vh; overflow-y: auto; padding: 16rpx 25rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: var(--bg-card); box-shadow: 0 -14rpx 44rpx rgba(15, 23, 42, .16); box-sizing: border-box; }
.knowledge-card-context { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.knowledge-card-context-label,
.knowledge-section-label { color: var(--knowledge-reading-text); font-size: 19rpx; line-height: 1.4; font-weight: 800; }
.knowledge-card-close { min-width: 88rpx; min-height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 18rpx; font-weight: 750; box-sizing: border-box; }
.knowledge-card-path { margin-top: 10rpx; color: var(--knowledge-system-text); font-size: 18rpx; line-height: 1.5; font-weight: 700; }
