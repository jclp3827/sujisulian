.terrain-page { min-height: 100vh; overflow-x: hidden; background: var(--bg-page-accent); }
.terrain-shell { min-height: 100vh; padding: 28rpx 24rpx calc(70rpx + env(safe-area-inset-bottom)); }
.terrain-hero { padding: 6rpx 2rpx 24rpx; }
.terrain-kicker { color: var(--knowledge-system-text); font-size: 21rpx; line-height: 1.4; font-weight: 800; letter-spacing: 2rpx; }
.terrain-title { margin-top: 8rpx; color: var(--text-primary); font-size: 42rpx; line-height: 1.28; font-weight: 800; }
.terrain-desc { margin-top: 12rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.6; }
.terrain-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 7rpx 2rpx; margin-bottom: 16rpx; }
.terrain-crumb { min-height: 60rpx; display: flex; align-items: center; max-width: 100%; color: var(--text-secondary); font-size: 19rpx; line-height: 1.45; }
.terrain-crumb-current { color: var(--knowledge-system-text); font-weight: 750; }
.terrain-crumb-arrow { padding: 0 7rpx; color: var(--border-strong); }
.terrain-controls { position: sticky; top: 0; z-index: 8; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 22rpx; padding: 8rpx; border: 1rpx solid rgba(148, 163, 184, .14); border-radius: 18rpx; background: rgba(245, 247, 250, .95); backdrop-filter: blur(16rpx); }
.terrain-levels { display: flex; gap: 5rpx; min-width: 0; }
.terrain-level { min-width: 68rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; padding: 11rpx 9rpx; border-radius: 11rpx; background: var(--bg-card); color: var(--text-secondary); font-size: 18rpx; line-height: 1; font-weight: 750; text-align: center; box-sizing: border-box; }
.terrain-level-active { background: var(--color-green-500); color: #fff; }
.terrain-level-disabled { opacity: .3; }
.terrain-projection { flex: none; min-height: 88rpx; display: flex; align-items: center; padding: 11rpx 13rpx; border-radius: 11rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 18rpx; line-height: 1; font-weight: 750; box-sizing: border-box; }
.terrain-canvas { padding: 20rpx; border: 1rpx solid rgba(51, 196, 122, .18); border-radius: 28rpx; background: linear-gradient(160deg, rgba(51, 196, 122, .075), rgba(255, 255, 255, .94) 42%, rgba(47, 107, 255, .035)); }
.terrain-canvas-l3 { background: radial-gradient(circle at 50% 13%, rgba(51, 196, 122, .13), rgba(255, 255, 255, .96) 36%, rgba(47, 107, 255, .04)); }
.terrain-scope-anchor { display: flex; align-items: center; gap: 15rpx; padding: 19rpx; border: 1rpx solid rgba(51, 196, 122, .2); border-radius: 19rpx; background: var(--bg-card); }
.terrain-anchor-mark { flex: none; width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: var(--color-green-500); color: #fff; font-size: 18rpx; font-weight: 800; }
.terrain-anchor-copy { flex: 1; min-width: 0; }
.terrain-anchor-title { color: var(--text-primary); font-size: 25rpx; line-height: 1.42; font-weight: 800; }
.terrain-anchor-meta { margin-top: 4rpx; color: var(--text-tertiary); font-size: 18rpx; line-height: 1.4; }
.terrain-trunk { width: 4rpx; height: 30rpx; margin: 0 auto; background: rgba(51, 196, 122, .35); }
.terrain-node-list { display: flex; flex-direction: column; gap: 13rpx; }
.terrain-canvas-l0 .terrain-node-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.terrain-canvas-l0 .terrain-node { min-height: 220rpx; display: flex; flex-direction: column; justify-content: space-between; background: linear-gradient(155deg, var(--bg-card), var(--bg-soft-green)); }
.terrain-canvas-l1 .terrain-node-list { position: relative; padding-left: 26rpx; }
.terrain-canvas-l1 .terrain-node-list::before { content: ''; position: absolute; top: 0; bottom: 0; left: 7rpx; width: 4rpx; border-radius: 999rpx; background: rgba(51, 196, 122, .28); }
.terrain-canvas-l1 .terrain-node::before { content: ''; position: absolute; top: 44rpx; left: -22rpx; width: 20rpx; height: 4rpx; background: rgba(51, 196, 122, .32); }
.terrain-canvas-l1 .terrain-node { position: relative; }
.terrain-canvas-l2 .terrain-node-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 14rpx; }
.terrain-canvas-l2 .terrain-node:nth-child(3n) { grid-column: 1 / -1; margin: 0 44rpx; }
.terrain-canvas-l3 .terrain-node-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 16rpx; }
.terrain-canvas-l3 .terrain-node-focus { grid-column: 1 / -1; max-width: 580rpx; margin: 0 auto 20rpx; }
.terrain-canvas-l3 .terrain-node-context { margin-left: 0; }
.terrain-canvas-l3 .terrain-node-context::before { left: 50%; top: -18rpx; width: 2rpx; height: 18rpx; }
.terrain-node { min-width: 0; padding: 20rpx 18rpx; border-color: rgba(51, 196, 122, .15); }
.terrain-node-aggregate { border-style: dashed; background: rgba(51, 196, 122, .035); }
.terrain-node-focus { border: 2rpx solid rgba(51, 196, 122, .45); background: var(--bg-soft-green); box-shadow: 0 12rpx 32rpx rgba(51, 196, 122, .1); }
.terrain-node-context { margin-left: 24rpx; border-color: rgba(47, 107, 255, .16); }
.terrain-node-context::before { content: ''; position: absolute; left: -26rpx; top: 50%; width: 24rpx; height: 2rpx; background: rgba(47, 107, 255, .24); }
.terrain-node-context { position: relative; }
.terrain-node-selected { border-color: var(--color-green-500); }
.terrain-node-topline { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 8rpx; }
.terrain-node-role { color: var(--knowledge-system-text); font-size: 17rpx; line-height: 1.3; font-weight: 800; letter-spacing: 1rpx; }
.terrain-node-context .terrain-node-role { color: var(--knowledge-reading-text); }
.terrain-node-count { flex: none; padding: 4rpx 8rpx; border-radius: 999rpx; background: var(--bg-soft-green); color: var(--knowledge-system-text); font-size: 16rpx; font-weight: 750; }
.terrain-node-title { color: var(--text-primary); font-size: 26rpx; line-height: 1.48; font-weight: 800; overflow-wrap: anywhere; }
.terrain-node-summary { margin-top: 7rpx; color: var(--text-secondary); font-size: 20rpx; line-height: 1.55; }
.terrain-node-reason { margin-top: 10rpx; padding: 10rpx 12rpx; border-radius: 11rpx; background: var(--bg-soft-blue); color: var(--text-secondary); font-size: 19rpx; line-height: 1.5; }
.terrain-node-labels { display: flex; flex-wrap: wrap; gap: 7rpx; margin-top: 10rpx; }
.terrain-node-label { padding: 4rpx 8rpx; border-radius: 999rpx; background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: 16rpx; font-weight: 750; }
.terrain-node-label-approved { background: var(--bg-soft-green); color: var(--knowledge-system-text); }
.terrain-node-label-risk { background: var(--bg-soft-purple); color: var(--knowledge-recall-text); }
.terrain-node-action { margin-top: 12rpx; color: var(--knowledge-system-text); font-size: 19rpx; line-height: 1.4; font-weight: 750; }
.terrain-node-context .terrain-node-action { color: var(--knowledge-reading-text); }
.terrain-node-action text { margin-left: 5rpx; }
.terrain-directory { padding: 18rpx; border: 1rpx solid var(--border-subtle); border-radius: 26rpx; background: rgba(255, 255, 255, .76); }
.terrain-directory-head { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; padding: 3rpx 2rpx 17rpx; }
.terrain-directory-title { color: var(--text-primary); font-size: 27rpx; line-height: 1.4; font-weight: 800; }
.terrain-directory-desc { margin-top: 4rpx; color: var(--text-secondary); font-size: 18rpx; line-height: 1.45; }
.terrain-directory-count { flex: none; padding: 6rpx 10rpx; border-radius: 999rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 17rpx; font-weight: 750; }
.terrain-directory-list { display: flex; flex-direction: column; gap: 11rpx; }
.terrain-directory-item { display: flex; align-items: center; gap: 13rpx; min-width: 0; padding: 18rpx 15rpx; }
.terrain-directory-item-selected { border-color: var(--color-green-500); background: var(--bg-soft-green); }
.terrain-directory-order { flex: none; width: 40rpx; color: var(--knowledge-system-text); font-size: 18rpx; line-height: 1.3; font-weight: 800; }
.terrain-directory-copy { flex: 1; min-width: 0; }
.terrain-directory-meta { color: var(--text-tertiary); font-size: 16rpx; line-height: 1.35; font-weight: 750; }
.terrain-directory-item-title { margin-top: 3rpx; color: var(--text-primary); font-size: 24rpx; line-height: 1.45; font-weight: 750; overflow-wrap: anywhere; }
.terrain-directory-reason { margin-top: 5rpx; color: var(--text-tertiary); font-size: 18rpx; line-height: 1.45; }
.terrain-overflow { margin-top: 14rpx; padding: 12rpx 14rpx; border-radius: 12rpx; background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: 18rpx; line-height: 1.5; }
.terrain-back { margin-top: 18rpx; padding: 17rpx; border: 1rpx solid var(--border-subtle); border-radius: 16rpx; background: var(--bg-card); color: var(--text-secondary); font-size: 20rpx; line-height: 1.4; font-weight: 750; text-align: center; }

@media (max-width: 340px) {
  .terrain-shell { padding-left: 18rpx; padding-right: 18rpx; }
  .terrain-title { font-size: 36rpx; }
  .terrain-controls { gap: 6rpx; }
  .terrain-level { min-width: 36rpx; padding-left: 7rpx; padding-right: 7rpx; }
  .terrain-projection { padding-left: 10rpx; padding-right: 10rpx; }
  .terrain-node-context { margin-left: 16rpx; }
  .terrain-node-context::before { left: -18rpx; width: 16rpx; }
  .terrain-canvas-l0 .terrain-node-list,
  .terrain-canvas-l2 .terrain-node-list,
  .terrain-canvas-l3 .terrain-node-list { grid-template-columns: 1fr; }
  .terrain-canvas-l0 .terrain-node { min-height: 0; }
  .terrain-canvas-l2 .terrain-node:nth-child(3n),
  .terrain-canvas-l3 .terrain-node-focus { grid-column: auto; margin-left: 0; margin-right: 0; }
  .terrain-canvas-l3 .terrain-node-context::before { display: none; }
}
.terrain-loading {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7280;
  font-size: 28rpx;
  background: #f3f6fb;
}

/* S5.5B unified KnowledgeSpace */
.knowledge-space { min-height: 100vh; overflow-x: hidden; background: var(--bg-page-accent); }
.knowledge-space-shell { min-height: 100vh; padding: 26rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.knowledge-space-hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 18rpx; }
.knowledge-space-kicker { color: var(--knowledge-system-text); font-size: 20rpx; line-height: 1.4; font-weight: 800; letter-spacing: 2rpx; }
.knowledge-space-title { margin-top: 6rpx; color: var(--text-primary); font-size: 39rpx; line-height: 1.3; font-weight: 800; }
.knowledge-space-projection { flex: none; min-height: 88rpx; display: flex; align-items: center; padding: 13rpx 16rpx; border-radius: 16rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 19rpx; line-height: 1.3; font-weight: 750; box-sizing: border-box; }
.knowledge-overview { padding: 20rpx; border: 1rpx solid rgba(51, 196, 122, .18); border-radius: 28rpx; background: linear-gradient(155deg, rgba(51, 196, 122, .075), rgba(255, 255, 255, .96) 46%, rgba(47, 107, 255, .04)); }
.knowledge-overview-regions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.knowledge-region { min-width: 0; min-height: 250rpx; display: flex; flex-direction: column; padding: 20rpx 17rpx; border-color: rgba(51, 196, 122, .16); box-sizing: border-box; }
.knowledge-region-top { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.knowledge-region-index { color: var(--knowledge-system-text); font-size: 18rpx; font-weight: 800; }
.knowledge-region-count { color: var(--text-tertiary); font-size: 16rpx; }
.knowledge-region-title { margin-top: 10rpx; color: var(--text-primary); font-size: 24rpx; line-height: 1.45; font-weight: 800; }
.knowledge-region-ticks { display: flex; flex-direction: column; gap: 5rpx; margin-top: 10rpx; }
.knowledge-region-ticks text { overflow: hidden; color: var(--text-tertiary); font-size: 16rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.knowledge-region-action { margin-top: auto; padding-top: 12rpx; color: var(--knowledge-system-text); font-size: 18rpx; font-weight: 750; }
.knowledge-region-rail { margin-bottom: 16rpx; padding: 14rpx 16rpx; border: 1rpx solid rgba(51, 196, 122, .18); border-radius: 20rpx; background: var(--bg-card); }
