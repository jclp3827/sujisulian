.knowledge-branch-peer-more { color: var(--text-tertiary); }
.knowledge-branch-list { display: flex; flex-direction: column; gap: 11rpx; }
.knowledge-branch-node { min-height: 88rpx; display: flex; align-items: center; gap: 13rpx; padding: 17rpx 16rpx; box-sizing: border-box; }
.knowledge-branch-node-mark { flex: none; width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 13rpx; background: var(--bg-soft-green); color: var(--knowledge-system-text); font-size: 17rpx; font-weight: 800; }
.knowledge-branch-point .knowledge-branch-node-mark { background: var(--bg-soft-blue); color: var(--knowledge-reading-text); }
.knowledge-branch-node-copy { flex: 1; min-width: 0; }
.knowledge-branch-node-title { color: var(--text-primary); font-size: 23rpx; line-height: 1.45; font-weight: 750; }
.knowledge-branch-node-meta { margin-top: 4rpx; color: var(--text-tertiary); font-size: 17rpx; line-height: 1.4; }
.knowledge-branch-continuation { margin-top: 20rpx; padding-top: 17rpx; border-top: 1rpx solid var(--border-subtle); }
