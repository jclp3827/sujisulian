.knowledge-directory-list { display: flex; flex-direction: column; gap: 10rpx; }
.knowledge-directory-item { min-height: 88rpx; display: flex; align-items: center; gap: 14rpx; padding: 17rpx 16rpx; box-sizing: border-box; }
