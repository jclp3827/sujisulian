.knowledge-region-chip { flex: none; max-width: 72%; min-height: 72rpx; display: flex; align-items: center; padding: 9rpx 14rpx; border: 1rpx solid var(--border-subtle); border-radius: 14rpx; color: var(--text-secondary); font-size: 18rpx; line-height: 1.4; font-weight: 750; box-sizing: border-box; }
.knowledge-region-chip-active { border-color: var(--color-green-500); background: var(--bg-soft-green); color: var(--knowledge-system-text); }
.knowledge-branch { position: relative; z-index: 2; margin-top: 18rpx; padding: 22rpx 20rpx; border: 1rpx solid rgba(47, 107, 255, .13); border-radius: 26rpx; background: var(--bg-card); box-shadow: 0 12rpx 34rpx rgba(15, 23, 42, .07); }
.knowledge-branch-context { margin-bottom: 17rpx; }
