.politics-map-page { min-height: 100vh; background: var(--bg-page-accent); }
.politics-map-shell { min-height: 100vh; padding: 28rpx 24rpx 180rpx; }
.politics-map-hero { padding: 8rpx 2rpx 26rpx; }
.politics-map-kicker { color: var(--color-green-500); font-size: 23rpx; line-height: 1.4; font-weight: 750; letter-spacing: 2rpx; }
.politics-map-title { margin-top: 8rpx; color: var(--text-primary); font-size: 49rpx; line-height: 1.2; font-weight: 750; }
.politics-map-desc { margin-top: 14rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.65; }
.politics-map-legend { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; margin-top: 18rpx; color: var(--text-tertiary); font-size: 19rpx; }
.politics-map-legend-item { display: flex; align-items: center; gap: 8rpx; }
.politics-map-dot { width: 13rpx; height: 13rpx; border-radius: 999rpx; background: var(--color-green-500); }
.politics-map-badge { width: 30rpx; height: 30rpx; display: flex; align-items: center; justify-content: center; border-radius: 8rpx; background: var(--bg-soft-blue); color: var(--color-primary-500); font-size: 17rpx; font-weight: 700; }
.politics-map-controls { position: sticky; top: 0; z-index: 8; display: flex; align-items: center; gap: 9rpx; margin: 0 -4rpx 24rpx; padding: 8rpx; border: 1rpx solid rgba(148, 163, 184, .12); border-radius: 18rpx; background: rgba(245, 247, 250, .94); backdrop-filter: blur(16rpx); }
.politics-map-control { flex: none; padding: 12rpx 15rpx; border-radius: 13rpx; background: var(--bg-card); color: var(--text-secondary); font-size: 20rpx; font-weight: 700; }
.politics-map-control-active { background: var(--bg-soft-green); color: var(--color-green-700); }
.politics-map-control-recall { background: var(--bg-soft-purple); color: var(--color-purple-500); }
.politics-map-control-recall-active { background: var(--color-purple-500); color: #fff; }
.politics-map-control-disabled { opacity: .35; }
.politics-map-control-label { flex: 1; min-width: 0; overflow: hidden; padding-right: 8rpx; color: var(--text-tertiary); font-size: 18rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.politics-map-module { display: flex; align-items: center; gap: 17rpx; padding: 24rpx 22rpx; border-color: rgba(51, 196, 122, .22); }
.politics-map-module-mark { flex: none; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: var(--bg-soft-green); color: var(--color-green-700); font-size: 22rpx; font-weight: 800; }
.politics-map-module-copy { flex: 1; min-width: 0; }
.politics-map-module-title { color: var(--text-primary); font-size: 29rpx; line-height: 1.4; font-weight: 750; }
.politics-map-module-desc { margin-top: 5rpx; color: var(--text-tertiary); font-size: 20rpx; line-height: 1.45; }
.politics-map-trunk,
.politics-map-rail { width: 4rpx; height: 32rpx; margin: 0 auto; background: rgba(51, 196, 122, .3); }
.politics-map-category-list { display: flex; flex-direction: column; gap: 14rpx; }
.politics-map-category-card { display: flex; align-items: center; gap: 15rpx; padding: 22rpx 18rpx; border-color: rgba(51, 196, 122, .16); }
.politics-map-category-index { flex: none; width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--bg-soft-green); color: var(--color-green-700); font-size: 20rpx; font-weight: 800; }
.politics-map-category-copy { flex: 1; min-width: 0; }
.politics-map-category-title { color: var(--text-primary); font-size: 27rpx; line-height: 1.45; font-weight: 750; }
.politics-map-category-meta { margin-top: 6rpx; color: var(--text-tertiary); font-size: 19rpx; line-height: 1.4; }
.politics-map-branch-head { padding: 24rpx 22rpx; border: 1rpx solid rgba(51, 196, 122, .2); border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--bg-card), var(--bg-soft-green)); text-align: center; }
.politics-map-branch-eyebrow { color: var(--color-green-700); font-size: 18rpx; font-weight: 800; }
.politics-map-branch-title { margin-top: 7rpx; color: var(--text-primary); font-size: 29rpx; line-height: 1.45; font-weight: 750; }
.politics-map-branch-hint { margin-top: 7rpx; color: var(--text-tertiary); font-size: 20rpx; line-height: 1.45; }
.politics-map-rail-short { height: 28rpx; }
.politics-map-layer { position: relative; }
.politics-map-layer-label { display: table; margin: 0 auto 12rpx; padding: 6rpx 13rpx; border-radius: 999rpx; background: var(--bg-soft-green); color: var(--color-green-700); font-size: 18rpx; line-height: 1.3; font-weight: 700; }
.politics-map-node-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.politics-map-node { flex: 1 1 285rpx; min-width: 0; padding: 20rpx 18rpx; border-color: rgba(47, 107, 255, .11); }
.politics-map-node-active { border-color: var(--color-green-500); background: var(--bg-soft-green); box-shadow: 0 8rpx 24rpx rgba(51, 196, 122, .1); }
.politics-map-node-masked { border-style: dashed; background: rgba(124, 92, 255, .045); }
.politics-map-node-masked.politics-map-node-active { border-color: var(--color-purple-500); background: var(--bg-soft-purple); }
.politics-map-node-topline { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 8rpx; }
.politics-map-node-depth { padding: 4rpx 8rpx; border-radius: 8rpx; background: var(--bg-soft-green); color: var(--color-green-700); font-size: 16rpx; font-weight: 800; }
.politics-map-node-relations { color: var(--text-tertiary); font-size: 17rpx; }
.politics-map-node-state { padding: 4rpx 8rpx; border-radius: 999rpx; background: var(--bg-soft-orange); color: var(--color-orange-700); font-size: 16rpx; font-weight: 700; }
.politics-map-node-state-approved { background: var(--bg-soft-green); color: var(--color-green-700); }
.politics-map-node-risk { display: inline-block; margin-bottom: 7rpx; padding: 4rpx 8rpx; border-radius: 999rpx; background: var(--bg-soft-purple); color: var(--color-purple-500); font-size: 16rpx; font-weight: 700; }
.politics-map-node-title { color: var(--text-primary); font-size: 26rpx; line-height: 1.45; font-weight: 750; }
.politics-map-node-summary { margin-top: 7rpx; color: var(--text-tertiary); font-size: 19rpx; line-height: 1.5; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.politics-preview-mask { position: fixed; inset: 0; z-index: 20; background: rgba(15, 23, 42, .38); }
.politics-preview-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; max-height: 76vh; overflow-y: auto; padding: 12rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: var(--bg-card); box-shadow: 0 -16rpx 42rpx rgba(15, 23, 42, .14); }
.politics-preview-handle { width: 72rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 999rpx; background: var(--border-subtle); }
.politics-preview-topline { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.politics-preview-kicker { color: var(--color-green-700); font-size: 20rpx; line-height: 1.4; font-weight: 750; }
.politics-preview-close { padding: 8rpx; color: var(--text-tertiary); font-size: 21rpx; }
.politics-preview-path { margin-top: 16rpx; color: var(--text-tertiary); font-size: 19rpx; line-height: 1.45; }
.politics-preview-title { margin-top: 7rpx; color: var(--text-primary); font-size: 37rpx; line-height: 1.3; font-weight: 800; }
.politics-preview-summary { margin-top: 13rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.7; }
.politics-preview-facts { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 15rpx; }
.politics-preview-facts view { padding: 5rpx 9rpx; border-radius: 999rpx; background: rgba(148, 163, 184, .11); color: var(--text-tertiary); font-size: 17rpx; }
.politics-preview-facts .politics-preview-review-state { background: var(--bg-soft-orange); color: var(--color-orange-700); font-weight: 700; }
.politics-preview-facts .politics-preview-risk-state { background: var(--bg-soft-purple); color: var(--color-purple-500); font-weight: 700; }
.politics-recall-preview { padding: 28rpx 4rpx 4rpx; text-align: center; }
.politics-recall-preview-mark { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto; border-radius: 20rpx; background: var(--bg-soft-purple); color: var(--color-purple-500); font-size: 24rpx; font-weight: 800; }
.politics-recall-preview-title { margin-top: 16rpx; color: var(--text-primary); font-size: 30rpx; line-height: 1.4; font-weight: 750; }
.politics-recall-preview-hint { margin-top: 10rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.55; }
.politics-recall-preview-reveal { width: 100%; min-height: 76rpx; margin-top: 22rpx; border-radius: 18rpx; background: var(--bg-soft-purple); color: var(--color-purple-500); font-size: 23rpx; line-height: 76rpx; font-weight: 750; }
.politics-recall-preview-reveal::after { border: 0; }
.politics-preview-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11rpx; margin-top: 23rpx; }
.politics-preview-actions-two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.politics-preview-action { min-width: 0; min-height: 74rpx; padding: 0 8rpx; border-radius: 17rpx; background: var(--bg-soft-blue); color: var(--color-primary-500); font-size: 22rpx; line-height: 74rpx; font-weight: 750; }
.politics-preview-action::after { border: 0; }
.politics-preview-action-primary { background: var(--color-primary-500); color: #fff; }
.politics-preview-action-system { background: var(--bg-soft-green); color: var(--color-green-700); }
.politics-preview-action-relation { background: var(--bg-soft-orange); color: var(--color-orange-700); }
.politics-preview-action-recall { background: var(--bg-soft-purple); color: var(--color-purple-500); }
.politics-relation-focus { width: fit-content; max-width: 100%; margin: 20rpx auto 24rpx; padding: 17rpx 22rpx; border: 2rpx solid rgba(255, 166, 43, .22); border-radius: 17rpx; background: var(--bg-soft-orange); color: var(--text-primary); font-size: 26rpx; line-height: 1.4; font-weight: 800; text-align: center; }
.politics-relation-group + .politics-relation-group { margin-top: 18rpx; }
.politics-relation-label { display: inline-block; margin-bottom: 10rpx; color: var(--color-primary-500); font-size: 19rpx; line-height: 1.3; font-weight: 750; }
.politics-relation-label-prerequisites { color: var(--color-green-700); }
.politics-relation-label-contrasts { color: var(--color-orange-700); }
.politics-relation-label-subsequent { color: var(--color-purple-500); }
.politics-relation-nodes { display: flex; flex-direction: column; gap: 9rpx; }
.politics-relation-node { padding: 14rpx 16rpx; border: 1rpx solid var(--border-subtle); border-radius: 14rpx; background: var(--bg-page-accent); }
.politics-relation-node-title { color: var(--text-primary); font-size: 22rpx; line-height: 1.4; font-weight: 750; }
.politics-relation-node-why { margin-top: 5rpx; color: var(--text-tertiary); font-size: 19rpx; line-height: 1.5; }
.politics-relation-empty { padding: 30rpx 0; color: var(--text-tertiary); font-size: 22rpx; text-align: center; }

@media (max-width: 340px) {
  .politics-map-shell { padding-left: 18rpx; padding-right: 18rpx; }
  .politics-map-control { padding-left: 11rpx; padding-right: 11rpx; }
  .politics-map-control-label { display: none; }
}
