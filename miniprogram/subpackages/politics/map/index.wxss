.knowledge-directory-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 16rpx; }
.knowledge-directory-title { color: var(--text-primary); font-size: 35rpx; line-height: 1.35; font-weight: 800; }
.knowledge-directory-desc { margin-top: 7rpx; color: var(--text-secondary); font-size: 20rpx; line-height: 1.55; }
