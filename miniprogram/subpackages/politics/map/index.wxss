.knowledge-branch-title { margin-top: 7rpx; color: var(--text-primary); font-size: 31rpx; line-height: 1.4; font-weight: 800; }
.knowledge-branch-meta { margin-top: 7rpx; color: var(--text-secondary); font-size: 20rpx; line-height: 1.5; }
.knowledge-branch-peers { display: flex; gap: 8rpx; margin: -3rpx 0 17rpx; overflow-x: auto; }
