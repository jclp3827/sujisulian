.knowledge-directory-group-title { color: var(--text-primary); font-size: 25rpx; line-height: 1.45; font-weight: 800; }
.knowledge-directory-group-count { flex: none; color: var(--knowledge-system-text); font-size: 17rpx; line-height: 1.5; font-weight: 750; }
.knowledge-directory-section { padding: 18rpx; border-top: 1rpx solid var(--border-subtle); }
.knowledge-directory-section-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 12rpx; }
.knowledge-directory-section-title { color: var(--knowledge-reading-text); font-size: 21rpx; line-height: 1.45; font-weight: 800; }
