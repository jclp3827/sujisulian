.knowledge-contrast-reason { color: var(--text-primary); font-size: 21rpx; line-height: 1.55; font-weight: 750; }
.knowledge-contrast-boundary { margin-top: 7rpx; color: var(--knowledge-boundary-text); font-size: 19rpx; line-height: 1.55; }
.knowledge-card-primary { min-height: 88rpx; display: flex; align-items: center; justify-content: center; margin-top: 22rpx; padding: 14rpx 18rpx; border-radius: 17rpx; background: var(--knowledge-reading-text); color: #fff; font-size: 22rpx; line-height: 1.4; font-weight: 800; text-align: center; box-sizing: border-box; }
.knowledge-card-secondary { min-height: 72rpx; display: flex; align-items: center; justify-content: center; margin-top: 8rpx; color: var(--knowledge-reading-text); font-size: 20rpx; line-height: 1.4; font-weight: 750; text-align: center; }
.knowledge-full,
.knowledge-recall { margin: -26rpx -24rpx calc(-48rpx - env(safe-area-inset-bottom)); min-height: 100vh; background: var(--bg-page-accent); }
.knowledge-context-bar { position: sticky; top: 0; z-index: 12; display: flex; align-items: center; gap: 14rpx; padding: 13rpx 20rpx; border-bottom: 1rpx solid var(--border-subtle); background: rgba(255, 255, 255, .96); backdrop-filter: blur(16rpx); }
.knowledge-context-back { flex: none; min-height: 88rpx; display: flex; align-items: center; padding: 8rpx 12rpx; border-radius: 14rpx; background: var(--bg-soft-green); color: var(--knowledge-system-text); font-size: 18rpx; line-height: 1.3; font-weight: 800; box-sizing: border-box; }
.knowledge-context-identity { min-width: 0; overflow: hidden; color: var(--text-secondary); font-size: 17rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.knowledge-full-card { margin: 18rpx 20rpx 0; padding: 28rpx 22rpx calc(150rpx + env(safe-area-inset-bottom)); border-radius: 25rpx 25rpx 0 0; background: var(--bg-card); }
.knowledge-reading-block { padding: 4rpx 0; scroll-margin-top: 112rpx; }
.knowledge-reading-block + .knowledge-reading-block { margin-top: 8rpx; }
.knowledge-reading-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.knowledge-key-toggle { min-height: 72rpx; display: flex; align-items: center; padding: 8rpx 14rpx; border-radius: 999rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 18rpx; font-weight: 750; box-sizing: border-box; }
.knowledge-reading-heading { margin: 23rpx 0 10rpx; color: var(--text-primary); font-size: 29rpx; line-height: 1.5; font-weight: 800; }
.knowledge-reading-text { color: var(--text-secondary); font-size: 25rpx; line-height: 1.82; white-space: pre-line; }
.knowledge-reading-callout,
.knowledge-semantic-definition,
.knowledge-semantic-conclusion { margin: 15rpx 0; padding: 17rpx; border-left: 5rpx solid var(--knowledge-reading-text); background: var(--bg-soft-blue); }
.knowledge-reading-quote { margin: 15rpx 0; padding: 17rpx; border-left: 5rpx solid var(--text-tertiary); background: var(--bg-page-accent); }
.knowledge-semantic-condition,
.knowledge-semantic-exception,
.knowledge-semantic-contrast { margin: 15rpx 0; padding: 17rpx; border: 1rpx solid var(--border-orange); border-radius: 14rpx; background: var(--bg-soft-orange); }
.knowledge-reading-list { display: flex; flex-direction: column; gap: 10rpx; }
.knowledge-reading-list-item { display: flex; gap: 11rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.72; }
.knowledge-reading-list-item text { flex: none; color: var(--knowledge-reading-text); font-weight: 800; }
.knowledge-reading-table { display: flex; flex-direction: column; gap: 10rpx; }
.knowledge-reading-table-row { overflow: hidden; border: 1rpx solid var(--border-subtle); border-radius: 13rpx; }
.knowledge-reading-table-cell { display: grid; grid-template-columns: minmax(120rpx, .7fr) minmax(0, 1.3fr); }
.knowledge-reading-table-cell text { padding: 12rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 19rpx; font-weight: 750; }
.knowledge-reading-table-cell view { min-width: 0; padding: 12rpx; color: var(--text-secondary); font-size: 21rpx; line-height: 1.55; }
.knowledge-context-tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9rpx; margin-top: 28rpx; padding-top: 18rpx; border-top: 1rpx solid var(--border-subtle); }
.knowledge-context-tools view { min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 19rpx; font-weight: 750; text-align: center; }
.knowledge-context-tool-trust { background: transparent !important; color: var(--text-tertiary) !important; font-weight: 650 !important; }
.knowledge-recall-card { margin: 24rpx 20rpx; padding: 30rpx 23rpx; border: 1rpx solid rgba(124, 92, 255, .18); border-radius: 26rpx; background: linear-gradient(145deg, var(--bg-card), rgba(124, 92, 255, .045)); }
.knowledge-recall-label { color: var(--knowledge-recall-text); font-size: 19rpx; line-height: 1.4; font-weight: 800; }
.knowledge-recall-title { margin-top: 8rpx; color: var(--text-primary); font-size: 28rpx; line-height: 1.45; font-weight: 800; }
.knowledge-recall-prompt { margin-top: 24rpx; color: var(--text-primary); font-size: 31rpx; line-height: 1.65; font-weight: 750; }
.knowledge-recall-answer { margin-top: 25rpx; padding-top: 22rpx; border-top: 1rpx solid var(--border-subtle); }
.knowledge-recall-answer-text { margin-top: 10rpx; color: var(--text-secondary); font-size: 25rpx; line-height: 1.8; }
.knowledge-recall-pitfall { margin-top: 18rpx; padding: 16rpx; border-radius: 14rpx; background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: 21rpx; line-height: 1.65; }
.knowledge-recall-assess { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; margin-top: 20rpx; }
.knowledge-recall-assess view { min-height: 88rpx; display: flex; align-items: center; justify-content: center; padding: 10rpx 6rpx; border-radius: 14rpx; background: var(--bg-soft-purple); color: var(--knowledge-recall-text); font-size: 18rpx; line-height: 1.35; font-weight: 750; text-align: center; box-sizing: border-box; }
.knowledge-recall-result { margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 14rpx; background: var(--bg-soft-purple); color: var(--knowledge-recall-text); font-size: 20rpx; line-height: 1.5; font-weight: 750; }
.knowledge-recall-remedies { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8rpx; margin-top: 16rpx; }
.knowledge-recall-remedies view { min-height: 80rpx; display: flex; align-items: center; justify-content: center; padding: 8rpx; border-radius: 13rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 18rpx; line-height: 1.35; font-weight: 700; text-align: center; box-sizing: border-box; }
.knowledge-learning-dock { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(18rpx + env(safe-area-inset-bottom)); z-index: 15; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10rpx; padding: 10rpx; border: 1rpx solid rgba(47,107,255,.14); border-radius: 20rpx; background: rgba(255,255,255,.96); box-shadow: 0 12rpx 36rpx rgba(15,23,42,.14); backdrop-filter: blur(16rpx); }
.knowledge-learning-dock view { min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; background: var(--bg-soft-blue); color: var(--knowledge-reading-text); font-size: 20rpx; font-weight: 800; text-align: center; }
.knowledge-learning-dock view:last-child { background: var(--bg-soft-purple); color: var(--knowledge-recall-text); }
.knowledge-learning-dock view:only-child { grid-column: 1 / -1; }
.knowledge-relation-sheet { padding-top: 27rpx; }
.knowledge-relation-panel-note { margin: 12rpx 0 16rpx; color: var(--text-secondary); font-size: 20rpx; line-height: 1.55; }
.knowledge-relation-panel-item { margin-top: 10rpx; padding: 16rpx; border: 1rpx solid var(--border-subtle); border-radius: 15rpx; background: var(--bg-card); }
.knowledge-relation-panel-item-selected { border-color: var(--knowledge-reading-text); background: var(--bg-soft-blue); }
.knowledge-relation-source { margin-top: 10rpx; color: var(--knowledge-reading-text); font-size: 18rpx; font-weight: 750; }
.knowledge-relation-other { overflow: hidden; margin-top: 8rpx; border: 1rpx solid var(--border-subtle); border-radius: 14rpx; }
.knowledge-relation-other view { min-height: 80rpx; display: flex; align-items: center; justify-content: center; padding: 12rpx 16rpx; color: var(--text-secondary); font-size: 19rpx; line-height: 1.4; font-weight: 750; text-align: center; box-sizing: border-box; }
.knowledge-relation-other view + view { border-top: 1rpx solid var(--border-subtle); }
.knowledge-feedback-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; max-height: 80vh; overflow-y: auto; padding: 28rpx 25rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: var(--bg-card); box-shadow: 0 -14rpx 44rpx rgba(15, 23, 42, .16); box-sizing: border-box; }
.knowledge-source-summary { margin-top: 17rpx; padding: 15rpx; border-radius: 14rpx; background: var(--bg-soft-blue); color: var(--text-secondary); font-size: 20rpx; line-height: 1.6; }
.knowledge-source-status { margin-top: 14rpx; color: var(--text-tertiary); font-size: 18rpx; line-height: 1.5; }
.knowledge-feedback-types { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 18rpx; }
.knowledge-feedback-type { min-height: 72rpx; display: flex; align-items: center; padding: 10rpx 13rpx; border-radius: 999rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 18rpx; font-weight: 750; box-sizing: border-box; }
.knowledge-feedback-type-active { background: var(--knowledge-reading-text); color: #fff; }
.knowledge-feedback-input { width: 100%; min-height: 150rpx; margin-top: 16rpx; padding: 16rpx; border: 1rpx solid var(--border-subtle); border-radius: 15rpx; background: var(--bg-page-accent); color: var(--text-primary); font-size: 22rpx; line-height: 1.6; box-sizing: border-box; }
.knowledge-feedback-note { margin-top: 11rpx; color: var(--text-tertiary); font-size: 18rpx; line-height: 1.5; }
.knowledge-font-large .knowledge-reading-text,
.knowledge-font-large .knowledge-atom-text,
.knowledge-font-large .knowledge-recall-answer-text { font-size: 29rpx; }
.knowledge-font-extraLarge .knowledge-reading-text,
.knowledge-font-extraLarge .knowledge-atom-text,
.knowledge-font-extraLarge .knowledge-recall-answer-text { font-size: 33rpx; }
.knowledge-line-relaxed .knowledge-reading-text,
.knowledge-line-relaxed .knowledge-atom-text { line-height: 2; }

@media (max-width: 340px) {
  .knowledge-space-shell { padding-left: 18rpx; padding-right: 18rpx; }
  .knowledge-overview-regions { grid-template-columns: 1fr; }
  .knowledge-region { min-height: 210rpx; }
  .knowledge-space-projection { padding-left: 11rpx; padding-right: 11rpx; }
  .knowledge-card-title { font-size: 32rpx; }
  .knowledge-full,
  .knowledge-recall { margin-left: -18rpx; margin-right: -18rpx; }
  .knowledge-recall-assess { grid-template-columns: 1fr; }
  .knowledge-recall-remedies { grid-template-columns: 1fr; }
}
