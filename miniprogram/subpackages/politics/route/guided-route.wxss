.guided-route-exam .guided-adjust { border: var(--ui-border-width) solid var(--ui-color-border); background: var(--ui-color-surface);  left: 0; right: 0; bottom: 0; padding: var(--ui-card-padding) var(--ui-page-gutter) calc(var(--ui-card-padding) + env(safe-area-inset-bottom)); border-radius: var(--ui-radius-sheet) var(--ui-radius-sheet) 0 0; box-shadow: var(--ui-shadow-floating);}
.guided-route-exam .guided-adjust-head text,
.guided-route-exam .guided-remedy-item { color: var(--ui-color-accent-text); }

.systematic-scope-adjust { display: flex; align-items: center; justify-content: center; gap: var(--space-2); min-width: var(--ui-touch-target); min-height: var(--ui-touch-target); flex: none; font-size: var(--ui-font-description); }

/* Continuous learning routes share action placement and reading space. */
.guided-learning-route .guided-shell { padding-bottom: calc(280rpx + env(safe-area-inset-bottom)); }
.guided-learning-route .guided-active { padding-bottom: 0; }
.guided-learning-start { padding: var(--ui-card-padding); border: var(--ui-border-width) solid var(--ui-color-border); border-radius: var(--ui-radius-card); background: var(--ui-color-surface); box-shadow: var(--ui-shadow-card); }
.guided-learning-method { margin-top: var(--space-3); color: var(--ui-color-muted); font-size: var(--ui-font-description); line-height: var(--ui-line-body); }
.guided-learning-route .systematic-order-toggle { margin-top: 0; }

.guided-learning-pause { display: flex; align-items: center; justify-content: center; flex: none; min-width: var(--ui-touch-target); min-height: var(--ui-touch-target); color: var(--ui-color-accent-text); font-size: var(--ui-font-description); font-weight: var(--ui-weight-label); }
.guided-system-toolbar-actions > .guided-primary-action { flex: 1; margin: 0; }
.guided-learning-route .systematic-start-actions { margin-top: 0; }


.guided-route-confusion { background: var(--ui-color-page); color: var(--ui-color-text); }
.guided-route-confusion .guided-section-label { color: var(--ui-color-accent-text); }




.guided-contrast-result { margin-top: var(--space-3); color: var(--ui-color-text); font-size: var(--ui-font-card-title); line-height: var(--ui-line-title); font-weight: var(--ui-weight-heading); }
.guided-route-confusion .guided-system-toolbar-primary.guided-action-disabled { background: var(--ui-color-soft); color: var(--ui-color-muted); }

.quick-structure-toggle { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-height: var(--ui-touch-target); color: var(--ui-color-accent-text); font-size: var(--ui-font-description); line-height: var(--ui-line-body); font-weight: var(--ui-weight-label); }
.quick-structure-toggle { flex: none; }
.quick-reference-text { margin-top: var(--space-2); color: var(--ui-color-text); font-size: var(--ui-font-reading-body); line-height: var(--ui-line-reading); }
.guided-route-quick .guided-section-label { color: var(--ui-color-accent-text); }

.guided-remedy-title { flex: 1; min-width: 0; }

/* Step-by-step primer: one task, persistent position, one shared action dock. */
.guided-learning-route { overflow: visible; }
.route-step-progress { position: sticky; top: 0; z-index: 12; padding: var(--space-3); border: var(--ui-border-width) solid var(--ui-color-border); border-radius: var(--ui-radius-card); background: var(--ui-color-surface); box-shadow: var(--ui-shadow-card); }
.route-progress-row { display: flex; align-items: center; gap: var(--space-3); }
.route-progress-step { flex: 0 0 24%; }
.route-progress-task { flex: 1; min-width: 0; }
.route-progress-label { color: var(--ui-color-muted); font-size: var(--ui-font-meta); line-height: var(--ui-line-body); }
.route-progress-value { margin-top: var(--space-1); color: var(--ui-color-text); font-size: var(--ui-font-body); line-height: var(--ui-line-title); font-weight: var(--ui-weight-heading); }
.route-progress-track { display: flex; gap: var(--space-1); margin-top: var(--space-3); }
.route-progress-segment { flex: 1; height: var(--space-1); border-radius: var(--ui-radius-pill); background: var(--ui-color-border); }
.route-progress-current { background: var(--ui-color-accent); }
.route-progress-completed { background: var(--ui-color-accent-soft); box-shadow: inset 0 0 0 var(--ui-border-width) var(--ui-color-accent); }
.quick-detail > view:first-child { flex: 1; min-width: 0; }
.guided-route-quick .guided-shell { padding-bottom: calc(280rpx + env(safe-area-inset-bottom)); }

.route-step-progress { margin-bottom: var(--space-4); }
.route-progress-note { margin-top: var(--space-2); color: var(--ui-color-muted); font-size: var(--ui-font-description); line-height: var(--ui-line-body); }

/* Hierarchical range selection keeps its confirmation visible while the tree scrolls. */
.guided-adjust-scope { height: 78vh; display: flex; flex-direction: column; overflow: hidden; }
.guided-adjust-scope .guided-adjust-head { flex: none; align-items: center; padding-bottom: var(--space-3); font-size: var(--ui-font-section-title); }
.scope-picker-list { flex: 1; min-height: 0; }
.scope-picker-row { display: flex; align-items: stretch; gap: var(--space-2); min-width: 0; padding-right: var(--space-1); background: var(--ui-color-surface); }
.scope-picker-line { flex: none; width: 3rpx; margin: 0 var(--space-1); background: var(--ui-color-accent); opacity: .25; }
.scope-picker-copy { display: flex; flex: 1; min-width: 0; border-bottom: var(--ui-border-width) solid var(--ui-color-border); }
.scope-picker-choice { flex: 1; min-width: 0; min-height: var(--ui-touch-target); margin-top: 0; padding: var(--space-4) var(--space-2); border: 0; border-radius: 0; background: var(--ui-color-surface); }
.scope-picker-choice.guided-choice-active { border: 0; background: var(--ui-color-accent-soft); }
.scope-picker-choice-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }
.scope-picker-title { min-width: 0; color: var(--ui-color-text); font-size: var(--ui-font-body); line-height: 1.5; font-weight: var(--ui-weight-heading); word-break: break-word; }
.scope-picker-title-article { font-weight: var(--ui-weight-heading); }
.scope-picker-title-chapter { font-weight: var(--ui-weight-heading); }
.scope-picker-choice .scope-picker-selected { flex: none; color: var(--ui-color-accent-text); font-size: var(--ui-font-description); font-weight: var(--ui-weight-label); }
.scope-picker-count { margin-top: var(--space-0); color: var(--ui-color-caption); font-size: var(--ui-font-description); line-height: 1.4; }
.scope-picker-toggle { flex: none; display: flex; align-items: center; justify-content: center; min-width: var(--ui-touch-target); min-height: var(--ui-touch-target); color: var(--ui-color-accent-text); }
.scope-picker-footer { flex: none; padding-top: var(--space-3); border-top: var(--ui-border-width) solid var(--ui-color-border); }
.scope-picker-summary { margin-bottom: var(--space-3); color: var(--ui-color-muted); font-size: var(--ui-font-description); line-height: var(--ui-line-body); }
.scope-picker-footer .systematic-adjust-confirm { margin-top: 0; }
