<template name="unitInline"><block wx:for="{{runs}}" wx:key="index"><text class="unit-inline-{{item.role}}">{{item.text}}</text></block></template>
<view class="unit-page {{screen === 'lesson' && view.closeout ? 'unit-closeout-visual' : ''}} {{screen === 'groups' ? 'unit-list-visual' : ''}} politics-theme unit-font-{{screen === 'lesson' && !view.closeout ? displayPreferences.fontScale : 'default'}} unit-line-{{screen === 'lesson' && !view.closeout ? displayPreferences.lineSpacing : 'normal'}} {{readingUiEnabled && screen === 'lesson' ? 'pr-reader' : ''}} {{systematicVisualEnabled && screen === 'lesson' ? 'systematic-visual-v1' : ''}} pr-font-{{screen === 'lesson' && !view.closeout ? displayPreferences.fontScale : 'default'}} pr-line-{{screen === 'lesson' && !view.closeout ? displayPreferences.lineSpacing : 'normal'}}">
  <view wx:if="{{screen === 'groups'}}">
    <view class="unit-list-head"><view class="unit-list-title">学习路线</view></view>
    <view class="unit-route-tabs"><button wx:for="{{routes}}" wx:key="id" class="btn-base btn-secondary unit-secondary unit-route-tab {{selectedRouteId === item.id ? 'unit-route-selected' : ''}}" data-route-id="{{item.id}}" bindtap="handleRoute" aria-pressed="{{selectedRouteId === item.id}}"><text class="unit-route-name">{{item.title}}</text><text class="unit-route-count">已读{{item.read}}/{{item.count}}节</text></button></view>
    <view wx:if="{{currentCard}}" class="unit-list-current">
      <view class="unit-list-current-label">{{currentCardLabel}}</view><view class="unit-list-current-title">{{currentCard.title}}</view>
      <button class="btn-base btn-primary unit-primary unit-current-action" bindtap="handleCurrent">{{currentCard.action}}</button>
    </view>
    <view class="unit-list-section-heading">学习主题</view>
    <view wx:for="{{visibleGroups}}" wx:key="id" id="route-list-group-{{item.id}}" class="unit-list-item unit-group-card-{{item.progressState}}" data-group-id="{{item.id}}" bindtap="handleGroup" role="button" aria-label="{{item.action}}，{{item.displayTitle}}，{{item.displayProgress}}" hover-class="unit-list-item-pressed">
      <view id="route-list-heading-{{item.id}}" class="unit-list-item-head"><view class="unit-list-title-row"><view class="unit-list-item-title">{{index + 1}}. {{item.displayTitle}}</view><view class="unit-list-progress politics-status-tag"><text wx:if="{{item.completed}}" aria-hidden="true">✓</text><text>{{item.displayProgress}}</text></view></view><view class="unit-list-arrow" aria-hidden="true"><view class="ui-chevron ui-chevron-right unit-list-chevron"></view></view></view>
      <view wx:if="{{item.displayDescription}}" class="unit-list-description">{{item.displayDescription}}</view>
    </view>
    <button wx:if="{{hasLegacy}}" class="btn-base btn-secondary unit-secondary unit-list-legacy" bindtap="handleLegacy"><text>继续原来的篇章学习</text><view class="ui-chevron ui-chevron-right" aria-hidden="true"></view></button>
  </view>
  <block wx:elif="{{screen === 'lesson' && view}}">
    <view class="unit-progress">
      <view class="unit-progress-row"><view class="unit-progress-metrics"><view class="unit-progress-metric"><text>本篇</text><text class="unit-progress-value">{{view.routeRead}}/{{view.routeCount}}</text></view><view class="unit-progress-metric"><text>本主题</text><text class="unit-progress-value">{{view.position}}/{{view.total}}</text></view></view><view wx:if="{{readingUiEnabled}}" class="pr-tools"><view wx:if="{{readingUiEnabled}}" class="pr-control-slot"><reading-controls id="reading-controls-entry" class="pr-reading-controls" wx:if="{{readingUiEnabled}}" preferences="{{displayPreferences}}" visible="{{readingSettingsVisible}}" bind:open="handleReadingSettingsOpen" /></view><view class="btn-base btn-compact btn-ghost unit-menu unit-progress-route" bindtap="handleGroups" role="button" aria-label="查看系统学习路线">路线</view></view><view wx:else class="btn-base btn-compact btn-ghost unit-menu unit-progress-route" bindtap="handleGroups" role="button" aria-label="查看系统学习路线">路线</view></view>
      <view class="session-progress-track unit-progress-track"><view class="session-progress-fill unit-progress-fill" style="width: {{view.routeProgressPercent}}%;"></view></view>
    </view>
    <view wx:if="{{!view.closeout}}" class="unit-card unit-reading">
      <view wx:if="{{reviewing}}" class="unit-caption">{{reviewWasSkipped ? '补读之前跳过的小节' : '回看已读小节'}}</view>
      <view class="unit-title"><block wx:if="{{readingUiEnabled}}"><text>{{view.readingTitle}}</text><view wx:if="{{view.readingOrdinal}}" class="pr-title-ordinal">{{view.readingOrdinal}}</view></block><block wx:else>{{view.title}}</block></view>
      <view class="unit-goal">
        <view class="unit-outcome-line"><text class="unit-outcome-label">读完能理解：</text><text class="unit-outcome-summary">{{view.outcomeSummary}}</text></view>
      </view>
      <view wx:for="{{view.parts}}" wx:key="id" id="{{item.id}}" class="unit-part unit-part-{{item.kind}} {{item.emphasized ? 'unit-part-emphasized' : ''}}"><view class="unit-heading">{{item.label}}</view><view class="unit-body"><block wx:if="{{item.paragraphs.length > 1}}"><view wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="id" class="unit-body-paragraph"><template is="unitInline" data="{{runs:paragraph.runs}}" /></view></block><template wx:else is="unitInline" data="{{runs:item.runs}}" /></view></view>
      <view class="unit-test"><view class="unit-test-head"><view class="unit-test-title">{{systematicVisualEnabled ? '快速自测' : '快速自测 · 1题'}}</view><view wx:if="{{!systematicVisualEnabled}}" class="unit-test-note">可跳过 · 不计分</view></view><view wx:if="{{!systematicVisualEnabled}}" class="unit-test-instruction">不看上文，试着用一句话回答：</view><view class="unit-question unit-test-question">{{view.reflection.prompt}}</view><button class="btn-base btn-secondary unit-secondary unit-test-action" bindtap="handleReference" aria-expanded="{{view.referenceVisible}}">{{view.referenceVisible ? '收起参考答案' : '查看参考答案'}}</button><view wx:if="{{view.referenceVisible}}" class="unit-test-answer"><view wx:if="{{!systematicVisualEnabled}}" class="unit-label">参考答案</view><view class="unit-body">{{view.reflection.answer}}</view></view></view>
      <view class="unit-sources"><button wx:if="{{view.primarySource}}" class="btn-base btn-secondary unit-secondary unit-source-primary" data-point-id="{{view.primarySource.id}}" bindtap="handleSource">查看主要原文</button><button wx:if="{{view.relatedSources.length}}" class="unit-menu unit-related-toggle" bindtap="handleSources" aria-expanded="{{sourcesVisible}}"><text wx:if="{{sourcesVisible}}">收起其他相关原文</text><text wx:else>其他相关原文（{{view.relatedSources.length}}）</text></button><view wx:if="{{sourcesVisible}}"><button wx:for="{{view.relatedSources}}" wx:key="id" class="unit-source" data-point-id="{{item.id}}" bindtap="handleSource">{{item.title}} ›</button></view></view>
    </view>
    <view wx:else class="unit-card unit-closeout-card">
      <block wx:if="{{view.routeConclusion && view.routeRead === view.routeCount}}">
        <view class="unit-caption">本篇已读完</view><view class="unit-title">{{view.routeConclusion.title}}</view>
        <view class="unit-body unit-conclusion-summary">{{view.routeConclusion.summary}}</view>
        <view class="unit-scope unit-conclusion-boundary"><text class="unit-scope-label">完成边界</text><text>{{view.routeConclusion.boundary}}</text></view>
      </block>
      <block wx:else>
        <view class="unit-closeout-title">{{closeoutGroupTitle}}</view>
        <view wx:if="{{view.remaining}}" class="unit-closeout-remaining">还有{{view.remaining}}个小节未读。</view>
        <view class="unit-closeout-lessons"><view wx:for="{{lessonRows}}" wx:key="stepId" class="unit-lesson-row"><view class="unit-review-title-row"><text class="unit-review-title">{{item.title}}</text><text class="politics-status-tag {{item.read ? '' : 'politics-status-tag-muted'}}">{{item.read ? '已读' : item.skipped ? '未读' : '待阅读'}}</text></view><button wx:if="{{item.read || item.skipped}}" class="unit-menu unit-review-action" data-index="{{item.index}}" bindtap="handleReview" aria-label="{{(item.skipped ? '补读' : '回看') + item.title}}">{{item.skipped ? '补读' : '回看'}}</button></view></view>
        <view wx:if="{{nextGroup}}" class="unit-closeout-next"><view class="unit-closeout-next-label">下一主题</view><view class="unit-closeout-next-title">{{nextGroupDisplay.title}}</view><view wx:if="{{nextGroupDisplay.description}}" class="unit-closeout-next-copy">{{nextGroupDisplay.description}}</view></view>
      </block>
    </view>
    <view class="session-action-dock unit-dock">
      <block wx:if="{{reviewing}}"><button wx:if="{{reviewWasSkipped}}" class="btn-base btn-primary unit-primary" bindtap="handleFinishReview">本节读完并返回</button><button wx:else class="btn-base btn-primary unit-primary" bindtap="handleReturnReview">返回当前进度</button></block>
      <block wx:elif="{{view.closeout}}"><button wx:if="{{nextGroup}}" class="btn-base btn-primary unit-primary unit-next-group" data-group-id="{{nextGroup.id}}" bindtap="handleGroup">进入下一主题</button><button wx:elif="{{view.routeConclusion && view.routeRead === view.routeCount}}" class="btn-base btn-primary unit-primary" bindtap="handleGroups">查看两篇进度</button><button wx:else class="btn-base btn-secondary unit-secondary" bindtap="handleGroups">返回学习首页</button></block>
      <block wx:else><view class="session-action-row unit-dock-actions"><view class="session-action-slot session-action-left unit-action-slot unit-action-left"><button class="btn-base btn-compact btn-secondary unit-secondary unit-save-progress" bindtap="handleExit">保留进度</button></view><view class="session-action-slot session-action-center unit-action-slot unit-action-center"><button class="btn-base btn-compact btn-primary unit-primary unit-complete" data-step-id="{{view.stepId}}" bindtap="handleComplete">{{view.completionAction}}</button></view><view class="session-action-slot session-action-right unit-action-slot unit-action-right"><button class="btn-base btn-compact btn-ghost unit-ghost unit-skip" data-step-id="{{view.stepId}}" bindtap="handleSkip">跳过本节</button></view></view></block>
    </view>
  </block>
  <view wx:elif="{{screen === 'expired'}}" class="unit-card"><view class="unit-title">学习内容已重新编排</view><view class="unit-body">原学习记录仍然保留。请选择当前可读的主题，从新的小节开始。</view><button class="btn-base btn-primary unit-primary" bindtap="handleGroups">查看可学习内容</button></view>
  <view wx:elif="{{screen === 'unavailable'}}" class="unit-card"><view class="unit-title">本次试读暂不可用</view><view class="unit-caption">可以返回政治首页，继续浏览现有知识。</view><button class="btn-base btn-primary unit-primary" bindtap="handleExit">返回政治首页</button></view>
  <view wx:if="{{error}}" class="unit-error" role="alert"><view>{{error}}</view><button class="btn-base btn-secondary unit-secondary" bindtap="handleRetry">重试</button></view>
<reading-controls id="reading-controls-panel" wx:if="{{readingUiEnabled && screen === 'lesson'}}" panel-only="{{true}}" visible="{{readingSettingsVisible}}" preferences="{{displayPreferences}}" bind:close="handleReadingSettingsClose" bind:preferenceschange="handleReadingPreferences" />
</view>
