.politics-search-page { min-height: 100vh; background: var(--bg-page-accent); }
.politics-search-shell { min-height: 100vh; padding: 24rpx 24rpx 52rpx; }
.politics-search-hero { margin-bottom: 22rpx; padding: 26rpx 22rpx; border-color: rgba(255, 166, 43, .14); }
.politics-search-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.politics-search-kicker { color: var(--knowledge-boundary-text); font-size: 21rpx; line-height: 1.4; font-weight: 800; }
.politics-search-title { margin-top: 7rpx; color: var(--text-primary); font-size: 40rpx; line-height: 1.25; font-weight: 750; }
.politics-search-clear { flex: none; min-width: 88rpx; min-height: 72rpx; display: flex; align-items: center; justify-content: center; padding: 8rpx 12rpx; border-radius: 999rpx; background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: 20rpx; font-weight: 700; box-sizing: border-box; }
.politics-search-field-label { margin-top: 20rpx; color: var(--text-secondary); font-size: 20rpx; font-weight: 750; }
.politics-search-bar { display: flex; align-items: center; gap: 13rpx; margin-top: 8rpx; padding: 17rpx 18rpx; border: 1rpx solid rgba(255, 166, 43, .16); border-radius: 18rpx; background: #fff; }
.politics-search-icon { flex: none; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 11rpx; background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: 17rpx; font-weight: 800; }
.politics-search-input { flex: 1; min-width: 0; color: var(--text-primary); font-size: 25rpx; line-height: 1.5; }
.politics-search-scope { margin-top: 13rpx; color: var(--text-tertiary); font-size: 19rpx; line-height: 1.4; }
.politics-search-intents { width: 100%; margin-top: 15rpx; white-space: nowrap; }
.politics-search-intent-row { display: inline-flex; gap: 8rpx; padding-right: 20rpx; }
.politics-search-intent { min-height: 72rpx; display: flex; align-items: center; padding: 8rpx 13rpx; border-radius: 999rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 18rpx; font-weight: 700; box-sizing: border-box; }
.politics-search-intent-active { background: var(--knowledge-reading-text); color: #fff; }
.politics-search-section-title { margin: 0 0 12rpx 3rpx; color: var(--text-secondary); font-size: 23rpx; font-weight: 750; }
.politics-search-suggestion-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.politics-search-suggestion { min-height: 72rpx; display: flex; align-items: center; padding: 11rpx 15rpx; border: 1rpx solid rgba(47, 107, 255, .12); border-radius: 999rpx; background: var(--bg-card); color: var(--knowledge-reading-text); font-size: 21rpx; font-weight: 700; box-sizing: border-box; }
.politics-search-guide { margin-top: 22rpx; padding: 24rpx 22rpx; border-color: rgba(51, 196, 122, .15); }
.politics-search-guide-title { color: var(--text-primary); font-size: 27rpx; line-height: 1.4; font-weight: 750; }
.politics-search-guide-desc { margin-top: 8rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.65; }
.politics-search-summary { margin: 0 0 13rpx 3rpx; color: var(--text-secondary); font-size: 22rpx; }
.politics-search-results { display: flex; flex-direction: column; gap: 16rpx; }
.politics-search-card { padding: 22rpx 20rpx; }
.politics-search-card-selected { border-color: var(--knowledge-reading-text); }
.politics-search-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.politics-search-card-title { flex: 1; min-width: 0; color: var(--text-primary); font-size: 30rpx; line-height: 1.35; font-weight: 750; }
.politics-search-match-label { flex: none; padding: 6rpx 10rpx; border-radius: 999rpx; background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: 17rpx; line-height: 1.3; font-weight: 700; }
.politics-search-review-meta { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 9rpx; }
.politics-search-review-state,
.politics-search-risk-state { padding: 4rpx 9rpx; border-radius: 999rpx; background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: 17rpx; line-height: 1.3; font-weight: 700; }
.politics-search-review-state-approved { background: var(--bg-soft-green); color: var(--knowledge-system-text); }
.politics-search-risk-state { background: var(--bg-soft-purple); color: var(--knowledge-recall-text); }
.politics-search-match { margin-top: 12rpx; padding: 13rpx 15rpx; border-left: 5rpx solid var(--knowledge-boundary-text); border-radius: 0 12rpx 12rpx 0; background: var(--bg-soft-orange); color: var(--text-secondary); font-size: 21rpx; line-height: 1.55; }
.politics-search-empty { padding: 46rpx 28rpx; text-align: center; }
.politics-search-empty-title { color: var(--text-primary); font-size: 29rpx; font-weight: 750; }
.politics-search-empty-desc { margin-top: 9rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.6; }
.politics-search-empty-action { min-height: 88rpx; display: flex; align-items: center; justify-content: center; margin-top: 20rpx; border-radius: 16rpx; background: var(--knowledge-system-text); color: #fff; font-size: 21rpx; font-weight: 800; }
.politics-search-mask { position: fixed; z-index: 20; inset: 0; background: rgba(15,23,42,.38); }
.politics-search-preview { position: fixed; z-index: 21; left: 0; right: 0; bottom: 0; max-height: 80vh; overflow-y: auto; padding: 16rpx 26rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fff; box-shadow: 0 -16rpx 50rpx rgba(15,23,42,.14); box-sizing: border-box; }
.politics-search-preview-handle { width: 68rpx; height: 7rpx; margin: 0 auto 18rpx; border-radius: 999rpx; background: var(--border-subtle); }
.politics-search-preview-label { color: var(--knowledge-reading-text); font-size: 19rpx; font-weight: 800; }
.politics-search-preview-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.politics-search-preview-close { min-width: 88rpx; min-height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--bg-page-accent); color: var(--text-secondary); font-size: 19rpx; font-weight: 750; }
.politics-search-preview-title { margin-top: 8rpx; color: var(--text-primary); font-size: 32rpx; line-height: 1.4; font-weight: 800; }
.politics-search-preview-primary { min-height: 88rpx; display: flex; align-items: center; justify-content: center; margin-top: 18rpx; padding: 15rpx 18rpx; border-radius: 16rpx; background: var(--knowledge-reading-text); color: #fff; font-size: 21rpx; font-weight: 800; text-align: center; box-sizing: border-box; }
.politics-search-preview-more { min-height: 72rpx; display: flex; align-items: center; justify-content: center; margin-top: 8rpx; color: var(--text-secondary); font-size: 19rpx; font-weight: 750; }
.politics-search-preview-other { overflow: hidden; border: 1rpx solid var(--border-subtle); border-radius: 14rpx; }
.politics-search-preview-other view { min-height: 80rpx; display: flex; align-items: center; justify-content: center; color: var(--text-secondary); font-size: 19rpx; font-weight: 750; }
.politics-search-preview-other view + view { border-top: 1rpx solid var(--border-subtle); }

@media (max-width: 340px) {
  .politics-search-shell { padding-left: 18rpx; padding-right: 18rpx; }
}
