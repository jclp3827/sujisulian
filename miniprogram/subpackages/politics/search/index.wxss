.politics-search-page { min-height: 100vh; background: var(--bg-page-accent); }
.politics-search-shell { min-height: 100vh; padding: 24rpx 24rpx 52rpx; }
.politics-search-hero { margin-bottom: 22rpx; padding: 26rpx 22rpx; border-color: rgba(255, 166, 43, .14); }
.politics-search-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.politics-search-kicker { color: var(--color-orange-700); font-size: 21rpx; line-height: 1.4; font-weight: 800; }
.politics-search-title { margin-top: 7rpx; color: var(--text-primary); font-size: 40rpx; line-height: 1.25; font-weight: 750; }
.politics-search-clear { flex: none; padding: 8rpx 12rpx; border-radius: 999rpx; background: var(--bg-soft-orange); color: var(--color-orange-700); font-size: 20rpx; font-weight: 700; }
.politics-search-bar { display: flex; align-items: center; gap: 13rpx; margin-top: 22rpx; padding: 17rpx 18rpx; border: 1rpx solid rgba(255, 166, 43, .16); border-radius: 18rpx; background: #fff; }
.politics-search-icon { flex: none; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 11rpx; background: var(--bg-soft-orange); color: var(--color-orange-700); font-size: 17rpx; font-weight: 800; }
.politics-search-input { flex: 1; min-width: 0; color: var(--text-primary); font-size: 25rpx; line-height: 1.5; }
.politics-search-scope { margin-top: 13rpx; color: var(--text-tertiary); font-size: 19rpx; line-height: 1.4; }
.politics-search-section-title { margin: 0 0 12rpx 3rpx; color: var(--text-secondary); font-size: 23rpx; font-weight: 750; }
.politics-search-suggestion-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.politics-search-suggestion { padding: 11rpx 15rpx; border: 1rpx solid rgba(47, 107, 255, .12); border-radius: 999rpx; background: var(--bg-card); color: var(--color-primary-500); font-size: 21rpx; font-weight: 700; }
.politics-search-guide { margin-top: 22rpx; padding: 24rpx 22rpx; border-color: rgba(51, 196, 122, .15); }
.politics-search-guide-title { color: var(--text-primary); font-size: 27rpx; line-height: 1.4; font-weight: 750; }
.politics-search-guide-desc { margin-top: 8rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.65; }
.politics-search-summary { margin: 0 0 13rpx 3rpx; color: var(--text-secondary); font-size: 22rpx; }
.politics-search-results { display: flex; flex-direction: column; gap: 16rpx; }
.politics-search-card { padding: 22rpx 20rpx; }
.politics-search-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.politics-search-card-title { flex: 1; min-width: 0; color: var(--text-primary); font-size: 30rpx; line-height: 1.35; font-weight: 750; }
.politics-search-match-label { flex: none; padding: 6rpx 10rpx; border-radius: 999rpx; background: var(--bg-soft-orange); color: var(--color-orange-700); font-size: 17rpx; line-height: 1.3; font-weight: 700; }
.politics-search-path { margin-top: 9rpx; color: var(--color-green-700); font-size: 19rpx; line-height: 1.45; font-weight: 700; }
.politics-search-review-meta { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 9rpx; }
.politics-search-review-state,
.politics-search-risk-state { padding: 4rpx 9rpx; border-radius: 999rpx; background: var(--bg-soft-orange); color: var(--color-orange-700); font-size: 17rpx; line-height: 1.3; font-weight: 700; }
.politics-search-review-state-approved { background: var(--bg-soft-green); color: var(--color-green-700); }
.politics-search-risk-state { background: var(--bg-soft-purple); color: var(--color-purple-500); }
.politics-search-match { margin-top: 12rpx; padding: 13rpx 15rpx; border-left: 5rpx solid var(--color-orange-700); border-radius: 0 12rpx 12rpx 0; background: var(--bg-soft-orange); color: var(--text-secondary); font-size: 21rpx; line-height: 1.55; }
.politics-search-card-summary { margin-top: 12rpx; color: var(--text-tertiary); font-size: 20rpx; line-height: 1.55; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.politics-search-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 15rpx; padding-top: 14rpx; border-top: 1rpx solid var(--border-subtle); }
.politics-search-relation-count { flex: none; color: var(--text-tertiary); font-size: 18rpx; }
.politics-search-actions { display: flex; gap: 7rpx; }
.politics-search-action { padding: 8rpx 11rpx; border-radius: 10rpx; font-size: 18rpx; font-weight: 750; }
.politics-search-action-system { background: var(--bg-soft-green); color: var(--color-green-700); }
.politics-search-action-reading { background: var(--bg-soft-blue); color: var(--color-primary-500); }
.politics-search-action-relation { background: var(--bg-soft-orange); color: var(--color-orange-700); }
.politics-search-empty { padding: 46rpx 28rpx; text-align: center; }
.politics-search-empty-title { color: var(--text-primary); font-size: 29rpx; font-weight: 750; }
.politics-search-empty-desc { margin-top: 9rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.6; }

@media (max-width: 340px) {
  .politics-search-shell { padding-left: 18rpx; padding-right: 18rpx; }
  .politics-search-card-footer { align-items: flex-start; flex-direction: column; }
}
