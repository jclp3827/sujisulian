.politics-search-page { min-height: 100vh; background: var(--bg-page-accent); }
.politics-search-shell { min-height: 100vh; padding: var(--space-4) var(--ui-page-gutter) calc(var(--space-7) + env(safe-area-inset-bottom)); }
.politics-search-hero { margin-bottom: var(--ui-section-gap); padding: var(--ui-card-padding); border-color: var(--ui-color-border); }
.politics-search-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.politics-search-title { color: var(--text-primary); font-size: var(--ui-font-page-title); line-height: 1.25; font-weight: var(--ui-weight-heading); }
.politics-search-clear { flex: none; min-width: var(--ui-touch-target); min-height: var(--ui-touch-target); display: flex; align-items: center; justify-content: center; padding: var(--space-1) var(--space-2); border-radius: var(--ui-radius-pill); background: var(--ui-color-accent-soft); color: var(--ui-color-accent-text); font-size: var(--ui-font-meta); font-weight: 700; box-sizing: border-box; }
.politics-search-bar { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-3); padding: var(--space-3) var(--space-4); border: var(--ui-border-width) solid var(--ui-color-border); border-radius: var(--ui-radius-control); background: #fff;  min-height: var(--ui-button-height);}
.politics-search-icon { flex: none; width: 24rpx; height: 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: transparent; color: var(--knowledge-boundary-text); font-size: var(--ui-font-meta); font-weight: var(--ui-weight-heading);  position: relative; border: 2rpx solid var(--ui-color-accent-text);}
.politics-search-input { flex: 1; min-width: 0; color: var(--text-primary); font-size: var(--ui-font-body); line-height: 1.5; }
.politics-search-scope { margin-top: var(--space-2); color: var(--text-tertiary); font-size: var(--ui-font-meta); line-height: 1.4; }
.politics-search-intents { width: 100%; margin-top: var(--space-3); white-space: nowrap; }
.politics-search-intent-row { display: inline-flex; gap: var(--space-1); padding-right: var(--space-3); }
.politics-search-intent { min-width: var(--ui-touch-target); min-height: var(--ui-touch-target); display: flex; align-items: center; justify-content: center; padding: var(--space-1) var(--space-2); border-radius: var(--ui-radius-pill); background: var(--ui-color-soft); color: var(--text-secondary); font-size: var(--ui-font-description); font-weight: 700; box-sizing: border-box; }
.politics-search-intent-active { background: var(--ui-color-accent); color: #fff; }
.politics-search-section-title { margin: 0 0 var(--space-2) var(--space-0); color: var(--text-secondary); font-size: var(--ui-font-description); font-weight: var(--ui-weight-heading); }
.politics-search-suggestion-list { display: flex; flex-wrap: wrap; gap: var(--space-1); }
.politics-search-suggestion { min-height: var(--ui-touch-target); display: flex; align-items: center; padding: var(--space-2) var(--space-3); border: var(--ui-border-width) solid var(--ui-color-border); border-radius: var(--ui-radius-pill); background: var(--bg-card); color: var(--knowledge-reading-text); font-size: var(--ui-font-description); font-weight: 700; box-sizing: border-box; }
.politics-search-summary { margin: 0 0 var(--space-2) var(--space-0); color: var(--text-secondary); font-size: var(--ui-font-meta); }
.politics-search-results { display: flex; flex-direction: column; gap: var(--space-3); }
.politics-search-card { padding: var(--ui-card-padding); }
.politics-search-card-selected { border-color: var(--knowledge-reading-text); }
.politics-search-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }
.politics-search-card-title { flex: 1; min-width: 0; color: var(--text-primary); font-size: var(--ui-font-card-title); line-height: 1.35; font-weight: var(--ui-weight-heading); }
.politics-search-match-label { flex: none; padding: var(--space-0) var(--space-1); border-radius: var(--ui-radius-pill); background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: var(--ui-font-meta); line-height: 1.3; font-weight: 700; }

.politics-search-match { margin-top: var(--space-2); padding: var(--space-2) var(--space-3); border-left: 4rpx solid var(--ui-color-accent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; background: var(--ui-color-soft); color: var(--ui-color-muted); font-size: var(--ui-font-body); line-height: 1.55; }
.politics-search-empty { padding: var(--space-7) var(--space-4); text-align: center; }
.politics-search-empty-title { color: var(--text-primary); font-size: var(--ui-font-body); font-weight: var(--ui-weight-heading); }
.politics-search-empty-desc { margin-top: var(--space-1); color: var(--text-secondary); font-size: var(--ui-font-description); line-height: 1.6; }
.politics-search-empty-action { min-height: var(--ui-button-height); display: flex; align-items: center; justify-content: center; margin-top: var(--space-3); border-radius: var(--ui-radius-control); background: var(--ui-color-accent); color: #fff; font-size: var(--ui-button-font); font-weight: var(--ui-weight-heading); }

@media (max-width: 340px) {
  .politics-search-shell { padding-left: var(--space-3); padding-right: var(--space-3); }
}
.politics-search-storage { margin-top: var(--space-2); padding: var(--space-2) var(--space-2); border-radius: var(--radius-sm); background: var(--bg-soft-orange); color: var(--knowledge-boundary-text); font-size: var(--ui-font-meta); line-height: 1.5; }

.politics-search-icon::after { position: absolute; content: ""; right: -8rpx; bottom: -4rpx; width: 10rpx; height: 2rpx; background: var(--ui-color-accent-text); transform: rotate(45deg); }
