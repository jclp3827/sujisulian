        {
          "id": "administrative-subject",
          "title": "行政主体",
          "guide": "用“权—名—责”判断行政主体：有行政权、能以自己名义行权、能独立担责；再区分行政机关与被授权组织。",
          "blocks": [
            {
              "type": "list",
              "label": "行政主体",
              "items": [
                "行政主体是依法享有行政职权，能以自己名义从事行政管理活动，并独立承担由此产生法律责任的组织，包括行政机关和依法授权的组织。具体授权依据因行政行为类型不同，可以来自法律、法规或者规章。",
                "三个特征：享有国家行政权力；能以自己名义行使行政权；能独立对外承担行为产生的法律责任，即“权—名—责”。"
              ],
              "highlights": [
                "权—名—责",
                "行政机关",
                "法律法规授权的组织"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-law-overview-kp-3"
              ]
            },
            {
              "type": "table",
              "label": "行政主体范围",
              "columns": [
                "类型",
                "主体资格规则"
              ],
              "rows": [
                [
                  "行政机关",
                  "包括中央和地方行政机关。政府派出机关具有主体资格；职能部门派出机构、行政机关内设机构须经授权才具有主体资格。"
                ],
                [
                  "依法授权组织",
                  "包括依照相关法律、法规或者规章取得授权的企业组织、事业单位、社会团体和群众自治组织；具体可授权的法源范围须以相应单行法规定为准。"
                ]
              ],
              "highlights": [
                "派出机关",
                "派出机构",
                "内设机构",
                "授权"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-law-overview-block-3-2"
              ],
              "mobileLayout": "cards",
              "cardTitleColumn": 0
            }
          ]
        },
        {
          "id": "administrative-counterpart",
          "title": "行政相对人",
          "guide": "行政相对人不是行政机关的下级，而是行政管理法律关系中权益受到行政行为影响的另一方个人或组织。",
          "blocks": [
            {
              "type": "list",
              "label": "行政相对人",
              "items": [
                "行政相对人是行政管理法律关系中与行政主体相对应的另一方当事人，即行政主体的行政行为影响其权益的个人或组织。"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-law-overview-kp-4"
              ]
            }
          ]
        },
        {
          "id": "administrative-act",
          "title": "行政行为",
          "guide": "按对象范围区分：针对特定人和事项的是具体行政行为；面向不特定对象、可反复适用的是抽象行政行为。",
          "blocks": [
            {
              "type": "table",
              "label": "行政行为",
              "columns": [
                "类型",
                "概念与特征",
                "常见形式"
              ],
              "rows": [
                [
                  "具体行政行为",
                  "行政主体针对特定对象、特定事项作出的处理决定；属于法律行为、单方行政职权行为和外部性处理。",
                  "行政许可与确认、行政奖励与给付、行政征收与征用、行政处罚、行政强制、行政监督、行政裁决等。"
                ],
                [
                  "抽象行政行为",
                  "国家行政机关制定法规、规章和有普遍约束力决定、命令等行政规则的行为；对象和效力具有普遍性、持续性。原则上不能单独提起行政诉讼，但对行政行为起诉时，可以依法附带请求审查规章以外的部分规范性文件。",
                  "行政法规、部门规章、地方政府规章、其他具有普遍约束力且能反复适用的行政规范性文件。"
                ]
              ],
              "highlights": [
                "具体行政行为",
                "抽象行政行为",
                "特定对象",
                "不特定对象",
                "不能单独提起行政诉讼",
                "附带审查"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-law-overview-kp-5"
              ],
              "mobileLayout": "cards",
              "cardTitleColumn": 0
            },
            {
              "type": "table",
              "label": "抽象行政行为制定机关",
              "columns": [
                "类型",
                "制定机关"
              ],
              "rows": [
                [
                  "行政法规",
                  "国务院"
                ],
                [
                  "部门规章",
                  "国务院各部、各委员会、中国人民银行、审计署、具有行政管理职能的直属机构以及法律规定的机构"
                ],
                [
                  "地方政府规章",
                  "省、自治区、直辖市、设区的市、自治州人民政府"
                ],
                [
                  "其他规范性文件",
                  "行政机关对不特定对象发布、具有普遍约束力并可反复适用的决定、命令等"
                ]
