      "indexText": "行政诉讼包括受案范围、级别地域管辖、复议后被告、被告举证、起诉期限和判决方式。",
      "tabs": [
        {
          "id": "litigation-concept",
          "title": "行政诉讼的概念",
          "guide": "行政诉讼是“民告官”：相对人起诉，法院在诉讼参与人参加下审查被诉行政行为并解决行政争议。",
          "blocks": [
            {
              "type": "list",
              "label": "行政诉讼的概念",
              "items": [
                "行政诉讼是公民、法人或其他组织认为行政机关或者法律、法规、规章授权的组织作出的行政行为侵犯其合法权益，依法向人民法院起诉，由法院审查被诉行政行为并裁判解决行政争议的制度，又称“民告官”。"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-litigation-kp-1"
              ]
            }
          ]
        },
        {
          "id": "litigation-parties",
          "title": "诉讼当事人",
          "guide": "原告看谁与行政行为有利害关系，被告看谁作出行为；经复议后用“维持共同告、改变告复议、复议不作为告所不服者”判断。",
          "blocks": [
            {
              "type": "table",
              "label": "诉讼当事人",
              "columns": [
                "角色或情形",
                "确定规则"
              ],
              "rows": [
                [
                  "公民原告",
                  "公民本人；公民死亡的，其近亲属可以起诉；公民被限制人身自由的，其近亲属可以依其口头或书面委托，以该公民名义提起诉讼。"
                ],
                [
                  "法人原告",
                  "法人本身；法人终止时，由承受其权利的法人或其他组织起诉。"
                ],
                [
                  "一般被告",
                  "公民、法人或其他组织直接起诉的，作出行政行为的行政机关是被告；法律、法规、规章授权组织作出行政行为的，该组织是被告；受委托组织作出行政行为的，委托机关是被告。"
                ],
                [
                  "复议维持",
                  "原行政机关和复议机关为共同被告。"
                ],
                [
                  "复议改变",
                  "复议机关为被告。"
                ],
                [
                  "复议不作为",
                  "起诉原行政行为的，作出原行政行为的机关是被告；起诉复议机关不作为的，复议机关是被告。"
                ]
              ],
              "highlights": [
                "共同被告",
                "复议机关为被告"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-litigation-kp-2"
              ],
              "mobileLayout": "cards",
              "cardTitleColumn": 0
            }
          ]
        },
        {
          "id": "litigation-principles",
          "title": "行政诉讼原则",
          "guide": "共有原则按普通诉讼制度记，特有原则抓六个边界：可选择复议、审合法性、不停止执行、不调解、被告举证、独立审判。",
          "blocks": [
            {
              "type": "list",
              "label": "行政诉讼原则",
              "items": [
                "共有原则：以事实为依据、以法律为准绳；当事人法律地位平等；使用民族语言；当事各方有权辩论；检察院监督；公开审判；合议、回避、两审终审。"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-litigation-kp-3"
              ]
            },
            {
              "type": "list",
              "label": "特有原则",
              "items": [
                "选择复议：可先复议后起诉，也可不经复议直接起诉，但法律规定复议前置的除外。",
                "人民法院审查行政行为合法性。",
                "诉讼期间，行政行为原则上不停止执行。",
                "行政案件原则上不适用调解；行政赔偿、补偿以及行政机关行使法定裁量权的案件可以调解。",
                "被告负举证责任。",
                "人民法院独立行使行政审判权，不受行政机关、社会团体和个人干涉。"
              ],
              "highlights": [
                "选择复议",
                "合法性",
                "不停止执行",
                "不适用调解",
                "被告负举证责任",
                "独立行使审判权"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-litigation-block-3-2"
              ]
            }
          ]
        },
        {
          "id": "litigation-scope",
          "title": "受案范围",
          "guide": "可诉事项围绕处罚、强制、许可、权属征收、履职和各类权益侵害；排除国家行为、抽象规范、内部人事和法定最终裁决。",
          "blocks": [
            {
              "type": "list",
              "label": "受案范围",
              "items": [
                "对行政处罚不服；对行政强制措施和行政强制执行不服；对行政许可决定不服。",
                "对确认自然资源所有权或使用权决定不服；对征收、征用及其补偿决定不服。",
                "行政机关不履行或拒绝履行保护人身权、财产权等法定职责。",
                "认为行政机关侵犯经营自主权、农村土地承包经营权、农村土地经营权，或滥用行政权力排除限制竞争。",
                "认为行政机关违法集资、摊派费用或违法要求履行其他义务；未依法支付抚恤金、最低生活保障或社会保险待遇。",
                "认为行政机关不依法履行、未按约履行或违法变更解除政府特许经营、土地房屋征收补偿等协议。",
                "认为行政机关侵犯其他人身权、财产权等合法权益。"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-litigation-kp-4"
              ]
            },
            {
              "type": "list",
              "label": "人民法院不予受理的事项",
              "items": [
                "国防、外交等国家行为。",
                "行政法规、规章或行政机关制定发布的具有普遍约束力的决定、命令。",
                "行政机关对其工作人员的奖惩、任免等决定。",
                "法律规定由行政机关最终裁决的行政行为。"
              ],
              "warningHighlights": [
                "不予受理"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-litigation-block-4-2"
              ]
            }
          ]
        },
