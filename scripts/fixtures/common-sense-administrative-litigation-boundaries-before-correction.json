        {
          "id": "litigation-evidence",
          "title": "证据",
          "guide": "证据种类完整列举，举证责任抓“被告证合法、原告证申请或损害”：被告不得在诉讼中自行向原告第三人和证人取证。",
          "blocks": [
            {
              "type": "list",
              "label": "证据",
              "items": [
                "证据种类包括：书证、物证、视听资料、电子数据、证人证言、当事人陈述、鉴定意见、勘验笔录、现场笔录。"
              ],
              "sourceUnitIds": [
                "cs-scan-114-165-administrative-litigation-kp-6"
              ]
            },
            {
              "type": "table",
              "label": "举证责任",
              "columns": [
                "主体",
                "责任"
              ],
              "rows": [
                [
                  "被告",
                  "提供事实依据和法律依据，证明行政行为合法；诉讼中被告及其代理人不得自行向原告、第三人和证人收集证据。"
                ],
                [
                  "原告",
                  "起诉不履行法定职责时，应提供曾向被告提出申请的证据；行政赔偿、补偿案件中，应对行政行为造成的损害提供证据。因被告原因导致原告无法举证的，由被告承担举证责任。"
                ]
              ],
              "highlights": [
                "被告负举证责任",
                "不得自行收集证据"
