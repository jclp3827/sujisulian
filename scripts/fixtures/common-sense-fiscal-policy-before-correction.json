                }
              ],
              "highlights": [
                "政府购买",
                "实质性支出",
                "实际交易",
                "直接形成社会需求和购买力",
                "政府转移支付",
                "货币性支出",
                "无相应交换"
              ],
              "sourceUnitIds": [
                "cs-23-30-p18-fiscal-policy-spending-list"
              ]
            }
          ]
