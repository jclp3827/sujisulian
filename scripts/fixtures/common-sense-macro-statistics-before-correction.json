          "blocks": [
            {
              "type": "list",
              "label": "拉动经济增长的三驾马车",
              "items": [
                "“三驾马车”是指投资、消费和出口，它们是拉动经济增长的最主要力量。",
                "投资和消费合称为内需，出口称为外需。"
              ],
              "highlights": [
