                "最终产品",
                "中间产品价值不计入",
                "生产",
                "流量而不是存量",
                "非市场活动不计入",
                "地域概念"
              ],
              "sourceUnitIds": [
                "cs-23-30-p15-gdp-list"
              ]
            }
          ]
        },
        {
