      "file": "xinhai-revolution.json",
      "unit": {
        "id": "cs-1-9-p17-xinhai-influence-list",
        "type": "list",
        "page": 17,
        "label": "影响",
        "items": [
          "影响：推翻了清王朝的统治，结束了中国两千多年的封建君主专制制度，使民主共和的观念深入人心。"
        ]
      }
    },
